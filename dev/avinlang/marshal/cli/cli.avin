module dev.avinlang.marshal.cli

// The command line: each command is one request to the daemon, which it starts when none is
// listening.
import avin.fs
import avin.io
import avin.io.ErrorKind
import avin.io.IoError
import avin.net.UnixStream
import avin.process
import avin.process.Command
import avin.threads
import avin.threads.{Atomic, spawn}
import avin.time
import avin.time.millis
import dev.avinlang.marshal
import dev.avinlang.marshal.{JobInfo, JobSpec, Reply, Request}
import dev.avinlang.marshal.{Submitted, Ended, Found, Jobs, Using, Hi, Done, Failed, Amended, Over}
import dev.avinlang.marshal.{Condition, Once, Past, Follow, Streamed, Replayed}
import dev.avinlang.marshal.{GrepSpec, grepMatcher, grepLines}
import dev.avinlang.marshal.daemon
import dev.avinlang.json.Json

// Each command: how it is written after `marshal`, and what it does. The README's command list
// is these lines, word for word.
val Commands: Vector[(string, string)] = [
  ("submit [options] -- <command...>", "queue a job; prints its id"),
  (
    "run [options] -- <command...>",
    "submit and wait: prints the log's path, then the result; exits with the job's status"
  ),
  ("run-type <type> [parameters]", "runs a job type's steps as one job and waits; <type> --help lists its parameters"),
  (
    "train [parameters] <branch...>",
    "run-type train: merges the branches, builds and tests them, lands them when green"
  ),
  (
    "wait <id> | --until <cond> [--timeout <t>] [--since <t>]",
    "waits for the job (--timeout also with an id), prints one result line, exits with its status (at once for a job that has already ended); or waits for an event (--since only here), prints it, exits 0; 124 on timeout"
  ),
  (
    "events [--follow] [--since <t>] [<filter>]",
    "the logged events as JSON lines; --follow goes on streaming them until killed"
  ),
  (
    "ls [--compact | -c]",
    "jobs queued, running and recently ended, after a line naming the reservation while one stands; a queued job's state says why it waits: queued (draining); --compact: one line a job, no wider than the terminal ($COLUMNS, else 80, where output is not one): COMMAND is cut with …, then LABEL, then columns go (FROM, RESV, USED, OWNER, ETA, UNITS, STARTED, ELAPSED, KIND)"
  ),
  (
    "kill <id> | <selector>",
    "stops the job's whole process tree (a queued or waiting job is cancelled); --owner <name>, --label <text> or --all stops every job selected (marshal kill --help)"
  ),
  (
    "rerun <id>",
    "submits an ended job again: its command, directory, environment, kind, label and resources; prints the new id"
  ),
  (
    "clean [--older-than <t>] [--keep <n>] [--dry-run]",
    "removes the logs of ended jobs (never a job that is not over), stale run directories and unused compiled steps; prints what went and the bytes freed; --dry-run only lists them"
  ),
  (
    "hold <id> | <filters>",
    "keeps a queued job from starting; it keeps its place; --exclusive, --draining, --kind <k>, --label <glob> hold every queued job selected, as a group (marshal hold --help)"
  ),
  (
    "release <id> | --group <name> | <filters>",
    "lets a held job start again, in its place; --group releases what a filtered hold held"
  ),
  ("groups", "the groups filtered holds made that still hold jobs: name, count, ids"),
  (
    "priority <id> <n> | --urgent | --low | --up | --down",
    "places a queued job in its lane: higher first; --urgent: the back of the urgent band; --low: behind every job not low, started only in spare room (a number or --urgent makes it normal again); --up, --down: one place earlier or later among the queued jobs of its band (urgent, normal or low), which it does not leave, taking the priority of the job it passes"
  ),
  (
    "amend <id> [options]",
    "changes a job's settings in place: queued, it keeps its place; running, only --deadline, --label, --retries, --quiet-timeout"
  ),
  (
    "pause [<id>]",
    "stops a running job's processes, keeping its units, its deadline's clock stopped; with no id, holds the queue"
  ),
  ("resume [<id>]", "continues a paused job; with no id, releases the queue"),
  (
    "polite [<fraction> | off]",
    "while you work: admit jobs against only a fraction of the budget (default 0.75, or 3/4 and the like); a job bigger than that runs alone; off: the whole budget again. Running jobs go on; config.json's polite_schedule switches it on by the clock"
  ),
  (
    "reserve --owner <name> --for <t>",
    "for a release: only the owner's jobs start (its --owner on submit, or its default owner), and quick jobs; every other job waits in its place, `reserved for <name>`, and submitting goes on; running jobs go on. --for (such as 3h, at most 24h) is required: it ends by itself. Reserving again replaces it"
  ),
  ("unreserve", "ends the reservation: the jobs it kept waiting start in their queue order"),
  ("tail <id> [-f] [-n <lines>]", "the job's log; -f follows it until the job ends"),
  (
    "grep <id> <pattern> [-i] [-v] [-n] [-c] [-F] [-m <n>] [-A|-B|-C <n>] [--last <n>]",
    "the lines of the job's log that match the pattern (a regular expression; -F: literal text), as grep prints them; exits 0 when a line matched, 1 when none did, 2 on an error"
  ),
  (
    "status [<id>] [--json]",
    "the budget in use; --json: one JSON object with the running and queued jobs; <id>: that job's state, running, queued (and why), waiting or ended, with its exit status once ended, for any job the daemon or the event log knows; exits 0 whatever the job's outcome"
  ),
  (
    "history [options]",
    "ended jobs from the event log, newest first: id, kind, outcome, exit code, duration, when, label"
  ),
  (
    "stats [options]",
    "per kind from the event log: count, success rate, p50/p90/max duration, timeouts, deadline, peak memory"
  ),
  ("top", "a live view of the budget, the jobs and their logs; h lists its keys"),
  ("stop [--wait | --force]", "stops the daemon; refused while jobs run unless it may wait for them or kill them"),
  ("restart", "the daemon becomes the marshal installed now, keeping its jobs running and queued"),
  (
    "remote token | rotate",
    "the read-only remote API's bearer token (made if there is none), or a new one replacing it at once; config.json's remote turns the API on (marshal remote --help)"
  ),
  ("version", "marshal's version, and the running daemon's"),
  ("daemon", "runs the daemon in the foreground")
]

// The options of `submit` and `run`.
val Options: string = """
Options of submit and run:
  --kind <k>        what the job is, for learning its deadline (default: test when a word of the command is `test`, else build)
  --units <n>       its weight in units, in steps of 0.25 such as 0.5 or 2 (default: the
                    cores 3 or more recent runs of the same work used, rounded up to a quarter,
                    ~ in UNITS: its command in its --dir, its command anywhere, its command with
                    its numbers made alike in its project, or its kind in its project; until
                    then a share of the budget: a quarter for a gate, train, release or landing
                    job, a sixth for a test, a ninth for a build, 1 otherwise). While it runs it
                    is charged the cores it uses where that is more, and weighs them after 90s
                    of it (live in FROM). A given n is a ceiling: once what it runs has run 3
                    times, it weighs the fewer of n and what those runs used (8→~1.5 in UNITS)
  --units-exact     with --units: weigh exactly n, even where its runs used fewer
  --mem <size>      the memory it needs, such as 29G or 512M (default: the learned peak of
                    the same work, such as `sysl test compiler` or `zsh gate.zsh`, learned as
                    --units is, ~ in RESV; until it has run 3 times, the most any run of its
                    work reached (max in FROM), else the share of the budget --units takes (def);
                    --mem 0 reserves none). While it runs it is charged the most it has held
                    where that is more. A given size is a ceiling: once what it runs has run 3
                    times, it reserves the fewer of it and their peak plus a quarter (at least 1G)
                    (20G→~7.5G in RESV)
  --mem-exact       with --mem: reserve exactly that size, even where its runs peaked lower
  --low             for exploratory or probe work: queue it behind every job not low and start it
                    only in spare room, when it fits and is expected (by its own learned runs, else
                    its deadline) to end before any waiting job could start; it never drains the
                    machine, runs at nice 19, and after config.json's low_promote_after (4h) of
                    waiting becomes a normal job; ~ in KIND. Not with --urgent, --landing,
                    --exclusive or --quick
  --external      its work runs outside its own processes (docker run, a VM, sudo to another
                    account's daemon): it reserves exactly --mem, which it must give, and its
                    measured peak is never learned (@ in RESV)
  --landing         run it in the landing lane: first, whatever units others hold, not niced;
                    while it runs its units count as any job's
  --urgent          queue it ahead of every job not urgent in its lane, behind the urgent ones already queued;
                    not niced, backfilled or not
  --quick           run it in the quick lane: at once, outside the unit budget, niced, while its
                    memory fits; at most 2 at a time, and a deadline of at most 2m (default 2m;
                    a shorter --deadline is kept, a longer one refused). Not with --landing
  --exclusive       own the machine, for a benchmark: start once no other job runs in any lane,
                    and start nothing else until it ends. It stops nobody: it waits for the
                    running jobs, and jobs queued after it wait for it, but a landing job
                    queued before it starts still goes first. It weighs the whole unit budget
                    (--units is not needed), is not niced, and its log gets a `marshal exclusive:`
                    line with the load and the busiest processes outside marshal at its start and
                    every 30s; # in KIND. Not with --landing or --quick
  --quiet-load <n>  with --exclusive: also wait until the 1-minute load average has stayed below
                    n for a whole minute; auto is a quarter of the processors. Marshal empties
                    for it as for any exclusive job (ls: emptying); once nothing of marshal's
                    runs it is settling (ls: settling (load 7.9 ≥ 4), ELAPSED the wait so far),
                    holding the machine until the load falls. It never starts before: past
                    config.json's load_wait (15m) it is overdue (red in top), and still waits
  --dir <d>         the directory to run it in, relative to this one (default: this one)
  --deadline <t>    stop it after t: minutes, or 90s, 30m, 2h (default: learned from the runs of
                    the same work, learned as --units is, never its kind alone: twice their
                    median or 1.5x the longest, whichever is later, at least 5m; and at least
                    1.5x a run of it the deadline stopped, until it next succeeds; a learned
                    deadline is then enforced at 1.5x itself, config.json's deadline_margin.
                    With nothing learned: build 20m, test 45m, landing 120m, else 30m)
  --quiet-timeout <t>
                    stop it, with a stack sample, once its log has had no new output for t, written
                    as --deadline writes one; time paused does not count (default: none; run-type
                    and train take it too)
  --after <ids>     wait until jobs <ids> (such as 3,4) have ended; the same as --after-ok
  --after-ok <ids>  wait until they have ended, and cancel it unless each of them succeeded
  --after-any <ids> wait until they have ended, then run it however they ended
  --retries <n>     run it again, up to n times, when it fails or times out (default: 0)
  --retry-delay <t> wait t before each retry: 90s, 30m, 2h (default: none)
  --label <text>    a note to find the job by, shown in ls, history and top: one line of at most 80
                    characters, no control characters (default: one from the command, at most 40
                    characters: a shell's script as its last two path parts, f1fix/gate.zsh, else
                    the program and its first argument, sysl test; label_from "cmd" in --json, and
                    kill --label matches only a given one; run-type and train take it too)
  --owner <name>    who the job is for, shown in OWNER in ls and top: one word (default: the
                    project its --dir is in under ~/dev, such as avin for ~/dev/avin-lang/avin,
                    else its label)
  --                the command begins after this; nothing after it is an option\
"""

// The options of `amend`.
val AmendOptions: string = """
Options of amend (each as submit takes it; give at least one):
  --deadline <t>    a new deadline, measured from the job's start, its pauses left out; +t adds t
                    to the deadline it has (+30m). A running job's deadline already passed is
                    refused: kill stops a job. The run teaches no deadline (amend in FROM)
  --label <text>    a new label
  --retries <n>     how many times more it runs after failing, 0 or more
  --quiet-timeout <t>
                    a new quiet timeout; on a running job its clock starts again now
  --units <n>       not running yet: a new weight, a ceiling as submit's is
  --mem <size>      not running yet: the memory it needs
  --after <ids>, --after-ok <ids>, --after-any <ids>
                    not running yet: the jobs it waits for, instead of those it waited for;
                    a queued job waits again and rejoins the queue where it was

A queued, held or waiting job keeps its place. A running job's --units and --mem are refused (exit
2): it was admitted on them. Its command, directory, environment and lane (--landing, --exclusive,
--quick, --urgent) are never amended (exit 2): kill it and submit it again, or use priority --urgent.
A job that has ended is refused with exit 1. Each amend logs an `amended` event.\
"""

// The options of `kill`.
val KillOptions: string = """
kill <id> stops one job. With a selector it stops every job selected, in one step:
  --owner <name>    the jobs whose OWNER (as ls shows it) is name
  --label <text>    the jobs whose label contains text, upper and lower case alike
  --owner and --label together select the jobs that match both.
  --queued          only jobs that have not started (queued, held, waiting for others, waiting to retry)
  --running         only running jobs (a paused one runs); neither flag means both
  --all             every job; lists them and asks y/N on a terminal; takes no --owner or --label.
                    Without a terminal it is refused unless --yes is given
  --yes             go ahead without asking (--all); the other selectors never ask
  --include-landing a landing job is skipped unless this is given (the count skipped is said)

An id and a selector together are refused (exit 2). Each job stopped prints one line (6512 killed
LABEL for a running job, 6520 cancelled LABEL for one that had not started), then a count. A
selector matching no job prints `marshal: no jobs match` (exit 1). Each job gets its usual killed or
cancelled event, and a job that waits for one of them (--after-ok) is cancelled as it is for a single
kill. An exclusive (benchmark) job is stopped like any other, and listed first when --all asks.\
"""

// The options of `hold` and `release`.
val HoldOptions: string = """
hold <id> holds one job. With filters it holds every job not started yet (queued, waiting for
others, waiting to retry) that matches them all, in one step; a running job is never held:
  --exclusive       exclusive jobs (benchmarks); never a landing job
  --draining        the jobs the queue drains for now: the job a drain is for, and an exclusive
                    job (or one that runs alone) the queue waits behind
  --kind <k>        jobs of kind k, exactly
  --label <glob>    jobs whose given label matches the glob as a whole (* any run, ? one
                    character), upper and lower case alike; quote it for the shell
  --group <name>    the group's name (one word); by default the filters and a number, such as
                    exclusive-3
  --include-landing a landing job is skipped unless this is given (the count skipped is said)

It prints the ids held and the group, and how to release it. A job already held is left as it is.
Matching nothing says so and exits 0. A held job keeps its place: released, it goes where it was,
and the time it was held is not counted as waiting (ELAPSED shows h and how long it has been held,
then w and its wait without it), nor toward the drain bound or low promotion.

release <id> releases one job; release --group <name> releases the jobs that group still holds (a
group holding none exits 1); filters release the held jobs that match them, in any group, and
--group with filters only those of that group. marshal groups lists the groups held. To unblock a
queue stuck behind a benchmark: marshal hold --exclusive, then marshal release --group <name>.\
"""

// The options of `grep`.
val GrepOptions: string = """
Options of grep (the log is read directly, as tail reads it: a running job and an ended one are
searched alike, and no daemon is needed; the log is read a line at a time, never held whole):
  -i          upper and lower case are the same
  -F          the pattern is literal text, not a regular expression
  -v          print the lines that do not match
  -n          put each line's number before it: N: for a match, N- for a line of context
  -c          print only the number of matching lines
  -m <n>      stop after n matching lines (the context after the last is still printed)
  -A <n>      also print n lines after each match
  -B <n>      also print n lines before each match
  -C <n>      -A n and -B n; -A and -B win over -C; groups that do not touch are parted by --
  --last <n>  search only the last n lines of the log (line numbers stay the log's own)
  --          the id and pattern follow; a pattern that begins with - goes after it

Exits 0 when a line matched, 1 when none did, 2 on an error: an unknown job, no log, a pattern
that is not a regular expression, a bad option, or a line on which the pattern backtracks past the
regular expression step budget (the search stops there; the message names the line).\
"""

// The options of `history` and `stats`.
val Queries: string = """
Options of history and stats (both read events.jsonl; no daemon is needed):
  --kind <k>        only jobs of this kind
  --label <text>    only jobs whose label contains text (upper and lower case count)
  --since <t>       only jobs that ended in the last t (90m, 2h, 3d, 1w) or since a date (2026-11-07 or 2026-11-07T14:30 on your local clock, or ending in Z or an offset such as +02:00)
  --json            one JSON object on one line
  --failed          history only: jobs that did not exit 0 (failed, signal, killed, timeout, quiet, cancelled, lost)
  --limit <n>       history only: at most n jobs (default 20)

A job's kind is marked as in ls: * landing, ^ quick, # exclusive, then ! urgent or ~ low.\
"""

// What `marshal remote --help` adds.
val RemoteHelp: string = """
The remote API is off until config.json in marshal's home says
  "remote": {"enabled": true, "port": 7177}
and the daemon starts again (marshal restart): it reads config.json only as it starts. It then
serves plain HTTP on every IPv4 interface at that port, read-only, advertised by Bonjour as
_marshal._tcp: GET /v1/status, /v1/jobs, /v1/jobs/<id> and /v1/jobs/<id>/log?from=<offset>&max=<bytes>,
each with the header `Authorization: Bearer <token>`. The token is in remote-token in marshal's
home (mode 0600); rotate refuses the old one from the next request on. Plain HTTP can be read by
anyone on the same network, the token with it: use the API only on a network you trust.\
"""

val Footer: string = "Marshal's files are in $MARSHAL_HOME, or ~/.marshal. `marshal <command> --help` describes one command."

// One line of the command list: `marshal` and the command, then what it does.
commandLine(c: (string, string)) -> string
  val left = "marshal " + c.0
  if left.byteLength >= 43 then left + "  " + c.1 else left.padEnd(43, ' ') + c.1

// What `marshal --help` prints.
val usage: string = "usage: marshal <command> [options]\n\n" + Commands.map(
  commandLine
).mkString("\n") + "\n\n" + Options + "\n" + Queries + "\n\n" + Footer

// What `marshal <command> --help` prints, or None for a word that is not a command.
commandHelp(name: string) -> Option[string]
  Commands.find(c -> c.0.split(" ")(0) == name).map(c ->
    val head = s"usage: marshal ${c.0}\n\n${c.1}"
    if name == "submit" || name == "run" then head + "\n\n" + Options
    elif name == "history" || name == "stats" then head + "\n\n" + Queries
    elif name == "grep" then head + "\n\n" + GrepOptions
    elif name == "amend" then head + "\n\n" + AmendOptions
    elif name == "kill" then head + "\n" + KillOptions
    elif name == "hold" || name == "release" then head + "\n" + HoldOptions
    elif name == "wait" || name == "events" then head + "\n" + marshal.Grammar
    elif name == "remote" then head + "\n" + RemoteHelp
    else head)

private isHelp(word: string) -> bool = word == "--help" || word == "-h"

// Whether the arguments after a command ask for its help. `submit` and `run` read options up to `--`
// or the first word that is not one, so `run prog --help` runs prog; the other commands read every
// argument before a `--`.
asksHelp(command: string, args: Vector[string]) -> bool
asksHelp("submit" | "run", args) = optionsAskHelp(args, 0)
// a type's run reads `--help` itself: after the type's name it is the type's help
asksHelp("run-type" | "train", args) = false
asksHelp(_, args) = args.takeWhile(a -> a != "--").exists(isHelp)

private optionsAskHelp(args: Vector[string], i: int) -> bool
optionsAskHelp(args, i) | i >= args.length = false
optionsAskHelp(args, i)
  | args(i) == "--" = false
  | isHelp(args(i)) = true
  | args(
    i
  ) == "--landing" || args(
    i
  ) == "--urgent" || args(i) == "--external" || args(i) == "--quick" || args(i) == "--exclusive" = optionsAskHelp(
    args,
    i + 1
  )
  | args(i).startsWith("--") = optionsAskHelp(args, i + 2)
  | _ = false

// Marshal's own failures (a bad command line, no daemon) exit with this; a job's status is its own.
val Trouble: int = 2

home() -> string = process.env("MARSHAL_HOME").getOrElse(process.homeDir().getOrElse("/") + "/.marshal")

main(args: Vector[string]) -> int
  if args.isEmpty then return complain(usage)
  val rest = args.drop(1)
  commandHelp(args(0)) match
    Some(text) if asksHelp(args(0), rest) ->
      println(text)
      return 0
    _ -> ()
  args(0) match
    "submit" -> submit(rest, false)
    "run" -> submit(rest, true)
    "run-type" -> runType(rest, None)
    "train" -> runType(rest, Some("train"))
    "run-steps" -> runSteps(rest)
    "wait" -> if rest.contains("--until") then waitUntil(rest) else waitJob(rest)
    "events" -> events(rest)
    "rerun" -> withId(rest, id -> rerun(id))
    "clean" -> clean(rest)
    "kill" ->
      if rest.exists(a -> a.startsWith("--")) then killMany(rest)
      else withId(rest, id -> simple(Request.Kill(id), s"marshal: job $id is being stopped"))
    "hold" ->
      if rest.exists(a -> a.startsWith("--")) then holdMany(rest, true)
      else withId(rest, id -> simple(Request.Hold(id), s"marshal: job $id is held"))
    "release" ->
      if rest.exists(a -> a.startsWith("--")) then holdMany(rest, false)
      else withId(rest, id -> simple(Request.Release(id), s"marshal: job $id is released"))
    "groups" -> if rest.isEmpty then groups() else complain("marshal: groups takes no arguments")
    "priority" -> priority(rest)
    "amend" -> amend(rest)
    "pause" ->
      if rest.isEmpty then simple(
        Request.PauseQueue,
        "marshal: the queue is held: running jobs go on, nothing new starts"
      )
      else withId(rest, id -> simple(Request.PauseJob(id), s"marshal: job $id is paused"))
    "resume" ->
      if rest.isEmpty then simple(Request.ResumeQueue, "marshal: the queue is released")
      else withId(rest, id -> simple(Request.ResumeJob(id), s"marshal: job $id is resumed"))
    "polite" -> polite(rest)
    "reserve" -> reserve(rest)
    "unreserve" -> if rest.isEmpty then unreserve() else complain("marshal: unreserve takes no arguments")
    "ls" -> list(rest)
    "status" -> rest match
      [] -> status()
      ["--json"] -> statusJson()
      [word] -> jobStatus(word, false)
      [word, "--json"] -> jobStatus(word, true)
      ["--json", word] -> jobStatus(word, true)
      _ -> complain(StatusUsage)
    "history" -> history(rest)
    "stats" -> stats(rest)
    "tail" -> tail(rest)
    "grep" -> grep(rest)
    "top" -> top(rest)
    "stop" -> stop(rest)
    "restart" -> if rest.isEmpty then restart() else complain("marshal: restart takes no arguments")
    "version" -> if rest.isEmpty then version() else complain("marshal: version takes no arguments")
    "remote" -> remote(rest)
    "daemon" -> rest match
      [] -> daemon.run(home())
      ["--resume", file] -> daemon.run(home(), Some(file))
      _ -> complain("marshal: daemon takes no arguments")
    "--help" | "-h" ->
      println(usage)
      0
    "help" -> rest match
      [] ->
        println(usage)
        0
      [name] -> commandHelp(name) match
        Some(text) ->
          println(text)
          0
        None -> complain(s"marshal: no command `$name`\n\n$usage")
      _ -> complain("marshal: help takes one command")
    other -> complain(s"marshal: no command `$other`\n\n$usage")

// `marshal remote token` and `marshal remote rotate`: the files alone, no daemon needed. The
// listener reads the token's file at every request, so a rotation holds from the next one.
remote(args: Vector[string]) -> int
  val made = args match
    ["token"] -> marshal.ensureToken(home())
    ["rotate"] -> marshal.rotateToken(home())
    _ -> return complain("marshal: remote takes token or rotate")
  made match
    Ok(token) ->
      println(token)
      0
    Err(e) -> complain(s"marshal: cannot write ${marshal.tokenFile(home())}: ${e.message}")

complain(message: string) -> int
  eprintln(message)
  Trouble

withId(args: Vector[string], body: (long) -> int) -> int
withId([word], body) = word.toLongOption() match
  Some(id) -> body(id)
  None -> complain(s"marshal: `$word` is not a job id")
withId(_, _) = complain("marshal: give one job id")

// `priority <id> <n>`, `priority <id> --urgent`, `--low`, `--up` or `--down`. A daemon older than
// moves refuses `--up` and `--down`, and the refusal says so (`moveRefusal`).
priority(args: Vector[string]) -> int
  val (word, level) = args match
    [w, l] -> (w, l)
    _ -> return complain(s"marshal: priority takes a job id and $PriorityWords")
  val id = word.toLongOption() match
    Some(n) -> n
    None -> return complain(s"marshal: `$word` is not a job id")
  val p = parsePriority(level) match
    Some(p) -> p
    None -> return complain(s"marshal: `$level` is not a priority: $PriorityWords")
  if p != marshal.OneUp && p != marshal.OneDown then return simple(
    Request.Prioritize(id, p),
    s"marshal: job $id is placed"
  )
  askDaemon(Request.Prioritize(id, p)) match
    Ok(Done) ->
      println(s"marshal: job $id is moved ${if p == marshal.OneUp then "up" else "down"}")
      0
    Ok(Failed(why)) -> complain(s"marshal: ${marshal.moveRefusal(why)}")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

// What `priority` takes after the job id.
val PriorityWords: string = "a whole number, --urgent, --low, --up or --down"

// A priority as the command line gives it: a whole number, `--urgent`, `--low`, `--up` or `--down`.
parsePriority(word: string) -> Option[marshal.Priority]
parsePriority("--urgent") = Some(marshal.Urgent)
parsePriority("--low") = Some(marshal.LowBand)
parsePriority("--up") = Some(marshal.OneUp)
parsePriority("--down") = Some(marshal.OneDown)
parsePriority(word) = word.toIntOption().map(n -> marshal.Level(n))

// `kill --owner/--label/--all [--queued | --running] [--include-landing] [--yes]`. An id beside a
// selector, or an option `kill` does not take, is refused (2). `--all` shows the jobs it would stop
// and asks on a terminal; where standard input or output is not one it is refused without `--yes`.
// Exits 0 with a line a job stopped and a count, 1 where no job is selected.
killMany(args: Vector[string]) -> int
  var owner: Option[string] = None
  var label: Option[string] = None
  var queued = false
  var running = false
  var all = false
  var landing = false
  var yes = false
  var i = 0
  while i < args.length
    val word = args(i)
    word match
      "--queued" -> queued = true
      "--running" -> running = true
      "--all" -> all = true
      "--include-landing" -> landing = true
      "--yes" -> yes = true
      "--owner" | "--label" ->
        if i + 1 >= args.length then return complain(s"marshal: kill: `$word` needs a value")
        val value = args(i + 1)
        if word == "--owner" then owner = Some(value) else label = Some(value)
        i += 1
      _ ->
        if word.startsWith("--") then return complain(s"marshal: kill: no option `$word`")
        return complain(s"marshal: kill: `$word` beside a selector: a job id and --owner, --label or --all are not given together")
    i += 1
  val selector = marshal.KillSelector(owner, label, queued, running, all, landing)
  for why in marshal.killSelectorRefusal(selector).toList do return complain(s"marshal: kill: $why")
  if all && !yes && !confirmAll(selector) then return Trouble
  askDaemon(Request.KillMany(selector)) match
    Ok(marshal.KilledJobs(jobs, skipped)) ->
      val note = if skipped > 0 then s" ($skipped landing skipped: --include-landing stops them too)" else ""
      if jobs.isEmpty
        eprintln(s"marshal: no jobs match$note")
        return 1
      for j in jobs do println(stoppedLine(j))
      println(s"marshal: ${jobs.length} ${if jobs.length == 1 then "job" else "jobs"} stopped$note")
      0
    Ok(Failed(e)) -> complain(s"marshal: $e")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

// `hold` (`on`) or `release` with filters: `--exclusive`, `--draining`, `--kind <k>`, `--label
// <glob>`, `--group <name>`, `--include-landing` (holdmany.avin). An id beside them, an option given
// twice, or one these commands do not take, is refused (2). A hold prints the ids it held and the
// group it made, and how to release it; a release the ids it released. Matching nothing is said and
// exits 0, except a release of a group that holds no job, which exits 1.
holdMany(args: Vector[string], on: bool) -> int
  val verb = if on then "hold" else "release"
  var exclusive = false
  var draining = false
  var kind: Option[string] = None
  var label: Option[string] = None
  var group: Option[string] = None
  var landing = false
  val seen = Buffer[string]()
  var i = 0
  while i < args.length
    val word = args(i)
    if word.startsWith("--") && seen.contains(word) then return complain(s"marshal: $verb: `$word` is given twice")
    seen += word
    word match
      "--exclusive" -> exclusive = true
      "--draining" -> draining = true
      "--include-landing" -> landing = true
      "--kind" | "--label" | "--group" ->
        if i + 1 >= args.length then return complain(s"marshal: $verb: `$word` needs a value")
        val value = Some(args(i + 1))
        word match
          "--kind" -> kind = value
          "--label" -> label = value
          _ -> group = value
        i += 1
      _ ->
        if word.startsWith("--") then return complain(s"marshal: $verb: no option `$word`")
        return complain(
          s"marshal: $verb: `$word` beside a filter: a job id and --exclusive, --draining, --kind, --label or --group are not given together"
        )
    i += 1
  val sel = marshal.HoldSelector(exclusive, draining, kind, label, group, landing)
  for why in marshal.holdSelectorRefusal(sel, on).toList do return complain(s"marshal: $verb: $why")
  askDaemon(Request.HoldMany(sel, on)) match
    Ok(marshal.HeldJobs(ids, made, skipped)) ->
      val note = if skipped > 0 then s" ($skipped landing skipped: --include-landing ${verb}s them too)" else ""
      if ids.isEmpty
        if !on && group.isDefined
          eprintln(s"marshal: no held jobs in group `${group.get}`${if marshal.hasFilter(sel) then " match" else ""}$note")
          return 1
        if on && draining && !exclusive && kind.isEmpty && label.isEmpty
          println(s"marshal: the queue drains for no job now: nothing held$note")
        else
          println(if on then s"marshal: no queued job not already held matches: nothing held$note" else s"marshal: no held job matches: nothing released$note")
        return 0
      val list = ids.map(id -> id.toString()).mkString(",")
      if on
        println(s"marshal: held $list as group $made$note")
        println(s"marshal: release them with: marshal release --group '$made'")
      else
        println(s"marshal: released $list$note")
      0
    Ok(Failed(e)) -> complain(s"marshal: $e")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

// `marshal groups`: every group a filtered hold made that still holds jobs, with its jobs.
groups() -> int
  askDaemon(Request.List) match
    Ok(Jobs(jobs)) ->
      println(marshal.groupsText(marshal.liveGroups(jobs.filter(j -> j.held && j.heldGroup.nonEmpty).map(j -> (j.id, j.heldGroup)))))
      0
    Ok(Failed(e)) -> complain(s"marshal: $e")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

// One line of a stopped job: its id, what became of it and its label.
stoppedLine(j: marshal.StoppedJob) -> string = (s"${j.id} ${j.how}  ${j.label}").trim

// Lists every job `--all` would stop, an exclusive one first, and asks. False, having said why,
// without a terminal on standard input and output, or on any answer but y.
confirmAll(selector: marshal.KillSelector) -> bool
  if !isTerminal(0) || !isTerminal(1)
    eprintln("marshal: kill --all needs a terminal to ask on: give --yes to stop every job without asking")
    return false
  val dry = askDaemon(Request.KillMany(marshal.KillSelector(all = true, includeLanding = selector.includeLanding, dryRun = true)))
  dry match
    Ok(marshal.KilledJobs(jobs, skipped)) ->
      if jobs.isEmpty
        eprintln("marshal: no jobs match")
        return false
      for j in jobs.filter(j -> j.exclusive) ++ jobs.filter(j -> !j.exclusive)
        println(s"${j.id} ${if j.exclusive then "exclusive " else ""}${j.how}  ${j.label}".trim)
      if skipped > 0 then println(s"($skipped landing skipped)")
      print(s"Stop these ${jobs.length} jobs? [y/N] ")
      val answer = io.readLine().getOrElse("").trim.toLower
      if answer == "y" || answer == "yes" then return true
      eprintln("marshal: nothing stopped")
      false
    Ok(Failed(e)) ->
      eprintln(s"marshal: $e")
      false
    _ ->
      eprintln("marshal: kill --all: the daemon did not list the jobs")
      false

// `amend <id> [options]`: prints what changed, a line a setting. A refusal exits 2, as `submit`'s
// does, but a job that has ended is refused with 1.
amend(args: Vector[string]) -> int
  if args.isEmpty then return complain("marshal: amend takes a job id and the settings to change")
  val id = args(0).toLongOption() match
    Some(n) -> n
    None -> return complain(s"marshal: `${args(0)}` is not a job id")
  val a = parseAmendment(args.drop(1)) match
    Ok(a) -> a
    Err(e) -> return complain(s"marshal: amend: $e")
  askDaemon(Request.Amend(id, a)) match
    Ok(Amended(changes, hint)) ->
      if hint.nonEmpty then eprintln(hint)
      println(s"marshal: job $id amended:\n$changes")
      0
    Ok(Over(e)) ->
      eprintln(s"marshal: $e")
      1
    Ok(Failed(e)) -> complain(s"marshal: $e")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

// Reads the options of `amend`, each written and checked as `submit` takes it; a `--deadline` may
// begin with `+`, adding to the deadline the job has. An option `amend` does not take is refused
// saying why (`amendRefusal`).
parseAmendment(args: Vector[string]) -> Result[marshal.Amendment, string]
  var deadline: Option[long] = None
  var extend = false
  var units: Option[int] = None
  var memory: Option[long] = None
  var label: Option[string] = None
  var retries: Option[int] = None
  var quiet: Option[long] = None
  val after = Buffer[long]()
  var afterMode: Option[string] = None
  var i = 0
  while i < args.length
    val word = args(i)
    for why in marshal.amendRefusal(word).toList do return Err(why)
    if !word.startsWith("--") then return Err(s"`$word` is not an option: amend takes one job id, then options")
    if i + 1 >= args.length then return Err(s"`$word` needs a value")
    val value = args(i + 1)
    word match
      "--deadline" ->
        val plus = value.startsWith("+")
        marshal.parseDeadline(if plus then value.drop(1) else value) match
          Some(ms) ->
            deadline = Some(ms)
            extend = plus
          None -> return Err(
            s"`--deadline $value`: a deadline is minutes, or a number with s, m or h, such as 90s; +t adds to the deadline the job has"
          )
      "--units" -> units = Some(marshal.unitsOption(value)?)
      "--mem" -> marshal.parseSize(value) match
        Some(n) -> memory = Some(n)
        None -> return Err(s"`--mem $value`: a size is a whole number with K, M, G or T, such as 29G")
      "--label" -> label = Some(marshal.checkLabel(value).mapErr(e -> s"`--label`: $e")?)
      "--retries" -> value.toIntOption() match
        Some(n) if n >= 0 -> retries = Some(n)
        _ -> return Err(s"`--retries $value`: retries are a whole number, 0 or more")
      "--quiet-timeout" -> quiet = Some(parseQuietTimeout(value)?)
      "--after" | "--after-ok" | "--after-any" ->
        val mode = if word == "--after-any" then "--after-any" else "--after-ok"
        if afterMode.exists(m -> m != mode) then return Err("a job waits with --after-ok or with --after-any, not both")
        afterMode = Some(mode)
        after ++= parseIds(value).mapErr(e -> s"`$word $value`: $e")?
      _ -> return Err(s"no option `$word`")
    i += 2
  val a = marshal.Amendment(
    deadline,
    extend,
    units,
    memory,
    label,
    retries,
    quiet,
    if afterMode.isDefined then Some(after.toVector.distinct) else None,
    afterMode == Some("--after-any")
  )
  if marshal.emptyAmendment(a) then return Err("give at least one setting to change (`marshal amend --help` lists them)")
  Ok(a)

// Reads the options of `submit` and `run`, `[options] [--] command...`. The command begins after `--`, or at the first word that is
// not an option.
parseSubmission(args: Vector[string], dir: string, env: Vector[(string, string)]) -> Result[JobSpec, string]
  var kind: Option[string] = None
  var units: Option[int] = None
  var memory: long = 0
  var memoryGiven = false
  var landing = false
  var urgent = false
  var quick = false
  var workDir = dir
  var deadline: Option[long] = None
  var quiet: long = 0
  val after = Buffer[long]()
  var afterMode: Option[string] = None
  var retries = 0
  var retryDelay: long = 0
  var label = ""
  var owner = ""
  var external = false
  var exclusive = false
  var exact = false
  var memExact = false
  var low = false
  var quietLoad = 0.0
  var i = 0
  while i < args.length
    val word = args(i)
    if word == "--"
      i += 1
      break
    if !word.startsWith("--") then break
    if word == "--landing"
      landing = true
      i += 1
      continue
    if word == "--low"
      low = true
      i += 1
      continue
    if word == "--mem-exact"
      memExact = true
      i += 1
      continue
    if word == "--urgent"
      urgent = true
      i += 1
      continue
    if word == "--external"
      external = true
      i += 1
      continue
    if word == "--quick"
      quick = true
      i += 1
      continue
    if word == "--exclusive"
      exclusive = true
      i += 1
      continue
    if word == "--units-exact"
      exact = true
      i += 1
      continue
    if i + 1 >= args.length then return Err(s"`$word` needs a value")
    val value = args(i + 1)
    word match
      "--kind" ->
        if value.isEmpty then return Err("a kind is a word, not empty")
        kind = Some(value)
      "--units" -> units = Some(marshal.unitsOption(value)?)
      "--mem" -> marshal.parseSize(value) match
        Some(n) ->
          memory = n
          memoryGiven = true
        None -> return Err(s"`--mem $value`: a size is a whole number with K, M, G or T, such as 29G")
      "--dir" -> workDir = if value.startsWith("/") then value else dir + "/" + value
      "--deadline" -> marshal.parseDeadline(value) match
        Some(ms) -> deadline = Some(ms)
        None -> return Err(s"`--deadline $value`: a deadline is minutes, or a number with s, m or h, such as 90s")
      "--quiet-timeout" -> quiet = parseQuietTimeout(value)?
      "--after" | "--after-ok" | "--after-any" ->
        val mode = if word == "--after-any" then "--after-any" else "--after-ok"
        if afterMode.exists(m -> m != mode) then return Err("a job waits with --after-ok or with --after-any, not both")
        afterMode = Some(mode)
        after ++= parseIds(value).mapErr(e -> s"`$word $value`: $e")?
      "--retries" -> value.toIntOption() match
        Some(n) if n >= 0 -> retries = n
        _ -> return Err(s"`--retries $value`: retries are a whole number, 0 or more")
      "--retry-delay" -> marshal.parseDeadline(value) match
        Some(ms) -> retryDelay = ms
        None -> return Err(s"`--retry-delay $value`: a delay is minutes, or a number with s, m or h, such as 90s")
      "--label" -> label = marshal.checkLabel(value).mapErr(e -> s"`--label`: $e")?
      "--owner" -> owner = marshal.checkOwner(value).mapErr(e -> s"`--owner`: $e")?
      "--quiet-load" -> quietLoad = marshal.parseQuietLoad(
        value,
        if value == "auto" then marshal.coreCount() else None
      )?
      _ -> return Err(s"no option `$word`")
    i += 2
  val cmd = args.drop(i)
  if cmd.isEmpty then return Err("no command to run: give it after `--`")
  if exact && units.isEmpty then return Err(marshal.ExactWithoutUnits)
  if memExact && !memoryGiven then return Err(marshal.MemExactWithoutMem)
  marshal.externalRefusal(external, memoryGiven) match
    Some(why) -> return Err(why)
    None -> ()
  val k = kind.getOrElse(if cmd.exists(w -> w == "test") then "test" else "build")
  val spec = JobSpec(
    k,
    units.getOrElse(marshal.defaultUnits(k)),
    memory,
    landing,
    workDir,
    deadline,
    cmd,
    env,
    urgent,
    after.toVector.distinct,
    afterMode == Some("--after-any"),
    retries,
    retryDelay,
    memoryGiven,
    label,
    quiet,
    external,
    quick,
    exclusive,
    quietLoad,
    units.isDefined,
    owner,
    exact,
    0,
    low,
    memExact
  )
  for why in marshal.exclusiveRefusal(spec).toList do return Err(why)
  for why in marshal.lowRefusal(spec).toList do return Err(why)
  Ok(spec)

// The value of `--quiet-timeout`, written as `--deadline` writes a deadline, in milliseconds.
parseQuietTimeout(value: string) -> Result[long, string] = marshal.parseDeadline(value) match
  Some(ms) -> Ok(ms)
  None -> Err(s"`--quiet-timeout $value`: a quiet timeout is minutes, or a number with s, m or h, such as 90s")

// Job ids separated by commas, such as `3,4`.
parseIds(text: string) -> Result[Vector[long], string]
  val ids = Buffer[long]()
  for word in text.split(",")
    word.trim.toLongOption() match
      Some(id) if id >= 1 -> ids += id
      _ -> return Err(s"`$word` is not a job id")
  Ok(ids.toVector)

submit(args: Vector[string], andWait: bool) -> int
  val dir = process.currentDir().getOrElse(".")
  val env = process.environment().toVector.sortBy(e -> e.0)
  val spec = parseSubmission(args, dir, env) match
    Ok(s) -> s
    Err(e) -> return complain(s"marshal: $e")
  if !spec.external && marshal.looksExternal(spec.cmd) then eprintln(marshal.ExternalWarning)
  val (id, log) = askDaemon(Request.Submit(spec)) match
    Ok(Submitted(id, log, hint)) ->
      if hint.nonEmpty then eprintln(hint)
      (id, log)
    Ok(Failed(e)) -> return complain(s"marshal: $e")
    Ok(other) -> return complain(s"marshal: unexpected reply $other")
    Err(e) -> return complain(e)
  if !andWait
    println(id)
    return 0
  println(s"marshal: job $id: log $log")
  waitFor(id)

waitFor(id: long) -> int = askDaemon(Request.Wait(id)) match
  Ok(Ended(job)) ->
    println(marshal.resultLine(job))
    job.outcome.map(marshal.exitCode).getOrElse(Trouble)
  Ok(Failed(e)) -> complain(s"marshal: $e")
  Ok(other) -> complain(s"marshal: unexpected reply $other")
  Err(e) -> complain(e)

// `wait <id> [--timeout <t>]`, the option before or after the id: waits for the job as `wait <id>`
// does; when it has not ended by the timeout, says so on one line and exits 124.
waitJob(args: Vector[string]) -> int
  var id: Option[long] = None
  var timeout: Option[long] = None
  var i = 0
  while i < args.length
    args(i) match
      "--timeout" ->
        if i + 1 >= args.length then return complain("marshal: --timeout needs a value")
        if timeout.isDefined then return complain("marshal: --timeout is given twice")
        val value = args(i + 1)
        timeout = marshal.parseDeadline(value) match
          Some(ms) -> Some(ms)
          None -> return complain(
            s"marshal: `--timeout $value`: a timeout is minutes, or a number with s, m or h, such as 90s"
          )
        i += 2
      "--since" -> return complain("marshal: --since goes with wait --until, not with a job id")
      word ->
        if word.startsWith("--") then return complain(s"marshal: wait <id> takes --timeout, not `$word`")
        if id.isDefined then return complain("marshal: give one job id")
        id = word.toLongOption() match
          Some(n) -> Some(n)
          None -> return complain(s"marshal: `$word` is not a job id")
        i += 1
  val job = id match
    Some(n) -> n
    None -> return complain("marshal: give one job id")
  val finished = Atomic(0)
  timeout.foreach(ms -> spawn(() ->
    threads.sleep(millis(ms))
    if finished.compareAndSet(0, 1)
      eprintln(s"marshal: timed out after ${marshal.formatMillis(ms)} waiting for job $job")
      process.exit(TimedOutWaiting)
    ()))
  val code = waitFor(job)
  finished.compareAndSet(0, 1)
  code

// `rerun <id>`: prints the id of the job that runs job `id` again.
rerun(id: long) -> int = askDaemon(Request.Rerun(id)) match
  Ok(Submitted(n, _, _)) ->
    println(n)
    0
  Ok(Failed(e)) -> complain(s"marshal: $e")
  Ok(other) -> complain(s"marshal: unexpected reply $other")
  Err(e) -> complain(e)

// `clean [--older-than <t>] [--keep <n>] [--dry-run]`: asks the daemon to remove what retention
// allows and prints what it removed.
clean(args: Vector[string]) -> int
  val rule = marshal.parseCleanArgs(args) match
    Ok(r) -> r
    Err(e) -> return complain(s"marshal: clean: $e")
  askDaemon(Request.Clean(rule)) match
    Ok(marshal.Cleaned(report)) ->
      for line in marshal.cleanLines(report) do println(line)
      0
    Ok(Failed(e)) -> complain(s"marshal: $e")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

// What `wait --until` and `events` exit with when no daemon can be reached, and when a
// `--timeout` ends the wait.
val Unreachable: int = 1
val TimedOutWaiting: int = 124

// `wait --until <condition> [--timeout <t>]`: blocks until the daemon reports an event the
// condition matches, prints that event as one JSON line and exits 0; 124 when the timeout comes
// first, 2 for a condition that is not one, 1 when no daemon can be reached.
waitUntil(args: Vector[string]) -> int
  var text: Option[string] = None
  var timeout: Option[long] = None
  var since: Option[marshal.Since] = None
  var i = 0
  while i < args.length
    args(i) match
      "--until" | "--timeout" | "--since" ->
        if i + 1 >= args.length then return complain(s"marshal: ${args(i)} needs a value")
        val value = args(i + 1)
        args(i) match
          "--until" ->
            if text.isDefined then return complain("marshal: --until is given twice")
            text = Some(value)
          "--since" ->
            if since.isDefined then return complain("marshal: --since is given twice")
            since = marshal.parseSince(value, time.now().epochMillis) match
              Ok(s) -> Some(s)
              Err(e) -> return complain(s"marshal: $e")
          _ ->
            if timeout.isDefined then return complain("marshal: --timeout is given twice")
            timeout = marshal.parseDeadline(value) match
              Some(ms) -> Some(ms)
              None -> return complain(
                s"marshal: `--timeout $value`: a timeout is minutes, or a number with s, m or h, such as 90s"
              )
        i += 2
      other -> return complain(s"marshal: wait --until takes --until, --timeout and --since, not `$other`")
  val source = text.get
  val cond = marshal.parseCondition(source) match
    Ok(c) -> c
    Err(e) -> return complain(s"marshal: bad condition: $e\n" + marshal.Grammar)
  // A wait that restarts asks again for events since it began: what happened while the daemon
  // handed over is in the log, and the daemon looks there first.
  val began = time.now().epochMillis
  val finished = Atomic(0)
  timeout.foreach(ms -> spawn(() ->
    threads.sleep(millis(ms))
    if finished.compareAndSet(0, 1)
      eprintln(s"marshal: timed out after ${marshal.formatMillis(ms)} waiting for $source")
      process.exit(TimedOutWaiting)
    ()))
  val from = since.getOrElse(marshal.Since(None, None))
  val first = Request.Watch(source, cond, Once, from.ms, from.id)
  val again = Request.Watch(source, cond, Once, Some(from.ms.getOrElse(began)), from.id)
  val code = watchLoop(first, () -> again, false, ev -> printWaited(finished, ev))
  code.getOrElse(Unreachable)

// The event a `wait --until` ends on, unless the timeout got in first and is ending the program.
printWaited(finished: Atomic[int], ev: Json) -> bool
  while !finished.compareAndSet(0, 1) do threads.sleep(millis(1000))
  println(ev.render)
  true

// `events [--follow] [--since <t>] [<filter>]`: the events the daemon logged that the filter lets
// through, one JSON object per line; with --follow, and those that come after, until killed.
events(args: Vector[string]) -> int
  var follow = false
  var since = marshal.Since(None, None)
  var filter: Option[string] = None
  var i = 0
  while i < args.length
    args(i) match
      "--follow" | "-f" ->
        follow = true
        i += 1
      "--since" ->
        if i + 1 >= args.length then return complain("marshal: --since needs a time")
        since = marshal.parseSince(args(i + 1), time.now().epochMillis) match
          Ok(s) -> s
          Err(e) -> return complain(s"marshal: $e")
        i += 2
      word ->
        if word.startsWith("--") || filter.isDefined then return complain(
          s"marshal: events takes --follow, --since and one filter, not `$word`"
        )
        filter = Some(word)
        i += 1
  val source = filter.getOrElse("any")
  val cond = marshal.parseFilter(source) match
    Ok(f) -> Condition.Matching(f)
    Err(e) -> return complain(s"marshal: bad filter: $e\n" + marshal.Grammar)
  val mode = if follow then Follow else Past
  val first = Request.Watch(source, cond, mode, since.ms, since.id)
  // After a restart the stream resumes from the last time it printed, and a line already
  // printed at that very time is not printed again.
  val lastTs: Atomic[long] = Atomic(0)
  val printed = Buffer[string]()
  val again = () -> Request.Watch(
    source,
    cond,
    mode,
    Some(if lastTs.load() > 0 then lastTs.load() else since.ms.getOrElse(0)),
    since.id
  )
  val code = watchLoop(first, again, !follow, ev -> printEvent(lastTs, printed, ev))
  code.getOrElse(Unreachable)

// Prints an event of `events`, unless it is one already printed at the same time; never ends the
// watch.
printEvent(lastTs: Atomic[long], printed: Buffer[string], ev: Json) -> bool
  val ts = ev.get("ts").flatMap(v -> v.asLong).getOrElse(0)
  val line = ev.render
  if ts == lastTs.load() && printed.contains(line) then return false
  if ts > lastTs.load()
    lastTs.store(ts)
    printed.clear()
  printed += line
  println(line)
  flush()
  false

// Reads a watch's stream: asks for `first`, hands each event to `onEvent`, which answers whether
// the watch is over, and ends with exit status 0 when it is, or, where `pastEnds`, when the daemon
// has sent the events already logged. A connection that closes without ending the stream is the
// daemon restarting: the client connects again, for up to 30 seconds, and asks for `again()`.
// None, with the reason on standard error, when no daemon can be reached or the daemon refuses.
watchLoop(first: Request, again: () -> Request, pastEnds: bool, onEvent: (Json) -> bool) -> Option[int]
  var conn = connect(false) match
    Ok(c) -> c
    Err(e) ->
      eprintln(e)
      return None
  var request = first
  loop
    if conn.writeText(marshal.encodeRequest(request).render + "\n").isOk
      loop
        val line = conn.readLine() match
          Ok(Some(l)) -> l
          _ -> break
        marshal.decodeReply(line) match
          Ok(Streamed(ev)) ->
            if onEvent(ev)
              val _ = conn.close()
              return Some(0)
          Ok(Replayed(evs)) ->
            for ev in evs
              if onEvent(ev)
                val _ = conn.close()
                return Some(0)
            if pastEnds
              val _ = conn.close()
              return Some(0)
          Ok(Failed(e)) ->
            val _ = conn.close()
            eprintln(s"marshal: $e")
            return Some(
              if e.startsWith("the daemon") || e.startsWith("events were dropped") then Unreachable else Trouble
            )
          Ok(other) ->
            val _ = conn.close()
            eprintln(s"marshal: unexpected reply $other")
            return None
          Err(e) ->
            val _ = conn.close()
            eprintln(s"marshal: the daemon's reply is not one: $e")
            return None
    val _ = conn.close()
    conn = reconnectExisting(time.monotonic() + Reconnecting) match
      Ok(c) -> c
      Err(e) ->
        eprintln(e)
        return None
    request = again()

// A new connection to a daemon that is there or is coming back, never starting one: a watch
// has nothing to ask of a daemon that was stopped.
reconnectExisting(limit: time.Duration) -> Result[UnixStream, string]
  var pause: long = 25
  loop
    threads.sleep(millis(pause))
    if pause < 500 then pause *= 2
    connect(false) match
      Ok(c) -> return Ok(c)
      Err(e) -> if time.monotonic() >= limit then return Err(
        s"marshal: the daemon went away and did not come back within ${Reconnecting.toMillis / 1000}s: $e"
      )

simple(request: Request, said: string) -> int = askDaemon(request) match
  Ok(Done) ->
    println(said)
    0
  Ok(Failed(e)) -> complain(s"marshal: $e")
  Ok(other) -> complain(s"marshal: unexpected reply $other")
  Err(e) -> complain(e)

// Why each queued job among `jobs` waits, from the daemon's snapshot: (job id, reason). Empty when
// nothing is queued, and when the daemon cannot say (a job that started since `jobs` was read has no
// reason, and shows as it is).
queuedWhys(jobs: Vector[JobInfo]) -> Vector[(long, marshal.Why)]
  if !jobs.exists(j -> j.state == "queued" || marshal.settling(j)) then return []
  askDaemon(Request.Snapshot) match
    Ok(marshal.Viewed(o)) -> o.queued.map(q -> (q.job.id, q.why))
    _ -> []

@sysl("sysl.posix.tty.is_tty")
private isTerminal(fd: int) -> bool

@sysl("sysl.posix.tty.WindowSize")
private data WindowSize(rows: int, cols: int)

@sysl("sysl.posix.tty.window_size")
private windowSize(fd: int) -> Option[WindowSize]

// The terminal's width in cells where standard output is a terminal that says it.
terminalWidth() -> Option[int] = if !isTerminal(1) then None else windowSize(1).map(s -> s.cols)

// `ls` and `ls --compact` (or `-c`): the table, or one line a job no wider than the terminal.
list(args: Vector[string]) -> int
  val compact = args match
    [] -> false
    ["--compact"] | ["-c"] -> true
    _ -> return complain("marshal: ls takes --compact (or -c), or nothing")
  askDaemon(Request.List) match
    Ok(Jobs(jobs)) ->
      val whys = queuedWhys(jobs)
      // a reservation that stands comes first, on a line of its own
      askDaemon(Request.Status) match
        Ok(Using(u)) if u.reserve.isDefined -> println(reserveState(u.reserve))
        _ -> ()
      println(
        if compact then marshal.compactListing(
          jobs,
          whys,
          marshal.compactWidth(terminalWidth(), process.env("COLUMNS"))
        ) else marshal.listing(jobs, whys)
      )
      0
    Ok(Failed(e)) -> complain(s"marshal: $e")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

// What `marshal polite` asks for: polite at the fraction given (`DefaultPolite` with none), or not
// polite with `off`; or why the arguments ask for neither.
politeRequest(args: Vector[string]) -> Result[Request, string] = args match
  [] -> Ok(Request.Polite(Some(marshal.DefaultPolite)))
  ["off"] -> Ok(Request.Polite(None))
  [text] -> marshal.parseFraction(text).map(f -> Request.Polite(Some(f))).mapErr(e -> s"marshal: polite: $e")
  _ -> Err("marshal: polite takes a fraction, `off`, or nothing (0.75)")

// Turns polite mode on, changes its fraction or turns it off, and prints the state it leaves.
polite(args: Vector[string]) -> int
  val request = politeRequest(args) match
    Ok(r) -> r
    Err(e) -> return complain(e)
  askDaemon(request) match
    Ok(Using(u)) ->
      println(marshal.politeLine(u.polite, u.unitBudget, u.memoryBudget))
      0
    Ok(Failed(e)) -> complain(s"marshal: $e")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

// What `marshal reserve` asks for: `--owner <name>` and `--for <t>`, in either order, both required;
// or why the arguments are not that.
reserveRequest(args: Vector[string]) -> Result[Request, string]
  var owner: Option[string] = None
  var forMs: Option[long] = None
  var i = 0
  while i < args.length
    val word = args(i)
    if word != "--owner" && word != "--for" then return Err(
      s"marshal: reserve takes --owner <name> and --for <t>, not `$word`"
    )
    if i + 1 >= args.length then return Err(s"marshal: $word needs a value")
    val value = args(i + 1)
    if word == "--owner"
      if owner.isDefined then return Err("marshal: reserve takes one --owner")
      owner = Some(value)
    else
      if forMs.isDefined then return Err("marshal: reserve takes one --for")
      val parsed = marshal.parseDeadline(value)
      if parsed.isEmpty then return Err(s"marshal: --for takes a time such as 3h, 90m or 600s, not `$value`")
      forMs = parsed
    i += 2
  if owner.isEmpty then return Err("marshal: reserve needs --owner <name>: the owner whose jobs alone start")
  if forMs.isEmpty then return Err(
    "marshal: reserve needs --for <t>, such as 3h or 90m: a reservation always ends by itself"
  )
  marshal.reserveRefusal(owner.get, forMs.get) match
    Some(why) -> Err(s"marshal: $why")
    None -> Ok(Request.Reserve(owner.get, forMs.get))

// Reserves marshal for an owner, and prints the reservation it leaves.
reserve(args: Vector[string]) -> int
  val request = reserveRequest(args) match
    Ok(r) -> r
    Err(e) -> return complain(e)
  askDaemon(request) match
    Ok(Using(u)) ->
      println(reserveState(u.reserve))
      0
    Ok(Failed(e)) -> complain(s"marshal: $e")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

// Ends the reservation, if one stands, and says that every owner's jobs start.
unreserve() -> int
  askDaemon(Request.Unreserve) match
    Ok(Using(u)) ->
      println(reserveState(u.reserve))
      0
    Ok(Failed(e)) -> complain(s"marshal: $e")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

// The line `reserve` and `unreserve` print: the reservation that stands, or that there is none.
reserveState(r: Option[marshal.ReserveUse]) -> string = r match
  Some(res) -> s"marshal: ${marshal.reserveText(res.owner, res.leftMs)}: only its jobs and quick jobs start"
  None -> "marshal: not reserved: every owner's jobs start"

status() -> int
  askDaemon(Request.Status) match
    Ok(Using(u)) ->
      println(marshal.usageLine(u))
      0
    Ok(Failed(e)) -> complain(s"marshal: $e")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

val StatusUsage: string = "marshal: status takes a job id, --json, both, or nothing"

// `status <id> [--json]`: the job's state, running, queued (and why), waiting or ended, and for an
// ended one its exit status, as one line, or as one JSON object with `--json`. Exits 0 for any job
// the daemon knows, whatever its outcome, and 2 for an id no job has had.
jobStatus(word: string, asJson: bool) -> int
  if word.startsWith("-") then return complain(StatusUsage)
  val id = word.toLongOption() match
    Some(n) -> n
    None -> return complain(s"marshal: `$word` is not a job id")
  askDaemon(Request.Lookup(id)) match
    Ok(Found(job, why)) ->
      println(if asJson then marshal.jobStatusJson(job, why).render else marshal.statusLine(job, why))
      0
    Ok(Failed(e)) -> complain(s"marshal: $e")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

// The budget in use and the running and queued jobs, as one JSON object on one line.
statusJson() -> int
  val usage = askDaemon(Request.Status) match
    Ok(Using(u)) -> u
    Ok(Failed(e)) -> return complain(s"marshal: $e")
    Ok(other) -> return complain(s"marshal: unexpected reply $other")
    Err(e) -> return complain(e)
  askDaemon(Request.List) match
    Ok(Jobs(jobs)) ->
      println(marshal.statusJson(usage, jobs, queuedWhys(jobs)).render)
      0
    Ok(Failed(e)) -> complain(s"marshal: $e")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

stop(args: Vector[string]) -> int
  val (force, drain) = args match
    [] -> (false, false)
    ["--force"] -> (true, false)
    ["--wait"] -> (false, true)
    _ -> return complain("marshal: stop takes --wait or --force")
  val conn = connect(false) match
    Ok(c) -> c
    Err(_) ->
      println("marshal: no daemon is running")
      return 0
  ask(conn, Request.Stop(force, drain)) match
    Ok(Done) ->
      println("marshal: the daemon has stopped")
      0
    Ok(Failed(e)) -> complain(s"marshal: $e")
    Ok(other) -> complain(s"marshal: unexpected reply $other")
    Err(e) -> complain(e)

// The daemon's version and process id, over `conn`.
hello(conn: UnixStream) -> Result[(string, long), string] = ask(conn, Request.Hello) match
  Ok(Hi(v, pid)) -> Ok((v, pid))
  Ok(Failed(e)) -> Err(
    s"marshal: the daemon does not say its version ($e): it is older than this marshal; `marshal stop --wait` and start it again"
  )
  Ok(other) -> Err(s"marshal: unexpected reply $other")
  Err(e) -> Err(e)

// `restart`: the daemon becomes the marshal installed at its own path and keeps its jobs. It
// answers only when it could not; otherwise its connection closes as it goes, and the new image is
// asked who it is once it listens.
restart() -> int
  val conn = connect(false) match
    Ok(c) -> c
    Err(_) ->
      println("marshal: no daemon is running")
      return 0
  val (old, pid) = hello(conn) match
    Ok(h) -> h
    Err(e) -> return complain(e)
  exchange(conn, Request.Restart(process.executable())) match
    Ok(Some(Failed(e))) -> return complain(s"marshal: $e")
    Ok(Some(other)) -> return complain(s"marshal: unexpected reply $other")
    Ok(None) -> ()
    Err(e) -> return complain(e)
  val _ = conn.close()
  restartedHello() match
    Ok((now, p)) if p == pid ->
      println(s"marshal: daemon $pid restarted: version $old, now $now")
      0
    Ok((_, p)) -> complain(
      s"marshal: daemon $pid ended instead of restarting; daemon $p took its place, and its jobs were lost; see ${home()}/daemon.log"
    )
    Err(e) -> complain(e)

// The restarted daemon's version and process id, once it listens. A connection made while the
// image before it still held the socket closes unanswered, and is made again.
restartedHello() -> Result[(string, long), string]
  val limit = time.monotonic() + Reconnecting
  loop
    val again = reconnect(limit)?
    val answer = exchange(again, Request.Hello)
    val _ = again.close()
    answer? match
      Some(Hi(v, p)) -> return Ok((v, p))
      Some(Failed(e)) -> return Err(
        s"marshal: the daemon does not say its version ($e): it is older than this marshal; `marshal stop --wait` and start it again"
      )
      Some(other) -> return Err(s"marshal: unexpected reply $other")
      None -> if time.monotonic() >= limit then return Err(
        s"marshal: the daemon went away and did not come back within ${Reconnecting.toMillis / 1000}s"
      )

// `version`: this marshal's version, and the daemon's when one is running.
version() -> int
  println(s"marshal ${marshal.Version}")
  UnixStream.connect(home() + "/sock") match
    Ok(conn) -> hello(conn) match
      Ok((v, pid)) -> println(s"daemon $pid: marshal $v")
      Err(e) -> return complain(e)
    Err(_) -> println("no daemon is running")
  0

// `tail <id> [-f] [-n N]`: the last lines of a job's log, and with -f what it writes after them
// until the job ends.
tail(args: Vector[string]) -> int
  var follow = false
  var count = 20
  var id: Option[long] = None
  var i = 0
  while i < args.length
    args(i) match
      "-f" -> follow = true
      "-n" ->
        i += 1
        if i >= args.length then return complain("marshal: -n needs a number of lines")
        args(i).toIntOption() match
          Some(n) if n >= 0 -> count = n
          _ -> return complain(s"marshal: `${args(i)}` is not a number of lines")
      word -> word.toLongOption() match
        Some(n) if id.isEmpty -> id = Some(n)
        _ -> return complain(s"marshal: `$word`: tail takes one job id, -f and -n")
    i += 1
  val job = id match
    Some(n) -> n
    None -> return complain("marshal: give a job id")
  val log = s"${home()}/jobs/$job.log"
  if !follow
    return fs.readTailLines(log, count) match
      Ok(lines) ->
        for l in lines do println(l)
        0
      Err(IoError(ErrorKind.NotFound, _, _)) -> complain(s"marshal: job $job has no log yet")
      Err(e) -> complain(s"marshal: $log: ${e.message}")
  // Following: a second connection waits for the job, so the follower knows when to stop.
  val code = Atomic(-1)
  val waiter = spawn(() ->
    val result = askDaemon(Request.Wait(job))
    val status = result match
      Ok(Ended(j)) -> j.outcome.map(marshal.exitCode).getOrElse(Trouble)
      _ -> Trouble
    code.store(status)
    result)
  // A queued job has no log yet: it is waited for.
  while !fs.exists(log) && code.load() < 0 do threads.sleep(millis(100))
  if !fs.exists(log)
    return reportEnd(waiter.join())
  fs.readTailLines(log, count).getOrElse([]).foreach(l -> println(l))
  val f = fs.open(log) match
    Ok(f) -> f
    Err(e) -> return complain(s"marshal: $log: ${e.message}")
  f.seekToEnd() match
    Ok(_) -> ()
    Err(e) -> return complain(s"marshal: $log: ${e.message}")
  loop
    val done = code.load() >= 0
    f.readCompleteLine() match
      Ok(Some(line)) -> println(line)
      Ok(None) ->
        if done
          f.readLine().getOrElse(None).foreach(l -> println(l))
          break
        threads.sleep(millis(100))
      Err(e) -> return complain(s"marshal: $log: ${e.message}")
  val _ = f.close()
  reportEnd(waiter.join())

// `grep [options] <id> <pattern>`: the lines of a job's log that match, read straight from the log
// as `tail` does, so a running job and an ended one are searched alike and no daemon is needed.
// Exits as grep does: 0 when a line matched, 1 when none did, 2 when the search could not be made.
grep(args: Vector[string]) -> int
  var ignoreCase = false
  var invert = false
  var numbers = false
  var countOnly = false
  var fixed = false
  var maxMatches: Option[long] = None
  var before: Option[int] = None
  var after: Option[int] = None
  var context: Option[int] = None
  var last: Option[long] = None
  val words = Buffer[string]()
  var i = 0
  var optionsOver = false
  while i < args.length
    val word = args(i)
    if optionsOver || !word.startsWith("-") || word == "-"
      words.addOne(word)
    else
      word match
        "--" -> optionsOver = true
        "-i" -> ignoreCase = true
        "-v" -> invert = true
        "-n" -> numbers = true
        "-c" -> countOnly = true
        "-F" -> fixed = true
        "-m" | "--last" ->
          i += 1
          if i >= args.length then return complain(s"marshal: grep: $word needs a number")
          args(i).toLongOption() match
            Some(n) if n >= 0 -> if word == "-m" then maxMatches = Some(n) else last = Some(n)
            _ -> return complain(s"marshal: grep: `${args(i)}` is not a number for $word")
        "-A" | "-B" | "-C" ->
          i += 1
          if i >= args.length then return complain(s"marshal: grep: $word needs a number of lines")
          args(i).toIntOption() match
            Some(
              n
            ) if n >= 0 -> if word == "-A" then after = Some(
              n
            ) elif word == "-B" then before = Some(n) else context = Some(n)
            _ -> return complain(s"marshal: grep: `${args(i)}` is not a number of lines for $word")
        _ -> return complain(s"marshal: grep: no option `$word`; use -- before a pattern that begins with -")
    i += 1
  if words.length != 2 then return complain("marshal: grep takes a job id and a pattern")
  val job = words(0).toLongOption() match
    Some(n) -> n
    None -> return complain(s"marshal: `${words(0)}` is not a job id")
  val hit = grepMatcher(words(1), fixed, ignoreCase) match
    Ok(h) -> h
    Err(e) -> return complain(s"marshal: grep: `${words(1)}` is not a pattern: $e")
  val spec = GrepSpec(
    invert,
    numbers,
    countOnly,
    maxMatches,
    before.getOrElse(context.getOrElse(0)),
    after.getOrElse(context.getOrElse(0))
  )
  val log = s"${home()}/jobs/$job.log"
  val f = fs.open(log) match
    Ok(f) -> f
    Err(IoError(ErrorKind.NotFound, _, _)) -> return complain(s"marshal: job $job has no log")
    Err(e) -> return complain(s"marshal: $log: ${e.message}")
  // `--last N` skips all but the last N lines: one pass to count them, then the search.
  var skip: long = 0
  last match
    Some(keep) ->
      var total: long = 0
      loop
        f.readLine() match
          Ok(Some(_)) -> total += 1
          Ok(None) -> break
          Err(e) -> return complain(s"marshal: $log: ${e.message}")
      skip = if total > keep then total - keep else 0
      f.seek(0) match
        Ok(_) -> ()
        Err(e) -> return complain(s"marshal: $log: ${e.message}")
    None -> ()
  var n: long = 0
  while n < skip
    val _ = f.readLine() // a line that cannot be read is skipped as the others are
    n += 1
  val result = grepLines(
    () -> f.readLine().mapErr(e -> s"marshal: $log: ${e.message}"),
    skip + 1,
    hit,
    spec,
    l -> println(l)
  )
  val _ = f.close()
  result match
    Ok(count) ->
      if countOnly then println(count)
      if count > 0 then 0 else 1
    Err(e) -> complain(e)

reportEnd(result: Result[Reply, string]) -> int
reportEnd(Ok(Ended(j))) =
  println(marshal.resultLine(j))
  j.outcome.map(marshal.exitCode).getOrElse(Trouble)
reportEnd(Ok(Failed(e))) = complain(s"marshal: $e")
reportEnd(Ok(other)) = complain(s"marshal: unexpected reply $other")
reportEnd(Err(e)) = complain(e)

// One request and its reply.
ask(conn: UnixStream, request: Request) -> Result[Reply, string] = exchange(conn, request)? match
  Some(reply) -> Ok(reply)
  None -> Err("marshal: the daemon closed the connection without a reply")

// One request and its reply, or None when the connection closed before a reply came.
exchange(conn: UnixStream, request: Request) -> Result[Option[Reply], string]
  if conn.writeText(marshal.encodeRequest(request).render + "\n").isErr then return Ok(None)
  conn.readLine() match
    Ok(Some(line)) -> marshal.decodeReply(line).map(r -> Some(r)).mapErr(
      e -> s"marshal: the daemon's reply is not one: $e"
    )
    _ -> Ok(None)

// How long a command goes on trying to reach a daemon whose connection closed: long enough for it
// to restart.
val Reconnecting: time.Duration = millis(30000)

// One request of the daemon, starting one when none listens. A connection that closes before the
// reply comes is opened again and the request asked again, for up to `Reconnecting`: a daemon
// writes every reply it gives before it restarts, so a request left unanswered was not carried
// out, and a `wait` goes on waiting across a restart.
askDaemon(request: Request) -> Result[Reply, string]
  var conn = connect(true)?
  loop
    exchange(conn, request)? match
      Some(reply) ->
        val _ = conn.close()
        return Ok(reply)
      None -> val _ = conn.close()
    conn = reconnect(time.monotonic() + Reconnecting)?

// A new connection to the daemon, looking with a growing pause until `limit`; a daemon is started
// when none is starting.
reconnect(limit: time.Duration) -> Result[UnixStream, string]
  var pause: long = 25
  loop
    threads.sleep(millis(pause))
    if pause < 1000 then pause *= 2
    connect(true) match
      Ok(c) -> return Ok(c)
      Err(e) -> if time.monotonic() >= limit then return Err(
        s"marshal: the daemon went away and did not come back within ${Reconnecting.toMillis / 1000}s: $e"
      )

// A connection to the daemon, starting one when none listens and `start` allows it.
connect(start: bool) -> Result[UnixStream, string]
  val dir = home()
  val sock = dir + "/sock"
  UnixStream.connect(sock) match
    Ok(c) -> return Ok(c)
    Err(e) -> if !start then return Err(s"marshal: no daemon at $sock: ${e.message}")
  launch(dir)?
  // The daemon is listening once its socket answers.
  val until = time.monotonic() + millis(10000)
  while time.monotonic() < until
    UnixStream.connect(sock) match
      Ok(c) -> return Ok(c)
      Err(_) -> threads.sleep(millis(50))
  // A lock left with no pid, by a command that died between making it and writing one, goes.
  if fs.isDir(dir + "/starting") && !fs.exists(dir + "/starting/pid") then val _ = fs.removeDirAll(dir + "/starting")
  val tail = fs.readTailLines(dir + "/daemon.log", 5).getOrElse([]).mkString("\n")
  Err(s"marshal: the daemon did not start; the end of $dir/daemon.log:\n$tail")

// Starts a daemon in the background, unless another command is starting one already: the
// directory `starting`, made by one command alone, says which, and holds that command's pid so a
// command that died starting one does not block the next. The daemon removes it once it listens.
launch(dir: string) -> Result[unit, string]
  fs.createDirAll(dir).mapErr(e -> s"marshal: cannot make $dir: ${e.message}")?
  val lock = dir + "/starting"
  fs.createDir(lock) match
    Ok(_) -> marshal.writeAtomic(lock + "/pid", process.pid().toString()).mapErr(
      e -> s"marshal: cannot start a daemon: ${e.message}"
    )?
    Err(IoError(ErrorKind.AlreadyExists, _, _)) ->
      // No pid yet: the command that made it is about to write one.
      val owner = fs.readText(lock + "/pid").ok.flatMap(t -> t.trim.toLongOption())
      val alive = owner.forall(p -> process.signal(p, 0).isOk)
      if alive then return Ok(())
      val _ = fs.removeDirAll(lock) // the createDir below reports a lock that stays
      fs.createDir(lock) match
        Ok(_) -> marshal.writeAtomic(lock + "/pid", process.pid().toString()).mapErr(
          e -> s"marshal: cannot start a daemon: ${e.message}"
        )?
        Err(IoError(ErrorKind.AlreadyExists, _, _)) -> return Ok(())
        Err(e) -> return Err(s"marshal: cannot start a daemon: ${e.message}")
    Err(e) -> return Err(s"marshal: cannot start a daemon: ${e.message}")
  val exe = process.executable() match
    Some(x) -> x
    None -> return Err("marshal: cannot tell where this program is, to start the daemon")
  Command(
    "sh",
    "-c",
    "\"$0\" daemon </dev/null >>\"$1\" 2>&1 &",
    exe,
    dir + "/daemon.log"
  ).run().mapErr(e -> s"marshal: cannot start the daemon: ${e.message}")?
  Ok(())
