module dev.avinlang.marshal

// The daemon's settings, from `config.json` in marshal's home directory. Every key is optional:
//
//   units           the development unit budget (12)
//   memory          the memory budget, a size such as "56G" or a number of bytes; by default the
//                   machine's memory less `reserve`
//   reserve         what the default memory budget leaves the rest of the machine ("8G")
//   deadline_floor  the shortest deadline learning may give, as `--deadline` writes one ("5m")
//   learn_window    how many recent runs of a kind learning reads (20)
//   learn_min_runs  how many runs a kind needs before its deadline is learned (3)
//   keep_logs       how long the files of an ended job (log, run directory) are kept, such as "30d"
//                   (30d); "never" keeps them for ever
//   keep_jobs       how many ended jobs' files are kept at most (1000); "never" for no limit
//   keep_events     how long an ended job's events stay in events.jsonl ("365d"); "never" for ever
//   keep_steps      how long a compiled step may go unused before it is removed ("30d"); "never"
//   take_slot       take-slot.zsh's lock directory, whose budget and landing lane marshal shares;
//                   "" or no setting shares none, and `MARSHAL_TAKE_SLOT_DIR` overrides it
//                   (see `takeSlotDir`)
//   drain_after     how long a development job may wait before the machine drains for it ("10m");
//                   "never" never drains (see `Fairness`)
//   load_wait       how long an exclusive job waits for its `--quiet-load` before it starts anyway
//                   ("15m"); "never" waits for the load for ever (see `settleWhy`)
import dev.avinlang.json
import dev.avinlang.json.Json

// `takeSlot` is what config.json says, None where it says nothing. `drainAfterMs` is the bound on a
// development job's wait, None for none. `loadWaitMs` is the bound on an exclusive job's wait for
// the load, None for none.
data Config(
    budget: Budget,
    learning: Learning,
    takeSlot: Option[string],
    retention: Retention = defaultRetention,
    drainAfterMs: Option[long] = Some(DefaultDrainAfter),
    loadWaitMs: Option[long] = Some(DefaultLoadWait)
)

// How long a development job waits before the machine drains for it, unless config.json says.
val DefaultDrainAfter: long = 10 * 60000

// How long an exclusive job waits for its quiet load before it starts anyway, unless config.json
// says: long enough for a passing burst (a build outside marshal, an update) to end, short enough
// that a machine whose background never quietens still runs the benchmark the same session.
val DefaultLoadWait: long = 15 * 60000

// The bound `config` sets on waiting, at `wallNow` (wall-clock microseconds).
fairness(config: Config, wallNow: long) -> Fairness = config.drainAfterMs match
  Some(ms) -> Fairness(ms, wallNow)
  None -> Unbounded

private val DefaultReserve: long = 8 * 1024 * 1024 * 1024

// The settings in `text` (empty text is every default), for a machine with `machineMemory` bytes
// (0 where it is not known: the memory budget is then unlimited unless the file gives one).
readConfig(text: string, machineMemory: long) -> Result[Config, string]
  val j = if text.trim.isEmpty then Json.obj() else json.parse(text) match
    Ok(v) -> v
    Err(e) -> return Err(s"config.json is not JSON: $e")
  if j.asMembers.isEmpty then return Err("config.json holds an object")
  for key in j.keys
    if ![
      "units",
      "memory",
      "reserve",
      "deadline_floor",
      "learn_window",
      "learn_min_runs",
      "take_slot",
      "keep_logs",
      "keep_jobs",
      "keep_events",
      "keep_steps",
      "drain_after",
      "load_wait"
    ].contains(key)
      return Err(s"config.json: no setting `$key`")
  val units = whole(j, "units", 12)?
  if units < 1 then return Err("config.json: `units` is at least 1")
  val reserve = size(j, "reserve", DefaultReserve)?
  val fallback = if machineMemory <= 0 then long.MaxValue elif machineMemory > reserve then machineMemory - reserve else machineMemory
    / 2
  val memory = size(j, "memory", fallback)?
  val floor = j.get("deadline_floor") match
    None -> defaultLearning.floorMs
    Some(v) -> v.asString.flatMap(parseDeadline) match
      Some(ms) -> ms
      None -> return Err("config.json: `deadline_floor` is a deadline such as \"5m\" or \"90s\"")
  val window = whole(j, "learn_window", defaultLearning.window)?
  val minRuns = whole(j, "learn_min_runs", defaultLearning.minRuns)?
  if window < 1 || minRuns < 1 then return Err("config.json: `learn_window` and `learn_min_runs` are at least 1")
  val takeSlot = j.get("take_slot") match
    None -> None
    Some(v) -> v.asString match
      Some(dir) -> Some(dir)
      None -> return Err("config.json: `take_slot` is a directory, or \"\" for none")
  val retention = Retention(
    ageSetting(j, "keep_logs", defaultRetention.logsMs)?,
    countSetting(j, "keep_jobs", defaultRetention.jobs)?,
    ageSetting(j, "keep_events", defaultRetention.eventsMs)?,
    ageSetting(j, "keep_steps", defaultRetention.stepsMs)?
  )
  val drainAfter = waitSetting(j, "drain_after", DefaultDrainAfter)?
  val loadWait = waitSetting(j, "load_wait", DefaultLoadWait)?
  Ok(
    Config(
      Budget(units, memory),
      Learning(window, minRuns, defaultLearning.factor, floor),
      takeSlot,
      retention,
      drainAfter,
      loadWait
    )
  )

// A wait such as "10m" or "90s" at `key`, `absent` where it says none, and None for "never".
private waitSetting(j: Json, key: string, absent: long) -> Result[Option[long], string]
  val refusal = s"config.json: `$key` is a wait such as \"10m\" or \"90s\", or \"never\""
  j.get(key) match
    None -> Ok(Some(absent))
    Some(v) -> v.asString match
      Some("never") -> Ok(None)
      Some(t) -> parseDeadline(t) match
        Some(ms) -> Ok(Some(ms))
        None -> Err(refusal)
      None -> Err(refusal)

private ageSetting(j: Json, key: string, absent: Option[long]) -> Result[Option[long], string] = j.get(key) match
  None -> Ok(absent)
  Some(v) -> v.asString match
    Some("never") -> Ok(None)
    Some(t) -> parseAge(t) match
      Some(ms) -> Ok(Some(ms))
      None -> Err(s"config.json: `$key` is an age such as \"30d\" or \"12h\", or \"never\"")
    None -> Err(s"config.json: `$key` is an age such as \"30d\" or \"12h\", or \"never\"")

private countSetting(j: Json, key: string, absent: Option[int]) -> Result[Option[int], string] = j.get(key) match
  None -> Ok(absent)
  Some(v) -> v.asString match
    Some("never") -> Ok(None)
    _ -> v.asInt.filter(n -> n >= 1) match
      Some(n) -> Ok(Some(n))
      None -> Err(s"config.json: `$key` is a whole number, at least 1, or \"never\"")

private whole(j: Json, key: string, absent: int) -> Result[int, string] = j.get(key) match
  None -> Ok(absent)
  Some(v) -> v.asInt match
    Some(n) -> Ok(n)
    None -> Err(s"config.json: `$key` is a whole number")

private size(j: Json, key: string, absent: long) -> Result[long, string] = j.get(key) match
  None -> Ok(absent)
  Some(v) -> v.asString.flatMap(parseSize).orElse(v.asLong.filter(n -> n >= 0)) match
    Some(n) -> Ok(n)
    None -> Err(s"config.json: `$key` is a size such as \"56G\" or a number of bytes")
