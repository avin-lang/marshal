module dev.avinlang.marshal

// Sizes and lengths of time as people write them on a command line and read them in a listing.

private val Kibi: long = 1024

// A memory size: whole digits with an optional K, M, G or T (powers of 1024, either case), bytes
// when bare. `29G` is 29 × 1024³ bytes. Anything else, a sign or a fraction among it, is None.
parseSize(text: string) -> Option[long]
    if text.isEmpty() then return None
    val unit: long = text.last() match
        'K' | 'k' -> Kibi
        'M' | 'm' -> Kibi * Kibi
        'G' | 'g' -> Kibi * Kibi * Kibi
        'T' | 't' -> Kibi * Kibi * Kibi * Kibi
        _ -> 1
    val digits = if unit == 1 then text else text.dropRight(1)
    if digits.isEmpty() || !digits.chars().forall(c -> '0' <= c <= '9') then return None
    digits.toLongOption() match
        Some(n) if n <= long.MaxValue / unit -> Some(n * unit)
        _ -> None

// A size in the largest unit that divides it exactly: `29G`, `1536M`, `100`, `0`.
formatSize(bytes: long) -> string
    if bytes == 0 then return "0"
    var n = bytes
    var unit = 0
    while unit < 4 && n % Kibi == 0
        n /= Kibi
        unit += 1
    n.toString() + sizeUnit(unit)

// A measured size, rounded to the nearest for a narrow column: one decimal under ten of its unit and
// whole numbers from there, in the largest unit it reaches: `512`, `1.5K`, `812M`, `9.4G`, `12G`.
// What rounds up to 1024 of a unit is `1.0` of the next; at most five characters below 10000T.
roundSize(bytes: long) -> string
    if bytes <= 0 then return "0"
    var unit = 0
    var div: long = 1
    while unit < 4 && bytes / div >= Kibi
        div *= Kibi
        unit += 1
    if unit == 0 then return bytes.toString()
    val whole = bytes / div
    val rem = bytes % div
    val tenths = whole * 10 + (rem * 10 + div / 2) / div
    if tenths < 100 then return s"${tenths / 10}.${tenths % 10}" + sizeUnit(unit)
    val rounded = whole + (if rem >= div - rem then 1 else 0)
    if rounded >= Kibi && unit < 4 then return "1.0" + sizeUnit(unit + 1)
    rounded.toString() + sizeUnit(unit)

private sizeUnit(i: int) -> string = ["", "K", "M", "G", "T"](i)

// A deadline as `--deadline` takes it: a bare whole number is minutes, and a number followed by
// `s`, `m` or `h` is seconds, minutes or hours. Answers milliseconds; zero and anything else is None.
parseDeadline(text: string) -> Option[long]
    if text.isEmpty() then return None
    val scale: long = text.last() match
        's' -> 1000
        'm' -> 60000
        'h' -> 3600000
        _ -> 0
    val digits = if scale == 0 then text else text.dropRight(1)
    if digits.isEmpty() || !digits.chars().forall(c -> '0' <= c <= '9') then return None
    val per: long = if scale == 0 then 60000 else scale
    digits.toLongOption() match
        Some(n) if 0 < n <= long.MaxValue / per -> Some(n * per)
        _ -> None

// A length of time for a listing: `850ms`, `4.2s`, `3m05s`, `1h02m`.
formatMillis(ms: long) -> string
    if ms < 1000 then return s"${ms}ms"
    if ms < 60000 then return s"${ms / 1000}.${ms % 1000 / 100}s"
    val seconds = ms / 1000
    if seconds < 3600 then return s"${seconds / 60}m${twoDigits(seconds % 60)}s"
    s"${seconds / 3600}h${twoDigits(seconds / 60 % 60)}m"

private twoDigits(n: long) -> string = if n < 10 then s"0$n" else n.toString()

// The processor time `ps -o time=` prints, `[HH:]MM:SS[.ss]`, in hundredths of a second;
// None for text of any other shape.
parseCpuTime(text: string) -> Option[long]
    val t = text.trim()
    if t.isEmpty() then return None
    val (whole, frac) = t.indexOf(".") match
        i if i >= 0 -> (t.slice(0, i), t.slice(i + 1, t.byteLength()))
        _ -> (t, "")
    val parts = whole.split(":")
    if parts.isEmpty || parts.length > 3 then return None
    var total: long = 0
    for p in parts
        if p.isEmpty() || !p.chars().forall(c -> '0' <= c <= '9') then return None
        total = total * 60 + p.toLong()
    val hundredths: long = frac.take(2).padEnd(2, '0') match
        f if f.chars().forall(c -> '0' <= c <= '9') -> f.toLong()
        _ -> return None
    Some(total * 100 + hundredths)
