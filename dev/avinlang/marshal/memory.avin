module dev.avinlang.marshal

// What a running job holds in RAM, as the daemon measures it: every so often the processes of the
// job's process group are listed, and their resident bytes summed.
import avin.io.IoError
import avin.process

// The resident bytes of the processes `pids`, summed by asking `resident` of each. A process that has
// ended since it was listed answers NotFound and counts nothing; so does one that cannot be asked.
residentOf(pids: Vector[long], resident: (long) -> Result[long, IoError]) -> long
    var total: long = 0
    for pid in pids
        resident(pid) match
            Ok(n) -> total += n
            Err(_) -> ()
    total

// The resident bytes of a job's whole process tree: every process of its group `pgid`, the group it
// was started in and every program it starts joins.
groupResident(pgid: long) -> long = residentOf(groupMembers(pgid), pid -> process.residentBytes(pid))

// The processes of the process group `pgid`; none where it cannot be asked, for a group nobody is in
// and for a `pgid` that is not a group's.
groupMembers(pgid: long) -> Vector[long]
    if pgid <= 0 then return []
    process.groupMembers(pgid).getOrElse([])

// A job's memory as measured: the latest measurement, and the most any has found.
data Resident(now: long, peak: long)

impl Resident
    // After a measurement of `bytes`: the peak never goes down.
    measured(bytes: long) -> Resident = Resident(bytes, if bytes > peak then bytes else peak)

// Reservations learned from the peaks jobs of a kind reached. A job that gives no memory reserves
// its history key's learned peak: the most of the last `window` peaks, plus `marginPercent`, rounded
// up to a whole mebibyte, once the key has at least `minRuns` peaks; nothing before that. Every job
// that ran and was measured is history, whatever its outcome: a failed build holds the memory it
// holds.
data MemoryLearning(window: int, minRuns: int, marginPercent: long)

val defaultMemoryLearning: MemoryLearning = MemoryLearning(10, 2, 10)

private val Mebi: long = 1024 * 1024

// The memory a job reserves, and whether it was learned rather than given.
data Reservation(bytes: long, learned: bool)

// The peak a key's history (oldest first) teaches, or None while it has too few peaks.
learnedPeak(learning: MemoryLearning, peaks: Vector[long]) -> Option[long]
    val runs = peaks.filter(p -> p > 0).takeRight(learning.window)
    if runs.length() < learning.minRuns || runs.isEmpty() then return None
    val most = runs.max()
    val margin = most / 100 * learning.marginPercent + most % 100 * learning.marginPercent / 100
    val withMargin = if most > long.MaxValue - margin then long.MaxValue else most + margin
    if withMargin > long.MaxValue - Mebi then return Some(withMargin)
    Some((withMargin + Mebi - 1) / Mebi * Mebi)

// The reservation of a job that declared `memory`, `given` saying it was given: a given memory, `0`
// among them, is the reservation; otherwise the learned peak, held to the whole `budget` so a job
// that has peaked above it still starts once nothing else holds memory, and runs alone; 0 for a
// kind nothing has been learned of.
reservationFor(learning: MemoryLearning, memory: long, given: bool, peaks: Vector[long], budget: long) -> Reservation
    if given || memory > 0 then return Reservation(memory, false)
    learnedPeak(learning, peaks) match
        Some(p) -> Reservation(if p > budget then budget else p, true)
        None -> Reservation(0, false)

// What admission counts a running job as holding: its reservation, or what it was last measured
// holding where that is more. A job holding more than it reserved delays the next start; one
// holding less keeps its reservation, for the peak it has not reached yet.
holding(reserved: long, rss: long) -> long = if rss > reserved then rss else reserved
