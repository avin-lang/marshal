module dev.avinlang.marshal

// What a running job holds in RAM, as the daemon measures it: every so often the processes of the
// job's process group are listed, and their physical footprint (the figure Activity Monitor's Memory
// column shows) summed.
import avin.c.{Errno, ESRCH, EPERM}
import avin.fs
import avin.io
import avin.io.IoError
import avin.process
import avin.threads.Atomic
import dev.avinlang.json
import dev.avinlang.json.Json

@c(const: "RUSAGE_INFO_V2")
private val rusageInfoV2: int

// The `long`s the fields of `struct rusage_info_v2` are, after the 16 bytes of `ri_uuid`: the ninth
// `uint64_t` field is `ri_phys_footprint`.
private val footprintAt = 9

@c(
  "int proc_pid_rusage(int pid, int flavor, out rusage_info_t *buffer)",
  array: "buffer",
  length: "sizeof(struct rusage_info_v2)",
  errno
)
private rusage(pid: int, flavor: int) -> Result[Array[long], Errno]

// The physical footprint of the process `pid`, in bytes: the memory it holds that the system cannot
// simply take back, compressed pages included and shared or droppable ones left out. A process that
// does not exist, or a `pid` no process has, answers NotFound; one that may not be asked,
// PermissionDenied.
footprintBytes(pid: long) -> Result[long, IoError]
  if pid <= 0 || pid > long(int.MaxValue) then return Err(IoError(io.NotFound))
  rusage(int(pid), rusageInfoV2) match
    Ok(info) -> Ok(info(footprintAt))
    Err(ESRCH) -> Err(IoError(io.NotFound))
    Err(EPERM) -> Err(IoError(io.PermissionDenied))
    Err(e) -> Err(IoError(io.Other(e.message), "measure", s"process $pid"))

// The physical footprint of the processes `pids`, summed by asking `resident` of each. A process that
// has ended since it was listed answers NotFound and counts nothing; so does one that cannot be asked.
residentOf(pids: Vector[long], resident: (long) -> Result[long, IoError]) -> long
  var total: long = 0
  for pid in pids
    resident(pid) match
      Ok(n) -> total += n
      Err(_) -> ()
  total

// The physical footprint of a job's whole process tree: every process of its group `pgid`, the group
// it was started in and every program it starts joins.
groupResident(pgid: long) -> long = residentOf(groupMembers(pgid), footprintBytes)

// The processes of the process group `pgid`; none where it cannot be asked, for a group nobody is in
// and for a `pgid` that is not a group's.
groupMembers(pgid: long) -> Vector[long]
  if pgid <= 0 then return []
  process.groupMembers(pgid).getOrElse([])

// A job's memory as measured: the latest measurement, and the most any has found.
data Resident(now: long, peak: long)

impl Resident
  // After a measurement of `bytes`: the peak never goes down.
  measured(bytes: long) -> Resident = Resident(bytes, if bytes > peak then bytes else peak)

// Reservations learned from the peaks earlier runs of the same work reached. A job that gives no
// memory reserves the learned peak of what it runs (`memoryHistory`): the most of the last `window`
// peaks, plus `marginPercent`, rounded up to a whole mebibyte, once there are at least `minRuns`
// peaks; nothing before that. Which runs are the same work is learning.avin's key chain, and only
// clean runs are history (`cleanRun`): a failed build that ran its course holds the memory it
// holds, but a run killed, stopped or ended abnormally soon says nothing of it.
//
// The short window is what lets a reservation follow the work as it changes. A run that peaks
// higher raises the next reservation at once, since the newest peak is always in the window. Once
// the work needs less, the old peaks leave the window one run at a time, so the reservation comes
// down to the new level after `window` runs, and a single spike is forgotten as fast. Work whose
// peaks vary from run to run reserves the top of its last few runs, which covers its usual range
// and moves only when that top leaves the window.
data MemoryLearning(window: int, minRuns: int, marginPercent: long)

val defaultMemoryLearning: MemoryLearning = MemoryLearning(3, 3, 0)

private val Mebi: long = 1024 * 1024

// The memory a job reserves, and whether it was learned rather than given.
data Reservation(bytes: long, learned: bool)

// The peak a key's history (oldest first) teaches, or None while it has too few peaks.
learnedPeak(learning: MemoryLearning, peaks: Vector[long]) -> Option[long]
  val runs = peaks.filter(p -> p > 0).takeRight(learning.window)
  if runs.length < learning.minRuns || runs.isEmpty then return None
  val most = runs.max
  val margin = most / 100 * learning.marginPercent + most % 100 * learning.marginPercent / 100
  val withMargin = if most > long.MaxValue - margin then long.MaxValue else most + margin
  if withMargin > long.MaxValue - Mebi then return Some(withMargin)
  Some((withMargin + Mebi - 1) / Mebi * Mebi)

// The reservation of a job that declared `memory`, `given` saying it was given: a given memory, `0`
// among them, is the reservation; otherwise the learned peak, held to the whole `budget` so a job
// that has peaked above it still starts once nothing else holds memory, and runs alone; 0 for work
// nothing has been learned of.
reservationFor(learning: MemoryLearning, memory: long, given: bool, peaks: Vector[long], budget: long) -> Reservation
  if given || memory > 0 then return Reservation(memory, false)
  learnedPeak(learning, peaks) match
    Some(p) -> Reservation(if p > budget then budget else p, true)
    None -> Reservation(0, false)

// What a job runs, as its memory, cores and durations are learned under: the program's name and its
// subcommand and target (`sysl test compiler`, `sysl test .`, `gradlew test`), or a shell and the
// path of its script (`zsh /tmp/s/gate.zsh`). A kind such as `build` or `test` covers work of every
// size, so it is never learned from on its own; the command is what tells a compiler's suite from a
// small package's.
//
// The program is the first word that is not a wrapper (`env`, `nice`, `caffeinate`, `nohup`,
// `time`, `timeout`, `sudo`, `exec`, `command`, with their options) or a `NAME=value` setting. Of
// its arguments, options (`-x`, `--x`) and numbers are passed over, and the next two words are the
// subcommand and the target; a word that is a path stands for its last component, so worktrees of
// one repository share what they learn. A shell running `-c` is learned as the command it runs,
// leaving out leading `cd` and `export` steps.
//
// A script is the exception to the last component: two scripts of one name in two directories
// (`/tmp/a/gate.zsh`, `/tmp/b/gate.zsh`) are different work, so a script keeps its path as it was
// written, a leading `./` left out. A relative path stays relative, so `zsh scripts/test.sh` in two
// worktrees of one repository is still one command. A shell running a script is the shell and the
// script's path, its arguments left out (a train's branch names change every run); an interpreter
// (`python3`, `perl`, `ruby`, `node`, ...) running a script is the interpreter, the script's path
// and its first argument; a program that is itself a script (its name ends `.sh`, `.zsh`, `.py`,
// ...) is its path and its first argument. A job's label is not part of it: a label names the run
// (`rel0110 gate2`), and the same script run under another label is the same work. "" for an empty
// command, which learns nothing.
commandSignature(cmd: Vector[string]) -> string = signatureOf(cmd, true)

private val interpreters: Set[string] = {
  "python", "python3", "perl", "ruby", "node", "deno", "bun", "lua", "tclsh", "php", "Rscript", "osascript"
}

// The options of an interpreter after which its code is given inline or by module name, not by a
// script: the command is then learned as any program's is.
private val inlineOptions: Set[string] = {"-c", "-e", "-E", "-m", "-p", "--eval", "--print", "-r"}

private val scriptEndings: Vector[string] = [".sh", ".zsh", ".bash", ".py", ".pl", ".rb", ".js", ".mjs", ".ts", ".lua", ".tcl"]

// `word` names a script by its ending.
private isScript(word: string) -> bool = scriptEndings.exists(e -> word.endsWith(e) && word.charCount > e.charCount)

// A script's path as its signature keeps it: as written, without a leading `./`.
private scriptPath(word: string) -> string
  var w = word
  while w.startsWith("./") do w = w.drop(2)
  w

private val wrappers: Set[string] = {
  "env", "nice", "nohup", "caffeinate", "time", "timeout", "gtimeout", "sudo", "exec", "command"
}

private val shells: Set[string] = {"sh", "bash", "zsh", "dash", "ksh"}

// The options of a wrapper that take the next word as their value.
private valuedOptions(wrapper: string) -> Set[string] = wrapper match
  "env" -> {"-u", "-C", "-P", "-S"}
  "nice" -> {"-n"}
  "caffeinate" -> {"-t", "-w"}
  "sudo" -> {"-u", "-g", "-C", "-h", "-p", "-U", "-D", "-R", "-T"}
  "timeout" | "gtimeout" -> {"-s", "-k", "--signal", "--kill-after"}
  _ -> {}

private baseName(word: string) -> string = word.drop(word.lastIndexOf("/") + 1)

private isOption(word: string) -> bool = word.charCount > 1 && word.startsWith("-")

private isNumber(word: string) -> bool =
  word.chars.exists(c -> '0' <= c <= '9') && word.chars.forall(c -> '0' <= c <= '9' || c == '.')

// `NAME=value`, as a shell or `env` takes a setting before a command.
private isSetting(word: string) -> bool
  val eq = word.indexOf("=")
  eq > 0 && !word.take(eq).contains("/") && !word.startsWith("-")

// `words` with `shellC` saying whether a shell's `-c` may still be looked into (once only).
private signatureOf(words: Vector[string], shellC: bool) -> string
  var i = 0
  var more = true
  while more && i < words.length
    val w = words(i)
    if isSetting(w)
      i += 1
    elif wrappers.contains(baseName(w))
      i = afterWrapper(words, i + 1, baseName(w))
    else
      more = false
  if i >= words.length then return ""
  val program = baseName(words(i))
  val rest = words.drop(i + 1)
  if shells.contains(program) then return shellSignature(program, rest, shellC)
  if interpreters.contains(program) then return interpreterSignature(program, rest)
  if isScript(program) then return scriptPath(words(i)) + namedWords(rest, 1)
  program + namedWords(rest, 2)

// An interpreter running a script: the interpreter, the script's path and its first argument; one
// given its code inline (`-c`, `-e`) or a module (`-m`) is learned as any program is.
private interpreterSignature(program: string, args: Vector[string]) -> string
  var i = 0
  while i < args.length && isOption(args(i))
    if inlineOptions.contains(args(i)) then return program + namedWords(args, 2)
    i += 1
  if i >= args.length then return program
  program + " " + scriptPath(args(i)) + namedWords(args.drop(i + 1), 1)

// Where a wrapper's options (and `timeout`'s duration) end, from `from`.
private afterWrapper(words: Vector[string], from: int, wrapper: string) -> int
  val valued = valuedOptions(wrapper)
  var durationLeft = wrapper == "timeout" || wrapper == "gtimeout"
  var i = from
  while i < words.length
    val a = words(i)
    if a == "--" then return i + 1
    if isOption(a)
      i += if valued.contains(a) then 2 else 1
    elif isSetting(a)
      i += 1
    elif durationLeft
      durationLeft = false
      i += 1
    else
      return i
  i

// The first `n` words of `args` that are neither options nor numbers, each as its last path
// component, each after a space.
private namedWords(args: Vector[string], n: int) -> string
  var out = ""
  var found = 0
  for a in args
    if found >= n then break
    if a == "--" || isOption(a) || isNumber(a) then continue
    val name = baseName(a)
    if name.isEmpty then continue
    out = out + " " + name
    found += 1
  out

private shellSignature(shell: string, args: Vector[string], shellC: bool) -> string
  var i = 0
  while i < args.length && isOption(args(i))
    val a = args(i)
    if a == "-o" || a == "+o"
      i += 2
    elif !a.startsWith("--") && a.endsWith("c")
      // `-c`, or `-ec` and the like: the next word is the command
      if i + 1 >= args.length then return shell + " -c"
      if !shellC then return shell + " -c"
      val inner = commandOfScript(args(i + 1))
      return if inner.isEmpty then shell + " -c" else inner
    else
      i += 1
  if i >= args.length then return shell
  shell + " " + scriptPath(args(i))

// The signature of the first step of a `-c` script that is not a `cd`, `export` or the like.
private commandOfScript(script: string) -> string
  val tokens = script.replace("\n", " ").replace("\t", " ").split(" ").filter(t -> t.nonEmpty).toVector
  val step = Buffer[string]()
  var ended = false
  for t in tokens
    val sep = t == "&&" || t == "||" || t == ";" || t == "|"
    val word = if !sep && t.endsWith(";") then t.dropRight(1) else t
    if !sep && word.nonEmpty then step += word
    if sep || t.endsWith(";")
      if step.nonEmpty && !preparation.contains(step(0)) then return signatureOf(step.toVector, false)
      step.clear()
  if step.nonEmpty && !preparation.contains(step(0)) then signatureOf(step.toVector, false) else ""

// Steps of a shell script that prepare for the command rather than run it.
private val preparation: Set[string] = {"cd", "export", "set", "unset", "source", ".", "pushd", "ulimit", "umask"}

// The key a job's peaks are learned under: its kind (`historyKey`, so landing jobs learn apart) and
// what it runs (`commandSignature`). A line feed parts them; a signature never holds one.
memoryKey(kind: string, landing: bool, signature: string) -> string = historyKey(kind, landing) + "\n" + signature

// The key of the same work run in one working directory, which refines `memoryKey` once that
// directory has history of its own: one repository's tree can differ from another's.
memoryDirKey(kind: string, landing: bool, signature: string, dir: string) -> string =
  memoryKey(kind, landing, signature) + "\n" + dir

// The keys a job of `kind` running `cmd` in `dir` teaches; none for a command without a signature.
memoryKeys(kind: string, landing: bool, cmd: Vector[string], dir: string) -> Vector[string]
  val sig = commandSignature(cmd)
  if sig.isEmpty then return []
  val own = [memoryKey(kind, landing, sig)]
  if dir.isEmpty then own else own ++ [memoryDirKey(kind, landing, sig, dir)]

// The peaks a job learns its reservation from, and which key they are (learning.avin): the first of
// `chain` (each key's peaks, oldest first, and its source, most particular first) with at least
// `learning.minRuns` peaks above 0, a key below `cmd+dir` only while its peaks are alike
// (`consistent`, each counted at least `MemorySpreadFloor`); none (`from` "") before. Work nothing
// has been learned of reserves nothing, and admission counts every running job at what it is
// measured holding where that is more (`holding`).
data MemoryHistory(peaks: Vector[long], from: string)

// The least peak `consistent` tells apart from another: a gibibyte, so small builds a few hundred
// mebibytes apart are alike.
val MemorySpreadFloor: long = 1024 * 1024 * 1024

memoryHistory(learning: MemoryLearning, chain: Vector[(Vector[long], string)]) -> MemoryHistory
  val c = choose(chain, learning.minRuns, p -> p > 0, runs -> consistent(runs, MemorySpreadFloor))
  MemoryHistory(c.values, c.from)

// Where a job's reservation came from, as `status --json` shows it in `resv_from`: `given` for a
// memory it gave (`--mem`, `0` among them), the key its learned peak came from (`cmd+dir`, `cmd`,
// `norm+project` or `kind+project`), or `none` while nothing has been learned.
reservationSource(memory: long, given: bool, r: Reservation, from: string) -> string =
  if given || memory > 0 then "given" elif r.learned then from else "none"

// What admission counts a running job as holding: its reservation, or what it was last measured
// holding where that is more. A job holding more than it reserved delays the next start; one
// holding less keeps its reservation, for the peak it has not reached yet.
holding(reserved: long, rss: long) -> long = if rss > reserved then rss else reserved

// What is learned of earlier runs, kept in `<home>/memory.json` so that it outlives the daemon, a
// restart, an upgrade and `marshal clean` trimming the event log: the memory peaks, the peak cores
// (cores.avin) and the durations of the runs that succeeded (eta.avin), each by key:
//
//   {"version": 5, "peaks": {"<key>": [bytes, ...], ...}, "cores": {"<key>": [1.25, ...], ...},
//    "durations": {"<key>": [milliseconds, ...], ...}}
//
// Each key is one of learning.avin's (`chainKeys`: a `memoryKey`, a `memoryDirKey`, a `normKey` or a
// `kindProjectKey`), and holds its last `MemoryKept` values, oldest first. A file of version 2 has
// no `durations`, and one of version 1 neither those nor `cores`: what it has is used, and what it
// lacks is learned again from the event log (`fromVersion1`, `withoutDurations`). Before version 4
// a script's signature was only its name, so one key could hold the runs of several scripts of
// that name: a file of version 1, 2 or 3 keeps every key but those (`isScriptKey`), and the
// scripts' history is learned again, under its new keys, from what the event log still has
// (`staleScripts`). Before version 5 there were no project keys, so a file before version 5 takes
// every project key's peaks, cores and durations from the event log (`staleProjects`). A file of
// another version, or one that does not read, is not used: the daemon learns everything again from
// the event log.
val MemoryFileVersion: long = 5

val MemoryKept: int = 20

// `peaks` in bytes, `cores` in hundredths of a core and `durations` in milliseconds, by key, oldest
// first. `fromVersion1` says they were read from a version 1 file, which kept no cores,
// `withoutDurations` from a file of version 1 or 2, which kept no durations, `staleScripts` from a
// file before version 4, whose scripts' keys were left out, and `staleProjects` from a file before
// version 5, which kept no project keys.
data Learned(
    peaks: Map[string, Vector[long]],
    cores: Map[string, Vector[long]],
    fromVersion1: bool = false,
    durations: Map[string, Vector[long]] = Map(),
    withoutDurations: bool = false,
    staleScripts: bool = false,
    staleProjects: bool = false
)

// Whether `key` is learned under a script's signature (a shell, an interpreter or a program that
// is a script, running one), whose form changed in version 4.
isScriptKey(key: string) -> bool
  val lines = key.split("\n").toVector
  if lines.length < 2 then return false
  val words = lines(1).split(" ").toVector
  if words.isEmpty then return false
  val first = words(0)
  if isScript(first) then return true
  (shells.contains(first) || interpreters.contains(first)) && words.length > 1 && words(1) != "-c"

// The entries of `table` whose key `keep` accepts.
private entriesWhere(table: Map[string, Vector[long]], keep: (string) -> bool) -> Map[string, Vector[long]]
  val out = Buffer[(string, Vector[long])]()
  for (k, v) in table
    if keep(k) then out += (k, v)
  out.toVector.toMap

// What a file of `version` holds, as this version learns it: before version 4, without the keys
// of scripts; before version 5, with its project keys still to be learned.
private upgraded(learned: Learned, version: long) -> Learned
  if version >= MemoryFileVersion then return learned
  if version >= 4 then return Learned(
    learned.peaks,
    learned.cores,
    learned.fromVersion1,
    learned.durations,
    learned.withoutDurations,
    learned.staleScripts,
    true
  )
  val keep = (k: string) -> !isScriptKey(k)
  Learned(
    entriesWhere(learned.peaks, keep),
    entriesWhere(learned.cores, keep),
    learned.fromVersion1,
    entriesWhere(learned.durations, keep),
    learned.withoutDurations,
    true,
    true
  )

// `learned` from a file before version 5 completed by what the event log teaches (`recovered`):
// of the scripts a file before version 4 left out, and of every project key; where a table is
// learned whole from the event log (a version 1 file's cores, a version 1 or 2 file's durations) it
// is taken whole. A current file is used as it is.
withRecovered(learned: Learned, peaks: Map[string, Vector[long]], cores: Map[string, Vector[long]], durations: Map[string, Vector[long]]) -> Learned
  val scripts = (k: string) -> isScriptKey(k)
  val c = if learned.fromVersion1 then cores elif learned.staleScripts then learned.cores ++ entriesWhere(
    cores,
    scripts
  ) else learned.cores
  val d = if learned.withoutDurations then durations elif learned.staleScripts then learned.durations ++ entriesWhere(
    durations,
    scripts
  ) else learned.durations
  val p = if learned.staleScripts then learned.peaks ++ entriesWhere(peaks, scripts) else learned.peaks
  if !learned.staleProjects then return Learned(p, c, false, d, false, false)
  val commands = (k: string) -> !isProjectKey(k)
  val projects = (k: string) -> isProjectKey(k)
  Learned(
    entriesWhere(p, commands) ++ entriesWhere(peaks, projects),
    entriesWhere(c, commands) ++ entriesWhere(cores, projects),
    false,
    entriesWhere(d, commands) ++ entriesWhere(durations, projects),
    false,
    false
  )

encodeMemory(learned: Learned) -> string
  val peakKeys = learned.peaks.keys.toVector.sorted
  val peaks = peakKeys.map(k -> (k, Json.Arr(learned.peaks(k).takeRight(MemoryKept).map(p -> Json.num(p)))))
  val coreKeys = learned.cores.keys.toVector.sorted
  val cores = coreKeys.map(k -> (k, Json.Arr(learned.cores(k).takeRight(MemoryKept).map(c -> coresJson(c)))))
  val durationKeys = learned.durations.keys.toVector.sorted
  val durations = durationKeys.map(
    k -> (k, Json.Arr(learned.durations(k).takeRight(MemoryKept).map(d -> Json.num(d))))
  )
  Json.obj(
    ("version", Json.num(MemoryFileVersion)),
    ("peaks", Json.Obj(peaks)),
    ("cores", Json.Obj(cores)),
    ("durations", Json.Obj(durations))
  ).render + "\n"

decodeMemory(text: string) -> Result[Learned, string]
  val j = json.parse(text) match
    Ok(v) -> v
    Err(e) -> return Err(s"not JSON: $e")
  val version = j.get("version").flatMap(v -> v.asLong)
  val v = version.getOrElse(0)
  if v < 1 || v > MemoryFileVersion then return Err(
    s"version ${version.map(n -> n.toString()).getOrElse("missing")}, not $MemoryFileVersion"
  )
  decodeLayout(j, v).map(l -> upgraded(l, v))

// What a file of `version` holds: version 3's layout is version 4's.
private decodeLayout(j: Json, version: long) -> Result[Learned, string]
  val members = j.get("peaks").flatMap(v -> v.asMembers) match
    Some(ms) -> ms
    None -> return Err("`peaks` is not an object")
  val out = Buffer[(string, Vector[long])]()
  for (k, v) in members
    val items = v.asVector.getOrElse([])
    if v.asVector.isEmpty || !items.forall(i -> i.asLong.exists(n -> n > 0))
      return Err(s"the peaks of `$k` are not sizes")
    out += (k, items.map(i -> i.asLong.get))
  if version == 1 then return Ok(Learned(out.toVector.toMap, Map(), true, Map(), true))
  val coreMembers = j.get("cores").flatMap(v -> v.asMembers) match
    Some(ms) -> ms
    None -> return Err("`cores` is not an object")
  val cores = Buffer[(string, Vector[long])]()
  for (k, v) in coreMembers
    val items = v.asVector.getOrElse([])
    if v.asVector.isEmpty || !items.forall(i -> centiOf(i).isDefined)
      return Err(s"the cores of `$k` are not numbers of cores")
    cores += (k, items.map(i -> centiOf(i).get))
  if version == 2 then return Ok(Learned(out.toVector.toMap, cores.toVector.toMap, false, Map(), true))
  val durationMembers = j.get("durations").flatMap(v -> v.asMembers) match
    Some(ms) -> ms
    None -> return Err("`durations` is not an object")
  val durations = Buffer[(string, Vector[long])]()
  for (k, v) in durationMembers
    val items = v.asVector.getOrElse([])
    if v.asVector.isEmpty || !items.forall(i -> i.asLong.exists(n -> n >= 0))
      return Err(s"the durations of `$k` are not milliseconds")
    durations += (k, items.map(i -> i.asLong.get))
  Ok(Learned(out.toVector.toMap, cores.toVector.toMap, false, durations.toVector.toMap))

// What `file` holds learned, or why it cannot be used (a missing file among the reasons).
loadMemory(file: string) -> Result[Learned, string] = fs.readText(file) match
  Ok(text) -> decodeMemory(text)
  Err(e) -> Err(s"cannot be read: ${e.kind}")

// Writes `learned` to `file` in one step. Each write has a temporary file of its own, so writers
// never share one, and the rename leaves the whole of one write or of another, never a mixture.
saveMemory(file: string, learned: Learned) -> Result[unit, IoError] =
  writeAtomicVia(file, encodeMemory(learned), s"$file.tmp-${process.pid()}-${memoryWrites.add(1)}")

private val memoryWrites: Atomic[long] = Atomic[long](0)
