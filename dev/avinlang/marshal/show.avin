module dev.avinlang.marshal

import avin.time

// What the command line prints: a job's one-line result, a listing, the budget's use.

// The line `wait` and `run` end with.
resultLine(j: JobInfo) -> string
    val took = formatMillis(j.elapsedMs)
    val how = j.outcome match
        Some(Exited(code)) -> s"exited $code after $took"
        Some(Signalled(sig)) -> if j.killed then s"killed (signal $sig) after $took" else s"ended by signal $sig after $took"
        Some(TimedOut) ->
            val sample = j.sample.map(s -> s"; stack sample in $s").getOrElse("")
            s"timed out after $took (deadline ${formatMillis(j.deadlineMs)})$sample"
        Some(Cancelled) -> "cancelled before it started"
        Some(Lost) -> "lost: the daemon stopped while it was queued or running"
        Some(DependencyFailed(after)) -> s"cancelled before it started: job $after, which it waited for, did not succeed"
        None -> s"is ${j.state}"
    val attempts = if j.attempt > 1 && j.outcome.isDefined() then s" (attempt ${j.attempt})" else ""
    s"marshal: job ${j.id} $how$attempts; log ${j.log}"

// A job's state as a listing's column shows it: a job waiting for others with the jobs it waits
// for (`after 3,4`), a job waiting to retry with the attempt it will make, and a job held by hand
// as `held`.
stateColumn(j: JobInfo) -> string = j.outcome match
    Some(Exited(code)) -> s"exit $code"
    Some(Signalled(sig)) -> if j.killed then "killed" else s"signal $sig"
    Some(TimedOut) -> "timeout"
    Some(Cancelled) -> "cancelled"
    Some(Lost) -> "lost"
    Some(DependencyFailed(after)) -> s"dep $after failed"
    None ->
        val waits = "after " + j.after.map(id -> id.toString()).mkString(",")
        if j.held then (if j.state == "waiting" then "held " + waits else "held")
        elif j.paused then "paused"
        else j.state match
            "waiting" -> waits
            "retrying" -> s"retry ${j.attempt}"
            other -> other

// When a job started, as the STARTED column shows it: the local date and minute, `11-07 08:31`, in
// `zone`; `-` for a job that has not started (queued, or cancelled before it ran).
startedColumn(j: JobInfo, zone: time.Zone) -> string
startedColumn(j, zone) = if j.startedAt <= 0 then "-" else time.epochMillis(j.startedAt).atZone(zone).format("MM-DD hh:mm")

// The same for a narrow screen: just `hh:mm` for a job that started on `today` (a `YYYY-MM-DD` in
// `zone`), the full form for any other day.
startedShort(j: JobInfo, zone: time.Zone, today: string) -> string
    if j.startedAt <= 0 then return "-"
    val at = time.epochMillis(j.startedAt).atZone(zone)
    if at.format("YYYY-MM-DD") == today then at.format("hh:mm") else at.format("MM-DD hh:mm")

// The listing `ls` prints: a header, then one row per job.
listing(jobs: Vector[JobInfo]) -> string
    val zone = time.localZone()
    val rows = [["ID", "STATE", "KIND", "UNITS", "RESV", "STARTED", "ELAPSED", "COMMAND"]] ++ jobs.map(j -> [
        j.id.toString(),
        stateColumn(j),
        if j.landing then j.kind + "*" else j.kind,
        j.units.toString(),
        reservedText(j),
        startedColumn(j, zone),
        formatMillis(j.elapsedMs),
        j.cmd.mkString(" ")])
    val widths = (0..<7).map(c -> rows.map(r -> r(c).charCount()).max())
    rows.map(r -> (0..<7).map(c -> r(c).padEnd(widths(c), ' ')).mkString("  ") + "  " + r(7)).mkString("\n")

// The line `status` prints.
usageLine(u: Usage) -> string
    val memory = if u.memoryBudget == long.MaxValue then formatSize(u.memory) else s"${formatSize(u.memory)}/${formatSize(u.memoryBudget)}"
    val lane = u.landing.map(id -> s"job $id").getOrElse("free")
    val outside = u.takeSlot.map(t -> s"; take-slot holds ${t.units} units, ${t.waiting} waiting" + (if t.landing then ", the landing lane" else "")).getOrElse("")
    val held = if u.queueHeld then "; the queue is held: nothing new starts" else ""
    s"units ${u.units}/${u.unitBudget}, memory $memory, ${u.running} running, ${u.queued} queued, landing lane $lane$outside$held"
