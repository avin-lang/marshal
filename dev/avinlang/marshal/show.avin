module dev.avinlang.marshal

import avin.time

// What the command line prints: a job's one-line result, a listing, the budget's use.

// What every job's log begins with: a line `marshal: job 12, project /u/dev/sysl, dir /u/dev/sysl-fix`
// naming the job, its project (the main repository its directory is in, learning.avin's
// `projectOf`; a directory outside git is its own) and the directory it runs in. Written once, as its
// first attempt starts; a retry's output follows it.
val LogHeaderMark: string = "marshal: job "

logHeader(id: long, project: string, dir: string) -> string =
  s"$LogHeaderMark$id, project ${if project.isEmpty then dir else project}, dir $dir\n"

// The line `wait` and `run` end with.
resultLine(j: JobInfo) -> string
  val took = formatMillis(j.elapsedMs)
  val how = j.outcome match
    Some(Exited(code)) -> s"exited $code after $took"
    Some(
      Signalled(sig)
    ) -> if j.killed then s"killed (signal $sig) after $took" else s"ended by signal $sig after $took"
    Some(TimedOut) ->
      val sample = j.sample.map(s -> s"; stack sample in $s").getOrElse("")
      s"timed out after $took (deadline ${formatMillis(j.deadlineMs)})$sample"
    Some(Quiet(afterMs)) ->
      val sample = j.sample.map(s -> s"; stack sample in $s").getOrElse("")
      s"${quietWords(afterMs)} (quiet timeout), having run $took$sample"
    Some(Cancelled) -> "cancelled before it started"
    Some(Lost) -> "lost: the daemon stopped while it was queued or running"
    Some(DependencyFailed(after)) -> s"cancelled before it started: job $after, which it waited for, did not succeed"
    None -> s"is ${j.state}"
  val attempts = if j.attempt > 1 && j.outcome.isDefined then s" (attempt ${j.attempt})" else ""
  s"marshal: job ${j.id} $how$attempts; log ${j.log}"

// A job's state as a listing's column shows it: a job waiting for others with the jobs it waits
// for (`after 3,4`), a job waiting to retry with the attempt it will make, and a job held by hand
// as `held`.
stateColumn(j: JobInfo) -> string = j.outcome match
  Some(Exited(code)) -> s"exit $code"
  Some(Signalled(sig)) -> if j.killed then "killed" else s"signal $sig"
  Some(TimedOut) -> "timeout"
  Some(Quiet(_)) -> "quiet"
  Some(Cancelled) -> "cancelled"
  Some(Lost) -> "lost"
  Some(DependencyFailed(after)) -> s"dep $after failed"
  None ->
    val waits = "after " + j.after.map(id -> id.toString()).mkString(",")
    if j.held then (if j.state == "waiting" then "held " + waits else "held")
    elif j.paused then "paused"
    else j.state match
      "waiting" -> waits
      "retrying" -> s"retry ${j.attempt}"
      other -> other

// Whether a job is still to run: queued, settling, held, waiting for others or waiting to retry.
notRunYet(j: JobInfo) -> bool = j.outcome.isEmpty && (
  j.state == "queued" || j.state == "settling" || j.state == "waiting" || j.state == "retrying"
)

// The ELAPSED column for `ms` of run time: `-` for a job that has not started, whose wait is
// `queued_ms` in the JSON, except that a settling job shows how long it has waited for the load
// (`settlingMs`), which is not run time; once it runs, the column counts its run from 0.
elapsedColumn(j: JobInfo, ms: long) -> string =
  if settling(j) then formatMillis(j.settlingMs) elif notRunYet(j) then "-" else formatMillis(ms)

// When a job started, as the STARTED column shows it: the local date and minute, `11-07 08:31`, in
// `zone`; `-` for a job that has not started (queued, or cancelled before it ran).
startedColumn(j: JobInfo, zone: time.Zone) -> string
startedColumn(j, zone) = if j.startedAt <= 0 then "-" else time.epochMillis(j.startedAt).atZone(zone).format(
  "MM-DD hh:mm"
)

// The same for a narrow screen: just `hh:mm` for a job that started on `today` (a `YYYY-MM-DD` in
// `zone`), the full form for any other day.
startedShort(j: JobInfo, zone: time.Zone, today: string) -> string
  if j.startedAt <= 0 then return "-"
  val at = time.epochMillis(j.startedAt).atZone(zone)
  if at.format("YYYY-MM-DD") == today then at.format("hh:mm") else at.format("MM-DD hh:mm")

// Why a queued job waits, in the words `top` shows and `ls` appends to `queued`.
whyText(w: Why) -> string
whyText(NoUnits) = "no units"
whyText(NoMemory) = "no memory"
whyText(LaneBusy) = "lane busy"
whyText(Draining) = "draining"
whyText(ForTakeSlot) = "take-slot"
whyText(Behind(id)) = s"behind $id"
whyText(DrainingFor(id)) = s"draining for $id"
whyText(Starting) = "starting"
whyText(Held) = "held"
whyText(QueueHeld) = "queue held"
whyText(QuickFull) = "quick lane full"
whyText(Emptying) = "emptying"
whyText(Load(load, limit, calmMs)) =
  if load >= limit then s"load ${loadText(load)} ≥ ${loadText(limit)}" else s"load ${loadText(load)} < ${loadText(limit)} for ${formatMillis(calmMs)}"
whyText(ForExclusive(id)) = s"exclusive $id"
whyText(DiskLow(free)) = s"disk low: ${roundSize(free)} free"
whyText(PoliteBudget) = "polite budget"
whyText(RunsAlone) = "polite: runs alone"
whyText(ForAlone(id)) = s"polite: $id runs alone"

// A job's state cell in `ls`: `stateColumn`, and for a job that is plainly `queued` or `settling` and
// has a reason in `whys` (job id, reason), the reason after it: `queued (draining)`,
// `settling (load 30.4 ≥ 4.5)`. A settling job past `load_wait` adds `overdue`. A job held by hand
// already says `held`, so its reason adds nothing.
stateWithWhy(j: JobInfo, whys: Vector[(long, Why)]) -> string
  val state = stateColumn(j)
  if state != "queued" && state != "settling" then return state
  val overdue = if j.loadOverdue then ", overdue" else ""
  whys.find(w -> w.0 == j.id) match
    Some((_, Held)) -> state
    Some((_, why)) -> s"$state (${whyText(why)}$overdue)"
    None -> if overdue.isEmpty then state else s"$state (overdue)"

// The listing `ls` prints: a header, then one row per job. A LABEL column stands before COMMAND, and
// always, empty for a job without a label. UNITS is what a job weighs (`unitsText`) and USED the cores
// it was measured using beside it (`usedText`). ETA is a running job's expected time left or a
// queued one's expected start (`etaColumn`), and OWNER who the job is for (`ownerText`). `whys`
// gives the queued jobs' reasons to wait; with none, a queued job shows plain `queued`.
listing(jobs: Vector[JobInfo], whys: Vector[(long, Why)] = []) -> string
  val rows = listingRows(jobs, whys)
  val last = rows(0).length - 1
  val widths = (0 ..< last).map(c -> rows.map(r -> r(c).charCount).max)
  rows.map(r -> (0 ..< last).map(c -> r(c).padEnd(widths(c), ' ')).mkString("  ") + "  " + r(last)).mkString("\n")

// The cells of a listing, the header first: `ListingColumns` names them in order.
val ListingColumns: Vector[string] = [
  "ID", "STATE", "KIND", "UNITS", "USED", "RESV", "STARTED", "ELAPSED", "ETA", "OWNER", "FROM", "LABEL", "COMMAND"
]

listingRows(jobs: Vector[JobInfo], whys: Vector[(long, Why)]) -> Vector[Vector[string]]
  val zone = time.localZone()
  [ListingColumns] ++ jobs.map(
    j -> [
      j.id.toString(),
      stateWithWhy(j, whys),
      laneKind(j),
      unitsText(j),
      usedText(j),
      reservedText(j),
      startedColumn(j, zone),
      elapsedColumn(j, j.elapsedMs),
      etaColumn(j),
      ownerText(j),
      fromText(j),
      j.label,
      j.cmd.mkString(" ")
    ]
  )

// Where a job's units, memory and deadline came from, as `ls` shows them in FROM, in that order:
// `units/memory/deadline`, each a short word for its source (`sourceWord`), such as
// `norm/norm/norm` for a train learned from its numbered siblings or `def/-/def` for work nothing
// is known of.
fromText(j: JobInfo) -> string = [j.unitsFrom, j.reservedFrom, j.deadlineFrom].map(sourceWord).mkString("/")

// A source of learning.avin's (or `given`, `default`, ...) in a word: `dir` (cmd+dir), `cmd`,
// `norm` (norm+project), `proj` (kind+project), `given`, `def` (a default), `live` (raised while it
// ran), `excl`, `quick`, `over` (a deadline after an overrun), `kind` (a kind's, from an older
// daemon), `-` for none or not said.
sourceWord(from: string) -> string = from match
  "cmd+dir" -> "dir"
  "norm+project" -> "norm"
  "kind+project" -> "proj"
  "default" -> "def"
  "exclusive" -> "excl"
  "overrun" -> "over"
  "none" | "" -> "-"
  other -> other

// Who a job is for, as a listing shows it: `-` for none.
ownerText(j: JobInfo) -> string = if j.owner.isEmpty then "-" else j.owner

// A job's kind as a listing shows it, marked with its lane: `*` after a landing job's, `^` after a
// quick job's, `#` after an exclusive job's, and `!` after that for a job in the urgent band
// (`test^!`, `test*!`, `bench#!`).
laneKind(j: JobInfo) -> string = kindMarked(j.kind, j.landing, j.quick, j.urgent, j.exclusive)

// A job's kind and marks fitted to a column `width` cells wide: unchanged when they fit; otherwise the
// kind's name is cut and ends in `…`, and every mark follows whole (`avin-g…*`, `funl-t…!`, `te…^!`).
// Only where the marks and the ellipsis alone are wider than the column are the marks cut, from the right.
fittedKind(j: JobInfo, width: int) -> string = fittedMarked(j.kind, j.landing, j.quick, j.urgent, width, j.exclusive)

fittedMarked(kind: string, landing: bool, quick: bool, urgent: bool, width: int, exclusive: bool = false) -> string
  val marks = kindMarked("", landing, quick, urgent, exclusive)
  val whole = kind + marks
  if whole.charCount <= width then return whole
  val room = width - marks.charCount - 1
  if room < 0 then return ("…" + marks).take(if width < 0 then 0 else width)
  kind.take(room) + "…" + marks

// A kind with its marks: the lane's (`*` landing, `^` quick, `#` exclusive; a job is in one), then
// `!` for urgent.
kindMarked(kind: string, landing: bool, quick: bool, urgent: bool, exclusive: bool = false) -> string
  val lane = if landing then "*" elif quick then "^" elif exclusive then "#" else ""
  kind + lane + (if urgent then "!" else "")

// The line `status` prints. The quick lane is named only while a quick job runs, and an exclusive job
// only while it runs. While marshal is polite, the units and memory are shown against the polite
// budget, of the full one (`units 3.25/9 of 12`), and polite mode after them.
usageLine(u: Usage) -> string
  val memory = u.polite match
    Some(p) if u.memoryBudget != long.MaxValue ->
      s"${formatSize(u.memory)}/${formatSize(p.memory)} of ${formatSize(u.memoryBudget)}"
    _ -> if u.memoryBudget == long.MaxValue then formatSize(
      u.memory
    ) else s"${formatSize(u.memory)}/${formatSize(u.memoryBudget)}"
  val units = u.polite match
    Some(p) -> s"${formatUnits(u.units)}/${formatUnits(p.units)} of ${formatUnits(u.unitBudget)}"
    None -> s"${formatUnits(u.units)}/${formatUnits(u.unitBudget)}"
  val polite = u.polite.map(p -> ", " + politeText(p)).getOrElse("")
  val lane = u.landing.map(id -> s"job $id").getOrElse("free")
  val outside = u.takeSlot.map(
    t -> s"; take-slot holds ${formatUnits(t.units)} units, ${t.waiting} waiting" + (
      if t.landing then ", the landing lane" else ""
    )
  ).getOrElse("")
  val held = if u.queueHeld then "; the queue is held: nothing new starts" else ""
  val quick = if u.quick > 0 then s", quick lane ${u.quick}/$QuickSlots" else ""
  val exclusive = u.exclusive.map(id -> s"; exclusive job $id owns the machine: nothing else starts").getOrElse("")
  val settling = if u.settling > 0 then s", ${u.settling} settling" else ""
  s"units $units, memory $memory$polite, ${u.running} running, ${u.queued} queued$settling, landing lane $lane$quick$outside$exclusive$held${machineText(u)}"

// What `status` says of the machine's processors and disk, after the rest: `; cpu 7.4 (jobs 5.1),
// disk 120G free, open files 10240` (the jobs' soft limit on open files), and that nothing new starts while the disk is under `disk_min`. Nothing for what
// was not measured.
machineText(u: Usage) -> string
  val parts = Buffer[string]()
  if u.cpu >= 0 then parts += s"cpu ${formatCores(u.cpu)} (jobs ${formatCores(if u.jobCpu < 0 then 0 else u.jobCpu)})"
  if u.diskFree >= 0 then parts += s"disk ${roundSize(u.diskFree)} free"
  if u.nofile > 0 then parts += s"open files ${u.nofile}"
  val low = if diskLow(
    u.diskFree,
    u.diskMin
  ) then s"; the disk is under disk_min ${formatSize(u.diskMin)}: nothing new starts" else ""
  (if parts.isEmpty then "" else "; " + parts.mkString(", ")) + low
