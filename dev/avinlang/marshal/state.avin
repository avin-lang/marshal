module dev.avinlang.marshal

// What a daemon hands to the program it becomes when it restarts: `<home>/state.json`, written just
// before the daemon replaces itself and read by the new image, which takes its jobs over. Times are
// on the wall clock, in milliseconds since 1970, so they mean the same to both images; a time that
// has not come yet (a queued job's start, a running job's end) is 0.
import dev.avinlang.json
import dev.avinlang.json.Json

// One job as the daemon holds it. `arrived` is its arrival on the wall clock in microseconds, which
// orders it against take-slot's waiters; `pid` and `pgid` are 0 until it starts. `held`,
// `priority` and `urgentAt` (when it joined the urgent band, wall-clock microseconds, 0 outside
// it) are a queued job's, and a state saved without them reads as false, 0 and 0. `pausedMs` is how
// long a running job's earlier pauses lasted and `pausedAt` when its current pause began (wall
// clock, milliseconds; 0 while it is not paused), 0 when absent. `attempt` counts its runs from 1
// (1 when absent), and `retryAt` is when a job waiting to retry queues again (0 otherwise).
// `reserved` is the memory the scheduler counts for it and `reservedLearned` whether learned peaks
// taught it; a state saved without them reads as -1 and false, and the new image learns the
// reservation again. `quietStopped` says a job being stopped (`timedOut`) is stopped for its quiet
// timeout rather than its deadline; false when absent. The quiet timeout itself is the spec's, and
// its clock is not saved: the new image starts every running job's again. `reservedFrom` is where
// the reservation came from (`reservationSource`); "" when absent, and the new image works it out
// from `reserved` and `reservedLearned`, a learned one being its kind's (`kind`, as daemons learned
// before reservations were learned per command). `durationLearned` says
// `expectedMs` was learned from its kind's runs rather than guessed; false when absent, so a drain
// counts such a job by its deadline.
data SavedJob(
    id: long,
    spec: JobSpec,
    state: string,
    submittedAt: long,
    arrived: long,
    startedAt: long,
    endedAt: long,
    deadlineMs: long,
    expectedMs: long,
    log: string,
    pid: long,
    pgid: long,
    outcome: Option[Outcome],
    killed: bool,
    timedOut: bool,
    sample: Option[string],
    rss: long,
    peakRss: long,
    held: bool = false,
    priority: int = 0,
    urgentAt: long = 0,
    pausedMs: long = 0,
    pausedAt: long = 0,
    attempt: int = 1,
    retryAt: long = 0,
    reserved: long = -1,
    reservedLearned: bool = false,
    quietStopped: bool = false,
    reservedFrom: string = "",
    durationLearned: bool = false
)

// The whole daemon: the version and process that saved it, when, when the daemon first began, the
// next job id, the queue in order, the running jobs, the jobs that ended last (oldest first), the
// name of its waiting ticket in take-slot's directory, whether the queue is held (false when the
// state does not say), and the jobs waiting for others or waiting to retry, oldest first.
data SavedState(
    version: string,
    pid: long,
    savedAt: long,
    beganAt: long,
    nextId: long,
    queue: Vector[SavedJob],
    running: Vector[SavedJob],
    ended: Vector[SavedJob],
    ticket: Option[string],
    queueHeld: bool = false,
    waiting: Vector[SavedJob] = []
)

private orNull[T](o: Option[T], f: (T) -> Json) -> Json = o.map(f).getOrElse(Json.Null)

encodeSavedJob(j: SavedJob) -> Json = Json.obj(
  ("id", Json.num(j.id)),
  ("spec", encodeSpec(j.spec)),
  ("state", Json.str(j.state)),
  ("submitted_at", Json.num(j.submittedAt)),
  ("arrived", Json.num(j.arrived)),
  ("started_at", Json.num(j.startedAt)),
  ("ended_at", Json.num(j.endedAt)),
  ("deadline_ms", Json.num(j.deadlineMs)),
  ("expected_ms", Json.num(j.expectedMs)),
  ("log", Json.str(j.log)),
  ("pid", Json.num(j.pid)),
  ("pgid", Json.num(j.pgid)),
  ("outcome", orNull(j.outcome, encodeOutcome)),
  ("killed", Json.Bool(j.killed)),
  ("timed_out", Json.Bool(j.timedOut)),
  ("sample", orNull(j.sample, s -> Json.str(s))),
  ("rss", Json.num(j.rss)),
  ("peak_rss", Json.num(j.peakRss)),
  ("held", Json.Bool(j.held)),
  ("priority", Json.num(j.priority)),
  ("urgent_at", Json.num(j.urgentAt)),
  ("paused_ms", Json.num(j.pausedMs)),
  ("paused_at", Json.num(j.pausedAt)),
  ("attempt", Json.num(j.attempt)),
  ("retry_at", Json.num(j.retryAt)),
  ("reserved", Json.num(j.reserved)),
  ("reserved_learned", Json.Bool(j.reservedLearned)),
  ("quiet_stopped", Json.Bool(j.quietStopped)),
  ("reserved_from", Json.str(j.reservedFrom)),
  ("duration_learned", Json.Bool(j.durationLearned))
)

private whole(j: Json, key: string) -> Result[long, string] = j.get(key).flatMap(v -> v.asLong) match
  Some(n) -> Ok(n)
  None -> Err(s"`$key` is not a whole number")

// A whole number that state written before it was recorded does not have: 0.
private wholeOrZero(j: Json, key: string) -> Result[long, string] = j.get(key) match
  None | Some(Json.Null) -> Ok(0)
  Some(_) -> whole(j, key)

// A whole number that state written before it was recorded does not have: `absent`.
private wholeOr(j: Json, key: string, absent: long) -> Result[long, string] = j.get(key) match
  None | Some(Json.Null) -> Ok(absent)
  Some(_) -> whole(j, key)

private text(j: Json, key: string) -> Result[string, string] = j.get(key).flatMap(v -> v.asString) match
  Some(s) -> Ok(s)
  None -> Err(s"`$key` is not a string")

private truth(j: Json, key: string) -> Result[bool, string] = j.get(key).flatMap(v -> v.asBool) match
  Some(b) -> Ok(b)
  None -> Err(s"`$key` is not a bool")

// A field a state saved before it existed lacks: absent or null reads as `absent`.
private truthOr(j: Json, key: string, absent: bool) -> Result[bool, string] = j.get(key) match
  None | Some(Json.Null) -> Ok(absent)
  Some(_) -> truth(j, key)

private intOr(j: Json, key: string, absent: int) -> Result[int, string] = j.get(key) match
  None | Some(Json.Null) -> Ok(absent)
  Some(v) -> v.asInt match
    Some(n) -> Ok(n)
    None -> Err(s"`$key` is not an int")

private maybeText(j: Json, key: string) -> Result[Option[string], string] = j.get(key) match
  None | Some(Json.Null) -> Ok(None)
  Some(v) -> v.asString match
    Some(s) -> Ok(Some(s))
    None -> Err(s"`$key` is not a string")

decodeSavedJob(j: Json) -> Result[SavedJob, string]
  val id = whole(j, "id")?
  val spec = decodeSpec(j.get("spec").getOrElse(Json.Null)).mapErr(e -> s"job $id: $e")?
  val outcome = j.get("outcome") match
    None | Some(Json.Null) -> None
    Some(o) -> Some(decodeOutcome(o).mapErr(e -> s"job $id: $e")?)
  Ok(
    SavedJob(
      id,
      spec,
      text(j, "state")?,
      whole(j, "submitted_at")?,
      whole(j, "arrived")?,
      whole(j, "started_at")?,
      whole(j, "ended_at")?,
      whole(j, "deadline_ms")?,
      whole(j, "expected_ms")?,
      text(j, "log")?,
      whole(j, "pid")?,
      whole(j, "pgid")?,
      outcome,
      truth(j, "killed")?,
      truth(j, "timed_out")?,
      maybeText(j, "sample")?,
      wholeOrZero(j, "rss")?,
      wholeOrZero(j, "peak_rss")?,
      truthOr(j, "held", false)?,
      intOr(j, "priority", 0)?,
      wholeOrZero(j, "urgent_at")?,
      wholeOrZero(j, "paused_ms")?,
      wholeOrZero(j, "paused_at")?,
      intOr(j, "attempt", 1)?,
      wholeOrZero(j, "retry_at")?,
      wholeOr(j, "reserved", -1)?,
      truthOr(j, "reserved_learned", false)?,
      truthOr(j, "quiet_stopped", false)?,
      maybeText(j, "reserved_from")?.getOrElse(""),
      truthOr(j, "duration_learned", false)?
    )
  )

encodeState(s: SavedState) -> Json = Json.obj(
  ("version", Json.str(s.version)),
  ("pid", Json.num(s.pid)),
  ("saved_at", Json.num(s.savedAt)),
  ("began_at", Json.num(s.beganAt)),
  ("next_id", Json.num(s.nextId)),
  ("queue", Json.Arr(s.queue.map(encodeSavedJob))),
  ("running", Json.Arr(s.running.map(encodeSavedJob))),
  ("ended", Json.Arr(s.ended.map(encodeSavedJob))),
  ("ticket", orNull(s.ticket, t -> Json.str(t))),
  ("queue_held", Json.Bool(s.queueHeld)),
  ("waiting", Json.Arr(s.waiting.map(encodeSavedJob)))
)

private savedJobs(j: Json, key: string) -> Result[Vector[SavedJob], string]
  val items = j.get(key).flatMap(v -> v.asVector) match
    Some(xs) -> xs
    None -> return Err(s"`$key` is not an array")
  val out = Buffer[SavedJob]()
  for item in items do out += decodeSavedJob(item)?
  Ok(out.toVector)

// The state in `saved`, or why it cannot be read.
decodeState(saved: string) -> Result[SavedState, string]
  val j = json.parse(saved) match
    Ok(v) -> v
    Err(e) -> return Err(s"not JSON: $e")
  if j.asMembers.isEmpty then return Err("the state is not a JSON object")
  Ok(
    SavedState(
      text(j, "version")?,
      whole(j, "pid")?,
      whole(j, "saved_at")?,
      whole(j, "began_at")?,
      whole(j, "next_id")?,
      savedJobs(j, "queue")?,
      savedJobs(j, "running")?,
      savedJobs(j, "ended")?,
      maybeText(j, "ticket")?,
      truthOr(j, "queue_held", false)?,
      if j.has("waiting") then savedJobs(j, "waiting")? else Vector[SavedJob]()
    )
  )
