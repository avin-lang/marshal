module dev.avinlang.marshal

// What the command line and the daemon say to each other: one JSON object per line each way, a
// request and then its reply. docs/protocol.md describes the text.
import dev.avinlang.json
import dev.avinlang.json.Json

// marshal's version, as `avin.hocon` gives it: what `marshal version` and `marshal restart` print.
val Version: string = "0.4.8"

// What a job is to run and how much of the machine it takes. `urgent` queues it in its lane's urgent
// band, behind the urgent jobs already queued and ahead of every other. `after` names the jobs it
// waits for: it queues once they have all ended, and with `afterAny` false only if each of them
// succeeded. `retries` is how many times more it runs after failing or timing out, `retryDelayMs`
// after how long. `memoryGiven` says the memory was given (`--mem`), so `--mem 0` opts out of the
// reservation learned from the kind's peaks; a memory above 0 counts as given either way. `label`
// is free text the submitter gave the job to find it by ("" for none; see `checkLabel`). `quietMs`
// stops a running job whose log has had no new output for that long (0 for none; see quiet.avin).
// `external` says the job's work runs outside its own process tree (a container, a VM, another
// account's daemon), so what its tree holds is not what it uses: it reserves the memory it gave,
// which it must give, and its measured peak is never learned from.
// `quick` runs it in the quick lane: at once, outside the unit budget, within `QuickCapMs`.
// `exclusive` makes it own the machine: it starts when no other job runs and nothing else starts
// while it runs (exclusive.avin); `quietLoad`, above 0, also waits for the one-minute load average
// to stay below it for a minute first (0 for none). `units` is in quarters (cores.avin), and
// `unitsGiven` says the submitter gave them (`--units`, or a job type's file): units not given are
// the default for the kind until runs of the same command teach better (`learnedUnits`). What
// marshal wrote before it learned units does not say, and reads as given. Units given are a
// ceiling: a command whose runs teach fewer weighs those (`sizeFor`), and `unitsAsked` keeps what
// was given, in quarters, while the job weighs less (0 while it weighs what it gave); `unitsExact`
// (`--units-exact`) keeps the given units as they are. `owner` is who submitted
// it as `--owner` named them, "" where it was not named and is derived from the directory and the
// label (`ownerOf`). `low` queues it behind every job not low and starts it only in spare room
// (low.avin). A given memory is a ceiling as given units are (memory.avin's `memoryCeiling`) unless
// `memExact` (`--mem-exact`) keeps it as it is.
data JobSpec(
    kind: string,
    units: int,
    memory: long,
    landing: bool,
    dir: string,
    deadlineMs: Option[long],
    cmd: Vector[string],
    env: Vector[(string, string)],
    urgent: bool = false,
    after: Vector[long] = [],
    afterAny: bool = false,
    retries: int = 0,
    retryDelayMs: long = 0,
    memoryGiven: bool = false,
    label: string = "",
    quietMs: long = 0,
    external: bool = false,
    quick: bool = false,
    exclusive: bool = false,
    quietLoad: real = 0.0,
    unitsGiven: bool = true,
    owner: string = "",
    unitsExact: bool = false,
    unitsAsked: int = 0,
    low: bool = false,
    memExact: bool = false
)

// The units `s` was given, in quarters: those it asked for when it weighs fewer, else its own.
askedUnits(s: JobSpec) -> int = if s.unitsAsked > 0 then s.unitsAsked else s.units

// `s` weighing `units` quarters instead of its own, with what it asked for kept.
withUnits(s: JobSpec, units: int) -> JobSpec = withSizing(s, units, s.unitsAsked)

// `s` weighing `units` quarters, having asked for `asked` (0 where it weighs what it asked for).
withSizing(s: JobSpec, units: int, asked: int) -> JobSpec =
  JobSpec(
    s.kind,
    units,
    s.memory,
    s.landing,
    s.dir,
    s.deadlineMs,
    s.cmd,
    s.env,
    s.urgent,
    s.after,
    s.afterAny,
    s.retries,
    s.retryDelayMs,
    s.memoryGiven,
    s.label,
    s.quietMs,
    s.external,
    s.quick,
    s.exclusive,
    s.quietLoad,
    s.unitsGiven,
    s.owner,
    s.unitsExact,
    asked,
    s.low,
    s.memExact
  )

// The longest label, in characters.
val MaxLabel: int = 80

// A label as a job may carry it: `text` itself when it is one, or why it is not. A label is one line
// of 1 to `MaxLabel` characters with no control characters (a newline, a tab) and no space at either
// end; a longer one is refused, not cut.
checkLabel(text: string) -> Result[string, string]
  if text.isEmpty then return Err("a label is text, not empty")
  if text.chars.exists(c -> c < ' ' || '\u{7f}' <= c <= '\u{9f}') then return Err(
    "a label is one line of printable text: no newline, tab or other control character"
  )
  if text.trim != text then return Err("a label does not begin or end with a space")
  if text.charCount > MaxLabel then return Err(s"a label is at most $MaxLabel characters, not ${text.charCount}")
  Ok(text)

data Request
  Submit(spec: JobSpec)
  Wait(id: long)
  Kill(id: long)
  // Stops or cancels every job a selector names, in one step (`KillSelector`).
  KillMany(selector: KillSelector)
  List
  Status
  // One job as it is now, whatever its state: running, queued, waiting, or ended, from the daemon's
  // memory or, for a job it no longer holds, the event log (`Found`).
  Lookup(id: long)
  // Everything a live view shows: the budget, the running, queued and recent jobs, and why each
  // queued job waits.
  Snapshot
  Stop(force: bool, drain: bool)
  // Which marshal the daemon is and its process.
  Hello
  // The daemon replaces itself with a program, keeping its jobs: the one the command line was run
  // from when it sends its path, else the one at the daemon's own path.
  Restart(program: Option[string])
  // Submits again a job that has ended, as it was submitted.
  Rerun(id: long)
  // Holds the queue, both lanes: running jobs go on and nothing new starts.
  PauseQueue
  // Releases the queue PauseQueue held.
  ResumeQueue
  // Stops a running job's whole process group, keeping its units and stopping its deadline's
  // clock, and continues it.
  PauseJob(id: long)
  ResumeJob(id: long)
  // Makes marshal polite at `fraction` of its budget (polite.avin), or not polite with None, until
  // the user says otherwise; answered with the budget then in use.
  Polite(fraction: Option[real])
  // Reserves marshal for `owner` for `forMs` (control.avin's `OwnerReserve`), replacing any
  // reservation, or ends the reservation; both answered with the budget then in use.
  Reserve(owner: string, forMs: long)
  Unreserve
  // Keeps one queued job from starting, and lets it start again.
  Hold(id: long)
  Release(id: long)
  // Holds (`on`) or releases every job a selector names, in one step (holdmany.avin); a hold puts
  // them in a group.
  HoldMany(selector: HoldSelector, on: bool)
  // Places a queued job: by a priority number among the jobs not urgent, at the back of its
  // lane's urgent band, in the low band, or one place up or down in its band.
  Prioritize(id: long, priority: Priority)
  // Changes the settings of a job that has not ended, in place (`Amendment`).
  Amend(id: long, amendment: Amendment)
  // Removes the files of ended jobs, stale run directories and unused compiled steps (see clean.avin).
  Clean(rule: CleanRule)
  // Follows events: `source` is the condition as written, `cond` what it parses to. The daemon
  // streams replies until the watch ends, which `mode` says; `since` and `sinceId` ask for the
  // events already in the log from a time (milliseconds since 1970, inclusive) and from a job.
  Watch(source: string, cond: Condition, mode: Mode, since: Option[long], sinceId: Option[long])

// The priority a queued job is given: a number (higher first, equal ones in arrival order, all
// behind the urgent band), the back of the urgent band, or the low band behind every other job
// (`LowBand`, low.avin). A number or `Urgent` takes a job out of the low band. `OneUp` and `OneDown`
// move it one place among the queued jobs of its own lane and band, which it never leaves
// (control.avin's `moveOne`).
data Priority
  Level(n: int)
  Urgent
  LowBand
  OneUp
  OneDown

// What `amend` changes; None leaves a setting as it is. `deadlineMs` is a deadline measured from the
// job's start, or, with `extend`, what is added to the deadline it has. `units` is in quarters and
// `memory` in bytes, both as `submit` gives them. `after` replaces the jobs it waits for, `afterAny`
// saying how (as `JobSpec`'s).
data Amendment(
    deadlineMs: Option[long] = None,
    extend: bool = false,
    units: Option[int] = None,
    memory: Option[long] = None,
    label: Option[string] = None,
    retries: Option[int] = None,
    quietMs: Option[long] = None,
    after: Option[Vector[long]] = None,
    afterAny: bool = false
)

// Whether an amendment changes nothing.
emptyAmendment(a: Amendment) -> bool =
  a.deadlineMs.isEmpty && a.units.isEmpty && a.memory.isEmpty && a.label.isEmpty && a.retries.isEmpty && a.quietMs.isEmpty && a.after.isEmpty

// Whether an amendment changes what only a job that has not started may change: what it was
// admitted on (its units and memory), and what it waits for.
startsOnly(a: Amendment) -> bool = a.units.isDefined || a.memory.isDefined || a.after.isDefined

// Which jobs `kill` stops at once: those whose owner is `owner` and whose label contains `label`
// (case ignored), only the queued (`queued`: queued, held, waiting
// or waiting to retry) or only the running (`running`: running or paused), neither meaning both;
// or, with `all`, every job. A landing job is left alone unless `includeLanding`. With `dryRun` the
// daemon only says which jobs it would stop (killmany.avin).
data KillSelector(
    owner: Option[string] = None,
    label: Option[string] = None,
    queued: bool = false,
    running: bool = false,
    all: bool = false,
    includeLanding: bool = false,
    dryRun: bool = false
)

// A job a `KillMany` stopped (`how` `killed`: it was running; `cancelled`: it had not started), or
// with `dryRun` would stop (`would kill`, `would cancel`).
data StoppedJob(id: long, how: string, label: string = "", landing: bool = false, exclusive: bool = false)

// How a job ended. `DependencyFailed` cancels a job waiting for job `after`, which did not succeed.
// `Quiet` is a job stopped because its log had no new output for `afterMs` (its quiet timeout).
data Outcome
  Exited(code: int)
  Signalled(signal: int)
  TimedOut
  Cancelled
  Lost
  DependencyFailed(after: long)
  Quiet(afterMs: long)

// The exit status `wait` and `run` end with: the job's own code, 128 + the signal that ended it,
// 124 for a timeout (its deadline or its quiet timeout), 143 for a job cancelled before it started
// (as a TERM would), 125 for a job lost with a daemon that died and 126 for a job cancelled because a
// job it waited for failed.
exitCode(o: Outcome) -> int
exitCode(Exited(code)) = code
exitCode(Signalled(sig)) = 128 + sig
exitCode(TimedOut) = 124
exitCode(Quiet(_)) = 124
exitCode(Cancelled) = 143
exitCode(Lost) = 125
exitCode(DependencyFailed(_)) = 126

// Whether a job that ended so succeeded, as a job waiting for it with `--after-ok` asks.
succeeded(o: Outcome) -> bool = o == Exited(0)

// Whether a job that ended so failed in a way another attempt may mend: a nonzero exit, a signal it
// was not sent by `kill`, its deadline, or its quiet timeout.
retryable(o: Outcome, killed: bool) -> bool
retryable(_, true) = false
retryable(Exited(code), _) = code != 0
retryable(Signalled(_) | TimedOut | Quiet(_), _) = true
retryable(_, _) = false

// One job as a listing shows it. `state` is `waiting` (for the jobs it runs after), `queued`,
// `running`, `retrying` (waiting out its retry delay) or `done`; `elapsedMs` is the time run, 0 for a
// waiting, queued or retrying job (`queuedMs` is how long it has waited). `memory` is the memory it declared;
// `rss` the physical footprint in bytes its whole process tree held when the daemon last measured it, 0 unless it
// runs; `peakRss` the most any measurement found, kept once it has ended; `startedAt` when it
// started on the wall clock, in milliseconds since 1970, 0 while it waits. `held` says a waiting or
// queued job is kept from starting by hand; `priority` places it in its lane's queue, and `urgent`
// puts it in the lane's urgent band, ahead of every job not urgent whatever its priority. `paused`
// says a running job's processes are stopped by `pause`; its `elapsedMs` leaves its pauses out.
// `after` is what a waiting job still waits for, the jobs that have not ended yet; `attempt` counts
// its runs from 1. `reserved` is the memory the scheduler counts for it, its effective reservation:
// the memory it declared, or, with `reservedLearned`, what the peaks of the same command taught
// (memory.avin).
// `label` is the text its submitter gave it, "" for none; `quietMs` its quiet timeout, 0 for none.
// `reservedFrom` says where the reservation came from (`reservationSource`: `given`, `cmd+dir`,
// `cmd`, `norm+project`, `kind+project` or `none`; `kind+dir` and `kind` from daemons that learned
// per kind), "" from a daemon that
// does not say.
// `external` says its work runs outside its process tree (`JobSpec`); `quick` says it is in the
// quick lane. `expectedMs` is how long it is expected to run (0 where not said), `durationLearned`
// whether that is learned from its kind's runs rather than guessed from the default deadline, and
// `expectedStart`, on the job the machine drains for, when it is expected to start (wall-clock
// milliseconds; 0 for any other job, or when that is not known). `exclusive` and `quietLoad` are its
// spec's. `units` is in quarters, and `unitsLearned` says they were learned from the cores earlier
// runs of its command used. `cores` is how many cores a running job keeps busy, as last measured, and
// `peakCores` the most it has, both in hundredths and -1 where it has not been measured; `cpuMs` is
// the processor time measured, in milliseconds (cores.avin). `owner` is who submitted it: the owner
// it named, or the one derived from its directory or label (`ownerOf`), "" where there is none.
// `durationFrom` says where `expectedMs` came from (`durationSource`: `cmd+dir`, `cmd`, `kind` or
// `none`), "" from a daemon that does not say; only a duration learned from its command's own runs,
// or guessed from its kind's in its project, gives it an ETA (eta.avin). `etaMs` is a running job's
// expected time left as the daemon reckoned it when it answered (`timeLeft`), -1 where it has none
// or did not say; `etaLate` says the job is past what that counted down from, and `etaGuess` that it
// counted down from a guess. `waitsOn` is the running job whose end is expected to let a queued job
// that waits for units or memory (or drains) start, 0 where none is said. `startsInMs` is how long a queued job is expected to wait before it
// starts, as the daemon reckoned it when it answered; -1 where that is not known. `heldCores` is
// the level the job held (`CpuMeter.held`), in hundredths, -1 where it has not been measured or
// the daemon did not say: what its command's units are learned from. `unitsAsked` is the units a
// job gave, in quarters, where it weighs the fewer its command's runs teach (`sizeFor`); 0 otherwise.
// `settlingMs` is how long an exclusive job in the state `settling` has waited for the load alone
// (the machine its own, nothing of marshal's running), which is not run time: it counts toward no
// deadline, duration or ETA; 0 otherwise. `loadOverdue` says that wait has passed config.json's
// `load_wait`: the job still waits, and `top` draws its row in red. `unitsFrom` says where its units
// came from (`unitsSource`: `given`, `default`, `exclusive`, `quick`, `live`, or the key they were
// learned from, learning.avin's `cmd+dir`, `cmd`, `norm+project` or `kind+project`), and
// `deadlineFrom` where its deadline did (`LearnedDeadline.from`, or `given`), "" from a daemon that
// does not say. `project` is the project its directory is in (learning.avin's `projectOf`), which
// its runs are learned under. `retries` is how many times more it runs after failing (`JobSpec`),
// and `amended` says `amend` changed its settings after it was submitted (a `deadlineFrom` of
// `amended` says its deadline was among them). `low` says it is in the low band (low.avin).
// `waitText` is why a queued job waits, in full (`needText`: what it needs and what is free, the job
// it waits for and when), "" for any other. `labelFrom` is `cmd` where `label` was derived from the
// command because none was given (memory.avin's `derivedLabel`), "" for a given label or none.
// `heldGroup` is the group a filtered hold put a held job in (holdmany.avin), "" for none, and
// `heldMs` how long a job not running yet has been held since it last began to wait, its current hold
// included: time not counted in `queuedMs`.
data JobInfo(
    id: long,
    kind: string,
    units: int,
    memory: long,
    landing: bool,
    dir: string,
    cmd: Vector[string],
    state: string,
    outcome: Option[Outcome],
    killed: bool,
    queuedMs: long,
    elapsedMs: long,
    deadlineMs: long,
    log: string,
    sample: Option[string],
    rss: long = 0,
    peakRss: long = 0,
    startedAt: long = 0,
    held: bool = false,
    priority: int = 0,
    urgent: bool = false,
    paused: bool = false,
    after: Vector[long] = [],
    attempt: int = 1,
    reserved: long = 0,
    reservedLearned: bool = false,
    label: string = "",
    quietMs: long = 0,
    reservedFrom: string = "",
    external: bool = false,
    quick: bool = false,
    expectedMs: long = 0,
    durationLearned: bool = false,
    expectedStart: long = 0,
    exclusive: bool = false,
    quietLoad: real = 0.0,
    unitsLearned: bool = false,
    cores: long = -1,
    peakCores: long = -1,
    cpuMs: long = 0,
    owner: string = "",
    durationFrom: string = "",
    startsInMs: long = -1,
    heldCores: long = -1,
    unitsAsked: int = 0,
    settlingMs: long = 0,
    loadOverdue: bool = false,
    unitsFrom: string = "",
    deadlineFrom: string = "",
    project: string = "",
    retries: int = 0,
    amended: bool = false,
    low: bool = false,
    waitText: string = "",
    labelFrom: string = "",
    heldGroup: string = "",
    heldMs: long = 0,
    etaMs: long = -1,
    etaLate: bool = false,
    etaGuess: bool = false,
    waitsOn: long = 0
)

// Whether a job is settling: an exclusive job with the machine to itself that waits only for the
// load outside marshal to fall below its `--quiet-load`.
settling(j: JobInfo) -> bool = j.outcome.isEmpty && j.state == "settling"

// The units a listing shows for a job: `~` before units learned from earlier runs' cores, and,
// where the job weighs fewer than it gave, what it gave and an arrow before them (`8→~1.5`) when
// that fits in `width` characters.
unitsText(j: JobInfo, width: int = 1000) -> string
  val units = (if j.unitsLearned then "~" else "") + formatUnits(j.units)
  if j.unitsAsked <= 0 then return units
  val both = formatUnits(j.unitsAsked) + "→" + units
  if both.charCount <= width then both else units

// The cores a listing shows a job using: a running job's latest measurement, an ended job's peak;
// `-` where it has not been measured, and for a job that has not run.
usedText(j: JobInfo) -> string =
  if j.state == "running" then formatCores(j.cores) elif j.state == "done" then formatCores(j.peakCores) else "-"

// The memory a listing shows for a job: its reservation, `~` before one learned from its kind's
// peaks, `@` before that of a job whose work runs elsewhere (`--external`); `-` for none. A job that
// says no reservation shows the memory it declared. A job whose given memory is held to its
// command's learned peak (memory.avin's `memoryCeiling`) shows what it gave and an arrow before it
// (`20G→~7.5G`), as UNITS shows a ceiling.
reservedText(j: JobInfo) -> string
  if j.reservedLearned && j.reserved > 0 && j.memory > j.reserved then return formatSize(j.memory) + "→~" + roundSize(
    j.reserved
  )
  if j.reservedLearned && j.reserved > 0 then return "~" + roundSize(j.reserved)
  val r = if j.reserved > j.memory then j.reserved else j.memory
  if j.external then return "@" + formatSize(r)
  if r == 0 then "-" else formatSize(r)

// The budget in use. `memory` is what the running jobs reserve (declared or learned); `rss` what
// their process trees hold (physical footprint), as last measured; `held` what admission counts them as holding,
// each job's reservation or its measured memory, whichever is more; `machineMemory` the memory the
// machine has, 0 where it is not known; `queueHeld` says the queue is held: nothing new starts in
// either lane; `quick` is how many quick jobs run, of the quick lane's `QuickSlots`; `exclusive` the
// exclusive job that runs, owning the machine, if one does. `units` and `unitBudget` are in quarters.
// `cpu` is the cores every process on the machine kept busy over the last measurement, and `jobCpu`
// those of the running jobs among them, both in hundredths and -1 where not measured. `diskFree` is
// the free space of the fullest volume holding marshal's home or a job's directory, -1 where not
// known; `diskMin` the least `disk_min` lets new jobs start beside (0: no guard; disk.avin).
// `nofile` is the soft limit on open files every job inherits from the daemon, 0 where not known
// (nofile.avin). `settling` is how many exclusive jobs are settling (`settling`): counted neither as
// running nor in `queued`. `polite` is the polite budget jobs are admitted against while marshal is
// polite (polite.avin), None while it is not; `unitBudget` and `memoryBudget` stay the full ones.
// `pressure` is the memory-pressure guard as last read (pressure.avin). `reserve` is the reservation
// that stands (control.avin's `OwnerReserve`), None while marshal is not reserved.
data Usage(
    units: int,
    unitBudget: int,
    memory: long,
    memoryBudget: long,
    running: int,
    queued: int,
    landing: Option[long],
    takeSlot: Option[TakeSlotUse],
    rss: long = 0,
    machineMemory: long = 0,
    queueHeld: bool = false,
    held: long = 0,
    quick: int = 0,
    exclusive: Option[long] = None,
    cpu: long = -1,
    jobCpu: long = -1,
    diskFree: long = -1,
    diskMin: long = 0,
    nofile: long = 0,
    settling: int = 0,
    polite: Option[PoliteUse] = None,
    pressure: Pressure = NoPressure,
    reserve: Option[ReserveUse] = None
)

// A reservation as `status` and `top` show it: its owner, when it ends (wall-clock milliseconds
// since 1970) and how long it has left as the daemon answered, in milliseconds.
data ReserveUse(owner: string, until: long, leftMs: long)

// A reservation as the protocol writes it: `{owner, until, left_ms}`, or null while there is none.
reserveJson(r: Option[ReserveUse]) -> Json = r match
  None -> Json.Null
  Some(u) -> Json.obj(("owner", Json.str(u.owner)), ("until", Json.num(u.until)), ("left_ms", Json.num(u.leftMs)))

// The reservation as the protocol wrote it under `reserve` in `j`: None where it is null or absent.
private decodeReserve(j: Json) -> Result[Option[ReserveUse], string]
  val r = j.get("reserve").getOrElse(Json.Null)
  if r == Json.Null then return Ok(None)
  Ok(
    Some(
      ReserveUse(
        field(r, "owner", v -> v.asString, "a string")?,
        field(r, "until", v -> v.asLong, "a whole number")?,
        field(r, "left_ms", v -> v.asLong, "a whole number")?
      )
    )
  )

// The members `status`, `status --json` and the snapshot add for the machine's processors, disk and
// memory: `cpu` and `job_cpu` in cores, `disk_free` and `disk_min` in bytes and `disk_low`, the jobs'
// limit on open files `nofile`, and the memory-pressure guard: `mem_pressure` (the kernel's level,
// `normal`, `warn`, `critical` or `unknown`), `swap_used` and `swap_growth` in bytes, and
// `mem_pressure_holds` with, while it holds, `mem_pressure_cause`; a value not measured is left out.
private machineMembers(u: Usage) -> Vector[(string, Json)]
  val out = Buffer[(string, Json)]()
  if u.cpu >= 0 then out += ("cpu", coresJson(u.cpu))
  if u.jobCpu >= 0 then out += ("job_cpu", coresJson(u.jobCpu))
  if u.diskFree >= 0 then out += ("disk_free", Json.num(u.diskFree))
  out += ("disk_min", Json.num(u.diskMin))
  out += ("disk_low", Json.Bool(diskLow(u.diskFree, u.diskMin)))
  if u.nofile > 0 then out += ("nofile", Json.num(u.nofile))
  out += ("mem_pressure", Json.str(pressureLevelName(u.pressure.level)))
  if u.pressure.swapUsed >= 0 then out += ("swap_used", Json.num(u.pressure.swapUsed))
  out += ("swap_growth", Json.num(u.pressure.swapGrowth))
  out += ("mem_pressure_holds", Json.Bool(u.pressure.cause.nonEmpty))
  if u.pressure.cause.nonEmpty then out += ("mem_pressure_cause", Json.str(u.pressure.cause))
  out.toVector

// The values `machineMembers` writes, read back.
private machineOf(j: Json) -> Result[(long, long, long, long, long, Pressure), string] =
  Ok(
    (
      optional(j, "cpu", centiOf, "a number of cores", long(-1))?,
      optional(j, "job_cpu", centiOf, "a number of cores", long(-1))?,
      optional(j, "disk_free", wholeNumber, "a whole number", long(-1))?,
      optional(j, "disk_min", wholeNumber, "a whole number", long(0))?,
      optional(j, "nofile", wholeNumber, "a whole number", long(0))?,
      Pressure(
        pressureLevelOf(optional(j, "mem_pressure", v -> v.asString, "a string", "unknown")?),
        optional(j, "swap_used", wholeNumber, "a whole number", long(-1))?,
        optional(j, "swap_growth", wholeNumber, "a whole number", long(0))?,
        optional(j, "mem_pressure_cause", v -> v.asString, "a string", "")?
      )
    )
  )

// `u` with the machine's processors, disk, limit on open files and memory as `m` gives them.
private withMachine(u: Usage, m: (long, long, long, long, long, Pressure)) -> Usage =
  Usage(
    u.units,
    u.unitBudget,
    u.memory,
    u.memoryBudget,
    u.running,
    u.queued,
    u.landing,
    u.takeSlot,
    u.rss,
    u.machineMemory,
    u.queueHeld,
    u.held,
    u.quick,
    u.exclusive,
    m.0,
    m.1,
    m.2,
    m.3,
    m.4,
    u.settling,
    u.polite,
    m.5,
    u.reserve
  )

// What take-slot.zsh holds in the directory `dir` that marshal shares: units its runs hold, how many
// of its runs wait, and whether one of them holds the landing lane. `units` is in quarters.
data TakeSlotUse(dir: string, units: int, waiting: int, landing: bool)

// Why a queued job has not started: its units do not fit beside what runs, its memory does not, it
// is a landing job and the lane is held, it is a landing job whose memory does not fit and it waits
// for running jobs to free it while nothing else starts, it waits for what take-slot holds or for a
// take-slot run ahead of it, it fits but starting it would delay job `id` at the head of the queue
// (or a landing job `id` drains the machine), or it starts at the daemon's next look; or it is held,
// or the whole queue is; or it is a quick job and the quick lane's slots are all taken; or the
// development job `id` has waited past the bound and the machine drains for it (`DrainingFor`).
// The job the machine drains for waits `Draining` too. An exclusive job waits `Emptying` while other
// jobs run or start, and `Load` while the load average has not stayed below its `--quiet-load`
// (`load` the last read, `limit` its quiet load, `calmMs` how long it has been below); every job
// queued behind it, and every job while one runs, waits `ForExclusive(id)`. While the disk has less
// free than `disk_min`, every queued job not held by hand waits `DiskLow(free)`, `free` the bytes
// free when it was last measured (disk.avin); while it does not but the machine is short of memory,
// `MemoryPressure(cause)`, `cause` `warn`, `critical` or `swapping` (pressure.avin). While marshal is polite (polite.avin), a job that would
// fit beside what runs in the full budget but not in the polite one waits `PoliteBudget`; one bigger
// than the polite budget waits `RunsAlone` until nothing else of marshal's runs, and every job held
// back by it, waiting or running alone, waits `ForAlone(id)`. A low job (low.avin) that cannot start
// in spare room waits `LowWaits`. While marshal is reserved for an owner (control.avin's
// `OwnerReserve`), a job of any other owner, not quick, waits `Reserved(owner)`.
data Why
  NoUnits
  NoMemory
  LaneBusy
  Draining
  ForTakeSlot
  Behind(id: long)
  DrainingFor(id: long)
  Starting
  Held
  QueueHeld
  QuickFull
  Emptying
  Load(load: real, limit: real, calmMs: long)
  ForExclusive(id: long)
  DiskLow(free: long)
  MemoryPressure(cause: string)
  PoliteBudget
  RunsAlone
  ForAlone(id: long)
  LowWaits
  Reserved(owner: string)

// A queued job, its place in its lane's queue (from 1; landing jobs, quick jobs and development jobs
// each have a queue), and why it waits.
data QueuedJob(job: JobInfo, position: int, why: Why)

// What `marshal top` draws: the budget in use, how long the daemon has run, the running jobs, the
// queued ones, the jobs that ended last, the latest first, and the jobs waiting for others or
// waiting to retry, oldest first.
data Overview(
    usage: Usage,
    uptimeMs: long,
    running: Vector[JobInfo],
    queued: Vector[QueuedJob],
    recent: Vector[JobInfo],
    waiting: Vector[JobInfo] = []
)

data Reply
  // `hint` is advice for the submitter ("" for none): see `quickHint`.
  Submitted(id: long, log: string, hint: string = "")
  Ended(job: JobInfo)
  // What `Lookup` answers: the job as it is now, and why it waits when it is queued.
  Found(job: JobInfo, why: Option[Why] = None)
  Jobs(jobs: Vector[JobInfo])
  Using(usage: Usage)
  Viewed(overview: Overview)
  // The daemon's version and process id.
  Hi(version: string, pid: long)
  // One event of a watch, as the log holds it, or the events of its backlog together.
  Streamed(event: Json)
  Replayed(events: Vector[Json])
  // What a clean removed.
  Cleaned(report: CleanReport)
  // What an amend changed, one `name old → new` line a setting, and advice for the amender as
  // `Submitted` gives it.
  Amended(changes: string, hint: string = "")
  // The jobs a `KillMany` stopped, by id, and how many matching landing jobs it left alone.
  KilledJobs(jobs: Vector[StoppedJob], skippedLanding: int = 0)
  // The jobs a `HoldMany` held or released, by id, the group a hold put them in ("" for a release),
  // and how many matching landing jobs it left alone.
  HeldJobs(ids: Vector[long], group: string = "", skippedLanding: int = 0)
  Done
  Failed(message: string)
  // A request about a job that has ended, which only a job that has not may be asked: refused, as
  // `Failed` refuses, but the command line exits 1 rather than 2.
  Over(message: string)

// Requests.

private strings(xs: Vector[string]) -> Json = Json.Arr(xs.map(x -> Json.str(x)))

encodeRequest(r: Request) -> Json
encodeRequest(Submit(s)) = Json.Obj([("op", Json.str("submit"))] ++ encodeSpec(s).asMembers.get)
encodeRequest(Wait(id)) = Json.obj(("op", Json.str("wait")), ("id", Json.num(id)))
encodeRequest(Kill(id)) = Json.obj(("op", Json.str("kill")), ("id", Json.num(id)))
encodeRequest(List) = Json.obj(("op", Json.str("ls")))
encodeRequest(Status) = Json.obj(("op", Json.str("status")))
encodeRequest(Lookup(id)) = Json.obj(("op", Json.str("job")), ("id", Json.num(id)))
encodeRequest(Snapshot) = Json.obj(("op", Json.str("snapshot")))
encodeRequest(Stop(force, drain)) = Json.obj(
  ("op", Json.str("stop")),
  ("force", Json.Bool(force)),
  ("wait", Json.Bool(drain))
)
encodeRequest(Hello) = Json.obj(("op", Json.str("version")))
encodeRequest(Restart(program)) = Json.Obj(
  [("op", Json.str("restart"))] ++ program.map(p -> [("program", Json.str(p))]).getOrElse([])
)
encodeRequest(Rerun(id)) = Json.obj(("op", Json.str("rerun")), ("id", Json.num(id)))
encodeRequest(Clean(rule)) = Json.obj(
  ("op", Json.str("clean")),
  ("older_ms", rule.olderMs.map(n -> Json.num(n)).getOrElse(Json.Null)),
  ("keep", rule.keep.map(n -> Json.num(n)).getOrElse(Json.Null)),
  ("dry_run", Json.Bool(rule.dryRun))
)
encodeRequest(PauseQueue) = Json.obj(("op", Json.str("pause")))
encodeRequest(ResumeQueue) = Json.obj(("op", Json.str("resume")))
encodeRequest(PauseJob(id)) = Json.obj(("op", Json.str("pause")), ("id", Json.num(id)))
encodeRequest(ResumeJob(id)) = Json.obj(("op", Json.str("resume")), ("id", Json.num(id)))
encodeRequest(Polite(Some(f))) = Json.obj(("op", Json.str("polite")), ("fraction", Json.num(f)))
encodeRequest(Polite(None)) = Json.obj(("op", Json.str("polite")), ("off", Json.Bool(true)))
encodeRequest(Reserve(owner, forMs)) = Json.obj(
  ("op", Json.str("reserve")),
  ("owner", Json.str(owner)),
  ("for_ms", Json.num(forMs))
)
encodeRequest(Unreserve) = Json.obj(("op", Json.str("unreserve")))
encodeRequest(Hold(id)) = Json.obj(("op", Json.str("hold")), ("id", Json.num(id)))
encodeRequest(Release(id)) = Json.obj(("op", Json.str("release")), ("id", Json.num(id)))
encodeRequest(Prioritize(id, Level(n))) = Json.obj(
  ("op", Json.str("priority")),
  ("id", Json.num(id)),
  ("priority", Json.num(n))
)
encodeRequest(Prioritize(id, Urgent)) = Json.obj(
  ("op", Json.str("priority")),
  ("id", Json.num(id)),
  ("priority", Json.str("urgent"))
)
encodeRequest(Prioritize(id, LowBand)) = Json.obj(
  ("op", Json.str("priority")),
  ("id", Json.num(id)),
  ("priority", Json.str("low"))
)
encodeRequest(Prioritize(id, OneUp)) = Json.obj(
  ("op", Json.str("priority")),
  ("id", Json.num(id)),
  ("priority", Json.str("up"))
)
encodeRequest(Prioritize(id, OneDown)) = Json.obj(
  ("op", Json.str("priority")),
  ("id", Json.num(id)),
  ("priority", Json.str("down"))
)
encodeRequest(KillMany(s)) = Json.Obj(
  [("op", Json.str("kill_many"))] ++ killSelectorMembers(s)
)
encodeRequest(HoldMany(s, on)) = Json.Obj(
  [("op", Json.str(if on then "hold_many" else "release_many"))] ++ holdSelectorMembers(s)
)
encodeRequest(Amend(id, a)) = Json.Obj(
  [("op", Json.str("amend")), ("id", Json.num(id))] ++ amendmentMembers(a)
)
encodeRequest(Watch(source, _, mode, since, sinceId)) = Json.obj(
  ("op", Json.str("watch")),
  ("cond", Json.str(source)),
  ("mode", Json.str(modeWord(mode))),
  ("since", since.map(n -> Json.num(n)).getOrElse(Json.Null)),
  ("since_id", sinceId.map(n -> Json.num(n)).getOrElse(Json.Null))
)

// A selector's members of a `kill_many` request: only what it sets.
private killSelectorMembers(s: KillSelector) -> Vector[(string, Json)]
  val out = Buffer[(string, Json)]()
  for o in s.owner.toList do out += ("owner", Json.str(o))
  for l in s.label.toList do out += ("label", Json.str(l))
  if s.queued then out += ("queued", Json.Bool(true))
  if s.running then out += ("running", Json.Bool(true))
  if s.all then out += ("all", Json.Bool(true))
  if s.includeLanding then out += ("include_landing", Json.Bool(true))
  if s.dryRun then out += ("dry_run", Json.Bool(true))
  out.toVector

// A `kill_many` request's selector.
private decodeKillSelector(j: Json) -> Result[KillSelector, string]
  val owner = if j.has("owner") && j("owner") != Json.Null then Some(field(j, "owner", v -> v.asString, "a string")?) else None
  val label = if j.has("label") && j("label") != Json.Null then Some(field(j, "label", v -> v.asString, "a string")?) else None
  val s = KillSelector(
    owner,
    label,
    optional(j, "queued", v -> v.asBool, "a bool", false)?,
    optional(j, "running", v -> v.asBool, "a bool", false)?,
    optional(j, "all", v -> v.asBool, "a bool", false)?,
    optional(j, "include_landing", v -> v.asBool, "a bool", false)?,
    optional(j, "dry_run", v -> v.asBool, "a bool", false)?
  )
  for why in killSelectorRefusal(s).toList do return Err(why)
  Ok(s)

// A selector's members of a `hold_many` or `release_many` request: only what it sets.
private holdSelectorMembers(s: HoldSelector) -> Vector[(string, Json)]
  val out = Buffer[(string, Json)]()
  if s.exclusive then out += ("exclusive", Json.Bool(true))
  if s.draining then out += ("draining", Json.Bool(true))
  for k in s.kind.toList do out += ("kind", Json.str(k))
  for l in s.label.toList do out += ("label", Json.str(l))
  for g in s.group.toList do out += ("group", Json.str(g))
  if s.includeLanding then out += ("include_landing", Json.Bool(true))
  out.toVector

// A `hold_many` (`on`) or `release_many` request's selector.
private decodeHoldSelector(j: Json, on: bool) -> Result[HoldSelector, string]
  val kind = if j.has("kind") && j("kind") != Json.Null then Some(field(j, "kind", v -> v.asString, "a string")?) else None
  val label = if j.has("label") && j("label") != Json.Null then Some(field(j, "label", v -> v.asString, "a string")?) else None
  val group = if j.has("group") && j("group") != Json.Null then Some(field(j, "group", v -> v.asString, "a string")?) else None
  val s = HoldSelector(
    optional(j, "exclusive", v -> v.asBool, "a bool", false)?,
    optional(j, "draining", v -> v.asBool, "a bool", false)?,
    kind,
    label,
    group,
    optional(j, "include_landing", v -> v.asBool, "a bool", false)?
  )
  for why in holdSelectorRefusal(s, on).toList do return Err(why)
  Ok(s)

// An amendment's members of an `amend` request: only the settings it changes.
private amendmentMembers(a: Amendment) -> Vector[(string, Json)]
  val out = Buffer[(string, Json)]()
  for ms in a.deadlineMs.toList
    out += ("deadline_ms", Json.num(ms))
    if a.extend then out += ("extend", Json.Bool(true))
  for q in a.units.toList do out += ("units", unitsJson(q))
  for b in a.memory.toList do out += ("mem", Json.num(b))
  for l in a.label.toList do out += ("label", Json.str(l))
  for n in a.retries.toList do out += ("retries", Json.num(n))
  for ms in a.quietMs.toList do out += ("quiet_ms", Json.num(ms))
  for ids in a.after.toList
    out += ("after", longs(ids))
    out += ("after_any", Json.Bool(a.afterAny))
  out.toVector

// An `amend` request's amendment, each setting checked as `submit` checks it.
private decodeAmendment(j: Json) -> Result[Amendment, string]
  val deadline = optional(j, "deadline_ms", someLong, "a whole number", None)?
  if deadline.exists(ms -> ms < 1) then return Err("`deadline_ms` is above 0")
  val units = optional(j, "units", v -> quartersOf(v).map(q -> Some(q)), unitsWanted, None)?
  if units.exists(q -> q < 1) then return Err("`units` is above 0")
  val memory = optional(j, "mem", someLong, "a whole number", None)?
  if memory.exists(b -> b < 0) then return Err("`mem` is 0 or more")
  val label = if j.has("label") && j("label") != Json.Null then Some(labelOf(j)?) else None
  val retries = optional(j, "retries", v -> v.asInt.map(n -> Some(n)), "an int", None)?
  if retries.exists(n -> n < 0) then return Err(s"retries are 0 or more, not ${retries.get}")
  val quiet = if j.has("quiet_ms") && j("quiet_ms") != Json.Null then Some(quietOf(j)?) else None
  val after = optional(j, "after", v -> longVector(v).map(ids -> Some(ids)), "an array of job ids", None)?
  if after.exists(ids -> ids.isEmpty) then return Err("`after` names at least one job")
  val a = Amendment(
    deadline,
    optional(j, "extend", v -> v.asBool, "a bool", false)?,
    units,
    memory,
    label,
    retries,
    quiet,
    after.map(ids -> ids.distinct),
    optional(j, "after_any", v -> v.asBool, "a bool", false)?
  )
  if emptyAmendment(a) then return Err("an amend changes at least one setting")
  Ok(a)

private modeWord(m: Mode) -> string
modeWord(Once) = "once"
modeWord(Past) = "past"
modeWord(Follow) = "follow"

// Whether a request is a watch, answered with a stream rather than one reply.
watching(r: Request) -> bool
watching(Watch(_, _, _, _, _)) = true
watching(_) = false

private decodeWatch(j: Json) -> Result[Request, string]
  val source = field(j, "cond", v -> v.asString, "a string")?
  val cond = parseCondition(source).mapErr(e -> s"bad condition: $e")?
  val mode = field(j, "mode", v -> v.asString, "a string")? match
    "once" -> Once
    "past" -> Past
    "follow" -> Follow
    other -> return Err(s"`mode` is not once, past or follow: `$other`")
  if mode != Once && parseFilter(source).isErr then return Err(
    "bad condition: events takes an event filter, not `idle` or `job=`"
  )
  Ok(
    Watch(
      source,
      cond,
      mode,
      optional(j, "since", someLong, "a whole number", None)?,
      optional(j, "since_id", someLong, "a whole number", None)?
    )
  )

private longs(xs: Vector[long]) -> Json = Json.Arr(xs.map(x -> Json.num(x)))

// A job's specification, as a submit request carries it after its `op`.
encodeSpec(s: JobSpec) -> Json = Json.Obj(
  Json.obj(
    ("kind", Json.str(s.kind)),
    ("units", unitsJson(s.units)),
    ("units_given", Json.Bool(s.unitsGiven)),
    ("mem", Json.num(s.memory)),
    ("landing", Json.Bool(s.landing)),
    ("dir", Json.str(s.dir)),
    ("deadline_ms", s.deadlineMs.map(d -> Json.num(d)).getOrElse(Json.Null)),
    ("cmd", strings(s.cmd)),
    ("env", Json.Obj(s.env.map(e -> (e.0, Json.str(e.1))))),
    ("urgent", Json.Bool(s.urgent)),
    ("after", longs(s.after)),
    ("after_any", Json.Bool(s.afterAny)),
    ("retries", Json.num(s.retries)),
    ("retry_delay_ms", Json.num(s.retryDelayMs)),
    ("mem_given", Json.Bool(s.memoryGiven))
  ).asMembers.get ++ labelMember(s.label) ++ quietMember(s.quietMs) ++ externalMember(
    s.external
  ) ++ quickMember(s.quick) ++ exclusiveMembers(s.exclusive, s.quietLoad) ++ ownerMember(s.owner) ++ sizingMembers(
    s.unitsExact,
    s.unitsAsked
  ) ++ flagMember("low", s.low) ++ flagMember("mem_exact", s.memExact)
)

// A flag's member of an object: none while it is false, as with a label, so what marshal wrote
// before the flag and what it writes without it are the same.
private flagMember(name: string, on: bool) -> Vector[(string, Json)] = if on then [(name, Json.Bool(true))] else []

// How given units were weighed, as members of an object: `units_exact` for units kept as given,
// `units_asked` and `units_capped` for a job that weighs fewer than it asked for; none otherwise, as
// with a label.
private sizingMembers(exact: bool, asked: int) -> Vector[(string, Json)] =
  (if exact then [("units_exact", Json.Bool(true))] else Vector[(string, Json)]()) ++ (
    if asked > 0 then [
      ("units_asked", unitsJson(asked)),
      ("units_capped", Json.Bool(true))
    ] else Vector[(string, Json)]()
  )

// The units a job asked for while it weighs fewer, read from an object: 0 where it is absent, as
// in what marshal wrote before given units were a ceiling.
private askedOf(j: Json) -> Result[int, string] = j.get("units_asked") match
  None | Some(Json.Null) -> Ok(0)
  Some(v) -> quartersOf(v) match
    Some(q) -> Ok(q)
    None -> Err(s"`units_asked` is not $unitsWanted")

// An owner's member of an object: none for no owner, as with a label.
private ownerMember(owner: string) -> Vector[(string, Json)] = if owner.isEmpty then [] else [
  ("owner", Json.str(owner))
]

// The longest owner, in characters.
val MaxOwner: int = 40

// An owner as `--owner` may name one: a word of 1 to `MaxOwner` letters, digits, `-`, `_` or `.`,
// or why it is not.
checkOwner(text: string) -> Result[string, string]
  if text.isEmpty then return Err("an owner is a word, not empty")
  if text.charCount > MaxOwner then return Err(s"an owner is at most $MaxOwner characters, not ${text.charCount}")
  if !text.chars.forall(
    c -> ('a' <= c <= 'z') || ('A' <= c <= 'Z') || ('0' <= c <= '9') || c == '-' || c == '_' || c == '.'
  )
    return Err("an owner is one word of letters, digits, `-`, `_` and `.`")
  Ok(text)

// An owner read from an object: "" where it is absent, an error where it is not an owner.
private ownerOf(j: Json) -> Result[string, string] = j.get("owner") match
  None | Some(Json.Null) -> Ok("")
  Some(v) -> v.asString match
    Some(s) -> checkOwner(s).mapErr(e -> s"`owner`: $e")
    None -> Err("`owner` is not a string")

// An exclusive job's members of an object, `exclusive` and its `quiet_load` when it has one: none
// for a job that is not exclusive, as with a label.
private exclusiveMembers(exclusive: bool, quietLoad: real) -> Vector[(string, Json)] =
  (if exclusive then [("exclusive", Json.Bool(true))] else Vector[(string, Json)]()) ++ (
    if quietLoad > 0.0 then [("quiet_load", Json.num(quietLoad))] else Vector[(string, Json)]()
  )

// A quiet load read from an object: 0 where it is absent or null, an error where it is not a number
// above 0.
private quietLoadOf(j: Json) -> Result[real, string] = j.get("quiet_load") match
  None | Some(Json.Null) -> Ok(0.0)
  Some(v) -> v.asReal match
    Some(x) if x > 0.0 -> Ok(x)
    _ -> Err("`quiet_load` is not a number above 0")

// An external job's member of an object: none for a job whose work is its own processes', as with a
// label.
private externalMember(external: bool) -> Vector[(string, Json)] = if external then [
  ("external", Json.Bool(true))
] else []

// The quick lane's member of an object: none for a job not in it, as with a label.
private quickMember(quick: bool) -> Vector[(string, Json)] = if quick then [("quick", Json.Bool(true))] else []

// A label's member of an object: none for no label, so what marshal wrote before labels and what it
// writes for a job without one are the same.
private labelMember(label: string) -> Vector[(string, Json)] = if label.isEmpty then [] else [
  ("label", Json.str(label))
]

// A quiet timeout's member of an object: none for no quiet timeout, as with a label.
private quietMember(ms: long) -> Vector[(string, Json)] = if ms <= 0 then [] else [("quiet_ms", Json.num(ms))]

// A quiet timeout read from an object: 0 where it is absent or null, an error where it is not a
// whole number above 0.
private quietOf(j: Json) -> Result[long, string] = j.get("quiet_ms") match
  None | Some(Json.Null) -> Ok(0)
  Some(v) -> v.asLong match
    Some(n) if n > 0 -> Ok(n)
    _ -> Err("`quiet_ms` is not a whole number above 0")

// A label read from an object: "" where it is absent, an error where it is not a label.
private labelOf(j: Json) -> Result[string, string] = j.get("label") match
  None | Some(Json.Null) -> Ok("")
  Some(v) -> v.asString match
    Some(s) -> checkLabel(s).mapErr(e -> s"`label`: $e")
    None -> Err("`label` is not a string")

decodeSpec(j: Json) -> Result[JobSpec, string]
  val cmd = field(j, "cmd", stringVector, "an array of strings")?
  if cmd.isEmpty then return Err("`cmd` is empty: a job runs a command")
  Ok(JobSpec(
      field(j, "kind", v -> v.asString, "a string")?,
      field(j, "units", quartersOf, unitsWanted)?,
      field(j, "mem", v -> v.asLong, "a whole number")?,
      optional(j, "landing", v -> v.asBool, "a bool", false)?,
      field(j, "dir", v -> v.asString, "a string")?,
      optional(j, "deadline_ms", someLong, "a whole number", None)?,
      cmd,
      optional(j, "env", stringPairs, "an object of strings", Vector[(string, string)]())?,
      optional(j, "urgent", v -> v.asBool, "a bool", false)?,
      optional(j, "after", longVector, "an array of job ids", Vector[long]())?,
      optional(j, "after_any", v -> v.asBool, "a bool", false)?,
      optional(j, "retries", v -> v.asInt, "an int", 0)?,
      optional(j, "retry_delay_ms", v -> v.asLong, "a whole number", long(0))?,
      optional(j, "mem_given", v -> v.asBool, "a bool", false)?,
      labelOf(j)?,
      quietOf(j)?,
      // absent from what marshal wrote before external jobs, and for a job that is not one
      optional(j, "external", v -> v.asBool, "a bool", false)?,
      optional(j, "quick", v -> v.asBool, "a bool", false)?,
      optional(j, "exclusive", v -> v.asBool, "a bool", false)?,
      quietLoadOf(j)?,
      // absent from what marshal wrote before it learned units: given
      optional(j, "units_given", v -> v.asBool, "a bool", true)?,
      // absent from what marshal wrote before owners, and for a job whose owner was not named
      ownerOf(j)?,
      // absent from what marshal wrote before given units were a ceiling, and where there is
      // nothing to say
      optional(j, "units_exact", v -> v.asBool, "a bool", false)?,
      askedOf(j)?,
      // absent from what marshal wrote before low jobs and memory ceilings, and while false
      optional(j, "low", v -> v.asBool, "a bool", false)?,
      optional(j, "mem_exact", v -> v.asBool, "a bool", false)?))

// What a `units` field must be.
private val unitsWanted: string = "a number of units in steps of 0.25"

private field[T](j: Json, key: string, read: (Json) -> Option[T], what: string) -> Result[T, string] =
  j.get(key) match
    Some(v) -> read(v) match
      Some(x) -> Ok(x)
      None -> Err(s"`$key` is not $what")
    None -> Err(s"`$key` is missing")

private optional[T](j: Json, key: string, read: (Json) -> Option[T], what: string, absent: T) -> Result[T, string] =
  j.get(key) match
    Some(Json.Null) -> Ok(absent)
    Some(v) -> read(v) match
      Some(x) -> Ok(x)
      None -> Err(s"`$key` is not $what")
    None -> Ok(absent)

private stringVector(j: Json) -> Option[Vector[string]] = j.asVector match
  Some(items) if items.forall(i -> i.asString.isDefined) -> Some(items.map(i -> i.asString.get))
  _ -> None

private longVector(j: Json) -> Option[Vector[long]] = j.asVector match
  Some(items) if items.forall(i -> i.asLong.isDefined) -> Some(items.map(i -> i.asLong.get))
  _ -> None

private stringPairs(j: Json) -> Option[Vector[(string, string)]] = j.asMembers match
  Some(ms) if ms.forall(m -> m.1.asString.isDefined) -> Some(ms.map(m -> (m.0, m.1.asString.get)))
  _ -> None

private someLong(j: Json) -> Option[Option[long]] = j.asLong.map(n -> Some(n))
private wholeNumber(j: Json) -> Option[long] = j.asLong

decodeRequest(text: string) -> Result[Request, string]
  val j = json.parse(text) match
    Ok(v) -> v
    Err(e) -> return Err(s"not JSON: $e")
  if j.asMembers.isEmpty then return Err("a request is a JSON object")
  val op = field(j, "op", v -> v.asString, "a string")?
  op match
    "submit" -> Ok(Submit(decodeSpec(j)?))
    "wait" -> Ok(Wait(field(j, "id", v -> v.asLong, "a whole number")?))
    "kill" -> Ok(Kill(field(j, "id", v -> v.asLong, "a whole number")?))
    "ls" -> Ok(List)
    "status" -> Ok(Status)
    "job" -> Ok(Lookup(field(j, "id", v -> v.asLong, "a whole number")?))
    "snapshot" -> Ok(Snapshot)
    "stop" -> Ok(
      Stop(optional(j, "force", v -> v.asBool, "a bool", false)?, optional(j, "wait", v -> v.asBool, "a bool", false)?)
    )
    "version" -> Ok(Hello)
    "restart" -> Ok(Restart(if j.has("program") then Some(field(j, "program", v -> v.asString, "a string")?) else None))
    "rerun" -> Ok(Rerun(field(j, "id", v -> v.asLong, "a whole number")?))
    "pause" -> if j.has("id") then Ok(PauseJob(field(j, "id", v -> v.asLong, "a whole number")?)) else Ok(PauseQueue)
    "resume" -> if j.has("id") then Ok(ResumeJob(field(j, "id", v -> v.asLong, "a whole number")?)) else Ok(ResumeQueue)
    "hold" -> Ok(Hold(field(j, "id", v -> v.asLong, "a whole number")?))
    "release" -> Ok(Release(field(j, "id", v -> v.asLong, "a whole number")?))
    "polite" ->
      if optional(j, "off", v -> v.asBool, "a bool", false)? then return Ok(Polite(None))
      val f = field(j, "fraction", v -> v.asReal, "a number")?
      checkFraction(f).map(x -> Polite(Some(x)))
    "reserve" ->
      val owner = field(j, "owner", v -> v.asString, "a string")?
      val forMs = field(j, "for_ms", v -> v.asLong, "a whole number")?
      reserveRefusal(owner, forMs) match
        Some(why) -> Err(why)
        None -> Ok(Reserve(owner, forMs))
    "unreserve" -> Ok(Unreserve)
    "priority" -> Ok(
      Prioritize(
        field(j, "id", v -> v.asLong, "a whole number")?,
        field(j, "priority", priorityOf, "a whole number, \"urgent\", \"low\", \"up\" or \"down\"")?
      )
    )
    "kill_many" -> Ok(KillMany(decodeKillSelector(j)?))
    "hold_many" -> Ok(HoldMany(decodeHoldSelector(j, true)?, true))
    "release_many" -> Ok(HoldMany(decodeHoldSelector(j, false)?, false))
    "amend" -> Ok(Amend(field(j, "id", v -> v.asLong, "a whole number")?, decodeAmendment(j)?))
    "clean" ->
      val older = optional(j, "older_ms", someLong, "a whole number", None)?
      val keep = optional(j, "keep", v -> v.asInt.map(n -> Some(n)), "a whole number", None)?
      if older.exists(n -> n < 1) then return Err("`older_ms` is at least 1")
      if keep.exists(n -> n < 0) then return Err("`keep` is 0 or more")
      Ok(Clean(CleanRule(older, keep, optional(j, "dry_run", v -> v.asBool, "a bool", false)?)))
    "watch" -> decodeWatch(j)
    other -> Err(s"no such request: `$other`")

private priorityOf(j: Json) -> Option[Priority] = j.asString match
  Some("urgent") -> Some(Urgent)
  Some("low") -> Some(LowBand)
  Some("up") -> Some(OneUp)
  Some("down") -> Some(OneDown)
  Some(_) -> None
  None -> j.asInt.map(n -> Level(n))

// Outcomes.

encodeOutcome(o: Outcome) -> Json
encodeOutcome(Exited(code)) = Json.obj(("how", Json.str("exit")), ("code", Json.num(code)))
encodeOutcome(Signalled(sig)) = Json.obj(("how", Json.str("signal")), ("signal", Json.num(sig)))
encodeOutcome(TimedOut) = Json.obj(("how", Json.str("timeout")))
encodeOutcome(Cancelled) = Json.obj(("how", Json.str("cancelled")))
encodeOutcome(Lost) = Json.obj(("how", Json.str("lost")))
encodeOutcome(DependencyFailed(after)) = Json.obj(("how", Json.str("dependency-failed")), ("after", Json.num(after)))
encodeOutcome(Quiet(afterMs)) = Json.obj(("how", Json.str("quiet")), ("after_ms", Json.num(afterMs)))

decodeOutcome(j: Json) -> Result[Outcome, string]
  field(j, "how", v -> v.asString, "a string")? match
    "exit" -> Ok(Exited(field(j, "code", v -> v.asInt, "an int")?))
    "signal" -> Ok(Signalled(field(j, "signal", v -> v.asInt, "an int")?))
    "timeout" -> Ok(TimedOut)
    "cancelled" -> Ok(Cancelled)
    "lost" -> Ok(Lost)
    "dependency-failed" -> Ok(DependencyFailed(field(j, "after", v -> v.asLong, "a whole number")?))
    "quiet" -> Ok(Quiet(field(j, "after_ms", v -> v.asLong, "a whole number")?))
    other -> Err(s"no such outcome: `$other`")

// Replies.

encodeJob(i: JobInfo) -> Json = Json.Obj(
  Json.obj(
    ("id", Json.num(i.id)),
    ("kind", Json.str(i.kind)),
    ("units", unitsJson(i.units)),
    ("mem", Json.num(i.memory)),
    ("landing", Json.Bool(i.landing)),
    ("dir", Json.str(i.dir)),
    ("cmd", strings(i.cmd)),
    ("state", Json.str(i.state)),
    ("outcome", i.outcome.map(encodeOutcome).getOrElse(Json.Null)),
    ("killed", Json.Bool(i.killed)),
    ("queued_ms", Json.num(i.queuedMs)),
    ("elapsed_ms", Json.num(i.elapsedMs)),
    ("deadline_ms", Json.num(i.deadlineMs)),
    ("log", Json.str(i.log)),
    ("sample", i.sample.map(s -> Json.str(s)).getOrElse(Json.Null)),
    ("rss", Json.num(i.rss)),
    ("peak_rss", Json.num(i.peakRss)),
    ("started_at", Json.num(i.startedAt)),
    ("held", Json.Bool(i.held)),
    ("priority", Json.num(i.priority)),
    ("urgent", Json.Bool(i.urgent)),
    ("paused", Json.Bool(i.paused)),
    ("after", longs(i.after)),
    ("attempt", Json.num(i.attempt)),
    ("resv", Json.num(i.reserved)),
    ("resv_learned", Json.Bool(i.reservedLearned))
  ).asMembers.get ++ labelMember(i.label) ++ quietMember(i.quietMs) ++ resvFromMember(
    i.reservedFrom
  ) ++ externalMember(i.external) ++ quickMember(i.quick) ++ expectedMembers(i) ++ exclusiveMembers(
    i.exclusive,
    i.quietLoad
  ) ++ coresMembers(i) ++ ownerMember(i.owner) ++ etaMembers(i) ++ settlingMembers(i) ++ learnedFromMembers(i)
)

// `units_from`, `deadline_from` and `project` are left out where the daemon did not say.
// `deadline_from` is `amended` for a job whose deadline `amend` changed: its run teaches no
// deadline (events.avin's `recover`).
private learnedFromMembers(i: JobInfo) -> Vector[(string, Json)]
  val out = Buffer[(string, Json)]()
  if i.unitsFrom.nonEmpty then out += ("units_from", Json.str(i.unitsFrom))
  if i.deadlineFrom.nonEmpty then out += ("deadline_from", Json.str(i.deadlineFrom))
  if i.project.nonEmpty then out += ("project", Json.str(i.project))
  // `retries` only for a job that has some, `amended` only for an amended one
  if i.retries > 0 then out += ("retries", Json.num(i.retries))
  if i.amended then out += ("amended", Json.Bool(true))
  // `low` only for a job in the low band, `wait_text` only on a queued job that says why it waits,
  // `label_from` only where the label was derived (`"cmd"`, memory.avin's `derivedLabel`)
  if i.low then out += ("low", Json.Bool(true))
  if i.waitText.nonEmpty then out += ("wait_text", Json.str(i.waitText))
  if i.labelFrom.nonEmpty then out += ("label_from", Json.str(i.labelFrom))
  // `held_group` only on a job a filtered hold holds, `held_ms` only where it has been held
  if i.heldGroup.nonEmpty then out += ("held_group", Json.str(i.heldGroup))
  if i.heldMs > 0 then out += ("held_ms", Json.num(i.heldMs))
  // `waits_on` only on a queued job whose wait ends with a running job's
  if i.waitsOn > 0 then out += ("waits_on", Json.num(i.waitsOn))
  out.toVector

// `settling_ms` and `load_overdue` are there only on a settling job.
private settlingMembers(i: JobInfo) -> Vector[(string, Json)] = if i.state == "settling" then [
  ("settling_ms", Json.num(i.settlingMs)),
  ("load_overdue", Json.Bool(i.loadOverdue))
] else Vector[(string, Json)]()

// `duration_from` is left out where the daemon did not say; `eta_ms`, a running job's expected time
// left, only where it has one (`etaLeft`), with `eta_late` and `eta_guess` only where true;
// `starts_in_ms` only on a queued job whose start can be reckoned.
private etaMembers(i: JobInfo) -> Vector[(string, Json)]
  val out = Buffer[(string, Json)]()
  if i.durationFrom.nonEmpty then out += ("duration_from", Json.str(i.durationFrom))
  val left = etaLeft(i)
  if left.ms >= 0
    out += ("eta_ms", Json.num(left.ms))
    if left.late then out += ("eta_late", Json.Bool(true))
    if left.guess then out += ("eta_guess", Json.Bool(true))
  if i.startsInMs >= 0 then out += ("starts_in_ms", Json.num(i.startsInMs))
  out.toVector

// `units_learned` is there only for learned units; `cores` only while a measured job runs, and
// `peak_cores` and `cpu_ms` once a job has been measured; `held_cores` once a level it held has
// been.
private coresMembers(i: JobInfo) -> Vector[(string, Json)]
  val out = Buffer[(string, Json)]()
  if i.unitsLearned then out += ("units_learned", Json.Bool(true))
  if i.state == "running" && i.cores >= 0 then out += ("cores", coresJson(i.cores))
  if i.peakCores >= 0
    out += ("peak_cores", coresJson(i.peakCores))
    out += ("cpu_ms", Json.num(i.cpuMs))
  if i.heldCores >= 0 then out += ("held_cores", coresJson(i.heldCores))
  out ++= sizingMembers(false, i.unitsAsked)
  out.toVector

// `resv_from` is left out where the daemon did not say where a reservation came from.
private resvFromMember(from: string) -> Vector[(string, Json)] = if from.isEmpty then [] else [
  ("resv_from", Json.str(from))
]

// `expected_ms` and `duration_learned` are left out where the daemon did not say how long a job is
// expected to run; `expected_start_at` is there only on the job the machine drains for.
private expectedMembers(i: JobInfo) -> Vector[(string, Json)]
  val expected = if i.expectedMs > 0 then [
    ("expected_ms", Json.num(i.expectedMs)),
    ("duration_learned", Json.Bool(i.durationLearned))
  ] else Vector[(string, Json)]()
  val start = if i.expectedStart > 0 then [
    ("expected_start_at", Json.num(i.expectedStart))
  ] else Vector[(string, Json)]()
  expected ++ start

decodeJob(j: Json) -> Result[JobInfo, string]
  val outcome = j.get("outcome") match
    Some(Json.Null) -> None
    Some(o) -> Some(decodeOutcome(o)?)
    None -> None
  val memory = field(j, "mem", v -> v.asLong, "a whole number")?
  Ok(JobInfo(
      field(j, "id", v -> v.asLong, "a whole number")?,
      field(j, "kind", v -> v.asString, "a string")?,
      field(j, "units", quartersOf, unitsWanted)?,
      memory,
      field(j, "landing", v -> v.asBool, "a bool")?,
      field(j, "dir", v -> v.asString, "a string")?,
      field(j, "cmd", stringVector, "an array of strings")?,
      field(j, "state", v -> v.asString, "a string")?,
      outcome,
      field(j, "killed", v -> v.asBool, "a bool")?,
      field(j, "queued_ms", v -> v.asLong, "a whole number")?,
      field(j, "elapsed_ms", v -> v.asLong, "a whole number")?,
      field(j, "deadline_ms", v -> v.asLong, "a whole number")?,
      field(j, "log", v -> v.asString, "a string")?,
      optional(j, "sample", v -> v.asString.map(s -> Some(s)), "a string", None)?,
      // absent from what marshal wrote before it measured memory, or held and ordered jobs
      optional(j, "rss", wholeNumber, "a whole number", 0)?,
      optional(j, "peak_rss", wholeNumber, "a whole number", 0)?,
      optional(j, "started_at", wholeNumber, "a whole number", 0)?,
      optional(j, "held", v -> v.asBool, "a bool", false)?,
      optional(j, "priority", v -> v.asInt, "an int", 0)?,
      optional(j, "urgent", v -> v.asBool, "a bool", false)?,
      optional(j, "paused", v -> v.asBool, "a bool", false)?,
      // absent from what marshal wrote before jobs waited for others and retried
      optional(j, "after", longVector, "an array of job ids", Vector[long]())?,
      optional(j, "attempt", v -> v.asInt, "an int", 1)?,
      // absent from what marshal wrote before it learned reservations: the declared memory
      optional(j, "resv", wholeNumber, "a whole number", memory)?,
      optional(j, "resv_learned", v -> v.asBool, "a bool", false)?,
      // absent from what marshal wrote before labels: no label; one already logged is read as it is
      optional(j, "label", v -> v.asString, "a string", "")?,
      // absent from what marshal wrote before quiet timeouts, and for a job without one: none
      quietOf(j)?,
      // absent from what marshal wrote before it learned per directory: not said
      optional(j, "resv_from", v -> v.asString, "a string", "")?,
      optional(j, "external", v -> v.asBool, "a bool", false)?,
      // absent from what marshal wrote before the quick lane, and for a job not in it
      optional(j, "quick", v -> v.asBool, "a bool", false)?,
      // absent from what marshal wrote before it said how long a job is expected to run
      optional(j, "expected_ms", wholeNumber, "a whole number", 0)?,
      optional(j, "duration_learned", v -> v.asBool, "a bool", false)?,
      // absent on every job but the one the machine drains for
      optional(j, "expected_start_at", wholeNumber, "a whole number", 0)?,
      // absent from what marshal wrote before exclusive jobs, and for a job that is not one
      optional(j, "exclusive", v -> v.asBool, "a bool", false)?,
      quietLoadOf(j)?,
      // absent from what marshal wrote before it learned units, and where there is nothing to say
      optional(j, "units_learned", v -> v.asBool, "a bool", false)?,
      optional(j, "cores", centiOf, "a number of cores", long(-1))?,
      optional(j, "peak_cores", centiOf, "a number of cores", long(-1))?,
      optional(j, "cpu_ms", wholeNumber, "a whole number", 0)?,
      // absent from what marshal wrote before owners, ETAs and learned durations per command
      optional(j, "owner", v -> v.asString, "a string", "")?,
      optional(j, "duration_from", v -> v.asString, "a string", "")?,
      optional(j, "starts_in_ms", wholeNumber, "a whole number", long(-1))?,
      // absent from what marshal wrote before it measured the level a job held
      optional(j, "held_cores", centiOf, "a number of cores", long(-1))?,
      // absent from what marshal wrote before given units were a ceiling, and for a job that
      // weighs what it asked for
      askedOf(j)?,
      // absent on every job but a settling one
      optional(j, "settling_ms", wholeNumber, "a whole number", 0)?,
      optional(j, "load_overdue", v -> v.asBool, "a bool", false)?,
      // absent from what marshal wrote before it said where units and deadlines were learned
      optional(j, "units_from", v -> v.asString, "a string", "")?,
      optional(j, "deadline_from", v -> v.asString, "a string", "")?,
      optional(j, "project", v -> v.asString, "a string", "")?,
      // absent from what marshal wrote before amend, and for a job without retries or amends
      optional(j, "retries", v -> v.asInt, "an int", 0)?,
      optional(j, "amended", v -> v.asBool, "a bool", false)?,
      // absent from what marshal wrote before low jobs, waits said in full and derived labels, and
      // where false or empty
      optional(j, "low", v -> v.asBool, "a bool", false)?,
      optional(j, "wait_text", v -> v.asString, "a string", "")?,
      optional(j, "label_from", v -> v.asString, "a string", "")?,
      // absent from what marshal wrote before hold groups, and where empty or 0
      optional(j, "held_group", v -> v.asString, "a string", "")?,
      optional(j, "held_ms", wholeNumber, "a whole number", 0)?,
      // absent on a job without an ETA, and where false; a running job's `eta_ms` written before
      // late ETAs is read as it is
      optional(j, "eta_ms", wholeNumber, "a whole number", long(-1))?,
      optional(j, "eta_late", v -> v.asBool, "a bool", false)?,
      optional(j, "eta_guess", v -> v.asBool, "a bool", false)?,
      // absent on a job whose wait ends with no running job's, and from what marshal wrote before
      optional(j, "waits_on", wholeNumber, "a whole number", 0)?))

encodeTakeSlot(t: TakeSlotUse) -> Json = Json.obj(
  ("dir", Json.str(t.dir)),
  ("units", unitsJson(t.units)),
  ("waiting", Json.num(t.waiting)),
  ("landing", Json.Bool(t.landing))
)

private decodeTakeSlot(j: Json) -> Result[Option[TakeSlotUse], string]
  if j == Json.Null then return Ok(None)
  Ok(
    Some(
      TakeSlotUse(
        field(j, "dir", v -> v.asString, "a string")?,
        field(j, "units", quartersOf, unitsWanted)?,
        field(j, "waiting", v -> v.asInt, "an int")?,
        field(j, "landing", v -> v.asBool, "a bool")?
      )
    )
  )

// What `status --json` prints: the budget in use, what take-slot holds (null when no directory is
// shared), and the running and queued jobs, each as the protocol gives a job. A queued job in `whys`
// (job id, reason) also has `why`, the protocol's word for the reason, and `behind`, the job it
// waits behind, when that is the reason. The settling jobs (`settling`) are listed apart, under
// `settling`, with the same reasons. The machine's processors and disk follow (`machineMembers`).
statusJson(u: Usage, jobs: Vector[JobInfo], whys: Vector[(long, Why)] = []) -> Json = Json.Obj(
  Json.obj(
    ("units", unitsJson(u.units)),
    ("unit_budget", unitsJson(u.unitBudget)),
    ("mem", Json.num(u.memory)),
    ("mem_budget", Json.num(u.memoryBudget)),
    ("rss", Json.num(u.rss)),
    ("mem_held", Json.num(u.held)),
    ("machine_mem", Json.num(u.machineMemory)),
    ("landing", u.landing.map(id -> Json.num(id)).getOrElse(Json.Null)),
    ("take_slot", u.takeSlot.map(encodeTakeSlot).getOrElse(Json.Null)),
    ("queue_held", Json.Bool(u.queueHeld)),
    ("quick", Json.num(u.quick)),
    ("quick_slots", Json.num(QuickSlots)),
    ("exclusive", u.exclusive.map(id -> Json.num(id)).getOrElse(Json.Null)),
    ("polite", politeJson(u.polite)),
    ("reserve", reserveJson(u.reserve)),
    ("running", Json.Arr(jobs.filter(j -> j.state == "running").map(encodeJob))),
    ("queued", Json.Arr(jobs.filter(j -> j.state == "queued").map(j -> withWhy(j, whys)))),
    ("settling", Json.Arr(jobs.filter(j -> settling(j)).map(j -> withWhy(j, whys))))
  ).asMembers.get ++ machineMembers(u)
)

private withWhy(j: JobInfo, whys: Vector[(long, Why)]) -> Json = whys.find(w -> w.0 == j.id) match
  Some((_, why)) ->
    Json.Obj(encodeJob(j).asMembers.get ++ [("why", Json.str(whyWord(why)))] ++ whyId(why))
  None -> encodeJob(j)

encodeReply(r: Reply) -> Json
encodeReply(Submitted(id, log, hint)) = Json.Obj(
  [
    ("ok", Json.Bool(true)),
    ("id", Json.num(id)),
    ("log", Json.str(log))
  ] ++ (if hint.isEmpty then [] else [("hint", Json.str(hint))])
)
encodeReply(Ended(job)) = Json.obj(("ok", Json.Bool(true)), ("job", encodeJob(job)))
encodeReply(Found(job, why)) = Json.obj(("ok", Json.Bool(true)), ("found", encodeFound(job, why)))
encodeReply(Jobs(jobs)) = Json.obj(("ok", Json.Bool(true)), ("jobs", Json.Arr(jobs.map(encodeJob))))
encodeReply(Using(u)) = Json.Obj(usageMembers(u))
encodeReply(Viewed(o)) = Json.obj(("ok", Json.Bool(true)), ("snapshot", encodeOverview(o)))
encodeReply(Hi(version, pid)) = Json.obj(
  ("ok", Json.Bool(true)),
  ("version", Json.str(version)),
  ("pid", Json.num(pid))
)
encodeReply(Streamed(event)) = Json.obj(("ok", Json.Bool(true)), ("event", event))
encodeReply(Replayed(events)) = Json.obj(("ok", Json.Bool(true)), ("events", Json.Arr(events)))
encodeReply(Cleaned(report)) = Json.obj(("ok", Json.Bool(true)), ("cleaned", encodeReport(report)))
encodeReply(Amended(changes, hint)) = Json.Obj(
  [("ok", Json.Bool(true)), ("amended", Json.str(changes))] ++ (if hint.isEmpty then [] else [("hint", Json.str(hint))])
)
encodeReply(KilledJobs(jobs, skipped)) = Json.obj(
  ("ok", Json.Bool(true)),
  ("stopped", Json.Arr(jobs.map(stoppedMembers))),
  ("skipped_landing", Json.num(skipped))
)
encodeReply(HeldJobs(ids, group, skipped)) = Json.obj(
  ("ok", Json.Bool(true)),
  ("held_ids", Json.Arr(ids.map(id -> Json.num(id)))),
  ("group", Json.str(group)),
  ("skipped_landing", Json.num(skipped))
)
encodeReply(Done) = Json.obj(("ok", Json.Bool(true)))
encodeReply(Failed(message)) = Json.obj(("ok", Json.Bool(false)), ("error", Json.str(message)))
encodeReply(Over(message)) = Json.obj(
  ("ok", Json.Bool(false)),
  ("error", Json.str(message)),
  ("ended", Json.Bool(true))
)

private stoppedMembers(s: StoppedJob) -> Json = Json.obj(
  ("id", Json.num(s.id)),
  ("how", Json.str(s.how)),
  ("label", Json.str(s.label)),
  ("landing", Json.Bool(s.landing)),
  ("exclusive", Json.Bool(s.exclusive))
)

private decodeStopped(j: Json) -> Result[StoppedJob, string] = Ok(
  StoppedJob(
    field(j, "id", v -> v.asLong, "a whole number")?,
    field(j, "how", v -> v.asString, "a string")?,
    optional(j, "label", v -> v.asString, "a string", "")?,
    optional(j, "landing", v -> v.asBool, "a bool", false)?,
    optional(j, "exclusive", v -> v.asBool, "a bool", false)?
  )
)

// The members of a `status` reply.
private usageMembers(u: Usage) -> Vector[(string, Json)] = Json.obj(
  ("ok", Json.Bool(true)),
  ("units", unitsJson(u.units)),
  ("unit_budget", unitsJson(u.unitBudget)),
  ("mem", Json.num(u.memory)),
  ("mem_budget", Json.num(u.memoryBudget)),
  ("rss", Json.num(u.rss)),
  ("mem_held", Json.num(u.held)),
  ("machine_mem", Json.num(u.machineMemory)),
  ("running", Json.num(u.running)),
  ("queued", Json.num(u.queued)),
  ("landing", u.landing.map(id -> Json.num(id)).getOrElse(Json.Null)),
  ("take_slot", u.takeSlot.map(encodeTakeSlot).getOrElse(Json.Null)),
  ("queue_held", Json.Bool(u.queueHeld)),
  ("quick", Json.num(u.quick)),
  ("exclusive", u.exclusive.map(id -> Json.num(id)).getOrElse(Json.Null)),
  ("settling", Json.num(u.settling)),
  ("polite", politeJson(u.polite)),
  ("reserve", reserveJson(u.reserve))
).asMembers.get ++ machineMembers(u)

// Polite mode as the protocol writes it: `{fraction, units, memory}`, with `until` while the
// schedule sets it, or null while marshal is not polite.
politeJson(p: Option[PoliteUse]) -> Json = p match
  None -> Json.Null
  Some(u) -> Json.Obj(
    [("fraction", Json.num(u.fraction)), ("units", unitsJson(u.units)), ("memory", Json.num(u.memory))] ++ (
      if u.until.isEmpty then Vector[(string, Json)]() else [("until", Json.str(u.until))]
    )
  )

// Polite mode as the protocol wrote it under `polite` in `j`: None where it is null or absent.
private decodePolite(j: Json) -> Result[Option[PoliteUse], string]
  val p = j.get("polite").getOrElse(Json.Null)
  if p == Json.Null then return Ok(None)
  Ok(
    Some(
      PoliteUse(
        field(p, "fraction", v -> v.asReal, "a number")?,
        field(p, "units", quartersOf, unitsWanted)?,
        field(p, "memory", v -> v.asLong, "a whole number")?,
        optional(p, "until", v -> v.asString, "a string", "")?
      )
    )
  )

decodeReply(text: string) -> Result[Reply, string]
  val j = json.parse(text) match
    Ok(v) -> v
    Err(e) -> return Err(s"not JSON: $e")
  if !field(j, "ok", v -> v.asBool, "a bool")?
    val message = field(j, "error", v -> v.asString, "a string")?
    return Ok(if optional(j, "ended", v -> v.asBool, "a bool", false)? then Over(message) else Failed(message))
  if j.has("amended") then return Ok(
    Amended(field(j, "amended", v -> v.asString, "a string")?, optional(j, "hint", v -> v.asString, "a string", "")?)
  )
  if j.has("stopped")
    val items = field(j, "stopped", v -> v.asVector, "an array")?
    val jobs = Buffer[StoppedJob]()
    for item in items do jobs += decodeStopped(item)?
    return Ok(KilledJobs(jobs.toVector, optional(j, "skipped_landing", v -> v.asInt, "an int", 0)?))
  if j.has("held_ids") then return Ok(
    HeldJobs(
      field(j, "held_ids", longVector, "an array of job ids")?,
      optional(j, "group", v -> v.asString, "a string", "")?,
      optional(j, "skipped_landing", v -> v.asInt, "an int", 0)?
    )
  )
  if j.has("event") then return Ok(Streamed(j("event")))
  if j.has("events") then return Ok(Replayed(field(j, "events", v -> v.asVector, "an array")?))
  if j.has("cleaned") then return Ok(Cleaned(decodeReport(j("cleaned"))?))
  if j.has("snapshot") then return Ok(Viewed(decodeOverview(j("snapshot"))?))
  if j.has("job") then return Ok(Ended(decodeJob(j("job"))?))
  if j.has("found") then return decodeFound(j("found"))
  if j.has("jobs")
    val items = field(j, "jobs", v -> v.asVector, "an array")?
    val jobs = Buffer[JobInfo]()
    for item in items do jobs += decodeJob(item)?
    return Ok(Jobs(jobs.toVector))
  if j.has("unit_budget")
    return Ok(
      Using(
        withMachine(
          Usage(
            field(j, "units", quartersOf, unitsWanted)?,
            field(j, "unit_budget", quartersOf, unitsWanted)?,
            field(j, "mem", v -> v.asLong, "a whole number")?,
            field(j, "mem_budget", v -> v.asLong, "a whole number")?,
            field(j, "running", v -> v.asInt, "an int")?,
            field(j, "queued", v -> v.asInt, "an int")?,
            optional(j, "landing", someLong, "a whole number", None)?,
            decodeTakeSlot(j.get("take_slot").getOrElse(Json.Null))?,
            optional(j, "rss", wholeNumber, "a whole number", 0)?,
            optional(j, "machine_mem", wholeNumber, "a whole number", 0)?,
            optional(j, "queue_held", v -> v.asBool, "a bool", false)?,
            optional(j, "mem_held", wholeNumber, "a whole number", 0)?,
            optional(j, "quick", v -> v.asInt, "an int", 0)?,
            optional(j, "exclusive", someLong, "a whole number", None)?,
            settling = optional(j, "settling", v -> v.asInt, "an int", 0)?,
            polite = decodePolite(j)?,
            reserve = decodeReserve(j)?
          ),
          machineOf(j)?
        )
      )
    )
  if j.has("version") then return Ok(
    Hi(field(j, "version", v -> v.asString, "a string")?, field(j, "pid", v -> v.asLong, "a whole number")?)
  )
  if j.has("id") then return Ok(
    Submitted(
      field(j, "id", v -> v.asLong, "a whole number")?,
      field(j, "log", v -> v.asString, "a string")?,
      optional(j, "hint", v -> v.asString, "a string", "")?
    )
  )
  Ok(Done)

// Snapshots.

// The word a queued job's `waits` field holds.
whyWord(w: Why) -> string
whyWord(NoUnits) = "units"
whyWord(NoMemory) = "memory"
whyWord(LaneBusy) = "lane"
whyWord(Draining) = "draining"
whyWord(ForTakeSlot) = "take-slot"
whyWord(Behind(_)) = "behind"
whyWord(DrainingFor(_)) = "draining-for"
whyWord(Starting) = "starting"
whyWord(Held) = "held"
whyWord(QueueHeld) = "queue-held"
whyWord(QuickFull) = "quick-lane"
whyWord(Emptying) = "emptying"
whyWord(Load(_, _, _)) = "load"
whyWord(ForExclusive(_)) = "exclusive"
whyWord(DiskLow(_)) = "disk-low"
whyWord(MemoryPressure(_)) = "memory-pressure"
whyWord(PoliteBudget) = "polite"
whyWord(RunsAlone) = "alone"
whyWord(ForAlone(_)) = "for-alone"
whyWord(LowWaits) = "low"
whyWord(Reserved(_)) = "reserved"

// The job a reason names, as the field beside its word: `behind` for `Behind`, `draining_for` for
// `DrainingFor`, `exclusive_id` for `ForExclusive` (beside the job's own `exclusive`), `alone_id` for
// `ForAlone`; and for `Load`, `load`, `load_limit` and `calm_ms`. Nothing for the rest.
private whyId(why: Why) -> Vector[(string, Json)]
whyId(Behind(id)) = [("behind", Json.num(id))]
whyId(DrainingFor(id)) = [("draining_for", Json.num(id))]
whyId(ForExclusive(id)) = [("exclusive_id", Json.num(id))]
whyId(ForAlone(id)) = [("alone_id", Json.num(id))]
whyId(DiskLow(free)) = [("disk_free", Json.num(free))]
whyId(MemoryPressure(cause)) = [("pressure", Json.str(cause))]
whyId(Reserved(owner)) = [("reserved_for", Json.str(owner))]
whyId(Load(load, limit, calmMs)) = [
  ("load", Json.num(load)),
  ("load_limit", Json.num(limit)),
  ("calm_ms", Json.num(calmMs))
]
whyId(_) = Vector[(string, Json)]()

// A `Found` job on the wire: the job, with `waits` and the job its reason names when it waits.
private encodeFound(j: JobInfo, why: Option[Why]) -> Json = why match
  Some(w) -> Json.Obj(encodeJob(j).asMembers.get ++ [("waits", Json.str(whyWord(w)))] ++ whyId(w))
  None -> encodeJob(j)

private decodeFound(j: Json) -> Result[Reply, string] =
  Ok(Found(decodeJob(j)?, if j.has("waits") then Some(decodeWhy(j)?) else None))

// What `marshal status <id> --json` prints: the job as `ls` encodes it, with `exit`, the status
// `wait` exits with (null until it has ended), and, while it is queued, `why` and the job its reason
// names, as `status --json` gives them.
jobStatusJson(j: JobInfo, why: Option[Why]) -> Json
  val exit = [("exit", j.outcome.map(o -> Json.num(exitCode(o))).getOrElse(Json.Null))]
  val reason = why.map(w -> [("why", Json.str(whyWord(w)))] ++ whyId(w)).getOrElse([])
  Json.Obj(encodeJob(j).asMembers.get ++ exit ++ reason)

private encodeQueued(q: QueuedJob) -> Json =
  Json.Obj(
    encodeJob(q.job).asMembers.get ++ [
      ("position", Json.num(q.position)),
      ("waits", Json.str(whyWord(q.why)))
    ] ++ whyId(q.why)
  )

private decodeWhy(j: Json) -> Result[Why, string]
  field(j, "waits", v -> v.asString, "a string")? match
    "units" -> Ok(NoUnits)
    "memory" -> Ok(NoMemory)
    "lane" -> Ok(LaneBusy)
    "draining" -> Ok(Draining)
    "take-slot" -> Ok(ForTakeSlot)
    "behind" -> Ok(Behind(field(j, "behind", v -> v.asLong, "a whole number")?))
    "draining-for" -> Ok(DrainingFor(field(j, "draining_for", v -> v.asLong, "a whole number")?))
    "starting" -> Ok(Starting)
    "held" -> Ok(Held)
    "queue-held" -> Ok(QueueHeld)
    "quick-lane" -> Ok(QuickFull)
    "emptying" -> Ok(Emptying)
    "load" -> Ok(
      Load(
        field(j, "load", v -> v.asReal, "a number")?,
        field(j, "load_limit", v -> v.asReal, "a number")?,
        field(j, "calm_ms", v -> v.asLong, "a whole number")?
      )
    )
    "exclusive" -> Ok(ForExclusive(field(j, "exclusive_id", v -> v.asLong, "a whole number")?))
    "disk-low" -> Ok(DiskLow(field(j, "disk_free", v -> v.asLong, "a whole number")?))
    "memory-pressure" -> Ok(MemoryPressure(field(j, "pressure", v -> v.asString, "a string")?))
    "polite" -> Ok(PoliteBudget)
    "alone" -> Ok(RunsAlone)
    "for-alone" -> Ok(ForAlone(field(j, "alone_id", v -> v.asLong, "a whole number")?))
    "low" -> Ok(LowWaits)
    "reserved" -> Ok(Reserved(field(j, "reserved_for", v -> v.asString, "a string")?))
    other -> Err(s"no such reason to wait: `$other`")

private decodeQueued(j: Json) -> Result[QueuedJob, string] =
  Ok(QueuedJob(decodeJob(j)?, field(j, "position", v -> v.asInt, "an int")?, decodeWhy(j)?))

encodeOverview(o: Overview) -> Json = Json.Obj(
  Json.obj(
    ("units", unitsJson(o.usage.units)),
    ("unit_budget", unitsJson(o.usage.unitBudget)),
    ("mem", Json.num(o.usage.memory)),
    ("mem_budget", Json.num(o.usage.memoryBudget)),
    ("rss", Json.num(o.usage.rss)),
    ("mem_held", Json.num(o.usage.held)),
    ("machine_mem", Json.num(o.usage.machineMemory)),
    ("landing", o.usage.landing.map(id -> Json.num(id)).getOrElse(Json.Null)),
    ("take_slot", o.usage.takeSlot.map(encodeTakeSlot).getOrElse(Json.Null)),
    ("queue_held", Json.Bool(o.usage.queueHeld)),
    ("quick", Json.num(o.usage.quick)),
    ("exclusive", o.usage.exclusive.map(id -> Json.num(id)).getOrElse(Json.Null)),
    ("polite", politeJson(o.usage.polite)),
    ("reserve", reserveJson(o.usage.reserve)),
    ("uptime_ms", Json.num(o.uptimeMs)),
    ("running", Json.Arr(o.running.map(encodeJob))),
    ("queued", Json.Arr(o.queued.map(encodeQueued))),
    ("recent", Json.Arr(o.recent.map(encodeJob))),
    ("waiting", Json.Arr(o.waiting.map(encodeJob)))
  ).asMembers.get ++ machineMembers(o.usage)
)

private each[T](j: Json, key: string, read: (Json) -> Result[T, string]) -> Result[Vector[T], string]
  val items = field(j, key, v -> v.asVector, "an array")?
  val out = Buffer[T]()
  for item in items do out += read(item)?
  Ok(out.toVector)

decodeOverview(j: Json) -> Result[Overview, string]
  val running = each(j, "running", decodeJob)?
  val queued = each(j, "queued", decodeQueued)?
  Ok(
    Overview(
      withMachine(
        Usage(
          field(j, "units", quartersOf, unitsWanted)?,
          field(j, "unit_budget", quartersOf, unitsWanted)?,
          field(j, "mem", v -> v.asLong, "a whole number")?,
          field(j, "mem_budget", v -> v.asLong, "a whole number")?,
          running.length,
          queued.filter(q -> !settling(q.job)).length,
          optional(j, "landing", someLong, "a whole number", None)?,
          decodeTakeSlot(j.get("take_slot").getOrElse(Json.Null))?,
          optional(j, "rss", wholeNumber, "a whole number", 0)?,
          optional(j, "machine_mem", wholeNumber, "a whole number", 0)?,
          optional(j, "queue_held", v -> v.asBool, "a bool", false)?,
          optional(j, "mem_held", wholeNumber, "a whole number", 0)?,
          optional(j, "quick", v -> v.asInt, "an int", 0)?,
          optional(j, "exclusive", someLong, "a whole number", None)?,
          settling = queued.filter(q -> settling(q.job)).length,
          polite = decodePolite(j)?,
          reserve = decodeReserve(j)?
        ),
        machineOf(j)?
      ),
      field(j, "uptime_ms", v -> v.asLong, "a whole number")?,
      running,
      queued,
      each(j, "recent", decodeJob)?,
      if j.has("waiting") then each(j, "waiting", decodeJob)? else Vector[JobInfo]()
    )
  )
