module dev.avinlang.marshal

// What the command line and the daemon say to each other: one JSON object per line each way, a
// request and then its reply. docs/protocol.md describes the text.
import json
import json.Json

// marshal's version, as `avin.hocon` gives it: what `marshal version` and `marshal restart` print.
val Version: string = "0.2.11"

// What a job is to run and how much of the machine it takes. `urgent` queues it in its lane's urgent
// band, behind the urgent jobs already queued and ahead of every other. `after` names the jobs it
// waits for: it queues once they have all ended, and with `afterAny` false only if each of them
// succeeded. `retries` is how many times more it runs after failing or timing out, `retryDelayMs`
// after how long. `memoryGiven` says the memory was given (`--mem`), so `--mem 0` opts out of the
// reservation learned from the kind's peaks; a memory above 0 counts as given either way. `label`
// is free text the submitter gave the job to find it by ("" for none; see `checkLabel`). `quietMs`
// stops a running job whose log has had no new output for that long (0 for none; see quiet.avin).
// `external` says the job's work runs outside its own process tree (a container, a VM, another
// account's daemon), so what its tree holds is not what it uses: it reserves the memory it gave,
// which it must give, and its measured peak is never learned from.
// `quick` runs it in the quick lane: at once, outside the unit budget, within `QuickCapMs`.
data JobSpec(
    kind: string,
    units: int,
    memory: long,
    landing: bool,
    dir: string,
    deadlineMs: Option[long],
    cmd: Vector[string],
    env: Vector[(string, string)],
    urgent: bool = false,
    after: Vector[long] = [],
    afterAny: bool = false,
    retries: int = 0,
    retryDelayMs: long = 0,
    memoryGiven: bool = false,
    label: string = "",
    quietMs: long = 0,
    external: bool = false,
    quick: bool = false)

// The longest label, in characters.
val MaxLabel: int = 80

// A label as a job may carry it: `text` itself when it is one, or why it is not. A label is one line
// of 1 to `MaxLabel` characters with no control characters (a newline, a tab) and no space at either
// end; a longer one is refused, not cut.
checkLabel(text: string) -> Result[string, string]
    if text.isEmpty() then return Err("a label is text, not empty")
    if text.chars().exists(c -> c < ' ' || '\u{7f}' <= c <= '\u{9f}') then return Err("a label is one line of printable text: no newline, tab or other control character")
    if text.trim() != text then return Err("a label does not begin or end with a space")
    if text.charCount() > MaxLabel then return Err(s"a label is at most $MaxLabel characters, not ${text.charCount()}")
    Ok(text)

data Request
    Submit(spec: JobSpec)
    Wait(id: long)
    Kill(id: long)
    List
    Status
    // Everything a live view shows: the budget, the running, queued and recent jobs, and why each
    // queued job waits.
    Snapshot
    Stop(force: bool, drain: bool)
    // Which marshal the daemon is and its process.
    Hello
    // The daemon replaces itself with a program, keeping its jobs: the one the command line was run
    // from when it sends its path, else the one at the daemon's own path.
    Restart(program: Option[string])
    // Submits again a job that has ended, as it was submitted.
    Rerun(id: long)
    // Holds the queue, both lanes: running jobs go on and nothing new starts.
    PauseQueue
    // Releases the queue PauseQueue held.
    ResumeQueue
    // Stops a running job's whole process group, keeping its units and stopping its deadline's
    // clock, and continues it.
    PauseJob(id: long)
    ResumeJob(id: long)
    // Keeps one queued job from starting, and lets it start again.
    Hold(id: long)
    Release(id: long)
    // Places a queued job: by a priority number among the jobs not urgent, or at the back of its
    // lane's urgent band.
    Prioritize(id: long, priority: Priority)
    // Removes the files of ended jobs, stale run directories and unused compiled steps (see clean.avin).
    Clean(rule: CleanRule)
    // Follows events: `source` is the condition as written, `cond` what it parses to. The daemon
    // streams replies until the watch ends, which `mode` says; `since` and `sinceId` ask for the
    // events already in the log from a time (milliseconds since 1970, inclusive) and from a job.
    Watch(source: string, cond: Condition, mode: Mode, since: Option[long], sinceId: Option[long])

// The priority a queued job is given: a number (higher first, equal ones in arrival order, all
// behind the urgent band), or the back of the urgent band.
data Priority
    Level(n: int)
    Urgent

// How a job ended. `DependencyFailed` cancels a job waiting for job `after`, which did not succeed.
// `Quiet` is a job stopped because its log had no new output for `afterMs` (its quiet timeout).
data Outcome
    Exited(code: int)
    Signalled(signal: int)
    TimedOut
    Cancelled
    Lost
    DependencyFailed(after: long)
    Quiet(afterMs: long)

// The exit status `wait` and `run` end with: the job's own code, 128 + the signal that ended it,
// 124 for a timeout (its deadline or its quiet timeout), 143 for a job cancelled before it started
// (as a TERM would), 125 for a job lost with a daemon that died and 126 for a job cancelled because a
// job it waited for failed.
exitCode(o: Outcome) -> int
exitCode(Exited(code)) = code
exitCode(Signalled(sig)) = 128 + sig
exitCode(TimedOut) = 124
exitCode(Quiet(_)) = 124
exitCode(Cancelled) = 143
exitCode(Lost) = 125
exitCode(DependencyFailed(_)) = 126

// Whether a job that ended so succeeded, as a job waiting for it with `--after-ok` asks.
succeeded(o: Outcome) -> bool = o == Exited(0)

// Whether a job that ended so failed in a way another attempt may mend: a nonzero exit, a signal it
// was not sent by `kill`, its deadline, or its quiet timeout.
retryable(o: Outcome, killed: bool) -> bool
retryable(_, true) = false
retryable(Exited(code), _) = code != 0
retryable(Signalled(_) | TimedOut | Quiet(_), _) = true
retryable(_, _) = false

// One job as a listing shows it. `state` is `waiting` (for the jobs it runs after), `queued`,
// `running`, `retrying` (waiting out its retry delay) or `done`; `elapsedMs` is the time run, 0 for a
// waiting, queued or retrying job (`queuedMs` is how long it has waited). `memory` is the memory it declared;
// `rss` the bytes its whole process tree held in RAM when the daemon last measured it, 0 unless it
// runs; `peakRss` the most any measurement found, kept once it has ended; `startedAt` when it
// started on the wall clock, in milliseconds since 1970, 0 while it waits. `held` says a waiting or
// queued job is kept from starting by hand; `priority` places it in its lane's queue, and `urgent`
// puts it in the lane's urgent band, ahead of every job not urgent whatever its priority. `paused`
// says a running job's processes are stopped by `pause`; its `elapsedMs` leaves its pauses out.
// `after` is what a waiting job still waits for, the jobs that have not ended yet; `attempt` counts
// its runs from 1. `reserved` is the memory the scheduler counts for it, its effective reservation:
// the memory it declared, or, with `reservedLearned`, what its kind's peaks taught (memory.avin).
// `label` is the text its submitter gave it, "" for none; `quietMs` its quiet timeout, 0 for none.
// `reservedFrom` says where the reservation came from (`reservationSource`: `given`, `kind+dir`,
// `kind` or `none`), "" from a daemon that does not say.
// `external` says its work runs outside its process tree (`JobSpec`); `quick` says it is in the
// quick lane. `expectedMs` is how long it is expected to run (0 where not said), `durationLearned`
// whether that is learned from its kind's runs rather than guessed from the default deadline, and
// `expectedStart`, on the job the machine drains for, when it is expected to start (wall-clock
// milliseconds; 0 for any other job, or when that is not known).
data JobInfo(
    id: long,
    kind: string,
    units: int,
    memory: long,
    landing: bool,
    dir: string,
    cmd: Vector[string],
    state: string,
    outcome: Option[Outcome],
    killed: bool,
    queuedMs: long,
    elapsedMs: long,
    deadlineMs: long,
    log: string,
    sample: Option[string],
    rss: long = 0,
    peakRss: long = 0,
    startedAt: long = 0,
    held: bool = false,
    priority: int = 0,
    urgent: bool = false,
    paused: bool = false,
    after: Vector[long] = [],
    attempt: int = 1,
    reserved: long = 0,
    reservedLearned: bool = false,
    label: string = "",
    quietMs: long = 0,
    reservedFrom: string = "",
    external: bool = false,
    quick: bool = false,
    expectedMs: long = 0,
    durationLearned: bool = false,
    expectedStart: long = 0)

// The memory a listing shows for a job: its reservation, `~` before one learned from its kind's
// peaks, `@` before that of a job whose work runs elsewhere (`--external`); `-` for none. A job that
// says no reservation shows the memory it declared.
reservedText(j: JobInfo) -> string
    if j.reservedLearned && j.reserved > 0 then return "~" + roundSize(j.reserved)
    val r = if j.reserved > j.memory then j.reserved else j.memory
    if j.external then return "@" + formatSize(r)
    if r == 0 then "-" else formatSize(r)

// The budget in use. `memory` is what the running jobs reserve (declared or learned); `rss` what
// their process trees hold in RAM, as last measured; `held` what admission counts them as holding,
// each job's reservation or its measured memory, whichever is more; `machineMemory` the memory the
// machine has, 0 where it is not known; `queueHeld` says the queue is held: nothing new starts in
// either lane; `quick` is how many quick jobs run, of the quick lane's `QuickSlots`.
data Usage(
    units: int,
    unitBudget: int,
    memory: long,
    memoryBudget: long,
    running: int,
    queued: int,
    landing: Option[long],
    takeSlot: Option[TakeSlotUse],
    rss: long = 0,
    machineMemory: long = 0,
    queueHeld: bool = false,
    held: long = 0,
    quick: int = 0)

// What take-slot.zsh holds in the directory `dir` that marshal shares: units its runs hold, how many
// of its runs wait, and whether one of them holds the landing lane.
data TakeSlotUse(dir: string, units: int, waiting: int, landing: bool)

// Why a queued job has not started: its units do not fit beside what runs, its memory does not, it
// is a landing job and the lane is held, it is a landing job whose memory does not fit and it waits
// for running jobs to free it while nothing else starts, it waits for what take-slot holds or for a
// take-slot run ahead of it, it fits but starting it would delay job `id` at the head of the queue
// (or a landing job `id` drains the machine), or it starts at the daemon's next look; or it is held,
// or the whole queue is; or it is a quick job and the quick lane's slots are all taken; or the
// development job `id` has waited past the bound and the machine drains for it (`DrainingFor`).
// The job the machine drains for waits `Draining` too.
data Why
    NoUnits
    NoMemory
    LaneBusy
    Draining
    ForTakeSlot
    Behind(id: long)
    DrainingFor(id: long)
    Starting
    Held
    QueueHeld
    QuickFull

// A queued job, its place in its lane's queue (from 1; landing jobs, quick jobs and development jobs
// each have a queue), and why it waits.
data QueuedJob(job: JobInfo, position: int, why: Why)

// What `marshal top` draws: the budget in use, how long the daemon has run, the running jobs, the
// queued ones, the jobs that ended last, the latest first, and the jobs waiting for others or
// waiting to retry, oldest first.
data Overview(usage: Usage, uptimeMs: long, running: Vector[JobInfo], queued: Vector[QueuedJob], recent: Vector[JobInfo], waiting: Vector[JobInfo] = [])

data Reply
    // `hint` is advice for the submitter ("" for none): see `quickHint`.
    Submitted(id: long, log: string, hint: string = "")
    Ended(job: JobInfo)
    Jobs(jobs: Vector[JobInfo])
    Using(usage: Usage)
    Viewed(overview: Overview)
    // The daemon's version and process id.
    Hi(version: string, pid: long)
    // One event of a watch, as the log holds it, or the events of its backlog together.
    Streamed(event: Json)
    Replayed(events: Vector[Json])
    // What a clean removed.
    Cleaned(report: CleanReport)
    Done
    Failed(message: string)

// Requests.

private strings(xs: Vector[string]) -> Json = Json.Arr(xs.map(x -> Json.str(x)))

encodeRequest(r: Request) -> Json
encodeRequest(Submit(s)) = Json.Obj([("op", Json.str("submit"))] ++ encodeSpec(s).asMembers().get())
encodeRequest(Wait(id)) = Json.obj(("op", Json.str("wait")), ("id", Json.num(id)))
encodeRequest(Kill(id)) = Json.obj(("op", Json.str("kill")), ("id", Json.num(id)))
encodeRequest(List) = Json.obj(("op", Json.str("ls")))
encodeRequest(Status) = Json.obj(("op", Json.str("status")))
encodeRequest(Snapshot) = Json.obj(("op", Json.str("snapshot")))
encodeRequest(Stop(force, drain)) = Json.obj(("op", Json.str("stop")), ("force", Json.Bool(force)), ("wait", Json.Bool(drain)))
encodeRequest(Hello) = Json.obj(("op", Json.str("version")))
encodeRequest(Restart(program)) = Json.Obj([("op", Json.str("restart"))] ++ program.map(p -> [("program", Json.str(p))]).getOrElse([]))
encodeRequest(Rerun(id)) = Json.obj(("op", Json.str("rerun")), ("id", Json.num(id)))
encodeRequest(Clean(rule)) = Json.obj(
    ("op", Json.str("clean")),
    ("older_ms", rule.olderMs.map(n -> Json.num(n)).getOrElse(Json.Null)),
    ("keep", rule.keep.map(n -> Json.num(n)).getOrElse(Json.Null)),
    ("dry_run", Json.Bool(rule.dryRun)))
encodeRequest(PauseQueue) =Json.obj(("op", Json.str("pause")))
encodeRequest(ResumeQueue) = Json.obj(("op", Json.str("resume")))
encodeRequest(PauseJob(id)) = Json.obj(("op", Json.str("pause")), ("id", Json.num(id)))
encodeRequest(ResumeJob(id)) = Json.obj(("op", Json.str("resume")), ("id", Json.num(id)))
encodeRequest(Hold(id)) = Json.obj(("op", Json.str("hold")), ("id", Json.num(id)))
encodeRequest(Release(id)) = Json.obj(("op", Json.str("release")), ("id", Json.num(id)))
encodeRequest(Prioritize(id, Level(n))) = Json.obj(("op", Json.str("priority")), ("id", Json.num(id)), ("priority", Json.num(n)))
encodeRequest(Prioritize(id, Urgent)) = Json.obj(("op", Json.str("priority")), ("id", Json.num(id)), ("priority", Json.str("urgent")))
encodeRequest(Watch(source, _, mode, since, sinceId)) = Json.obj(
    ("op", Json.str("watch")), ("cond", Json.str(source)), ("mode", Json.str(modeWord(mode))),
    ("since", since.map(n -> Json.num(n)).getOrElse(Json.Null)),
    ("since_id", sinceId.map(n -> Json.num(n)).getOrElse(Json.Null)))

private modeWord(m: Mode) -> string
modeWord(Once) = "once"
modeWord(Past) = "past"
modeWord(Follow) = "follow"

// Whether a request is a watch, answered with a stream rather than one reply.
watching(r: Request) -> bool
watching(Watch(_, _, _, _, _)) = true
watching(_) = false

private decodeWatch(j: Json) -> Result[Request, string]
    val source = field(j, "cond", v -> v.asString(), "a string")?
    val cond = parseCondition(source).mapErr(e -> s"bad condition: $e")?
    val mode = field(j, "mode", v -> v.asString(), "a string")? match
        "once" -> Once
        "past" -> Past
        "follow" -> Follow
        other -> return Err(s"`mode` is not once, past or follow: `$other`")
    if mode != Once && parseFilter(source).isErr() then return Err("bad condition: events takes an event filter, not `idle` or `job=`")
    Ok(Watch(source, cond, mode, optional(j, "since", someLong, "a whole number", None)?, optional(j, "since_id", someLong, "a whole number", None)?))

private longs(xs: Vector[long]) -> Json = Json.Arr(xs.map(x -> Json.num(x)))

// A job's specification, as a submit request carries it after its `op`.
encodeSpec(s: JobSpec) -> Json = Json.Obj(Json.obj(
    ("kind", Json.str(s.kind)),
    ("units", Json.num(s.units)),
    ("mem", Json.num(s.memory)),
    ("landing", Json.Bool(s.landing)),
    ("dir", Json.str(s.dir)),
    ("deadline_ms", s.deadlineMs.map(d -> Json.num(d)).getOrElse(Json.Null)),
    ("cmd", strings(s.cmd)),
    ("env", Json.Obj(s.env.map(e -> (e.0, Json.str(e.1))))),
    ("urgent", Json.Bool(s.urgent)),
    ("after", longs(s.after)),
    ("after_any", Json.Bool(s.afterAny)),
    ("retries", Json.num(s.retries)),
    ("retry_delay_ms", Json.num(s.retryDelayMs)),
    ("mem_given", Json.Bool(s.memoryGiven))).asMembers().get() ++ labelMember(s.label) ++ quietMember(s.quietMs) ++ externalMember(s.external) ++ quickMember(s.quick))

// An external job's member of an object: none for a job whose work is its own processes', as with a
// label.
private externalMember(external: bool) -> Vector[(string, Json)] = if external then [("external", Json.Bool(true))] else []

// The quick lane's member of an object: none for a job not in it, as with a label.
private quickMember(quick: bool) -> Vector[(string, Json)] = if quick then [("quick", Json.Bool(true))] else []

// A label's member of an object: none for no label, so what marshal wrote before labels and what it
// writes for a job without one are the same.
private labelMember(label: string) -> Vector[(string, Json)] = if label.isEmpty() then [] else [("label", Json.str(label))]

// A quiet timeout's member of an object: none for no quiet timeout, as with a label.
private quietMember(ms: long) -> Vector[(string, Json)] = if ms <= 0 then [] else [("quiet_ms", Json.num(ms))]

// A quiet timeout read from an object: 0 where it is absent or null, an error where it is not a
// whole number above 0.
private quietOf(j: Json) -> Result[long, string] = j.get("quiet_ms") match
    None | Some(Json.Null) -> Ok(0)
    Some(v) -> v.asLong() match
        Some(n) if n > 0 -> Ok(n)
        _ -> Err("`quiet_ms` is not a whole number above 0")

// A label read from an object: "" where it is absent, an error where it is not a label.
private labelOf(j: Json) -> Result[string, string] = j.get("label") match
    None | Some(Json.Null) -> Ok("")
    Some(v) -> v.asString() match
        Some(s) -> checkLabel(s).mapErr(e -> s"`label`: $e")
        None -> Err("`label` is not a string")

decodeSpec(j: Json) -> Result[JobSpec, string]
    val cmd = field(j, "cmd", stringVector, "an array of strings")?
    if cmd.isEmpty() then return Err("`cmd` is empty: a job runs a command")
    Ok(JobSpec(
        field(j, "kind", v -> v.asString(), "a string")?,
        field(j, "units", v -> v.asInt(), "an int")?,
        field(j, "mem", v -> v.asLong(), "a whole number")?,
        optional(j, "landing", v -> v.asBool(), "a bool", false)?,
        field(j, "dir", v -> v.asString(), "a string")?,
        optional(j, "deadline_ms", someLong, "a whole number", None)?,
        cmd,
        optional(j, "env", stringPairs, "an object of strings", Vector[(string, string)]())?,
        optional(j, "urgent", v -> v.asBool(), "a bool", false)?,
        optional(j, "after", longVector, "an array of job ids", Vector[long]())?,
        optional(j, "after_any", v -> v.asBool(), "a bool", false)?,
        optional(j, "retries", v -> v.asInt(), "an int", 0)?,
        optional(j, "retry_delay_ms", v -> v.asLong(), "a whole number", long(0))?,
        optional(j, "mem_given", v -> v.asBool(), "a bool", false)?,
        labelOf(j)?,
        quietOf(j)?,
        // absent from what marshal wrote before external jobs, and for a job that is not one
        optional(j, "external", v -> v.asBool(), "a bool", false)?,
        optional(j, "quick", v -> v.asBool(), "a bool", false)?))

private field[T](j: Json, key: string, read: (Json) -> Option[T], what: string) -> Result[T, string] =
    j.get(key) match
        Some(v) -> read(v) match
            Some(x) -> Ok(x)
            None -> Err(s"`$key` is not $what")
        None -> Err(s"`$key` is missing")

private optional[T](j: Json, key: string, read: (Json) -> Option[T], what: string, absent: T) -> Result[T, string] =
    j.get(key) match
        Some(Json.Null) -> Ok(absent)
        Some(v) -> read(v) match
            Some(x) -> Ok(x)
            None -> Err(s"`$key` is not $what")
        None -> Ok(absent)

private stringVector(j: Json) -> Option[Vector[string]] = j.asVector() match
    Some(items) if items.forall(i -> i.asString().isDefined()) -> Some(items.map(i -> i.asString().get()))
    _ -> None

private longVector(j: Json) -> Option[Vector[long]] = j.asVector() match
    Some(items) if items.forall(i -> i.asLong().isDefined()) -> Some(items.map(i -> i.asLong().get()))
    _ -> None

private stringPairs(j: Json) -> Option[Vector[(string, string)]] = j.asMembers() match
    Some(ms) if ms.forall(m -> m.1.asString().isDefined()) -> Some(ms.map(m -> (m.0, m.1.asString().get())))
    _ -> None

private someLong(j: Json) -> Option[Option[long]] = j.asLong().map(n -> Some(n))
private wholeNumber(j: Json) -> Option[long] = j.asLong()

decodeRequest(text: string) -> Result[Request, string]
    val j = json.parse(text) match
        Ok(v) -> v
        Err(e) -> return Err(s"not JSON: $e")
    if j.asMembers().isEmpty() then return Err("a request is a JSON object")
    val op = field(j, "op", v -> v.asString(), "a string")?
    op match
        "submit" -> Ok(Submit(decodeSpec(j)?))
        "wait" -> Ok(Wait(field(j, "id", v -> v.asLong(), "a whole number")?))
        "kill" -> Ok(Kill(field(j, "id", v -> v.asLong(), "a whole number")?))
        "ls" -> Ok(List)
        "status" -> Ok(Status)
        "snapshot" -> Ok(Snapshot)
        "stop" -> Ok(Stop(optional(j, "force", v -> v.asBool(), "a bool", false)?, optional(j, "wait", v -> v.asBool(), "a bool", false)?))
        "version" -> Ok(Hello)
        "restart" -> Ok(Restart(if j.has("program") then Some(field(j, "program", v -> v.asString(), "a string")?) else None))
        "rerun" -> Ok(Rerun(field(j, "id", v -> v.asLong(), "a whole number")?))
        "pause" -> if j.has("id") then Ok(PauseJob(field(j, "id", v -> v.asLong(), "a whole number")?)) else Ok(PauseQueue)
        "resume" -> if j.has("id") then Ok(ResumeJob(field(j, "id", v -> v.asLong(), "a whole number")?)) else Ok(ResumeQueue)
        "hold" -> Ok(Hold(field(j, "id", v -> v.asLong(), "a whole number")?))
        "release" -> Ok(Release(field(j, "id", v -> v.asLong(), "a whole number")?))
        "priority" -> Ok(Prioritize(field(j, "id", v -> v.asLong(), "a whole number")?, field(j, "priority", priorityOf, "a whole number or \"urgent\"")?))
        "clean" ->
            val older = optional(j, "older_ms", someLong, "a whole number", None)?
            val keep = optional(j, "keep", v -> v.asInt().map(n -> Some(n)), "a whole number", None)?
            if older.exists(n -> n < 1) then return Err("`older_ms` is at least 1")
            if keep.exists(n -> n < 0) then return Err("`keep` is 0 or more")
            Ok(Clean(CleanRule(older, keep, optional(j, "dry_run", v -> v.asBool(), "a bool", false)?)))
        "watch" -> decodeWatch(j)
        other -> Err(s"no such request: `$other`")

private priorityOf(j: Json) -> Option[Priority] = j.asString() match
    Some("urgent") -> Some(Urgent)
    Some(_) -> None
    None -> j.asInt().map(n -> Level(n))

// Outcomes.

encodeOutcome(o: Outcome) -> Json
encodeOutcome(Exited(code)) = Json.obj(("how", Json.str("exit")), ("code", Json.num(code)))
encodeOutcome(Signalled(sig)) = Json.obj(("how", Json.str("signal")), ("signal", Json.num(sig)))
encodeOutcome(TimedOut) = Json.obj(("how", Json.str("timeout")))
encodeOutcome(Cancelled) = Json.obj(("how", Json.str("cancelled")))
encodeOutcome(Lost) = Json.obj(("how", Json.str("lost")))
encodeOutcome(DependencyFailed(after)) = Json.obj(("how", Json.str("dependency-failed")), ("after", Json.num(after)))
encodeOutcome(Quiet(afterMs)) = Json.obj(("how", Json.str("quiet")), ("after_ms", Json.num(afterMs)))

decodeOutcome(j: Json) -> Result[Outcome, string]
    field(j, "how", v -> v.asString(), "a string")? match
        "exit" -> Ok(Exited(field(j, "code", v -> v.asInt(), "an int")?))
        "signal" -> Ok(Signalled(field(j, "signal", v -> v.asInt(), "an int")?))
        "timeout" -> Ok(TimedOut)
        "cancelled" -> Ok(Cancelled)
        "lost" -> Ok(Lost)
        "dependency-failed" -> Ok(DependencyFailed(field(j, "after", v -> v.asLong(), "a whole number")?))
        "quiet" -> Ok(Quiet(field(j, "after_ms", v -> v.asLong(), "a whole number")?))
        other -> Err(s"no such outcome: `$other`")

// Replies.

encodeJob(i: JobInfo) -> Json = Json.Obj(Json.obj(
    ("id", Json.num(i.id)),
    ("kind", Json.str(i.kind)),
    ("units", Json.num(i.units)),
    ("mem", Json.num(i.memory)),
    ("landing", Json.Bool(i.landing)),
    ("dir", Json.str(i.dir)),
    ("cmd", strings(i.cmd)),
    ("state", Json.str(i.state)),
    ("outcome", i.outcome.map(encodeOutcome).getOrElse(Json.Null)),
    ("killed", Json.Bool(i.killed)),
    ("queued_ms", Json.num(i.queuedMs)),
    ("elapsed_ms", Json.num(i.elapsedMs)),
    ("deadline_ms", Json.num(i.deadlineMs)),
    ("log", Json.str(i.log)),
    ("sample", i.sample.map(s -> Json.str(s)).getOrElse(Json.Null)),
    ("rss", Json.num(i.rss)),
    ("peak_rss", Json.num(i.peakRss)),
    ("started_at", Json.num(i.startedAt)),
    ("held", Json.Bool(i.held)),
    ("priority", Json.num(i.priority)),
    ("urgent", Json.Bool(i.urgent)),
    ("paused", Json.Bool(i.paused)),
    ("after", longs(i.after)),
    ("attempt", Json.num(i.attempt)),
    ("resv", Json.num(i.reserved)),
    ("resv_learned", Json.Bool(i.reservedLearned))).asMembers().get() ++ labelMember(i.label) ++ quietMember(i.quietMs) ++ resvFromMember(i.reservedFrom) ++ externalMember(i.external) ++ quickMember(i.quick) ++ expectedMembers(i))

// `resv_from` is left out where the daemon did not say where a reservation came from.
private resvFromMember(from: string) -> Vector[(string, Json)] = if from.isEmpty() then [] else [("resv_from", Json.str(from))]

// `expected_ms` and `duration_learned` are left out where the daemon did not say how long a job is
// expected to run; `expected_start_at` is there only on the job the machine drains for.
private expectedMembers(i: JobInfo) -> Vector[(string, Json)]
    val expected = if i.expectedMs > 0 then [("expected_ms", Json.num(i.expectedMs)), ("duration_learned", Json.Bool(i.durationLearned))] else Vector[(string, Json)]()
    val start = if i.expectedStart > 0 then [("expected_start_at", Json.num(i.expectedStart))] else Vector[(string, Json)]()
    expected ++ start

decodeJob(j: Json) -> Result[JobInfo, string]
    val outcome = j.get("outcome") match
        Some(Json.Null) -> None
        Some(o) -> Some(decodeOutcome(o)?)
        None -> None
    val memory = field(j, "mem", v -> v.asLong(), "a whole number")?
    Ok(JobInfo(
        field(j, "id", v -> v.asLong(), "a whole number")?,
        field(j, "kind", v -> v.asString(), "a string")?,
        field(j, "units", v -> v.asInt(), "an int")?,
        memory,
        field(j, "landing", v -> v.asBool(), "a bool")?,
        field(j, "dir", v -> v.asString(), "a string")?,
        field(j, "cmd", stringVector, "an array of strings")?,
        field(j, "state", v -> v.asString(), "a string")?,
        outcome,
        field(j, "killed", v -> v.asBool(), "a bool")?,
        field(j, "queued_ms", v -> v.asLong(), "a whole number")?,
        field(j, "elapsed_ms", v -> v.asLong(), "a whole number")?,
        field(j, "deadline_ms", v -> v.asLong(), "a whole number")?,
        field(j, "log", v -> v.asString(), "a string")?,
        optional(j, "sample", v -> v.asString().map(s -> Some(s)), "a string", None)?,
        // absent from what marshal wrote before it measured memory, or held and ordered jobs
        optional(j, "rss", wholeNumber, "a whole number", 0)?,
        optional(j, "peak_rss", wholeNumber, "a whole number", 0)?,
        optional(j, "started_at", wholeNumber, "a whole number", 0)?,
        optional(j, "held", v -> v.asBool(), "a bool", false)?,
        optional(j, "priority", v -> v.asInt(), "an int", 0)?,
        optional(j, "urgent", v -> v.asBool(), "a bool", false)?,
        optional(j, "paused", v -> v.asBool(), "a bool", false)?,
        // absent from what marshal wrote before jobs waited for others and retried
        optional(j, "after", longVector, "an array of job ids", Vector[long]())?,
        optional(j, "attempt", v -> v.asInt(), "an int", 1)?,
        // absent from what marshal wrote before it learned reservations: the declared memory
        optional(j, "resv", wholeNumber, "a whole number", memory)?,
        optional(j, "resv_learned", v -> v.asBool(), "a bool", false)?,
        // absent from what marshal wrote before labels: no label; one already logged is read as it is
        optional(j, "label", v -> v.asString(), "a string", "")?,
        // absent from what marshal wrote before quiet timeouts, and for a job without one: none
        quietOf(j)?,
        // absent from what marshal wrote before it learned per directory: not said
        optional(j, "resv_from", v -> v.asString(), "a string", "")?,
        optional(j, "external", v -> v.asBool(), "a bool", false)?,
        // absent from what marshal wrote before the quick lane, and for a job not in it
        optional(j, "quick", v -> v.asBool(), "a bool", false)?,
        // absent from what marshal wrote before it said how long a job is expected to run
        optional(j, "expected_ms", wholeNumber, "a whole number", 0)?,
        optional(j, "duration_learned", v -> v.asBool(), "a bool", false)?,
        // absent on every job but the one the machine drains for
        optional(j, "expected_start_at", wholeNumber, "a whole number", 0)?))

encodeTakeSlot(t: TakeSlotUse) -> Json = Json.obj(
    ("dir", Json.str(t.dir)),
    ("units", Json.num(t.units)),
    ("waiting", Json.num(t.waiting)),
    ("landing", Json.Bool(t.landing)))

private decodeTakeSlot(j: Json) -> Result[Option[TakeSlotUse], string]
    if j == Json.Null then return Ok(None)
    Ok(Some(TakeSlotUse(
        field(j, "dir", v -> v.asString(), "a string")?,
        field(j, "units", v -> v.asInt(), "an int")?,
        field(j, "waiting", v -> v.asInt(), "an int")?,
        field(j, "landing", v -> v.asBool(), "a bool")?)))

// What `status --json` prints: the budget in use, what take-slot holds (null when no directory is
// shared), and the running and queued jobs, each as the protocol gives a job. A queued job in `whys`
// (job id, reason) also has `why`, the protocol's word for the reason, and `behind`, the job it
// waits behind, when that is the reason.
statusJson(u: Usage, jobs: Vector[JobInfo], whys: Vector[(long, Why)] = []) -> Json = Json.obj(
    ("units", Json.num(u.units)),
    ("unit_budget", Json.num(u.unitBudget)),
    ("mem", Json.num(u.memory)),
    ("mem_budget", Json.num(u.memoryBudget)),
    ("rss", Json.num(u.rss)),
    ("mem_held", Json.num(u.held)),
    ("machine_mem", Json.num(u.machineMemory)),
    ("landing", u.landing.map(id -> Json.num(id)).getOrElse(Json.Null)),
    ("take_slot", u.takeSlot.map(encodeTakeSlot).getOrElse(Json.Null)),
    ("queue_held", Json.Bool(u.queueHeld)),
    ("quick", Json.num(u.quick)),
    ("quick_slots", Json.num(QuickSlots)),
    ("running", Json.Arr(jobs.filter(j -> j.state == "running").map(encodeJob))),
    ("queued", Json.Arr(jobs.filter(j -> j.state == "queued").map(j -> withWhy(j, whys)))))

private withWhy(j: JobInfo, whys: Vector[(long, Why)]) -> Json = whys.find(w -> w.0 == j.id) match
    Some((_, why)) ->
        Json.Obj(encodeJob(j).asMembers().get() ++ [("why", Json.str(whyWord(why)))] ++ whyId(why))
    None -> encodeJob(j)

encodeReply(r: Reply) -> Json
encodeReply(Submitted(id, log, hint)) = Json.Obj([("ok", Json.Bool(true)), ("id", Json.num(id)), ("log", Json.str(log))] ++ (if hint.isEmpty() then [] else [("hint", Json.str(hint))]))
encodeReply(Ended(job)) = Json.obj(("ok", Json.Bool(true)), ("job", encodeJob(job)))
encodeReply(Jobs(jobs)) = Json.obj(("ok", Json.Bool(true)), ("jobs", Json.Arr(jobs.map(encodeJob))))
encodeReply(Using(u)) = Json.obj(
    ("ok", Json.Bool(true)),
    ("units", Json.num(u.units)),
    ("unit_budget", Json.num(u.unitBudget)),
    ("mem", Json.num(u.memory)),
    ("mem_budget", Json.num(u.memoryBudget)),
    ("rss", Json.num(u.rss)),
    ("mem_held", Json.num(u.held)),
    ("machine_mem", Json.num(u.machineMemory)),
    ("running", Json.num(u.running)),
    ("queued", Json.num(u.queued)),
    ("landing", u.landing.map(id -> Json.num(id)).getOrElse(Json.Null)),
    ("take_slot", u.takeSlot.map(encodeTakeSlot).getOrElse(Json.Null)),
    ("queue_held", Json.Bool(u.queueHeld)),
    ("quick", Json.num(u.quick)))
encodeReply(Viewed(o)) = Json.obj(("ok", Json.Bool(true)), ("snapshot", encodeOverview(o)))
encodeReply(Hi(version, pid)) = Json.obj(("ok", Json.Bool(true)), ("version", Json.str(version)), ("pid", Json.num(pid)))
encodeReply(Streamed(event)) = Json.obj(("ok", Json.Bool(true)), ("event", event))
encodeReply(Replayed(events)) = Json.obj(("ok", Json.Bool(true)), ("events", Json.Arr(events)))
encodeReply(Cleaned(report)) = Json.obj(("ok", Json.Bool(true)), ("cleaned", encodeReport(report)))
encodeReply(Done) =Json.obj(("ok", Json.Bool(true)))
encodeReply(Failed(message)) = Json.obj(("ok", Json.Bool(false)), ("error", Json.str(message)))

decodeReply(text: string) -> Result[Reply, string]
    val j = json.parse(text) match
        Ok(v) -> v
        Err(e) -> return Err(s"not JSON: $e")
    if !field(j, "ok", v -> v.asBool(), "a bool")?
        return Ok(Failed(field(j, "error", v -> v.asString(), "a string")?))
    if j.has("event") then return Ok(Streamed(j("event")))
    if j.has("events") then return Ok(Replayed(field(j, "events", v -> v.asVector(), "an array")?))
    if j.has("cleaned") then return Ok(Cleaned(decodeReport(j("cleaned"))?))
    if j.has("snapshot") then return Ok(Viewed(decodeOverview(j("snapshot"))?))
    if j.has("job") then return Ok(Ended(decodeJob(j("job"))?))
    if j.has("jobs")
        val items = field(j, "jobs", v -> v.asVector(), "an array")?
        val jobs = Buffer[JobInfo]()
        for item in items do jobs += decodeJob(item)?
        return Ok(Jobs(jobs.toVector()))
    if j.has("unit_budget")
        return Ok(Using(Usage(
            field(j, "units", v -> v.asInt(), "an int")?,
            field(j, "unit_budget", v -> v.asInt(), "an int")?,
            field(j, "mem", v -> v.asLong(), "a whole number")?,
            field(j, "mem_budget", v -> v.asLong(), "a whole number")?,
            field(j, "running", v -> v.asInt(), "an int")?,
            field(j, "queued", v -> v.asInt(), "an int")?,
            optional(j, "landing", someLong, "a whole number", None)?,
            decodeTakeSlot(j.get("take_slot").getOrElse(Json.Null))?,
            optional(j, "rss", wholeNumber, "a whole number", 0)?,
            optional(j, "machine_mem", wholeNumber, "a whole number", 0)?,
            optional(j, "queue_held", v -> v.asBool(), "a bool", false)?,
            optional(j, "mem_held", wholeNumber, "a whole number", 0)?,
            optional(j, "quick", v -> v.asInt(), "an int", 0)?)))
    if j.has("version") then return Ok(Hi(field(j, "version", v -> v.asString(), "a string")?, field(j, "pid", v -> v.asLong(), "a whole number")?))
    if j.has("id") then return Ok(Submitted(field(j, "id", v -> v.asLong(), "a whole number")?, field(j, "log", v -> v.asString(), "a string")?, optional(j, "hint", v -> v.asString(), "a string", "")?))
    Ok(Done)

// Snapshots.

// The word a queued job's `waits` field holds.
whyWord(w: Why) -> string
whyWord(NoUnits) = "units"
whyWord(NoMemory) = "memory"
whyWord(LaneBusy) = "lane"
whyWord(Draining) = "draining"
whyWord(ForTakeSlot) = "take-slot"
whyWord(Behind(_)) = "behind"
whyWord(DrainingFor(_)) = "draining-for"
whyWord(Starting) = "starting"
whyWord(Held) = "held"
whyWord(QueueHeld) = "queue-held"
whyWord(QuickFull) = "quick-lane"

// The job a reason names, as the field beside its word: `behind` for `Behind`, `draining_for` for
// `DrainingFor`, nothing for the rest.
private whyId(why: Why) -> Vector[(string, Json)]
whyId(Behind(id)) = [("behind", Json.num(id))]
whyId(DrainingFor(id)) = [("draining_for", Json.num(id))]
whyId(_) = Vector[(string, Json)]()

private encodeQueued(q: QueuedJob) -> Json =
    Json.Obj(encodeJob(q.job).asMembers().get() ++ [("position", Json.num(q.position)), ("waits", Json.str(whyWord(q.why)))] ++ whyId(q.why))

private decodeWhy(j: Json) -> Result[Why, string]
    field(j, "waits", v -> v.asString(), "a string")? match
        "units" -> Ok(NoUnits)
        "memory" -> Ok(NoMemory)
        "lane" -> Ok(LaneBusy)
        "draining" -> Ok(Draining)
        "take-slot" -> Ok(ForTakeSlot)
        "behind" -> Ok(Behind(field(j, "behind", v -> v.asLong(), "a whole number")?))
        "draining-for" -> Ok(DrainingFor(field(j, "draining_for", v -> v.asLong(), "a whole number")?))
        "starting" -> Ok(Starting)
        "held" -> Ok(Held)
        "queue-held" -> Ok(QueueHeld)
        "quick-lane" -> Ok(QuickFull)
        other -> Err(s"no such reason to wait: `$other`")

private decodeQueued(j: Json) -> Result[QueuedJob, string] =
    Ok(QueuedJob(decodeJob(j)?, field(j, "position", v -> v.asInt(), "an int")?, decodeWhy(j)?))

encodeOverview(o: Overview) -> Json = Json.obj(
    ("units", Json.num(o.usage.units)),
    ("unit_budget", Json.num(o.usage.unitBudget)),
    ("mem", Json.num(o.usage.memory)),
    ("mem_budget", Json.num(o.usage.memoryBudget)),
    ("rss", Json.num(o.usage.rss)),
    ("mem_held", Json.num(o.usage.held)),
    ("machine_mem", Json.num(o.usage.machineMemory)),
    ("landing", o.usage.landing.map(id -> Json.num(id)).getOrElse(Json.Null)),
    ("take_slot", o.usage.takeSlot.map(encodeTakeSlot).getOrElse(Json.Null)),
    ("queue_held", Json.Bool(o.usage.queueHeld)),
    ("quick", Json.num(o.usage.quick)),
    ("uptime_ms", Json.num(o.uptimeMs)),
    ("running", Json.Arr(o.running.map(encodeJob))),
    ("queued", Json.Arr(o.queued.map(encodeQueued))),
    ("recent", Json.Arr(o.recent.map(encodeJob))),
    ("waiting", Json.Arr(o.waiting.map(encodeJob))))

private each[T](j: Json, key: string, read: (Json) -> Result[T, string]) -> Result[Vector[T], string]
    val items = field(j, key, v -> v.asVector(), "an array")?
    val out = Buffer[T]()
    for item in items do out += read(item)?
    Ok(out.toVector())

decodeOverview(j: Json) -> Result[Overview, string]
    val running = each(j, "running", decodeJob)?
    val queued = each(j, "queued", decodeQueued)?
    Ok(Overview(
        Usage(
            field(j, "units", v -> v.asInt(), "an int")?,
            field(j, "unit_budget", v -> v.asInt(), "an int")?,
            field(j, "mem", v -> v.asLong(), "a whole number")?,
            field(j, "mem_budget", v -> v.asLong(), "a whole number")?,
            running.length(),
            queued.length(),
            optional(j, "landing", someLong, "a whole number", None)?,
            decodeTakeSlot(j.get("take_slot").getOrElse(Json.Null))?,
            optional(j, "rss", wholeNumber, "a whole number", 0)?,
            optional(j, "machine_mem", wholeNumber, "a whole number", 0)?,
            optional(j, "queue_held", v -> v.asBool(), "a bool", false)?,
            optional(j, "mem_held", wholeNumber, "a whole number", 0)?,
            optional(j, "quick", v -> v.asInt(), "an int", 0)?),
        field(j, "uptime_ms", v -> v.asLong(), "a whole number")?,
        running,
        queued,
        each(j, "recent", decodeJob)?,
        if j.has("waiting") then each(j, "waiting", decodeJob)? else Vector[JobInfo]()))
