module dev.avinlang.marshal

// How long jobs are expected to take, learned per command, and what that says of when they end and
// start.
//
// Each run of a command that exits 0 is remembered under the keys its memory is learned under
// (learning.avin's `learningKeys`), and kept in memory.json. A job's
// expected duration is the median of the last `DurationWindow` such runs of its command in its
// directory, or of its command anywhere while its directory has none; before any, of its command
// made alike in its project, or of its kind in its project (learning.avin), once one of those has
// enough runs alike enough to trust; before that, the median of its kind's runs (deadline.avin),
// which is guessed rather than learned until the kind has enough. The scheduler's backfill and
// drains read the expected duration whichever it is.
//
// An ETA counts down from the job's ETA basis (`etaBasis`): its expected duration where that is
// learned from its own command (`cmd+dir`, `cmd`, `norm+project`); for a command with no runs of
// its own whose duration comes from its kind in its project, the larger of that and its deadline
// times the share of their deadlines that kind's runs in that project took (`deadlineShares`), a
// guess the ETA marks with `?`; none from its kind alone or from nothing, since a kind's runs
// (every test of every project) say little of when one of them ends. A job past its basis is late:
// its time left is then the median of its key's runs that went on longer than it has run, less
// what it has run, or, where none did, half what it has run; never past its deadline, which stops
// it (`timeLeft`). A late ETA is marked `+`.
//
// A queued job's expected start is reckoned from the running jobs' expected ends: the jobs of
// each lane, in their queue's order, each start at the earliest end after which its units and
// memory fit beside what runs and what is reckoned to have started before it. Only where every end
// that start waits for is known: a job waiting for something no duration measures (take-slot, the
// load, an exclusive job, a held queue, a low disk) has none, and neither has any job behind it.
import avin.collections.mutable.{Map as MutableMap}

// How many of a command's latest successful runs its duration is learned from.
val DurationWindow: int = 5

// A duration learned of a command and the key it came from (learning.avin's sources).
data LearnedDuration(ms: long, from: string)

// The least duration `consistent` tells apart from another: a minute, so runs of a few seconds
// each are alike however they differ.
val DurationSpreadFloor: long = 60000

// The duration the runs of a command in its directory (`dirRuns`) and anywhere (`cmdRuns`), oldest
// first, teach, from any run of them; else what the project keys teach (`projectChain`: its
// command made alike in its project, then its kind in its project, each with its source), from the
// first with `minRuns` runs alike enough to trust (`consistent`); None while none does.
learnedDuration(
    dirRuns: Vector[long],
    cmdRuns: Vector[long],
    projectChain: Vector[(Vector[long], string)] = [],
    minRuns: int = 3
) -> Option[LearnedDuration]
  if dirRuns.nonEmpty then return Some(LearnedDuration(median(dirRuns.takeRight(DurationWindow)), "cmd+dir"))
  if cmdRuns.nonEmpty then return Some(LearnedDuration(median(cmdRuns.takeRight(DurationWindow)), "cmd"))
  val c = choose(projectChain, minRuns, ms -> ms >= 0, runs -> consistent(runs, DurationSpreadFloor))
  if c.from.isEmpty then None else Some(LearnedDuration(median(c.values.takeRight(DurationWindow)), c.from))

// How long a job is expected to run, whether that is learned rather than guessed, and where it came
// from (`durationSource`).
data Expectation(ms: long, learned: bool, from: string)

// What a job of `kind` is expected to take: its command's learned duration where there is one,
// else its kind's (`expectedMs`, `durationLearned`, given the kind's `history`); never more than
// its `deadline`, nor less than a millisecond.
expectationFor(
    learning: Learning,
    kind: string,
    landing: bool,
    history: Vector[long],
    command: Option[LearnedDuration],
    deadline: long
) -> Expectation
  val (ms, learned, from) = command match
    Some(d) -> (d.ms, true, d.from)
    None ->
      val known = durationLearned(learning, history)
      (expectedMs(learning, kind, landing, history), known, if known then "kind" else "none")
  val held = if ms < deadline then ms else deadline
  Expectation(if held < 1 then 1 else held, learned, from)

// Whether a duration from `from` is learned from the job's own command (made alike or not), which
// an ETA is given from as it is.
ownDuration(from: string) -> bool = from == FromCmd || from == FromDir || from == FromNorm

// How many of a kind's latest deadline shares in a project (`deadlineShares`) a guess reads.
val ShareWindow: int = 20

// What an ETA counts down from: `ms`, and whether that is a guess rather than learned from the
// job's own command.
data EtaBasis(ms: long, guess: bool)

// The ETA basis of a job expected to run `expectedMs` (learned from `from`) under `deadlineMs`
// (0 for none), given its kind's deadline shares in its project (`shares`, oldest first, in
// thousandths of a deadline): its expectation where its own command's runs teach it; for one from
// its kind in its project, a guess of the larger of that and its deadline times the median of the
// latest `ShareWindow` shares, once there are `minRuns` of them, never past its deadline; None from
// anything else.
etaBasis(expectedMs: long, from: string, deadlineMs: long, shares: Vector[long] = [], minRuns: int = 3) -> Option[EtaBasis]
  if expectedMs <= 0 then return None
  if ownDuration(from) then return Some(EtaBasis(expectedMs, false))
  if from != FromKindProject then return None
  val counted = shares.filter(s -> s > 0).takeRight(ShareWindow)
  var ms = expectedMs
  if deadlineMs > 0 && counted.length >= minRuns && counted.nonEmpty
    val byDeadline = deadlineMs / 1000 * median(counted) + deadlineMs % 1000 * median(counted) / 1000
    if byDeadline > ms then ms = byDeadline
  if deadlineMs > 0 && ms > deadlineMs then ms = deadlineMs
  Some(EtaBasis(ms, true))

// The share of its deadline a run took, in thousandths (`deadlineShares`); -1 without a deadline.
deadlineShare(ranMs: long, deadlineMs: long) -> long =
  if deadlineMs <= 0 || ranMs < 0 then -1 else ranMs / deadlineMs * 1000 + ranMs % deadlineMs * 1000 / deadlineMs

// A running job's expected time left (`ms`, -1 where there is none), whether it is past its basis
// (`late`), and whether its basis is a guess.
data EtaLeft(ms: long, late: bool = false, guess: bool = false)

val NoEta: EtaLeft = EtaLeft(-1)

// The time left of a job that has run `elapsedMs` of a `basis`, its key's runs `runs` (oldest
// first) and its deadline `deadlineMs` (0 for none): its basis less what it has run; past it, late,
// the median of the runs longer than it has run less what it has run, or half what it has run where
// none was; never more than its deadline leaves.
timeLeft(basis: EtaBasis, runs: Vector[long], elapsedMs: long, deadlineMs: long) -> EtaLeft
  val late = elapsedMs >= basis.ms
  val longer = runs.filter(r -> r > elapsedMs)
  var left = if !late then basis.ms - elapsedMs elif longer.nonEmpty then median(longer) - elapsedMs else elapsedMs / 2
  if deadlineMs > 0
    val toDeadline = if deadlineMs > elapsedMs then deadlineMs - elapsedMs else long(0)
    if left > toDeadline then left = toDeadline
  EtaLeft(left, late, basis.guess)

// A running job's expected time left as the daemon reckoned it (`JobInfo.etaMs`), or, from a daemon
// that did not say, from its expectation alone (`etaBasis`, `timeLeft` without runs or shares);
// `NoEta` for a job that is not running or has no basis.
etaLeft(j: JobInfo) -> EtaLeft
  if j.state != "running" then return NoEta
  if j.etaMs >= 0 then return EtaLeft(j.etaMs, j.etaLate, j.etaGuess)
  etaBasis(j.expectedMs, j.durationFrom, j.deadlineMs) match
    Some(b) -> timeLeft(b, [], j.elapsedMs, j.deadlineMs)
    None -> NoEta

// A time to come, roughly: `<1m`, `~6m` (minutes rounded up), `~1h05`.
etaText(ms: long) -> string
  if ms < 60000 then return "<1m"
  val minutes = (ms + 59999) / 60000
  if minutes < 60 then s"~${minutes}m" else f"~${minutes / 60}%dh${minutes % 60}%02d"

// A queued job's expected start as a listing shows it: `in ~3m`, and from an hour on to the nearest
// hour, `in ~2h`, which is as near as a start reckoned from other jobs' estimates is; `-` where it
// is not known.
startText(ms: long) -> string
  if ms < 0 then return "-"
  if ms < 3600000 then return "in " + etaText(ms)
  s"in ~${(ms + 1800000) / 3600000}h"

// The ETA column of `ls` and `top`: a running job's time left (`~6m`), marked `+` once it is past
// its basis (`+~4m`) and `?` where its basis is a guess (`~6m?`); a queued job's expected start;
// `-` otherwise. `since` is how long after the listing was made it is shown (a paused job stands
// still).
etaColumn(j: JobInfo, since: long = 0) -> string
  val left = etaLeft(j)
  if left.ms >= 0
    val passed = if j.paused then 0 else since
    val text = etaText(if left.ms > passed then left.ms - passed else 0)
    return (if left.late then "+" else "") + text + (if left.guess then "?" else "")
  if j.state == "queued" && j.startsInMs >= 0
    return startText(if j.startsInMs > since then j.startsInMs - since else 0)
  "-"

// A running job as a start estimate weighs it: what it holds, its lane, and how long it is expected
// to run yet (-1 where not known).
data EtaRunning(units: int, memory: long, landing: bool, quick: bool, leftMs: long)

// A queued job as a start estimate weighs it: what it needs, its lane, its place in its lane's
// queue, why it waits, and how long it is expected to run (-1 where not known).
data EtaQueued(
    id: long,
    units: int,
    memory: long,
    landing: bool,
    quick: bool,
    position: int,
    why: Why,
    expectedMs: long
)

private val Never: long = long.MaxValue

// Whether a job waiting for `why` waits only for running jobs to end, so its start can be reckoned.
private reckonable(why: Why) -> bool = why match
  NoUnits | NoMemory | Behind(_) | Starting | Draining | DrainingFor(_) | LaneBusy | PoliteBudget -> true
  _ -> false

// When each queued job is expected to start, in milliseconds from now, by job id; a job whose start
// cannot be reckoned is left out. `used` is the development units held now (marshal's and
// take-slot's), and `memory` what admission counts the running jobs holding; take-slot's units never
// free in the reckoning, since nothing says when its runs end.
startEstimates(
    budget: Budget,
    used: int,
    memory: long,
    running: Vector[EtaRunning],
    queued: Vector[EtaQueued]
) -> Map[long, long]
  val out = MutableMap[long, long]()
  // the development lane: (time, units, memory) freed at each time, or taken where negative
  val changes = Buffer[(long, int, long)]()
  // against a polite budget every lane's units count, a quick job's too
  val polite = isPolite(budget)
  for r in running
    if r.quick && !polite then continue
    changes += (if r.leftMs < 0 then Never else r.leftMs, r.units, r.memory)
  val freeUnits = budget.units - used
  val freeMemory = budget.memory - memory
  var floor: long = 0
  for q in queued.filter(q -> !q.landing && !q.quick).sortBy(q -> q.position)
    if q.why == Held then continue
    if !reckonable(q.why) || q.why == LaneBusy then floor = Never
    if floor == Never then continue
    val at = earliest(changes, freeUnits, freeMemory, floor, q.units, q.memory)
    if at == Never
      floor = Never
      continue
    out(q.id) = at
    floor = at
    changes += (at, -q.units, -q.memory)
    changes += (if q.expectedMs < 0 then Never else at + q.expectedMs, q.units, q.memory)
  // the landing lane: one job at a time
  var laneFree: long = 0
  for r in running
    if r.landing then laneFree = if r.leftMs < 0 then Never else r.leftMs
  for q in queued.filter(q -> q.landing).sortBy(q -> q.position)
    if q.why == Held then continue
    if !(q.why == LaneBusy || q.why == Starting) then laneFree = Never
    if laneFree == Never then continue
    out(q.id) = laneFree
    laneFree = if q.expectedMs < 0 then Never else laneFree + q.expectedMs
  out.toMap

// The earliest time from `floor` at which `units` and `memory` fit, given what is free now and the
// `changes` to come; `Never` where they never do. Every start already reckoned is at or before
// `floor`, so from there on what is free only grows, and the first time it fits it stays fitting.
private earliest(
    changes: Buffer[(long, int, long)],
    freeUnits: int,
    freeMemory: long,
    floor: long,
    units: int,
    memory: long
) -> long
  val times = ([floor] ++ changes.filter(c -> c.0 > floor && c.0 != Never).map(c -> c.0).toVector).distinct.sorted
  for t in times
    var u = freeUnits
    var m = freeMemory
    for (at, du, dm) in changes
      if at <= t
        u += du
        m += dm
    if units <= u && memory <= m then return t
  Never
