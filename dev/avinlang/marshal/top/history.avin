module dev.avinlang.marshal.top

// Where `marshal top` finds the jobs that ended before those its snapshot carries: the event log,
// read as `marshal history` reads it. The snapshot holds only the latest ended jobs; scrolling past
// the oldest of them asks for a page of earlier ones.
import avin.collections.mutable.{Map as MutableMap}
import avin.fs
import avin.io.IoError
import json
import dev.avinlang.marshal
import dev.avinlang.marshal.{JobInfo, Lost}

// How many earlier jobs one page holds.
val HistoryPageSize: int = 100

// A page of ended jobs, the latest first, and how many ended before the last of them.
data Page(jobs: Vector[JobInfo], left: int)

// Gives the page of at most `limit` jobs that ended before job `before` (from the latest, with
// None), or why it cannot.
type HistorySource = (Option[long], int) -> Result[Page, string]

// The page of `all` (ended jobs, the latest first) after job `before`, at most `limit` long. A
// `before` that `all` does not hold starts the page at the latest, so the caller, which leaves out the
// jobs it already shows, still gets every job in order.
pageOf(all: Vector[JobInfo], before: Option[long], limit: int) -> Page
    val start = before match
        Some(id) -> all.indexWhere(j -> j.id == id) + 1
        None -> 0
    val jobs = all.slice(start, minInt(start + limit, all.length()))
    Page(jobs, all.length() - start - jobs.length())

// The jobs the event log at `log` saw end, the latest first: each job as its last ending event
// describes it, ordered by when that event came and then by id, as `marshal history` lists them. A
// job whose ending event carries no outcome is shown lost. Lines that are not ending events of a job
// are skipped. No log is no jobs.
endedJobs(log: string) -> Result[Vector[JobInfo], string]
    val f = fs.open(log) match
        Ok(f) -> f
        Err(IoError.NotFound) -> return Ok([])
        Err(e) -> return Err(s"$log: ${e.message()}")
    val ends = Buffer[(long, JobInfo)]()
    val position = MutableMap[long, int]()
    loop
        f.readLine() match
            Ok(Some(line)) ->
                for e in endingOf(line)
                    position.get(e.1.id) match
                        Some(p) -> ends(p) = e
                        None ->
                            position(e.1.id) = ends.length()
                            ends += e
            Ok(None) -> break
            Err(e) ->
                f.close()
                return Err(s"$log: ${e.message()}")
    f.close()
    val sorted = ends.toVector().sortWith((a, b) -> if a.0 != b.0 then (if a.0 > b.0 then -1 else 1) elif a.1.id != b.1.id then (if a.1.id > b.1.id then -1 else 1) else 0)
    Ok(sorted.map(e -> e.1))

// The time and job of a line of the log that ends a job; None for any other line.
private endingOf(line: string) -> Option[(long, JobInfo)]
    if line.trim().isEmpty() then return None
    val ev = json.parse(line).ok() match
        Some(ev) -> ev
        None -> return None
    if !marshal.endsJob(ev) then return None
    val ts = ev.get("ts").flatMap(v -> v.asLong()) match
        Some(t) -> t
        None -> return None
    marshal.decodeJob(ev).ok().map(j -> (ts, if j.outcome.isDefined() then j else j with { outcome = Some(Lost) }))

// The history of the log at `log`, read once, at the first page asked for: what ended later comes in
// the snapshots, so the pages before it never change.
logHistory(log: string) -> HistorySource
    var read: Option[Vector[JobInfo]] = None
    (before, limit) ->
        val all = read match
            Some(all) -> all
            None -> endedJobs(log) match
                Ok(all) ->
                    read = Some(all)
                    all
                Err(why) -> return Err(why)
        Ok(pageOf(all, before, limit))
