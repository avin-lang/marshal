package { name = "marshal", version = "0.4.9", description = "A job manager for building, testing and releasing: a unit and memory budget, a landing lane, learned deadlines" }

dependencies {
  tui { git = "github.com/avin-lang/tui", version = "0.2.10" }
  json { git = "github.com/avin-lang/json", version = "0.0.4" }
}

c-libraries {
  libc { headers = ["<sys/resource.h>", "<limits.h>", "<sys/sysctl.h>", "<libproc.h>", "<mach/mach.h>", "<mach/mach_time.h>"] }
}
