module tests

// End to end, with the helpers of e2e.avin: `marshal grep` through the executable, every option and
// exit code, against logs written by hand (which need no daemon, as for `tail`), against a running
// job whose log grows, an ended job, and across a restart.
import avin.fs
import avin.threads
import avin.time
import avin.time.millis

// Puts `text` as job `id`'s log in the home.
writeLog(home: string, id: long, text: string)
    fs.createDirAll(home + "/jobs").ok().get()
    fs.writeText(s"$home/jobs/$id.log", text).ok().get()

val sample: string = "alpha\nERR one\nbeta\ngamma\ndelta\nERR two\nepsilon\nzeta\neta\nERR three\n"

// The lines of a command's output.
linesOf(r: Ran) -> Vector[string] = r.out.lines().toVector()

@test("grep prints the matching lines of a log, exits 0, and starts no daemon")
grepMatches()
    val home = newHome()
    writeLog(home, 5, sample)
    val r = m(home, "grep", "5", "ERR")
    assertEq(r.code, 0)
    assertEq(linesOf(r), ["ERR one", "ERR two", "ERR three"])
    assertEq(fs.exists(home + "/daemon.pid"), false)
    cleanUp(home)

@test("grep exits 1 and prints nothing when no line matches")
grepNoMatch()
    val home = newHome()
    writeLog(home, 5, sample)
    val r = m(home, "grep", "5", "zzz")
    assertEq(r.code, 1)
    assertEq(r.out, "")
    cleanUp(home)

@test("-i, -F and -v each change what matches")
grepMatchOptions()
    val home = newHome()
    writeLog(home, 5, "Alpha\nalpha\na.c\nabc\n(x)\n")
    assertEq(linesOf(m(home, "grep", "5", "alpha")), ["alpha"])
    assertEq(linesOf(m(home, "grep", "5", "alpha", "-i")), ["Alpha", "alpha"])
    assertEq(linesOf(m(home, "grep", "5", "a.c")), ["a.c", "abc"])
    assertEq(linesOf(m(home, "grep", "5", "a.c", "-F")), ["a.c"])
    assertEq(linesOf(m(home, "grep", "5", "(x)", "-F")), ["(x)"])
    assertEq(linesOf(m(home, "grep", "5", "^[a-z]+$", "-v")), ["Alpha", "a.c", "(x)"])
    // -F -i together
    assertEq(linesOf(m(home, "grep", "5", "A.C", "-F", "-i")), ["a.c"])
    cleanUp(home)

@test("-n numbers lines, -c counts them, -m stops after n")
grepNumberCountMax()
    val home = newHome()
    writeLog(home, 5, sample)
    assertEq(linesOf(m(home, "grep", "5", "ERR", "-n")), ["2:ERR one", "6:ERR two", "10:ERR three"])
    val c = m(home, "grep", "5", "ERR", "-c")
    assertEq((c.code, c.out), (0, "3\n"))
    val none = m(home, "grep", "5", "zzz", "-c")
    assertEq((none.code, none.out), (1, "0\n"))
    assertEq(linesOf(m(home, "grep", "5", "ERR", "-m", "2")), ["ERR one", "ERR two"])
    assertEq(m(home, "grep", "5", "ERR", "-m", "0").code, 1)
    cleanUp(home)

@test("-A, -B and -C print context, parted by --, and -A and -B win over -C")
grepContextCli()
    val home = newHome()
    writeLog(home, 5, sample)
    assertEq(linesOf(m(home, "grep", "5", "ERR", "-A", "1")), ["ERR one", "beta", "--", "ERR two", "epsilon", "--", "ERR three"])
    assertEq(linesOf(m(home, "grep", "5", "ERR", "-B", "1")), ["alpha", "ERR one", "--", "delta", "ERR two", "--", "eta", "ERR three"])
    assertEq(linesOf(m(home, "grep", "5", "ERR", "-C", "1", "-n")), ["1-alpha", "2:ERR one", "3-beta", "--", "5-delta", "6:ERR two", "7-epsilon", "--", "9-eta", "10:ERR three"])
    assertEq(linesOf(m(home, "grep", "5", "ERR", "-C", "2", "-B", "0")), ["ERR one", "beta", "gamma", "--", "ERR two", "epsilon", "zeta", "--", "ERR three"])
    assertEq(linesOf(m(home, "grep", "5", "ERR", "-B", "0", "-C", "2")), ["ERR one", "beta", "gamma", "--", "ERR two", "epsilon", "zeta", "--", "ERR three"])
    assertEq(linesOf(m(home, "grep", "5", "ERR", "-A", "0", "-B", "0")), ["ERR one", "ERR two", "ERR three"])
    cleanUp(home)

@test("options combine: -n with -C, -v with -c, -m with context, -v with -n")
grepCombined()
    val home = newHome()
    writeLog(home, 5, sample)
    assertEq(linesOf(m(home, "grep", "5", "gamma", "-n", "-C", "1")), ["3-beta", "4:gamma", "5-delta"])
    val vc = m(home, "grep", "5", "ERR", "-v", "-c")
    assertEq((vc.code, vc.out), (0, "7\n"))
    assertEq(linesOf(m(home, "grep", "5", "ERR", "-m", "1", "-A", "2", "-n")), ["2:ERR one", "3-beta", "4-gamma"])
    assertEq(linesOf(m(home, "grep", "5", "ERR", "-m", "1", "-C", "1")), ["alpha", "ERR one", "beta"])
    assertEq(linesOf(m(home, "grep", "5", "[ae]", "-v", "-n", "-m", "1")), ["6:ERR two"])
    assertEq(linesOf(m(home, "grep", "5", "^[a-z]", "-v", "-n")), ["2:ERR one", "6:ERR two", "10:ERR three"])
    assertEq(linesOf(m(home, "grep", "5", "ERR", "-c", "-n", "-C", "3")), ["3"])
    cleanUp(home)

@test("--last searches only the last n lines, and numbers stay the log's own")
grepLast()
    val home = newHome()
    writeLog(home, 5, sample)
    assertEq(linesOf(m(home, "grep", "5", "ERR", "--last", "4", "-n")), ["10:ERR three"])
    assertEq(linesOf(m(home, "grep", "5", "ERR", "--last", "4")), ["ERR three"])
    assertEq(linesOf(m(home, "grep", "5", "ERR", "--last", "5", "-n")), ["6:ERR two", "10:ERR three"])
    assertEq(linesOf(m(home, "grep", "5", "ERR", "--last", "7", "-n")), ["6:ERR two", "10:ERR three"])
    assertEq(linesOf(m(home, "grep", "5", ".", "--last", "2", "-n")), ["9:eta", "10:ERR three"])
    // more than the log has: all of it
    assertEq(m(home, "grep", "5", "ERR", "--last", "1000", "-c").out, "3\n")
    // none: nothing to search
    assertEq(m(home, "grep", "5", ".", "--last", "0").code, 1)
    // context does not reach before the first line searched
    assertEq(linesOf(m(home, "grep", "5", "ERR", "--last", "4", "-B", "9", "-n")), ["7-epsilon", "8-zeta", "9-eta", "10:ERR three"])
    cleanUp(home)

@test("an empty log has no lines: exit 1, and a count of 0")
grepEmptyLogCli()
    val home = newHome()
    writeLog(home, 5, "")
    val r = m(home, "grep", "5", "x")
    assertEq((r.code, r.out), (1, ""))
    assertEq(m(home, "grep", "5", "").code, 1)
    assertEq(m(home, "grep", "5", "x", "-c").out, "0\n")
    assertEq(m(home, "grep", "5", "x", "-v").code, 1)
    assertEq(m(home, "grep", "5", "x", "--last", "3").code, 1)
    cleanUp(home)

@test("a log with no trailing newline: its last line is searched, a trailing newline adds no line, a blank line is one")
grepNoTrailingNewline()
    val home = newHome()
    writeLog(home, 5, "one\ntwo\nthree")
    assertEq(linesOf(m(home, "grep", "5", "three", "-n")), ["3:three"])
    assertEq(m(home, "grep", "5", ".", "-c").out, "3\n")
    writeLog(home, 6, "one\ntwo\n")
    assertEq(m(home, "grep", "6", ".", "-c").out, "2\n")
    writeLog(home, 7, "one\n\ntwo\n")
    assertEq(m(home, "grep", "7", "^$", "-n").out, "2:\n")
    writeLog(home, 8, "only")
    assertEq(m(home, "grep", "8", "only", "--last", "1").out, "only\n")
    assertEq(linesOf(m(home, "grep", "5", "", "--last", "1", "-n")), ["3:three"])
    cleanUp(home)

@test("a log with Windows line ends is searched without the carriage returns")
grepCrLf()
    val home = newHome()
    writeLog(home, 5, "one\r\ntwo\r\n")
    assertEq(m(home, "grep", "5", "^two$").out, "two\n")
    cleanUp(home)

@test("Unicode lines are matched, folded by -i, and printed whole")
grepUnicodeCli()
    val home = newHome()
    writeLog(home, 5, "héllo wörld\n日本語のログ\nemoji 🙂 here\nÉCOLE\nplain\n")
    assertEq(m(home, "grep", "5", "ö").out, "héllo wörld\n")
    assertEq(m(home, "grep", "5", "日本語").out, "日本語のログ\n")
    assertEq(m(home, "grep", "5", "🙂", "-F").out, "emoji 🙂 here\n")
    assertEq(m(home, "grep", "5", "école", "-i").out, "ÉCOLE\n")
    assertEq(m(home, "grep", "5", "école").code, 1)
    assertEq(linesOf(m(home, "grep", "5", "^.{6}$", "-n")), ["2:日本語のログ"])
    cleanUp(home)

@test("a log of several megabytes is searched in a pass, with --last, -m and -c")
grepBigLog()
    val home = newHome()
    val text = Buffer[string]()
    for i in 1..<100_001 do text.addOne(s"line $i of the big log, padded with some more words to give it weight")
    val big = text.mkString("\n") + "\n"
    assert(big.byteLength() > 6_000_000, s"${big.byteLength()}")
    writeLog(home, 5, big)
    assertEq(m(home, "grep", "5", "line 99999 ", "-n").out, "99999:line 99999 of the big log, padded with some more words to give it weight\n")
    assertEq(m(home, "grep", "5", "of the big log", "-c").out, "100000\n")
    assertEq(m(home, "grep", "5", "00 of", "-c").out, "1000\n")
    assertEq(linesOf(m(home, "grep", "5", "line 1 ", "-m", "1", "-A", "1", "-n")).map(l -> l.take(9)), ["1:line 1 ", "2-line 2 "])
    val last = m(home, "grep", "5", "line", "--last", "3", "-n")
    assertEq(linesOf(last).map(l -> l.split(" ")(0)), ["99998:line", "99999:line", "100000:line"])
    assertEq(m(home, "grep", "5", "no such words").code, 1)
    assertEq(m(home, "grep", "5", "00000 of", "-c", "-v").out, "99999\n")
    cleanUp(home)

@test("grep reads a running job's log as it grows, and the ended job's log the same")
grepRunningAndEnded()
    val home = newHome()
    val id = submitted(home, "--", "sh", "-c", "echo first; sleep 3; echo second; sleep 1; echo third; sleep 30")
    assert(within(20_000, () -> m(home, "grep", id.toString(), "first").code == 0), "the first line never showed")
    // the log holds only what has been written so far
    assertEq(m(home, "grep", id.toString(), "second").code, 1)
    assert(within(20_000, () -> m(home, "grep", id.toString(), "second").code == 0), "the log did not grow")
    assert(within(20_000, () -> m(home, "grep", id.toString(), "third").code == 0), "the log did not grow")
    assertEq(linesOf(m(home, "grep", id.toString(), "i", "-n")), ["1:first", "3:third"])
    assertEq(m(home, "kill", id.toString()).code, 0)
    assert(within(20_000, () -> ended(home, id)), "the job did not end")
    // an ended job: the same log
    assertEq(linesOf(m(home, "grep", id.toString(), "^(first|second|third)$")), ["first", "second", "third"])
    assertEq(m(home, "grep", id.toString(), ".", "-c").out, "3\n")
    cleanUp(home)

@test("grep finds the lines of a job that ended, and after the daemon restarted")
grepEndedAcrossRestart()
    val home = newHome()
    val id = submitted(home, "--", "sh", "-c", "printf 'one\\ntwo\\nthree\\n'")
    assertEq(m(home, "wait", id.toString()).code, 0)
    assertEq(linesOf(m(home, "grep", id.toString(), "t", "-n")), ["2:two", "3:three"])
    restarted(home)
    assertEq(linesOf(m(home, "grep", id.toString(), "t", "-n")), ["2:two", "3:three"])
    cleanUp(home)

@test("grep of an unknown job or one with no log is an error, exit 2")
grepUnknownJob()
    val home = newHome()
    val r = m(home, "grep", "99", "x")
    assertEq(r.code, 2)
    assert(r.out.contains("job 99 has no log"), r.out)
    // the same with a daemon running
    assertEq(m(home, "status").code, 0)
    assertEq(m(home, "grep", "99", "x").code, 2)
    cleanUp(home)

@test("a pattern that is not a regular expression is an error, exit 2, naming the pattern")
grepBadRegex()
    val home = newHome()
    writeLog(home, 5, sample)
    for p in ["(", "a)", "[a", "\\"] do
        val r = m(home, "grep", "5", p)
        assert(r.code == 2, s"pattern $p exited ${r.code}")
        assert(r.out.contains("is not a pattern"), r.out)
    // as text it is no error
    assertEq(m(home, "grep", "5", "(", "-F").code, 1)
    cleanUp(home)

@test("bad arguments are errors, exit 2: an unknown option, a missing or bad number, a missing id or pattern")
grepBadArguments()
    val home = newHome()
    writeLog(home, 5, sample)
    for args in [["5", "ERR", "-x"], ["5", "ERR", "-m"], ["5", "ERR", "-m", "many"], ["5", "ERR", "-m", "-1"], ["5", "ERR", "-C"], ["5", "ERR", "-C", "x"], ["5", "ERR", "-A", "-2"], ["5", "ERR", "-B", "1.5"], ["5", "ERR", "--last"], ["5", "ERR", "--last", "-1"], ["5", "ERR", "--frobnicate"], ["5"], ["ERR"], [], ["five", "ERR"], ["5", "ERR", "extra"], ["-5", "ERR"]] do
        val r = m(home, (["grep"] ++ args)*)
        assert(r.code == 2, s"${args.mkString(" ")} exited ${r.code}")
        assert(r.out.startsWith("marshal:"), r.out)
    cleanUp(home)

// A line on which `(a+)+?$` backtracks without end.
val runaway: string = "a".repeat(60) + "b"

@test("a pattern that spends the regex step budget on a line is exit 2 naming the pattern and the line, with no trap")
grepBudgetExceeded()
    val home = newHome()
    writeLog(home, 5, "fine\n" + runaway + "\nlater\n")
    val r = m(home, "grep", "5", "(a+)+?$")
    assertEq(r.code, 2)
    assert(r.out.contains("marshal: grep: line 2:"), r.out)
    assert(r.out.contains("`(a+)+?$`"), r.out)
    assert(r.out.contains("backtracked too far"), r.out)
    cleanUp(home)

@test("one over-budget line ends the search: the lines before it stand, none after is read, and -n numbers it")
grepBudgetStopsSearch()
    val home = newHome()
    writeLog(home, 5, "aab\naaa\n" + runaway + "\naaa\n")
    val r = m(home, "grep", "5", "(a+)+?$", "-n")
    assertEq(r.code, 2)
    assertEq(linesOf(r).take(1), ["2:aaa"])
    assert(r.out.contains("line 3:"), r.out)
    assert(!r.out.contains("4:aaa"), r.out)
    cleanUp(home)

@test("an over-budget line is exit 2 with -v and with -c, and -c prints no count")
grepBudgetWithInvertAndCount()
    val home = newHome()
    writeLog(home, 5, "aaa\n" + runaway + "\n")
    val v = m(home, "grep", "5", "(a+)+?$", "-v")
    assertEq(v.code, 2)
    assert(v.out.contains("line 2:"), v.out)
    val c = m(home, "grep", "5", "(a+)+?$", "-c")
    assertEq(c.code, 2)
    assert(c.out.contains("line 2:"), c.out)
    assert(!c.out.startsWith("1\n"), c.out)
    cleanUp(home)

@test("-F on the same long line is no error, and ordinary patterns on it still exit 0 and 1")
grepBudgetNotMet()
    val home = newHome()
    writeLog(home, 5, runaway + "\n")
    assertEq(m(home, "grep", "5", "(a+)+?$", "-F").code, 1)
    assertEq(m(home, "grep", "5", "a+b$").code, 0)
    assertEq(m(home, "grep", "5", "zzz").code, 1)
    assertEq(m(home, "grep", "5", "(a+)+?$", "-F", "-c").out, "0\n")
    cleanUp(home)

@test("-- ends the options, so a pattern may begin with a dash")
grepDashDash()
    val home = newHome()
    writeLog(home, 5, "-v flag\nplain\n--x\n")
    assertEq(linesOf(m(home, "grep", "5", "-F", "--", "-v")), ["-v flag"])
    assertEq(linesOf(m(home, "grep", "--", "5", "--x")), ["--x"])
    assertEq(m(home, "grep", "5", "-v").code, 2)
    cleanUp(home)

@test("grep --help and help grep print its options and the exit codes, whatever the other arguments")
grepHelpCli()
    val home = newHome()
    for args in [["grep", "--help"], ["grep", "-h"], ["grep", "5", "x", "--help"], ["help", "grep"]] do
        val r = m(home, args*)
        assert(r.code == 0, s"${args.mkString(" ")} exited ${r.code}")
        assert(r.out.startsWith("usage: marshal grep <id> <pattern>"), r.out)
        assert(r.out.contains("--last <n>") && r.out.contains("Exits 0 when a line matched"), r.out)
    cleanUp(home)
