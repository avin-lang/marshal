module tests

// The bound on waiting: once a development job has waited past it, it goes ahead of every other
// development job and, while it does not fit, the machine drains for it. Before the bound the urgent
// band and priorities jump it as they always did; the landing and quick lanes go on beside it.
import dev.avinlang.marshal
import dev.avinlang.marshal.{Budget, Fairness, Outside, Started, Ticket, Waiting, Why}
import dev.avinlang.marshal.{NoUnits, NoMemory, Draining, DrainingFor, ForTakeSlot, Starting}

val drainBudget: Budget = Budget(12, 64 * 1024)
val waitBound: long = 10 * minute

// A development job of `units` that arrived at `arrivedMs` (wall clock, milliseconds).
dj(id: long, units: int, arrivedMs: long, expected: long = minute, memory: long = 0) -> Waiting =
    Waiting(id, units, memory, false, expected, arrivedMs * 1000)
dq(id: long, arrivedMs: long) -> Waiting = Waiting(id, 1, 0, false, minute, arrivedMs * 1000, true)
dl(id: long, arrivedMs: long, memory: long = 0) -> Waiting = Waiting(id, 1, memory, true, minute, arrivedMs * 1000)
dr(id: long, units: int, expected: long = minute, memory: long = 0) -> Started = Started(id, units, memory, false, 0, expected)

// The bound of ten minutes, seen at `nowMs` on the wall clock.
fairAt(nowMs: long) -> Fairness = Fairness(waitBound, nowMs * 1000)

startsAt(running: Vector[Started], queue: Vector[Waiting], nowMs: long, o: Outside = marshal.NoOutside) -> Vector[long] =
    marshal.schedule(drainBudget, running, queue, 0, o, fairAt(nowMs))

whysAt(running: Vector[Started], queue: Vector[Waiting], nowMs: long, o: Outside = marshal.NoOutside) -> Vector[(long, Why)] =
    marshal.waits(drainBudget, running, queue, 0, o, fairAt(nowMs)).map(w -> (w.0, w.2))

@test("before the bound an urgent job jumps a big job that does not fit; past it the big job drains the machine")
urgentJumpsUntilTheBound()
    val r = [dr(10, 4)]
    // queue order: the urgent band first, then the big job that arrived at 0
    val q = [dj(20, 1, 5 * minute), dj(1, 12, 0)]
    assertEq(startsAt(r, q, 5 * minute), [long(20)])
    assertEq(whysAt(r, q, 5 * minute), [(long(20), Starting), (long(1), NoUnits)])
    // one millisecond short of the bound nothing has changed
    assertEq(startsAt(r, q, waitBound - 1), [long(20)])
    // at the bound the urgent job waits for the big one, which says it is draining
    assertEq(startsAt(r, q, waitBound), [])
    assertEq(whysAt(r, q, waitBound), [(long(20), DrainingFor(1)), (long(1), Draining)])

@test("a stream of small urgent jobs: the big job starts as soon as the units it waits for free after the bound")
streamOfUrgentJobs()
    // every minute an urgent 1-unit job arrives and would start beside what runs
    var running: Vector[Started] = [dr(100, 4), dr(101, 4)]
    var t: long = 0
    var bigStarted: Option[long] = None
    val big = dj(1, 12, 0)
    while bigStarted.isEmpty() && t <= 30 * minute
        val q = [dj(1000 + t / minute, 1, t), big]
        val go = startsAt(running, q, t)
        if go.contains(1) then bigStarted = Some(t)
        // what starts runs on; past the bound nothing starts, so the running jobs end one by one
        running = if t >= waitBound then running.drop(1) else running ++ go.map(id -> dr(id, 1))
        t += minute
    assert(bigStarted.isDefined(), "the big job never started")
    // at most 12 jobs run at the bound, and one ends each minute after it
    assert(bigStarted.get() <= waitBound + 12 * minute, s"started at ${bigStarted.get()}")
    // and not before the bound: before it the urgent jobs kept units busy
    assert(bigStarted.get() >= waitBound)

@test("past the bound nothing backfills either: a short job that would end before the big one could start waits")
noBackfillWhileDraining()
    val r = [dr(10, 10, expected = minute)]
    val q = [dj(1, 4, 0), dj(2, 1, minute, expected = 1)]
    assertEq(startsAt(r, q, minute), [long(2)])
    assertEq(startsAt(r, q, waitBound), [])
    assertEq(whysAt(r, q, waitBound), [(long(1), Draining), (long(2), DrainingFor(1))])

@test("a landing job keeps its lane while a development job drains: it holds no development units")
landingGoesOnWhileDraining()
    val r = [dr(10, 4)]
    val q = [dl(30, 11 * minute), dj(20, 1, 5 * minute), dj(1, 12, 0)]
    assertEq(startsAt(r, q, 11 * minute), [long(30)])
    assertEq(whysAt(r, q, 11 * minute), [(long(30), Starting), (long(20), DrainingFor(1)), (long(1), Draining)])

@test("a quick job keeps its lane while a development job drains")
quickGoesOnWhileDraining()
    val r = [dr(10, 4)]
    val q = [dq(40, 11 * minute), dj(1, 12, 0)]
    assertEq(startsAt(r, q, 11 * minute), [long(40)])

@test("a job past the bound that fits starts, and the jobs after it are decided as before")
fitsAtOnceIsUnaffected()
    val q = [dj(20, 4, 11 * minute), dj(1, 4, 0), dj(2, 4, minute)]
    // job 1 goes first as the one past the bound; nothing is held
    assertEq(startsAt([], q, 11 * minute), [long(1), long(20), long(2)])
    assertEq(whysAt([dr(10, 6)], q, 11 * minute), [(long(20), NoUnits), (long(1), Starting), (long(2), NoUnits)])

@test("two big jobs in a row: the first past the bound drains, then the second")
twoBigJobs()
    val r = [dr(10, 4)]
    val q = [dj(20, 1, 15 * minute), dj(1, 12, 0), dj(2, 12, minute)]
    assertEq(whysAt(r, q, 12 * minute), [(long(20), DrainingFor(1)), (long(1), Draining), (long(2), DrainingFor(1))])
    assertEq(startsAt([], q, 12 * minute), [long(1)])
    // the first runs; the second has waited past the bound and the urgent job waits for it in turn
    val after = [dj(20, 1, 15 * minute), dj(2, 12, minute)]
    assertEq(whysAt([dr(1, 12)], after, 16 * minute), [(long(20), DrainingFor(2)), (long(2), Draining)])
    assertEq(startsAt([], after, 16 * minute), [long(2)])

@test("a draining job that leaves the queue releases the hold at once")
killReleasesTheHold()
    val r = [dr(10, 4)]
    assertEq(startsAt(r, [dj(20, 1, 5 * minute), dj(1, 12, 0)], waitBound), [])
    assertEq(startsAt(r, [dj(20, 1, 5 * minute)], waitBound), [long(20)])

@test("once the draining job starts, the jobs it held start in their own order as the units allow")
heldJobsKeepTheirOrder()
    val q = [dj(20, 4, 5 * minute), dj(21, 4, 6 * minute), dj(1, 8, 0)]
    // the big job starts, and the urgent jobs follow in their band's order as the units allow
    assertEq(startsAt([], q, waitBound), [long(1), long(20)])
    assertEq(whysAt([], q, waitBound), [(long(20), Starting), (long(21), NoUnits), (long(1), Starting)])

@test("a job past the bound waits for take-slot like any other, and still holds the jobs after it")
drainingBehindTakeSlot()
    val o = Outside(10, [], false)
    val q = [dj(20, 1, 5 * minute), dj(1, 4, 0)]
    assertEq(whysAt([], q, waitBound, o), [(long(20), DrainingFor(1)), (long(1), ForTakeSlot)])
    // a take-slot waiter that arrived before the big job keeps its place ahead of it
    val early = Outside(0, [Ticket(-1000, 12)], false)
    assertEq(whysAt([], q, waitBound, early), [(long(20), DrainingFor(1)), (long(1), ForTakeSlot)])

@test("a job past the bound short of memory drains for memory too")
drainsForMemory()
    val b = Budget(12, 100)
    val r = [dr(10, 1, memory = 60)]
    val q = [dj(20, 1, 5 * minute, memory = 10), dj(1, 1, 0, memory = 50)]
    assertEq(marshal.schedule(b, r, q, 0, marshal.NoOutside, fairAt(5 * minute)), [long(20)])
    assertEq(marshal.waits(b, r, q, 0, marshal.NoOutside, fairAt(waitBound)).map(w -> (w.0, w.2)), [(long(20), DrainingFor(1)), (long(1), Draining)])

@test("the daemon's take-slot ticket is the draining job's, at its own arrival")
ticketIsTheDrainingJobs()
    val r = [dr(10, 4)]
    val q = [dj(20, 1, 5 * minute), dj(1, 12, 0)]
    assertEq(marshal.ticketFor(drainBudget, r, q, 0, marshal.NoOutside, fairAt(5 * minute)), Some((5 * minute * 1000, 1)))
    assertEq(marshal.ticketFor(drainBudget, r, q, 0, marshal.NoOutside, fairAt(waitBound)), Some((long(0), 12)))

@test("no bound never drains, however long a job has waited")
unboundedNeverDrains()
    val r = [dr(10, 4)]
    val q = [dj(20, 1, 5 * minute), dj(1, 12, 0)]
    assertEq(marshal.schedule(drainBudget, r, q, 0), [long(20)])
    assertEq(marshal.schedule(drainBudget, r, q, 0, marshal.NoOutside, marshal.Unbounded), [long(20)])

@test("drain_after in config.json: ten minutes by default, a wait such as 90s, or never; anything else is refused")
drainAfterConfig()
    val G: long = 1024 * 1024 * 1024
    assertEq(marshal.readConfig("", 64 * G).ok().get().drainAfterMs, Some(10 * minute))
    assertEq(marshal.readConfig("{\"drain_after\": \"90s\"}", 64 * G).ok().get().drainAfterMs, Some(long(90000)))
    assertEq(marshal.readConfig("{\"drain_after\": \"2h\"}", 64 * G).ok().get().drainAfterMs, Some(120 * minute))
    assertEq(marshal.readConfig("{\"drain_after\": \"never\"}", 64 * G).ok().get().drainAfterMs, None)
    for bad in ["{\"drain_after\": \"soon\"}", "{\"drain_after\": \"0m\"}", "{\"drain_after\": 5}", "{\"drain_after\": \"\"}"]
        assert(marshal.readConfig(bad, 64 * G).isErr(), bad)
    val never = marshal.readConfig("{\"drain_after\": \"never\"}", 64 * G).ok().get()
    assertEq(marshal.fairness(never, 123), marshal.Unbounded)
    assertEq(marshal.fairness(marshal.readConfig("", 64 * G).ok().get(), 123), Fairness(10 * minute, 123))
