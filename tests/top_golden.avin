module tests

// `marshal top`'s screens, cell for cell: every screen is drawn into a grid and compared with a
// golden file under tests/golden/top, which holds each row's text and every run of cells not drawn
// in the plain style. A change to how top looks fails here until the golden is written again, with
// MARSHAL_GOLDEN_WRITE=1 set, and the new file is read over in review.
import avin.fs
import avin.process
import dev.avinlang.marshal
import dev.avinlang.marshal.{JobInfo, Outcome, Overview, QueuedJob, TakeSlotUse, Usage, Why}
import dev.avinlang.marshal.top.App
import dev.avinlang.marshal.top
import dev.avinlang.tui.{Down, End, Enter, Green, Grid, Home, Magenta, PageDown, PageUp, Resize, Style, Up}

val GoldenDir: string = "tests/golden/top"

// The style of a cell as the golden file writes it.
styleText(s: Style) -> string = s"${s.fg}/${s.bg}/${s.attrs}"

// `g` as text: its rows between bars, then for each row the runs of cells in one style other than
// the plain one, as `row x..end style`.
screenText(g: Grid) -> string
  val rows = (0 ..< g.height).map(y -> "|" + g.rowText(y) + "|").toVector
  val runs = Vector.newBuilder[string]()
  for y in 0 ..< g.height
    var x = 0
    while x < g.width
      val s = g(x, y).style
      var end = x + 1
      while end < g.width && g(end, y).style == s
        end += 1
      if s != Style.plain() then runs.addOne(s"$y $x..$end ${styleText(s)}")
      x = end
  (rows ++ ["--"] ++ runs.result()).mkString("\n") + "\n"

// Checks `g` against the golden file `name`, or writes it when MARSHAL_GOLDEN_WRITE is set.
golden(name: string, g: Grid)
  val file = s"$GoldenDir/$name.txt"
  val got = screenText(g)
  if process.env("MARSHAL_GOLDEN_WRITE").isDefined
    fs.createDirAll(GoldenDir).ok.get
    fs.writeText(file, got).ok.get
    return
  val want = fs.readText(file).ok.getOrElse(s"(no golden file $file)")
  if got != want then println(s"the screen differs from $file")
  assertEq(got, want)

// A job with every field the screen reads, as a snapshot gives it.
gjob(
    id: long,
    kind: string = "build",
    state: string = "running",
    outcome: Option[Outcome] = None,
    units: int = 1,
    landing: bool = false,
    cmd: Vector[string] = ["make", "-j4"],
    elapsed: long = 2 * minuteMs,
    deadline: long = 30 * minuteMs,
    memory: long = 0,
    rss: long = 0,
    peak: long = 0,
    paused: bool = false,
    killed: bool = false,
    label: string = "",
    after: Vector[long] = [],
    attempt: int = 1,
    reserved: long = 0,
    learned: bool = false,
    quick: bool = false,
    urgent: bool = false,
    exclusive: bool = false,
    cores: long = -1,
    owner: string = "",
    expected: long = 0,
    from: string = "",
    startsIn: long = -1,
    quarters: int = 0,
    unitsLearned: bool = false,
    asked: int = 0,
    settlingMs: long = 0,
    overdue: bool = false
) -> JobInfo =
  JobInfo(
    id,
    kind,
    if quarters > 0 then quarters else marshal.wholeUnits(units),
    memory,
    landing,
    "/w",
    cmd,
    state,
    outcome,
    killed,
    0,
    elapsed,
    deadline,
    s"/h/jobs/$id.log",
    None,
    rss = rss,
    peakRss = peak,
    paused = paused,
    after = after,
    attempt = attempt,
    reserved = reserved,
    reservedLearned = learned,
    label = label,
    quick = quick,
    urgent = urgent,
    exclusive = exclusive,
    cores = cores,
    owner = owner,
    expectedMs = expected,
    durationFrom = from,
    startsInMs = startsIn,
    unitsLearned = unitsLearned,
    unitsAsked = asked,
    settlingMs = settlingMs,
    loadOverdue = overdue
  )

// A busy daemon: a landing job, a paused one, take-slot holding units with runs waiting, the queue
// held, every reason to wait, jobs waiting for others or to retry, and every way a job ends.
busy() -> Overview
  val running = [
    gjob(
      21,
      kind = "test",
      units = 2,
      landing = true,
      cmd = ["sysl", "test", "compiler", "--timeout", "1800"],
      elapsed = 25 * minuteMs,
      memory = 4 * G,
      rss = 3 * G,
      peak = 5 * G,
      label = "release 0.3 train",
      cores = 175,
      owner = "sysl",
      expected = 31 * minuteMs,
      from = "cmd+dir"
    ),
    gjob(
      22,
      units = 3,
      cmd = ["cargo", "build", "--release"],
      elapsed = 29 * minuteMs + 30000,
      memory = 2 * G,
      rss = 2 * G + G / 2,
      peak = 3 * G,
      cores = 312,
      owner = "nex",
      expected = 95 * minuteMs,
      from = "cmd"
    ),
    gjob(
      23,
      kind = "bench",
      paused = true,
      cmd = ["./bench.sh"],
      elapsed = 3 * minuteMs,
      deadline = 4 * minuteMs,
      reserved = G,
      learned = true
    ),
    gjob(24, kind = "lint", cmd = ["eslint", "."], elapsed = 26 * minuteMs, deadline = 30 * minuteMs)
  ]
  val queuedJobs = [
    QueuedJob(
      gjob(30, state = "queued", deadline = 45 * minuteMs, units = 4, owner = "avin", startsIn = 6 * minuteMs),
      1,
      Why.NoUnits
    ),
    QueuedJob(gjob(31, state = "queued", memory = 8 * G, owner = "avin", startsIn = 75 * minuteMs), 2, Why.NoMemory),
    QueuedJob(gjob(32, kind = "test", state = "queued", landing = true), 3, Why.LaneBusy),
    QueuedJob(gjob(33, state = "queued"), 4, Why.Draining),
    QueuedJob(gjob(34, state = "queued"), 5, Why.ForTakeSlot),
    QueuedJob(gjob(35, state = "queued"), 6, Why.Behind(30)),
    QueuedJob(gjob(36, state = "queued"), 7, Why.Starting),
    QueuedJob(gjob(37, state = "queued", label = "日本語のラベルはとても長い"), 8, Why.Held),
    QueuedJob(gjob(38, state = "queued"), 9, Why.QueueHeld)
  ]
  val waits = [gjob(40, state = "waiting", after = [21, 22]), gjob(41, state = "retrying", attempt = 2)]
  val recent = [
    gjob(19, state = "done", outcome = Some(Outcome.Quiet(600000))),
    gjob(18, state = "done", outcome = Some(Outcome.DependencyFailed(17))),
    gjob(17, state = "done", outcome = Some(Outcome.Exited(1))),
    gjob(16, state = "done", outcome = Some(Outcome.Signalled(9))),
    gjob(15, state = "done", outcome = Some(Outcome.Exited(0)), peak = 700 * 1048576)
  ]
  Overview(
    Usage(
      24,
      48,
      7 * G,
      16 * G,
      4,
      9,
      Some(21),
      Some(TakeSlotUse("/s/.git", 12, 2, false)),
      6 * G,
      64 * G,
      true,
      10 * G,
      cpu = 840,
      jobCpu = 487,
      diskFree = 31 * G,
      diskMin = 20 * G
    ),
    90061000,
    running,
    queuedJobs,
    recent,
    waits
  )

idleDaemon() -> Overview = Overview(Usage(0, 48, 0, 16 * G, 0, 0, None, None), 5000, [], [], [])

@test("the unit bar puts each boundary at the nearest cell and an exact half rounds up, wherever the half falls")
unitBarHalves()
  // 15 of 22 in 11 cells is exactly 7.5, and 1 of 4 in 10 is 2.5: both round up
  assertEq(counts(0, 15, 22, 11), [0, 8])
  assertEq(counts(15, 0, 22, 11), [8, 0])
  assertEq(counts(1, 0, 4, 10), [3, 0])
  assertEq(counts(7, 8, 22, 11), [4, 4])
  // past the budget the bar is full, and a budget of 0 counts as 1
  assertEq(counts(10, 10, 12, 12), [10, 2])
  assertEq(counts(1, 0, 0, 10), [10, 0])

// The green cells and the magenta ones of a unit bar `width` wide for `ours` and `outside` of `budget`.
private counts(ours: int, outside: int, budget: int, width: int) -> Vector[int]
  val g = Grid(width + 2, 1)
  top.unitBar(g, 0, 0, width, ours, outside, budget)
  val cells = (1 .. width).map(x -> g(x, 0).style.fg).toVector
  [cells.count(c -> c == Green), cells.count(c -> c == Magenta)]

@test("golden: the main list of a full daemon at every width, wide to narrow")
goldenMain()
  for (w, h) in [(140, 24), (120, 22), (100, 20), (90, 20), (89, 20), (80, 18), (60, 16), (40, 12), (24, 8)]
    golden(s"full-$w", drawn(viewing(full()), w, h))

@test("golden: the header meters scale to the terminal's width, half of it at most 120 cells")
goldenMeters()
  for (w, h) in [(80, 12), (160, 12), (250, 12)]
    golden(s"meters-$w", drawn(viewing(full()), w, h))
  assertEq(top.meterWidth(24), 10)
  assertEq(top.meterWidth(60), 23)
  assertEq(top.meterWidth(90), 38)
  assertEq(top.meterWidth(250), 118)
  assertEq(top.meterWidth(400), 120)
  for w in [24, 60, 80, 90, 140, 250, 400]
    assert(top.meterWidth(w) <= 120, s"$w")
    assert(top.meterWidth(w) >= (if w / 3 < 10 then 10 elif w / 3 > 40 then 40 else w / 3), s"$w")

@test("golden: a busy daemon, with landing, take-slot, a paused job, the queue held and every state")
goldenBusy()
  for (w, h) in [(160, 30), (120, 30), (100, 28), (89, 28), (70, 24), (40, 14)]
    golden(s"busy-$w", drawn(viewing(busy()), w, h))
  // time on since the snapshot: clocks move, the paused job's stands still
  golden("busy-later", drawn(viewing(busy()), 120, 30, 5 * minuteMs))

@test("golden: every filter")
goldenFilters()
  val app = viewing(busy())
  for name in ["running", "queued", "finished", "all"]
    app.handle(key('f'))
    golden(s"filter-$name", drawn(app, 120, 30))

@test("golden: an empty daemon, no daemon, one that cannot answer, and none asked yet")
goldenEmpty()
  golden("empty", drawn(viewing(idleDaemon()), 100, 12))
  golden("empty-narrow", drawn(viewing(idleDaemon()), 30, 8))
  val none = App("/h/sock")
  golden("asking", drawn(none, 80, 8))
  none.lost("no daemon at /h/sock (connection refused)", true)
  golden("no-daemon", drawn(none, 80, 8))
  none.lost("the daemon cannot give a snapshot", false)
  golden("cannot-answer", drawn(none, 80, 8))

@test("golden: the selection hidden after the delay, and scrolled to the end of a short screen")
goldenSelection()
  val app = viewing(busy())
  app.handle(press(Down))
  app.handle(press(Down))
  val g = Grid(120, 30)
  app.draw(g, 0, 60000)
  golden("hidden", g)
  app.handle(press(End), 60000)
  app.handle(press(End), 60000)
  golden("end-short", drawn(app, 100, 14))

@test("golden: the log pane with its header, following, scrolled back, empty, wrapped and squeezed")
goldenLog()
  val app = viewing(busy())
  app.handle(press(Enter))
  app.logLines = (1 .. 60).map(i -> s"line $i of the build output").toVector
  golden("log-labelled", drawn(app, 120, 34))
  golden("log-narrow", drawn(app, 50, 34))
  app.handle(press(PageUp))
  golden("log-back", drawn(app, 120, 34))
  app.handle(press(Home))
  golden("log-home", drawn(app, 120, 34))
  app.handle(press(End))
  app.handle(press(Down))
  app.logLines = []
  golden("log-empty", drawn(app, 100, 30))
  val lengthy = ["sh", "-c", (0 ..< 14).map(i -> "abcdefghij").mkString("")]
  val wrapping = viewing(
    Overview(full().usage, 0, [gjob(1, cmd = lengthy, label = "a label long enough to wrap in a narrow pane")], [], [])
  )
  wrapping.handle(press(Enter))
  wrapping.logLines = ["first", "last"]
  for (w, h) in [(60, 30), (60, 16), (60, 14), (60, 12), (40, 12), (30, 10), (100, 9), (100, 8), (100, 7)]
    golden(s"log-wrap-$w-$h", drawn(wrapping, w, h))

@test("golden: the help, wide and squeezed, and the kill prompt and messages on the bottom line")
goldenOverlays()
  val app = viewing(busy())
  app.handle(key('h'))
  golden("help", drawn(app, 120, 30))
  golden("help-small", drawn(app, 50, 14))
  app.handle(key('x'))
  app.handle(key('k'))
  golden("kill-prompt", drawn(app, 120, 30))
  golden("kill-prompt-narrow", drawn(app, 40, 12))
  app.handle(key('n'))
  golden("not-killed", drawn(app, 120, 30))
  app.handle(key('f'))
  app.handle(key('f'))
  app.handle(key('f'))
  app.handle(press(End))
  app.handle(key('k'))
  golden("already-ended", drawn(app, 120, 30))
  val none = viewing(idleDaemon())
  none.handle(key('k'))
  golden("no-job-selected", drawn(none, 80, 10))
  // a resize while the help shows closes it
  app.handle(key('h'))
  app.handle(Resize(120, 30))
  golden("help-resized", drawn(app, 120, 30))

@test(
  "golden: the quick lane: running quick jobs say quick with their kind marked ^, the header counts the lane, and a third waits for it"
)
goldenQuickLane()
  val running = [
    gjob(
      41,
      kind = "test",
      units = 4,
      cmd = ["avin", "test", "."],
      elapsed = 20000,
      deadline = 2 * minuteMs,
      quick = true
    ),
    gjob(
      42,
      kind = "test",
      units = 4,
      cmd = ["avin", "test", "lib"],
      elapsed = 5000,
      deadline = 2 * minuteMs,
      quick = true
    ),
    gjob(40, units = 12, cmd = ["make", "-j12"], elapsed = 10 * minuteMs)
  ]
  val queued = [
    QueuedJob(
      gjob(43, kind = "test", state = "queued", units = 4, deadline = 2 * minuteMs, quick = true),
      1,
      Why.QuickFull
    ),
    QueuedJob(gjob(44, state = "queued", units = 1), 1, Why.NoUnits)
  ]
  val o = Overview(Usage(48, 48, 0, 16 * G, 3, 2, None, None, quick = 2), 60000, running, queued, [])
  golden("quick-lane", drawn(viewing(o), 100, 12))
  // with no quick job running, the header says nothing of the lane
  assert(!drawn(viewing(idleDaemon()), 100, 10).rowText(0).contains("quick"))
  assert(drawn(viewing(o), 100, 12).rowText(0).contains("quick: 2/2"))

@test(
  "golden: an urgent job's kind is marked !, after its lane's mark, running, queued and ended; a long kind is cut as build* is"
)
goldenUrgentMarks()
  val running = [
    gjob(51, kind = "test", urgent = true, cmd = ["make", "test"]),
    gjob(
      52,
      kind = "test",
      units = 4,
      cmd = ["avin", "test", "."],
      elapsed = 20000,
      deadline = 2 * minuteMs,
      quick = true,
      urgent = true
    ),
    gjob(53, kind = "test", landing = true, urgent = true, cmd = ["sysl", "test", "compiler"]),
    gjob(54, kind = "funl-test", urgent = true, cmd = ["sbt", "test"]),
    gjob(55, kind = "build", landing = false, cmd = ["make"])
  ]
  val queued = [
    QueuedJob(gjob(56, kind = "test", state = "queued", urgent = true), 1, Why.NoUnits),
    QueuedJob(
      gjob(57, kind = "test", state = "queued", quick = true, urgent = true, deadline = 2 * minuteMs),
      1,
      Why.QuickFull
    ),
    QueuedJob(gjob(58, state = "queued"), 2, Why.NoUnits)
  ]
  val ended = [gjob(50, kind = "test", state = "done", outcome = Some(Outcome.Exited(0)), urgent = true)]
  val o = Overview(Usage(32, 48, 0, 16 * G, 5, 3, Some(53), None, quick = 1), 60000, running, queued, ended)
  golden("urgent-marks", drawn(viewing(o), 120, 20))
  golden("urgent-marks-80", drawn(viewing(o), 80, 20))
  assert(drawn(viewing(o), 120, 20).rowText(6).contains("test!"))
  assert(drawn(viewing(o), 120, 20).rowText(9).contains("funl-t…!"))

// A daemon whose exclusive job 70 is settling, `settlingMs` into its wait for the load, overdue or
// not, with job 71 queued behind it and job 69 ended.
settlingDaemon(settlingMs: long, overdue: bool) -> Overview
  val x = gjob(
    70,
    kind = "bench",
    state = "settling",
    units = 12,
    exclusive = true,
    elapsed = 0,
    cmd = ["./bench"],
    settlingMs = settlingMs,
    overdue = overdue
  )
  val queued = [
    QueuedJob(x, 1, Why.Load(30.4, 4.5, 0)),
    QueuedJob(gjob(71, state = "queued", elapsed = 0), 2, Why.ForExclusive(70))
  ]
  val ended = [gjob(69, state = "done", outcome = Some(Outcome.Exited(0)))]
  Overview(Usage(0, 48, 0, 16 * G, 0, 1, None, None, settling = 1), 60000, [], queued, ended)

@test(
  "golden: a settling job says settling, its ELAPSED the load wait; past load_wait its whole row is red, selected or not, and nothing else changes"
)
goldenSettling()
  val calm = viewing(settlingDaemon(3 * minuteMs, false))
  golden("settling", drawn(calm, 120, 12))
  val late = viewing(settlingDaemon(17 * minuteMs, true))
  golden("settling-overdue", drawn(late, 120, 12))
  // the selection moved off it: still red
  late.handle(press(Down))
  golden("settling-overdue-unselected", drawn(late, 120, 12))
  // the header counts it apart; ELAPSED moves with the clock, not as run time
  val g = drawn(viewing(settlingDaemon(3 * minuteMs, false)), 120, 12, 60000)
  assert(g.rowText(0).contains("0 running  1 queued  1 settling"), g.rowText(0))
  assert(g.rowText(6).contains("settling") && g.rowText(6).contains("4:00"), g.rowText(6))
  // the queued job behind it is not red, and nothing is red when no job is overdue
  val calmGrid = drawn(viewing(settlingDaemon(3 * minuteMs, false)), 120, 12)
  for y in 0 ..< 12
    for x in 0 ..< 120 do assert(calmGrid(x, y).style.bg != top.OverdueStyle.bg, s"$x,$y")
  val lateGrid = drawn(viewing(settlingDaemon(17 * minuteMs, true)), 120, 12)
  for x in 0 ..< 120 do assertEq(lateGrid(x, 6).style.bg, top.OverdueStyle.bg)
  for x in 0 ..< 120 do assert(lateGrid(x, 7).style.bg != top.OverdueStyle.bg, s"$x,7")

@test("golden: an exclusive job's kind is marked #, running, queued and ended, with ! after it")
goldenExclusiveMarks()
  val running = [
    gjob(61, kind = "bench", units = 12, exclusive = true, cmd = ["./bench"]),
    gjob(62, kind = "bench", exclusive = true, urgent = true, cmd = ["./bench", "-x"])
  ]
  val queued = [QueuedJob(gjob(63, kind = "bench", state = "queued", exclusive = true), 1, Why.NoUnits)]
  val ended = [gjob(60, kind = "bench", state = "done", outcome = Some(Outcome.Exited(0)), exclusive = true)]
  val o = Overview(Usage(32, 48, 0, 16 * G, 5, 3, None, None), 60000, running, queued, ended)
  golden("exclusive-marks", drawn(viewing(o), 100, 16))
  assert(drawn(viewing(o), 100, 16).rowText(6).contains("bench#"))
  assert(drawn(viewing(o), 100, 16).rowText(7).contains("bench#!"))

@test("golden: a job weighing fewer units than it gave shows both where they fit in UNITS, and else what it weighs")
goldenUnitsCapped()
  val running = [
    // gave 4, weighs the 1 its runs teach: `4→~1` fits
    gjob(81, quarters = 4, unitsLearned = true, asked = 16, cores = 90),
    // gave exactly 8, or gave none: as before
    gjob(82, units = 8, cmd = ["make", "-j8"]),
    gjob(83, quarters = 6, unitsLearned = true, cmd = ["make", "-j2"])
  ]
  // gave 8, weighs 1.5: `8→~1.5` is wider than the column, so `~1.5`
  val queued = [QueuedJob(gjob(84, state = "queued", quarters = 6, unitsLearned = true, asked = 32), 1, Why.NoUnits)]
  val o = Overview(Usage(42, 48, 0, 16 * G, 3, 1, None, None), 60000, running, queued, [])
  golden("units-capped", drawn(viewing(o), 120, 12))
  val g = drawn(viewing(o), 120, 12)
  val rows = (0 ..< g.height).map(y -> g.rowText(y)).toVector
  assert(rows.exists(r -> r.contains(" 4→~1 ")), rows.mkString("\n"))
  assert(rows.exists(r -> r.contains("84") && r.contains(" ~1.5 ") && !r.contains("→")), rows.mkString("\n"))

// A daemon whose disk is under `disk_min`, with jobs of two owners.
lowDisk() -> Overview
  val running = [
    gjob(70, cores = 120, owner = "sysl", expected = 10 * minuteMs, from = "cmd", elapsed = 4 * minuteMs),
    gjob(71, owner = "avin", cmd = ["avin", "test", "."], cores = 0, expected = minuteMs, from = "kind")
  ]
  val queued = [
    QueuedJob(gjob(72, state = "queued", owner = "sysl"), 1, Why.DiskLow(14 * G)),
    QueuedJob(gjob(73, state = "queued", owner = "avin"), 2, Why.Held)
  ]
  Overview(
    Usage(8, 48, 0, 16 * G, 2, 2, None, None, cpu = 300, jobCpu = 120, diskFree = 14 * G, diskMin = 20 * G),
    60000,
    running,
    queued,
    []
  )

@test(
  "golden: a low disk holds the queue and is red in the header; o shows one owner's jobs, then the next's, then all"
)
goldenDiskAndOwner()
  golden("disk-low", drawn(viewing(lowDisk()), 140, 12))
  golden("disk-low-100", drawn(viewing(lowDisk()), 100, 12))
  val app = viewing(lowDisk())
  app.handle(key('o'))
  assertEq(app.owner, Some("avin"))
  golden("owner-avin", drawn(app, 140, 12))
  assertEq(app.shown.map(l -> l.job.id), [71, 73])
  app.handle(key('o'))
  assertEq(app.shown.map(l -> l.job.id), [70, 72])
  app.handle(key('o'))
  assertEq(app.owner, None)
  assertEq(app.shown.length, 4)

@test("golden: the disk's free space is plain above twice disk_min, yellow under it, red under disk_min")
goldenDiskLevels()
  for (free, level) in [(41 * G, "plenty"), (39 * G, "near"), (14 * G, "low")]
    val o = lowDisk()
    val u = o.usage
    val at = Overview(
      Usage(
        u.units,
        u.unitBudget,
        u.memory,
        u.memoryBudget,
        u.running,
        u.queued,
        None,
        None,
        cpu = 300,
        jobCpu = 120,
        diskFree = free,
        diskMin = 20 * G
      ),
      o.uptimeMs,
      o.running,
      [],
      []
    )
    golden(s"disk-level-$level", drawn(viewing(at), 120, 6))

// A daemon running only a landing job of `units`, with take-slot's use if any.
landingOnly(units: int, takeSlot: Option[TakeSlotUse]) -> Overview =
  Overview(
    Usage(0, 48, 0, 16 * G, 1, 0, Some(7), takeSlot),
    60000,
    [gjob(7, kind = "test", units = units, landing = true)],
    [],
    []
  )

@test(
  "golden: the units line adds the landing job's units, outside the budget, and drops them whole where they do not fit"
)
goldenLandingUnits()
  val alone = landingOnly(1, None)
  // `0/12]   landing 1` ends at column 29 of a 29-cell screen, and is dropped from a 28-cell one
  for w in [100, 29, 28, 24]
    golden(s"landing-units-$w", drawn(viewing(alone), w, 10))
  val beside = landingOnly(3, Some(TakeSlotUse("/s/.git", 16, 0, false)))
  // `0+4/12] take-slot   landing 3` ends at column 43 of a 43-cell screen, and is dropped from a
  // 42-cell one
  for w in [120, 43, 42, 40]
    golden(s"landing-units-takeslot-$w", drawn(viewing(beside), w, 10))
  golden(
    "landing-units-takeslot-waiting",
    drawn(viewing(landingOnly(2, Some(TakeSlotUse("/s/.git", 16, 3, false)))), 100, 10)
  )
  // the lane held by take-slot, or by a landing job not among the running ones: nothing is added
  golden(
    "landing-units-lane-takeslot",
    drawn(
      viewing(Overview(Usage(0, 48, 0, 16 * G, 0, 0, None, Some(TakeSlotUse("/s", 8, 0, true))), 0, [], [], [])),
      100,
      10
    )
  )
  golden(
    "landing-units-not-running",
    drawn(viewing(Overview(Usage(0, 48, 0, 16 * G, 0, 1, Some(9), None), 0, [], [], [])), 100, 10)
  )
  val row = drawn(viewing(alone), 100, 10).rowText(1)
  assert(row.contains(" 0/12]   landing 1"), row)
  assert(drawn(viewing(alone), 29, 10).rowText(1).endsWith("0/12]   landing 1"))
  assert(!drawn(viewing(alone), 28, 10).rowText(1).contains("landing"))
  val takeSlot = drawn(viewing(beside), 43, 10).rowText(1)
  assert(takeSlot.endsWith("0+4/12] take-slot   landing 3"), takeSlot)
  assert(!drawn(viewing(beside), 42, 10).rowText(1).contains("landing"))

// A daemon running 3.25 units of 12, with a job queued to run alone and one held behind it: polite at
// `polite` (None for not), and set by the schedule until `until`.
politeDaemon(polite: Option[marshal.PoliteUse]) -> Overview
  val running = [gjob(50, units = 13, cmd = ["make", "-j3"], elapsed = 4 * minuteMs)]
  val queued = [
    QueuedJob(gjob(51, kind = "test", state = "queued", units = 40), 1, Why.RunsAlone),
    QueuedJob(gjob(52, state = "queued", units = 4), 2, Why.ForAlone(51)),
    QueuedJob(gjob(53, state = "queued", units = 4), 3, Why.PoliteBudget)
  ]
  Overview(Usage(13, 48, 12 * G, 56 * G, 1, 3, None, None, polite = polite), 60000, running, queued, [])

@test(
  "golden: polite mode in the header, the meters against the polite budget of the full one, and why jobs wait for it"
)
goldenPolite()
  golden("polite-off", drawn(viewing(politeDaemon(None)), 120, 12))
  golden("polite-on", drawn(viewing(politeDaemon(Some(marshal.PoliteUse(0.75, 36, 42 * G)))), 120, 12))
  golden("polite-schedule", drawn(viewing(politeDaemon(Some(marshal.PoliteUse(0.75, 36, 42 * G, "16:05")))), 120, 12))
  val on = drawn(viewing(politeDaemon(Some(marshal.PoliteUse(0.75, 36, 42 * G)))), 120, 12)
  assert(on.rowText(0).contains("  polite ¾   landing: free"), on.rowText(0))
  assert(on.rowText(1).contains("3.25/9 of 12]"), on.rowText(1))
  assert(on.rowText(2).contains("12G/42G of 56G]"), on.rowText(2))
  assert(!drawn(viewing(politeDaemon(None)), 120, 12).rowText(0).contains("polite"))

// Running jobs whose ETAs are on time, late, a guess and a late guess, one with none, and a queued
// job's start.
etaMarks() -> Overview
  val running = [
    gjob(60, expected = 10 * minuteMs, from = "cmd", elapsed = 4 * minuteMs),
    gjob(61, expected = 10 * minuteMs, from = "cmd+dir", elapsed = 14 * minuteMs),
    gjob(62, expected = 10 * minuteMs, from = "kind+project", elapsed = 4 * minuteMs),
    gjob(63, expected = 10 * minuteMs, from = "kind+project", elapsed = 26 * minuteMs),
    gjob(64, expected = 10 * minuteMs, from = "kind", elapsed = 4 * minuteMs)
  ]
  val queued = [QueuedJob(gjob(65, state = "queued", expected = 3 * minuteMs, from = "cmd", startsIn = 4 * minuteMs), 1, Why.NoUnits)]
  Overview(Usage(5, 48, 0, 16 * G, 5, 1, None, None), 60000, running, queued, [])

@test("golden: a late ETA is marked +, a guessed one ?, a late guess both, and the deadline holds a late one")
goldenEtaMarks()
  golden("eta-marks", drawn(viewing(etaMarks()), 120, 12))
  val g = drawn(viewing(etaMarks()), 120, 12)
  val rows = (0 ..< g.height).map(y -> g.rowText(y)).toVector
  val row = (id: string) -> rows.find(r -> r.trim.startsWith(id + " ")).getOrElse("")
  assert(row("60").contains(" ~6m "), row("60"))
  // 14 minutes in: late, 7 more
  assert(row("61").contains(" +~7m "), row("61"))
  assert(row("62").contains(" ~6m? "), row("62"))
  // 26 minutes in of a 30-minute deadline: 13 more would pass it, which leaves 4
  assert(row("63").contains(" +~4m? "), row("63"))
  assert(!row("64").contains("~"), row("64"))
  assert(row("65").contains(" in ~4m "), row("65"))
