module tests

// Quiet timeouts: the quiet clock (output starts it again, a pause and a restart start it again),
// how `--quiet-timeout` is read, and how the quiet timeout and its outcome travel (the wire, the
// saved state, the event log) and show (`wait`, `ls`, history, events filters).
import json
import json.Json
import dev.avinlang.marshal
import dev.avinlang.marshal.cli
import dev.avinlang.marshal.{JobInfo, JobSpec, Outcome, SavedJob, SavedState}

val quietSpec: JobSpec = JobSpec("test", 4, 0, false, "/w", None, ["sysl", "test", "."], [("PATH", "/bin")], quietMs = 600000)

// A job as a listing or the log gives it, with the quiet timeout `quietMs`.
quietJob(id: long, quietMs: long, state: string = "running", outcome: Option[Outcome] = None, sample: Option[string] = None) -> JobInfo =
    JobInfo(id, "build", 1, 0, false, "/w", ["sleep", "30"], state, outcome, false, 0, 61000, 1200000, s"/h/jobs/$id.log", sample, quietMs = quietMs)

// ---- the quiet clock

@test("output, a change of the log's size either way, starts the quiet clock again; no change leaves it")
quietClockOutput()
    val c = marshal.quietStart(100, 1000)
    assertEq(c, marshal.QuietClock(100, 1000))
    assertEq(marshal.quietSeen(c, 100, 5000), c)
    assertEq(marshal.quietSeen(c, 101, 5000), marshal.QuietClock(101, 5000))
    // a log truncated and written again is output too
    assertEq(marshal.quietSeen(c, 0, 5000), marshal.QuietClock(0, 5000))
    assertEq(marshal.quietFor(c, 5000), 4000)
    assertEq(marshal.quietFor(marshal.quietSeen(c, 200, 5000), 5000), 0)
    // a clock read before it began has been quiet for no time
    assertEq(marshal.quietFor(c, 500), 0)

@test("a quiet timeout passes exactly when the log has been quiet that long, and never when there is none")
quietClockPasses()
    val c = marshal.quietStart(0, 10_000)
    assert(!marshal.quietPassed(c, 2000, 11_999))
    assert(marshal.quietPassed(c, 2000, 12_000))
    assert(marshal.quietPassed(c, 2000, 99_000))
    // output a moment before it would have passed puts it off by a whole timeout
    val later = marshal.quietSeen(c, 7, 11_999)
    assert(!marshal.quietPassed(later, 2000, 12_000))
    assert(!marshal.quietPassed(later, 2000, 13_998))
    assert(marshal.quietPassed(later, 2000, 13_999))
    // 0 is no quiet timeout, however long the quiet
    assert(!marshal.quietPassed(c, 0, long.MaxValue))
    // the longest timeout `--quiet-timeout` can give does not overflow
    assert(!marshal.quietPassed(marshal.quietStart(0, 0), long.MaxValue, 1_000_000))

@test("a pause is not quiet: the clock started again at the resume counts from there, however long the pause")
quietClockPause()
    // started at 0; paused at 1500 having written nothing; resumed at 60000
    val c = marshal.quietStart(10, 0)
    assert(!marshal.quietPassed(c, 2000, 1500))
    val resumed = marshal.quietStart(10, 60_000)
    assert(!marshal.quietPassed(resumed, 2000, 60_000))
    assert(!marshal.quietPassed(resumed, 2000, 61_999))
    assert(marshal.quietPassed(resumed, 2000, 62_000))
    // output after the resume starts it again as usual
    assert(!marshal.quietPassed(marshal.quietSeen(resumed, 11, 61_000), 2000, 62_500))

@test("a restart starts the clock again, from the log as it is then")
quietClockRestart()
    // quiet for 1900 of 2000 under the old image; the new one starts the clock at 5000
    val old = marshal.quietStart(40, 3100)
    assert(!marshal.quietPassed(old, 2000, 5000))
    val taken = marshal.quietStart(40, 5000)
    assert(!marshal.quietPassed(taken, 2000, 6000))
    assert(marshal.quietPassed(taken, 2000, 7000))
    // output written while the daemon restarted is seen as a size it did not start from only if it
    // changes again; the clock already counts from the takeover
    assertEq(marshal.quietSeen(taken, 40, 6500), taken)

// ---- reading --quiet-timeout

@test("submit, run and run-type read --quiet-timeout as --deadline reads a deadline")
quietOptions()
    val env: Vector[(string, string)] = []
    val parse = (args: Vector[string]) -> cli.parseSubmission(args, "/w", env)
    assertEq(parse(["--quiet-timeout", "90s", "--", "make"]).map(s -> s.quietMs), Ok(long(90000)))
    assertEq(parse(["--quiet-timeout", "10", "make"]).map(s -> s.quietMs), Ok(long(600000)))
    assertEq(parse(["--quiet-timeout", "2h", "--deadline", "3h", "make"]).map(s -> (s.quietMs, s.deadlineMs)), Ok((long(7200000), Some(long(10800000)))))
    assertEq(parse(["make"]).map(s -> s.quietMs), Ok(long(0)))
    assertEq(cli.typeLine(["--quiet-timeout", "5m", "train", "main"]).map(l -> (l.quietMs, l.rest)), Ok((long(300000), ["train", "main"])))
    assertEq(cli.typeLine(["train", "main", "--quiet-timeout", "1s", "--submit"]).map(l -> (l.quietMs, l.submitOnly, l.rest)), Ok((long(1000), true, ["train", "main"])))
    assertEq(cli.typeLine(["train"]).map(l -> l.quietMs), Ok(long(0)))
    // after `--` it is the command's
    assertEq(cli.typeLine(["train", "--", "--quiet-timeout", "x"]).map(l -> (l.quietMs, l.rest)), Ok((long(0), ["train", "--", "--quiet-timeout", "x"])))

@test("a quiet timeout that is zero, negative, garbage or missing is refused, with the reason")
quietOptionsRefused()
    val env: Vector[(string, string)] = []
    val parse = (args: Vector[string]) -> cli.parseSubmission(args, "/w", env)
    for bad in ["0", "0s", "0m", "-5", "-5s", "abc", "", "5x", "1.5m", "s", "10 m", "99999999999999999999h"]
        val why = s"`--quiet-timeout $bad`: a quiet timeout is minutes, or a number with s, m or h, such as 90s"
        assertEq(parse(["--quiet-timeout", bad, "--", "make"]), Err(why))
        assertEq(cli.typeLine(["--quiet-timeout", bad, "train"]), Err(why))
    assertEq(parse(["--quiet-timeout"]), Err("`--quiet-timeout` needs a value"))
    assertEq(cli.typeLine(["train", "--quiet-timeout"]), Err("`--quiet-timeout` needs a value"))

@test("no parameter of a job type may be named after run-type's own --quiet-timeout or --label, and its help names them")
quietTypeOption()
    typeRefused(withParams("\"quiet-timeout\": {\"default\": \"\"}"), "`--quiet-timeout` is an option of run-type itself")
    typeRefused(withParams("\"label\": {\"default\": \"\"}"), "`--label` is an option of run-type itself")
    val h = marshal.typeHelp(parsedType(sampleType))
    assert(h.contains("--quiet-timeout <t>"), h)

// ---- how it travels

@test("a spec's quiet timeout reads back; none writes no member, and a spec without one reads as none")
quietSpecWire()
    assertEq(marshal.decodeSpec(marshal.encodeSpec(quietSpec)), Ok(quietSpec))
    for ms in [long(1), long(1000), long.MaxValue]
        val s = JobSpec("build", 1, 0, false, "/w", None, ["make"], [], quietMs = ms)
        assertEq(marshal.decodeSpec(marshal.encodeSpec(s)), Ok(s))
    val none = JobSpec("build", 1, 0, false, "/w", None, ["make"], [])
    val text = marshal.encodeSpec(none).render()
    assert(!text.contains("quiet"), text)
    assertEq(marshal.decodeSpec(marshal.encodeSpec(none)).map(s -> s.quietMs), Ok(long(0)))
    val nulled = json.parse(text.dropRight(1) + ",\"quiet_ms\":null}").ok().get()
    assertEq(marshal.decodeSpec(nulled).map(s -> s.quietMs), Ok(long(0)))

@test("a spec's quiet timeout that is not a whole number above 0 is refused, naming the field")
quietSpecRefused()
    val text = marshal.encodeSpec(quietSpec).render()
    for bad in ["0", "-1", "\"10m\"", "2.5", "true"]
        val j = json.parse(text.replace("\"quiet_ms\":600000", s"\"quiet_ms\":$bad")).ok().get()
        assertEq(marshal.decodeSpec(j), Err("`quiet_ms` is not a whole number above 0"))

@test("the quiet outcome reads back, its timeout with it, and an outcome without its timeout is refused")
quietOutcomeWire()
    for ms in [long(1), long(600000), long.MaxValue]
        assertEq(marshal.decodeOutcome(marshal.encodeOutcome(Outcome.Quiet(ms))), Ok(Outcome.Quiet(ms)))
    assertEq(marshal.encodeOutcome(Outcome.Quiet(2000)).render(), "{\"how\":\"quiet\",\"after_ms\":2000}")
    assert(marshal.decodeOutcome(json.parse("{\"how\":\"quiet\"}").ok().get()).isErr())
    assert(marshal.decodeOutcome(json.parse("{\"how\":\"quiet\",\"after_ms\":\"2s\"}").ok().get()).isErr())
    // a deadline's timeout is still its own outcome
    assertEq(marshal.decodeOutcome(marshal.encodeOutcome(Outcome.TimedOut)), Ok(Outcome.TimedOut))

@test("a listed job carries its quiet timeout, as status --json and the events give it; one without has no member")
quietJobWire()
    val running = quietJob(3, 600000)
    assertEq(marshal.decodeJob(marshal.encodeJob(running)), Ok(running))
    assert(marshal.encodeJob(running).render().contains("\"quiet_ms\":600000"))
    val ended = quietJob(4, 2000, "done", Some(Outcome.Quiet(2000)), Some("/h/jobs/4.sample.txt"))
    assertEq(marshal.decodeJob(marshal.encodeJob(ended)), Ok(ended))
    val none = quietJob(5, 0)
    assert(!marshal.encodeJob(none).render().contains("quiet"))
    assertEq(marshal.decodeJob(marshal.encodeJob(none)), Ok(none))

// A saved running job with the quiet timeout `quietMs`, being stopped for it (`stopped`) or not.
quietSaved(quietMs: long, stopped: bool) -> SavedJob =
    val spec = JobSpec("build", 1, 0, false, "/w", None, ["make"], [], quietMs = quietMs)
    val sample = if stopped then Some("/h/jobs/5.sample.txt") else None
    SavedJob(5, spec, "running", 1, 2, 3, 0, 5, 6, "/h/jobs/5.log", 70, 70, None, false, stopped, sample, 0, 0, quietStopped = stopped)

@test("a restart hands over each job's quiet timeout and whether it is being stopped for it")
quietStateRoundTrip()
    for ms in [long(0), long(1000), long.MaxValue]
        for stopped in [false, true]
            val s = SavedState("0.2.5", 1, 2, 3, 4, [], [quietSaved(ms, stopped)], [], None)
            assertEq(marshal.decodeState(marshal.encodeState(s).render()), Ok(s))
    // ended by it, too
    val ended = SavedJob(6, quietSpec, "done", 1, 2, 3, 4, 5, 6, "/h/jobs/6.log", 70, 71, Some(Outcome.Quiet(600000)), false, true, Some("/s"), 0, 0, quietStopped = true)
    val s = SavedState("0.2.5", 1, 2, 3, 4, [], [], [ended], None)
    assertEq(marshal.decodeState(marshal.encodeState(s).render()), Ok(s))

@test("a state saved before quiet timeouts reads as none, and no job being stopped for one")
quietStateBefore()
    val head = "\"version\": \"0.2.5\", \"pid\": 1, \"saved_at\": 2, \"began_at\": 3, \"next_id\": 4"
    val full = marshal.encodeSavedJob(quietSaved(1000, true)).render()
    val old = full.replace(",\"quiet_stopped\":true", "").replace(",\"quiet_ms\":1000", "")
    assert(!old.contains("quiet"), old)
    val decoded = marshal.decodeState(s"{$head, \"queue\": [], \"running\": [$old], \"ended\": []}")
    assertEq(decoded.map(st -> (st.running(0).spec.quietMs, st.running(0).quietStopped, st.running(0).timedOut)), Ok((long(0), false, true)))
    val nulls = full.replace("\"quiet_stopped\":true", "\"quiet_stopped\":null")
    assertEq(marshal.decodeState(s"{$head, \"queue\": [], \"running\": [$nulls], \"ended\": []}").map(st -> st.running(0).quietStopped), Ok(false))
    val wrong = full.replace("\"quiet_stopped\":true", "\"quiet_stopped\":1")
    assert(marshal.decodeState(s"{$head, \"queue\": [], \"running\": [$wrong], \"ended\": []}").err().get().contains("`quiet_stopped` is not a bool"))

// ---- how it shows

@test("wait's line, ls and history tell a quiet timeout from a deadline")
quietShows()
    val q = quietJob(4, 600000, "done", Some(Outcome.Quiet(600000)), Some("/h/jobs/4.sample.txt"))
    assertEq(marshal.resultLine(q), "marshal: job 4 killed after 10m00s without output (quiet timeout), having run 1m01s; stack sample in /h/jobs/4.sample.txt; log /h/jobs/4.log")
    assertEq(marshal.stateColumn(q), "quiet")
    val t = quietJob(5, 600000, "done", Some(Outcome.TimedOut), Some("/h/jobs/5.sample.txt"))
    assert(marshal.resultLine(t).contains("timed out after 1m01s (deadline 20m00s)"), marshal.resultLine(t))
    assertEq(marshal.stateColumn(t), "timeout")
    assertEq(marshal.quietWords(2000), "killed after 2.0s without output")
    assertEq(marshal.howWord(Outcome.Quiet(1), false), "quiet")
    assertEq(marshal.howWord(Outcome.TimedOut, false), "timeout")
    assertEq(marshal.exitCode(Outcome.Quiet(1)), 124)
    // retried like a deadline's timeout, but never after a kill
    assert(marshal.retryable(Outcome.Quiet(1), false))
    assert(!marshal.retryable(Outcome.Quiet(1), true))

@test("the quiet ending is an ending: history reads it, and events filters take outcome=quiet")
quietEvents()
    val q = quietJob(4, 2000, "done", Some(Outcome.Quiet(2000)))
    val line = marshal.eventLine(1_762_000_000_000, "quiet", q, [("run_ms", Json.num(3000)), ("exit", Json.num(124))])
    val ev = json.parse(line).ok().get()
    assertEq(marshal.outcomeOf(ev), Some("quiet"))
    assert(marshal.endsJob(ev))
    val filterOf = (text: string) -> marshal.parseFilter(text).ok().get()
    assert(marshal.admits(filterOf("ended:outcome=quiet"), ev))
    assert(marshal.admits(filterOf("failed"), ev))
    assert(!marshal.admits(filterOf("ended:outcome=timeout"), ev))
    val l = marshal.Ledger()
    l.add(line)
    assertEq(l.ends.map(e -> (e.id, e.how, e.exit, e.runMs)).toVector, [(long(4), "quiet", 124, long(3000))])
