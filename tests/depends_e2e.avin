module tests

// End to end, with the helpers of e2e.avin: jobs waiting for others, the cancels that cascade from a
// failure, retries, and `rerun`, through the command line and a real daemon, and across a restart.
import avin.fs
import avin.threads
import avin.time
import avin.time.millis

// Whether job `later` started after job `earlier` finished, by the order of the event log.
startedAfter(home: string, later: long, earlier: long) -> bool = at(home, later, "started") > at(home, earlier, "finished")

// A command that fails until it has run `times` times in `dir`, counting its runs in a file there.
failsUntil(dir: string, times: int) -> Vector[string] =
    ["sh", "-c", s"n=$$(cat $dir/runs 2>/dev/null || echo 0); n=$$((n + 1)); echo $$n > $dir/runs; echo run $$n; [ $$n -ge $times ] || exit 5"]

@test("a chain a, b after a, c after b runs in order, and ls shows the waiting jobs with what they wait for")
dependsChain()
    val home = newHome()
    val a = submitted(home, "--", "sleep", "1")
    val b = submitted(home, "--after", a.toString(), "--", "sh", "-c", "echo b")
    val c = submitted(home, "--after", b.toString(), "--", "sh", "-c", "echo c")
    val ls = m(home, "ls")
    assert(ls.out.contains(s"after $a "), ls.out)
    assert(ls.out.contains(s"after $b "), ls.out)
    val r = m(home, "wait", c.toString())
    assertEq(r.code, 0)
    assert(startedAfter(home, b, a))
    assert(startedAfter(home, c, b))
    assertEq(eventsOf(home, b), ["submitted", "ready", "started", "finished"])
    assertEq(eventsOf(home, c), ["submitted", "ready", "started", "finished"])
    cleanUp(home)

@test("a job waiting for several starts only after the last of them ends")
dependsFanIn()
    val home = newHome()
    val a = submitted(home, "--", "sleep", "0.3")
    val b = submitted(home, "--", "sleep", "1")
    val c = submitted(home, "--", "sleep", "0.6")
    val d = submitted(home, "--after", s"$a,$b,$c", "--", "true")
    assertEq(m(home, "wait", d.toString()).code, 0)
    for dep in [a, b, c] do assert(startedAfter(home, d, dep), s"$d started before $dep finished")
    cleanUp(home)

@test("a failed job cancels what waits for it, the cancel cascades, and --after-any runs anyway")
dependsCascade()
    val home = newHome()
    val a = submitted(home, "--", "sh", "-c", "sleep 0.5; exit 3")
    val b = submitted(home, "--after-ok", a.toString(), "--", "touch", "b-ran")
    val c = submitted(home, "--after", b.toString(), "--", "touch", "c-ran")
    val d = submitted(home, "--after-any", b.toString(), "--", "sh", "-c", "exit 0")
    val rb = m(home, "wait", b.toString())
    assertEq(rb.code, 126)
    assert(rb.out.contains(s"job $b cancelled before it started: job $a, which it waited for, did not succeed"), rb.out)
    val rc = m(home, "wait", c.toString())
    assertEq(rc.code, 126)
    assert(rc.out.contains(s"job $b, which it waited for"), rc.out)
    assertEq(m(home, "wait", d.toString()).code, 0)
    assertEq(eventsOf(home, b), ["submitted", "cancelled"])
    assertEq(eventsOf(home, c), ["submitted", "cancelled"])
    assert(!fs.exists(home + "/b-ran") && !fs.exists(home + "/c-ran"))
    assert(m(home, "ls").out.contains(s"dep $a failed"))
    cleanUp(home)

@test("a job killed while it waits is cancelled, and so are the jobs waiting for it")
dependsKillWaiting()
    val home = newHome()
    val a = submitted(home, "--", "sleep", "30")
    val b = submitted(home, "--after", a.toString(), "--", "true")
    val c = submitted(home, "--after", b.toString(), "--", "true")
    assertEq(m(home, "kill", b.toString()).code, 0)
    assertEq(m(home, "wait", b.toString()).code, 143)
    assertEq(m(home, "wait", c.toString()).code, 126)
    assertEq(m(home, "kill", a.toString()).code, 0)
    cleanUp(home)

@test("a job waiting for one already ended runs, or is cancelled, at once")
dependsAlreadyEnded()
    val home = newHome()
    assertEq(m(home, "run", "--", "true").code, 0)
    assertEq(m(home, "run", "--", "sh", "-c", "exit 4").code, 4)
    val ok = m(home, "run", "--after", "1", "--", "sh", "-c", "exit 0")
    assertEq(ok.code, 0)
    val failed = m(home, "run", "--after", "2", "--", "true")
    assertEq(failed.code, 126)
    assert(failed.out.contains("job 2, which it waited for"), failed.out)
    assertEq(m(home, "run", "--after-any", "2", "--", "true").code, 0)
    // a job an earlier daemon ended is read from the log
    assertEq(m(home, "stop").code, 0)
    assertEq(m(home, "run", "--after", "1", "--", "true").code, 0)
    assertEq(m(home, "run", "--after", "1,2", "--", "true").code, 126)
    cleanUp(home)

@test("a job waiting for an unknown job, for itself, or with bad retries is refused")
dependsRefusals()
    val home = newHome()
    assertEq(submitted(home, "--", "true"), 1)
    val unknown = m(home, "submit", "--after", "99", "--", "true")
    assertEq(unknown.code, 2)
    assert(unknown.out.contains("no job 99"), unknown.out)
    val itself = m(home, "submit", "--after", "2", "--", "true")
    assertEq(itself.code, 2)
    assert(itself.out.contains("job 2 cannot wait for itself"), itself.out)
    assertEq(m(home, "submit", "--retries", "-1", "--", "true").code, 2)
    // nothing refused took an id
    assertEq(submitted(home, "--", "true"), 2)
    cleanUp(home)

@test("waiting jobs keep waiting across a restart and run when what they wait for ends; one whose wait failed is cancelled")
dependsAcrossRestart()
    val home = newHome()
    val a = submitted(home, "--", "sleep", "1.5")
    val b = submitted(home, "--", "sh", "-c", "sleep 1.5; exit 1")
    val c = submitted(home, "--after", a.toString(), "--", "true")
    val d = submitted(home, "--after", b.toString(), "--", "true")
    val e = submitted(home, "--after", c.toString(), "--", "true")
    val before = daemonPid(home)
    restarted(home)
    assertEq(daemonPid(home), before)
    assert(daemonLog(home).contains("taking over 2 running and 0 queued and 3 waiting jobs"), daemonLog(home))
    assertEq(m(home, "wait", e.toString()).code, 0)
    assertEq(m(home, "wait", d.toString()).code, 126)
    assert(startedAfter(home, c, a))
    assertEq(eventsOf(home, c), ["submitted", "ready", "started", "finished"])
    cleanUp(home)

@test("a job whose dependency ends while the daemon restarts is made ready by the restarted daemon")
dependsReadyAtRestart()
    val home = newHome()
    val a = submitted(home, "--", "sleep", "0.2")
    val b = submitted(home, "--after", a.toString(), "--", "true")
    threads.sleep(millis(100))
    restarted(home)
    assertEq(m(home, "wait", b.toString()).code, 0)
    cleanUp(home)

@test("a job that fails once and is retried succeeds on its second attempt, with every attempt in the log")
dependsRetrySucceeds()
    val home = newHome()
    val r = m(home, (["run", "--retries", "2", "--"] ++ failsUntil(home, 2))*)
    assertEq(r.code, 0)
    assert(r.out.contains("job 1 exited 0") && r.out.contains("(attempt 2)"), r.out)
    assertEq(eventsOf(home, 1), ["submitted", "started", "finished", "retry", "started", "finished"])
    val attempts = events(home).filter(e -> e("event").asString() == Some("started")).map(e -> e("attempt").asLong().get())
    assertEq(attempts, [long(1), long(2)])
    assertEq(fs.readText(home + "/jobs/1.log").ok().get(), "run 1\nmarshal: attempt 2 of 3\nrun 2\n")
    cleanUp(home)

@test("retries that are exhausted end with the last attempt's status")
dependsRetryExhausted()
    val home = newHome()
    val r = m(home, (["run", "--retries", "2", "--"] ++ failsUntil(home, 10))*)
    assertEq(r.code, 5)
    assert(r.out.contains("exited 5") && r.out.contains("(attempt 3)"), r.out)
    assertEq(eventsOf(home, 1), ["submitted", "started", "finished", "retry", "started", "finished", "retry", "started", "finished"])
    // a job waiting for it sees only the final outcome
    assertEq(m(home, "run", "--after", "1", "--", "true").code, 126)
    // without --retries a failure is final
    assertEq(m(home, "run", "--", "sh", "-c", "exit 5").code, 5)
    assertEq(eventsOf(home, 3), ["submitted", "started", "finished"])
    cleanUp(home)

@test("a retry delay holds the next attempt back, and ls shows it waiting")
dependsRetryDelay()
    val home = newHome()
    val began = time.monotonic()
    val id = submitted(home, (["--retries", "1", "--retry-delay", "2s", "--"] ++ failsUntil(home, 2))*)
    threads.sleep(millis(800))
    val ls = m(home, "ls")
    assert(ls.out.contains("retry 2"), ls.out)
    assertEq(m(home, "wait", id.toString()).code, 0)
    val took = (time.monotonic() - began).toMillis()
    assert(took >= 2000, s"the retry came after ${took}ms, not 2s")
    cleanUp(home)

@test("a job killed while it waits to retry is cancelled and not retried")
dependsKillRetrying()
    val home = newHome()
    val id = submitted(home, "--retries", "3", "--retry-delay", "30s", "--", "sh", "-c", "exit 1")
    threads.sleep(millis(500))
    assertEq(m(home, "kill", id.toString()).code, 0)
    assertEq(m(home, "wait", id.toString()).code, 143)
    assertEq(eventsOf(home, id), ["submitted", "started", "finished", "retry", "killed"])
    cleanUp(home)

@test("a killed job is not retried")
dependsKillNotRetried()
    val home = newHome()
    val id = submitted(home, "--retries", "3", "--", "sleep", "30")
    threads.sleep(millis(300))
    assertEq(m(home, "kill", id.toString()).code, 0)
    assertEq(m(home, "wait", id.toString()).code, 143)
    assertEq(eventsOf(home, id), ["submitted", "started", "killed"])
    cleanUp(home)

@test("an attempt past its deadline is retried, and the next attempt has a deadline of its own")
dependsRetryDeadline()
    val home = newHome()
    val cmd = s"if [ -f $home/once ]; then exit 0; fi; touch $home/once; sleep 30"
    val r = m(home, "run", "--deadline", "2s", "--retries", "1", "--", "sh", "-c", cmd)
    assertEq(r.code, 0)
    assertEq(eventsOf(home, 1), ["submitted", "started", "timeout", "retry", "started", "finished"])
    // a second attempt that also passes its deadline ends the job timed out
    val r2 = m(home, "run", "--deadline", "1s", "--retries", "1", "--", "sleep", "30")
    assertEq(r2.code, 124)
    assertEq(eventsOf(home, 2), ["submitted", "started", "timeout", "retry", "started", "timeout"])
    cleanUp(home)

@test("a job waiting to retry keeps waiting across a restart, and retries after it")
dependsRetryAcrossRestart()
    val home = newHome()
    val id = submitted(home, (["--retries", "1", "--retry-delay", "2s", "--"] ++ failsUntil(home, 2))*)
    threads.sleep(millis(500))
    restarted(home)
    assert(daemonLog(home).contains("and 1 waiting jobs"), daemonLog(home))
    assertEq(m(home, "wait", id.toString()).code, 0)
    assertEq(eventsOf(home, id), ["submitted", "started", "finished", "retry", "started", "finished"])
    cleanUp(home)

@test("rerun submits an ended job again with its command, directory and environment, and prints the new id")
dependsRerun()
    val home = newHome()
    fs.createDir(home + "/sub").ok().get()
    val first = mWith(home, [("RERUN_VAR", "kept")], "run", "--dir", home + "/sub", "--kind", "probe", "--units", "2", "--", "sh", "-c", "echo $RERUN_VAR $(pwd); exit 3")
    assertEq(first.code, 3)
    val r = m(home, "rerun", "1")
    assertEq(r.code, 0)
    assertEq(r.out.trim(), "2")
    assertEq(m(home, "wait", "2").code, 3)
    assertEq(fs.readText(home + "/jobs/2.log").ok().get(), fs.readText(home + "/jobs/1.log").ok().get())
    val again = events(home).find(e -> e("id").asLong() == Some(long(2)) && e("event").asString() == Some("submitted")).get()
    assertEq(again("kind").asString(), Some("probe"))
    assertEq(again("units").asLong(), Some(long(2)))
    assertEq(again("rerun_of").asLong(), Some(long(1)))
    // a job an earlier daemon ran is rerun from the event log
    assertEq(m(home, "stop").code, 0)
    assertEq(m(home, "rerun", "1").out.trim(), "3")
    assertEq(m(home, "wait", "3").code, 3)
    assertEq(fs.readText(home + "/jobs/3.log").ok().get(), fs.readText(home + "/jobs/1.log").ok().get())
    cleanUp(home)

@test("rerun of an unknown job, a running one, a waiting one or a bad id is refused")
dependsRerunRefused()
    val home = newHome()
    val unknown = m(home, "rerun", "99")
    assertEq(unknown.code, 2)
    assert(unknown.out.contains("no job 99"), unknown.out)
    val a = submitted(home, "--", "sleep", "30")
    val b = submitted(home, "--after", a.toString(), "--", "true")
    threads.sleep(millis(200))
    val running = m(home, "rerun", a.toString())
    assertEq(running.code, 2)
    assert(running.out.contains(s"job $a is running: only a job that has ended runs again"), running.out)
    val waits = m(home, "rerun", b.toString())
    assertEq(waits.code, 2)
    assert(waits.out.contains(s"job $b is waiting"), waits.out)
    assertEq(m(home, "rerun", "x").code, 2)
    assertEq(m(home, "rerun").code, 2)
    assertEq(m(home, "rerun", "1", "2").code, 2)
    cleanUp(home)

@test("stop is refused while jobs wait for others, and --force cancels them")
dependsStopWaiting()
    val home = newHome()
    val a = submitted(home, "--", "sleep", "30")
    val b = submitted(home, "--after-any", a.toString(), "--", "touch", "ran")
    val refused = m(home, "stop")
    assertEq(refused.code, 2)
    assert(refused.out.contains("1 waiting"), refused.out)
    assertEq(m(home, "stop", "--force").code, 0)
    assertEq(m(home, "wait", b.toString()).code, 143)
    assert(!fs.exists(home + "/ran"))
    cleanUp(home)
