module tests

// `marshal top` in a real pseudo-terminal, against a daemon of its own: the executable named by
// $MARSHAL_BIN is run under `script`, which supplies the pty, keys are written to it after a pause,
// and what it drew is read back with the terminal's escape sequences taken out.
import avin.fs
import avin.process
import avin.process.{Command, MacOS}
import avin.net.UnixStream
import avin.threads
import avin.time
import avin.time.millis
import dev.avinlang.marshal
import dev.avinlang.marshal.{Outcome, Overview, Reply, Why}

// Runs `marshal top` against `home` in a pty of `cols` by 30, typing `keys` (a shell `printf` format) once
// it has drawn: what it wrote, with every escape sequence a space and runs of blanks one space.
topIn(home: string, keys: string, zone: string = "", cols: int = 130) -> string
  val script = "(sleep 3; printf '"
    + keys
    + "'; sleep 2) | script -q /dev/null sh -c 'stty cols "
    + cols.toString()
    + " rows 30; \"$M\" top; echo STATUS=$?'"
  val base = Command("sh", "-c", script).withEnv("M", bin()).withEnv("MARSHAL_HOME", home).withEnv(
    "MARSHAL_TAKE_SLOT_DIR",
    slots(home)
  )
  val out = (if zone.nonEmpty then base.withEnv("TZ", zone) else base).output().getOrElse("")
  plainText(out)

// Runs `marshal top` against `home` with the highlight hiding after `idleMs`, running the shell
// commands `steps` (sleeps and `printf`s of keys) in front of it: everything it wrote, escape
// sequences and all.
topRaw(home: string, steps: string, idleMs: int) -> string
  val script = "(" + steps + ") | script -q /dev/null sh -c 'stty cols 130 rows 30; \"$M\" top; echo STATUS=$?'"
  val base = Command("sh", "-c", script).withEnv("M", bin()).withEnv("MARSHAL_HOME", home).withEnv(
    "MARSHAL_TAKE_SLOT_DIR",
    slots(home)
  )
  base.withEnv("MARSHAL_TEST_TOP_IDLE_MS", idleMs.toString()).output().getOrElse("")

// `text` with each escape sequence (ESC, `[`, parameters, a final letter) a space, and every run of
// blanks one space.
plainText(text: string) -> string
  val out = StringWriter()
  var escaping = false
  for c in text.chars
    if escaping
      if 'a' <= c <= 'z' || 'A' <= c <= 'Z'
        escaping = false
        out.write(" ")
    else if c == '\u{1b}'
      escaping = true
    else
      out.write(c.toString())
  out.text.split(" ").filter((w: string) -> w.trim.nonEmpty).mkString(" ")

// Waits up to five seconds for job `id` of `home` to be running.
runningSoon(home: string, id: long) -> bool
  for _ in 0 ..< 50
    if eventsOf(home, id).contains("started") then return true
    threads.sleep(millis(100))
  false

@test("top in a pty shows the running job's row and quits on q with status 0, leaving the job running")
topShowsRunningJob()
  if process.os() != MacOS then return
  val home = newHome()
  assertEq(m(home, "run", "--", "true").code, 0)
  val id = submitted(home, "--units", "3", "--", "sleep", "60")
  assert(runningSoon(home, id))
  val shown = topIn(home, "q")
  assert(shown.contains("STATUS=0"), shown)
  assert(shown.contains(s"marshal ${marshal.Version} up"), shown)
  assert(shown.contains(s"$id running build 3"), shown)
  assert(shown.contains("sleep 60"), shown)
  assert(shown.contains("1 exit 0 build 1"), shown)
  // the screen comes back with a space between runs of different styles: the label, then `]`
  assert(shown.contains("3+0/12 ] take-slot"), shown)
  assertEq(eventsOf(home, id), ["submitted", "started"])
  cleanUp(home)

@test("top in a pty shows when each job started in the terminal's zone, and - for a queued one")
topShowsStartTime()
  if process.os() != MacOS then return
  val home = newHome("{\"units\": 1}")
  val id = submitted(home, "--mem", "0", "--", "sleep", "60")
  val waiting = submitted(home, "--mem", "0", "--", "sleep", "60")
  assert(runningSoon(home, id))
  val startedAt = snapshotOf(home).running(0).startedAt
  assert(startedAt > 0)
  val utc = topIn(home, "q", "UTC")
  val utcText = time.epochMillis(startedAt).atZone(time.utc).format("MM-DD hh:mm")
  assert(utc.contains(s"$id running build 1 - ") && utc.contains(s" $utcText 0:"), utc)
  assert(utc.contains(s"$waiting #1 no units build 1 - - - - "), utc)
  val york = topIn(home, "q", "America/New_York")
  val yorkText = time.epochMillis(startedAt).atZone(time.zone("America/New_York").ok.get).format("MM-DD hh:mm")
  assert(york.contains(s"$id running build 1 - ") && york.contains(s" $yorkText 0:"), york)
  assert(utcText != yorkText)
  cleanUp(home)

@test(
  "top in a pty starts with no row highlighted, shows it on a key, hides it when idle and shows it again on the next key without moving"
)
topHidesHighlightWhenIdle()
  if process.os() != MacOS then return
  val home = newHome()
  val id = submitted(home, "--", "sleep", "60")
  assert(runningSoon(home, id))
  // the selected row's first cell, reversed, as the terminal is told to draw it
  val lit = "\u{1b}[7m    " + id.toString() + " "
  val idle = topRaw(home, "sleep 3; printf q", 1000)
  assert(idle.contains("STATUS=0"), plainText(idle))
  assert(idle.contains(s"running"), plainText(idle))
  assertEq(idle.split(lit).length, 1)
  // a key shows it; with no key after it the screen is not drawn lit again
  val shown = topRaw(home, "sleep 3; printf x; sleep 1; printf q", 5000)
  assertEq(shown.split(lit).length, 2)
  // key, idle past the delay (hidden), Down (only shows it again on the same job), q
  val again = topRaw(home, "sleep 3; printf x; sleep 3; printf '\\033[B'; sleep 1; printf q", 1000)
  assert(again.contains("STATUS=0"), plainText(again))
  assertEq(again.split(lit).length, 3)
  cleanUp(home)

@test("top kills the selected job after k and y in its dialog")
topKills()
  if process.os() != MacOS then return
  val home = newHome()
  val id = submitted(home, "--", "sleep", "60")
  assert(runningSoon(home, id))
  val shown = topRaw(home, "sleep 3; printf k; sleep 1; printf y; sleep 1; printf q", 5000)
  assert(shown.contains("STATUS=0"), plainText(shown))
  assert(plainText(shown).contains(s"Kill job $id?"), plainText(shown))
  assert(plainText(shown).contains("command sleep 60"), plainText(shown))
  assert(plainText(shown).contains(s"job $id is being stopped"), plainText(shown))
  val r = m(home, "wait", id.toString())
  assertEq(r.code, 143)
  assert(r.out.contains("killed"), r.out)
  val status = m(home, "status", id.toString()).out
  assert(status.contains("killed"), status)
  cleanUp(home)

@test("top's kill dialog closed with Escape kills nothing, and the job runs on")
topKillCancelled()
  if process.os() != MacOS then return
  val home = newHome()
  val id = submitted(home, "--", "sleep", "60")
  assert(runningSoon(home, id))
  // Escape alone, then q a second later, so the two are not read as Alt-q
  val shown = topRaw(home, "sleep 3; printf k; sleep 1; printf '\\033'; sleep 1; printf q", 5000)
  assert(shown.contains("STATUS=0"), plainText(shown))
  assert(plainText(shown).contains(s"Kill job $id?"), plainText(shown))
  assert(plainText(shown).contains("not killed"), plainText(shown))
  assertEq(eventsOf(home, id), ["submitted", "started"])
  assert(snapshotOf(home).running.exists(j -> j.id == id))
  cleanUp(home)

@test("top holds a queued job and releases it again with p, and the daemon agrees")
topHoldsAndReleases()
  if process.os() != MacOS then return
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--units", "1", "--", "sleep", "60")
  assert(runningSoon(home, blocker))
  val waiting = submitted(home, "--units", "1", "--", "sleep", "60")
  // x shows the highlight, Down moves to the queued job, p holds it
  val held = topIn(home, "x\\033[Bpq")
  assert(held.contains(s"held $waiting"), held)
  assert(m(home, "ls").out.contains("held"), m(home, "ls").out)
  assert(m(home, "status", waiting.toString()).out.contains("(held)"), m(home, "status", waiting.toString()).out)
  val released = topIn(home, "x\\033[Bpq")
  assert(released.contains(s"released $waiting"), released)
  assert(!m(home, "ls").out.contains("held"), m(home, "ls").out)
  cleanUp(home)

@test("top pauses a running job and resumes it with p")
topPausesAndResumes()
  if process.os() != MacOS then return
  val home = newHome()
  val id = submitted(home, "--", "sleep", "60")
  assert(runningSoon(home, id))
  val paused = topIn(home, "xpq")
  assert(paused.contains(s"paused $id"), paused)
  assert(m(home, "ls").out.contains("paused"), m(home, "ls").out)
  val resumed = topIn(home, "xpq")
  assert(resumed.contains(s"resumed $id"), resumed)
  assert(!m(home, "ls").out.contains("paused"), m(home, "ls").out)
  cleanUp(home)

@test("top says p cannot hold a job that has ended, and changes nothing")
topHoldRefusesEnded()
  if process.os() != MacOS then return
  val home = newHome()
  val id = submitted(home, "--", "true")
  assertEq(m(home, "wait", id.toString()).code, 0)
  val shown = topIn(home, "xpq")
  assert(shown.contains(s"job $id has already ended"), shown)
  cleanUp(home)

// A daemon of one unit with a job running (the first id) and three queued behind it, in order.
queueOfThree() -> (string, long, Vector[long])
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--units", "1", "--", "sleep", "60")
  assert(runningSoon(home, blocker))
  val ids = [
    submitted(home, "--units", "1", "--", "sleep", "60"),
    submitted(home, "--units", "1", "--", "sleep", "60"),
    submitted(home, "--units", "1", "--", "sleep", "60")
  ]
  (home, blocker, ids)

// The keys that show the highlight and go `n` lines down.
downs(n: int) -> string = "x" + (0 ..< n).map(_ -> "\\033[B").mkString("")

@test("top makes a queued job urgent with u, and the daemon agrees")
topMakesUrgent()
  if process.os() != MacOS then return
  val (home, _, ids) = queueOfThree()
  val out = topIn(home, downs(2) + "uq")
  assert(out.contains(s"${ids(1)} urgent"), out)
  assertEq(queuedIds(home), [ids(1), ids(0), ids(2)])
  assertEq(queuedUrgent(home), [true, false, false])
  cleanUp(home)

@test("top makes a queued job low with w, and the daemon agrees")
topMakesLow()
  if process.os() != MacOS then return
  val (home, _, ids) = queueOfThree()
  val out = topIn(home, downs(1) + "wq")
  assert(out.contains(s"${ids(0)} low"), out)
  assertEq(queuedIds(home), [ids(1), ids(2), ids(0)])
  assert(m(home, "status", ids(0).toString(), "--json").out.contains("\"low\":true"))
  cleanUp(home)

@test("top makes an urgent job normal again with n, and it goes back among the jobs not urgent")
topUrgentThenNormal()
  if process.os() != MacOS then return
  val (home, _, ids) = queueOfThree()
  // the third job urgent: it is listed first of the queued, the selection on it still; then n
  val out = topIn(home, downs(3) + "unq")
  assert(out.contains(s"${ids(2)} urgent"), out)
  // the bottom line already began with the job's id, so only the word after it is written again
  assert(out.contains(" normal "), out)
  assertEq(queuedIds(home), ids)
  assertEq(queuedUrgent(home), [false, false, false])
  cleanUp(home)

@test("top makes a low job urgent with u, out of the low band")
topLowThenUrgent()
  if process.os() != MacOS then return
  val (home, _, ids) = queueOfThree()
  // w sends the first queued job to the end, where the selection follows it; u brings it to the front
  val out = topIn(home, downs(1) + "wuq")
  assert(out.contains(s"${ids(0)} low"), out)
  assert(out.contains(s"${ids(0)} urgent"), out)
  assertEq(queuedIds(home), ids)
  assertEq(queuedUrgent(home), [true, false, false])
  // a job not low has no `low` member
  assert(!m(home, "status", ids(0).toString(), "--json").out.contains("\"low\""))
  cleanUp(home)

@test("top moves a queued job up with + and down with -, one place each")
topMovesUpAndDown()
  if process.os() != MacOS then return
  val (home, _, ids) = queueOfThree()
  val up = topIn(home, downs(2) + "+q")
  assert(up.contains(s"${ids(1)} moved up"), up)
  assertEq(queuedIds(home), [ids(1), ids(0), ids(2)])
  val down = topIn(home, downs(2) + "-q")
  assert(down.contains(s"${ids(0)} moved down"), down)
  assertEq(queuedIds(home), [ids(1), ids(2), ids(0)])
  cleanUp(home)

@test("top's selection follows a job that moved, so a second + moves the same job again")
topSelectionFollowsMove()
  if process.os() != MacOS then return
  val (home, blocker, ids) = queueOfThree()
  val out = topIn(home, downs(3) + "++q")
  assert(out.contains(s"${ids(2)} moved up"), out)
  assertEq(queuedIds(home), [ids(2), ids(0), ids(1)])
  // and from the first line of the list, which a view otherwise stays on: the queue is held and
  // nothing runs, so the first queued job is the first line
  assertEq(m(home, "pause").code, 0)
  m(home, "kill", blocker.toString())
  assertEq(m(home, "wait", blocker.toString()).code, 143)
  val first = topIn(home, "x--q")
  assert(first.contains(s"${ids(2)} moved down"), first)
  assertEq(queuedIds(home), [ids(0), ids(1), ids(2)])
  cleanUp(home)

@test("top says the first job of its band is not moved up, nor the last down, and nothing changes")
topMoveAtTheEdges()
  if process.os() != MacOS then return
  val (home, _, ids) = queueOfThree()
  val up = topIn(home, downs(1) + "+q")
  assert(up.contains(s"job ${ids(0)} is first in its band"), up)
  val down = topIn(home, downs(3) + "-q")
  assert(down.contains(s"job ${ids(2)} is last in its band"), down)
  assertEq(queuedIds(home), ids)
  cleanUp(home)

@test("top says a running job is not given a priority nor moved, and changes nothing")
topPlaceRefusesRunning()
  if process.os() != MacOS then return
  val (home, blocker, ids) = queueOfThree()
  val placed = topIn(home, "xuq")
  assert(placed.contains(s"job $blocker is running: only a queued job is given a priority"), placed)
  val moved = topIn(home, "x+q")
  assert(moved.contains(s"job $blocker is running: only a queued job is moved"), moved)
  assertEq(queuedIds(home), ids)
  assertEq(eventsOf(home, blocker).filter(e -> e == "prioritized"), Vector[string]())
  cleanUp(home)

@test("top says a job that has ended is not given a priority nor moved")
topPlaceRefusesEnded()
  if process.os() != MacOS then return
  val home = newHome()
  val id = submitted(home, "--", "true")
  assertEq(m(home, "wait", id.toString()).code, 0)
  for keys in ["xuq", "xwq", "xnq", "x+q", "x-q"]
    val shown = topIn(home, keys)
    assert(shown.contains(s"job $id has already ended"), shown)
  cleanUp(home)

@test("top places a held job, which stays held")
topPlacesHeld()
  if process.os() != MacOS then return
  val (home, _, ids) = queueOfThree()
  assertEq(m(home, "hold", ids(2).toString()).code, 0)
  val out = topIn(home, downs(3) + "+q")
  assert(out.contains(s"${ids(2)} moved up"), out)
  assertEq(queuedIds(home), [ids(0), ids(2), ids(1)])
  val urgent = topIn(home, downs(2) + "uq")
  assert(urgent.contains(s"${ids(2)} urgent"), urgent)
  assertEq(queuedIds(home), [ids(2), ids(0), ids(1)])
  assert(m(home, "status", ids(2).toString()).out.contains("(held)"), m(home, "status", ids(2).toString()).out)
  cleanUp(home)

@test("top gives the daemon's answer for a landing and an exclusive job: urgent yes, low refused")
topPlacesLandingAndExclusive()
  if process.os() != MacOS then return
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--landing", "--units", "1", "--", "sleep", "60")
  assert(runningSoon(home, blocker))
  val landing = submitted(home, "--landing", "--units", "1", "--", "sleep", "60")
  val exclusive = submitted(home, "--exclusive", "--", "sleep", "60")
  assertEq(queuedIds(home), [landing, exclusive])
  // 160 columns: each refusal is whole after the placing keys, which the bottom line names here
  val low = topIn(home, downs(1) + "w\\033[Bwq", cols = 160)
  assert(low.contains(s"job $landing is a landing job: only a development job is low"), low)
  assert(low.contains(s"job $exclusive is an exclusive job: only a development job is low"), low)
  val urgent = topIn(home, downs(2) + "uq")
  assert(urgent.contains(s"$exclusive urgent"), urgent)
  assertEq(queuedUrgent(home), [true, false])
  // each is alone in its lane: no move
  val moved = topIn(home, downs(2) + "-q")
  assert(moved.contains(s"job $landing is last in its band"), moved)
  cleanUp(home)

@test("top names the placing keys on the bottom line, after Quit, only while a queued job is selected")
topNamesPlacingKeys()
  if process.os() != MacOS then return
  val (home, _, _) = queueOfThree()
  val running = topIn(home, "xq")
  assert(!running.contains("Urgent"), running)
  assert(running.contains("Quit"), running)
  val queued = topIn(home, downs(1) + "q")
  assert(queued.contains("Urgent") && queued.contains("Normal") && queued.contains("Move"), queued)
  // the screen is redrawn where it changed: the keys come after the bottom line's own, on its row
  assert(queued.indexOf("Quit") >= 0 && queued.indexOf("Quit") < queued.indexOf("Urgent"), queued)
  cleanUp(home)

@test("top with no daemon says so, starts none, and quits on q with status 0")
topWithoutDaemon()
  if process.os() != MacOS then return
  val home = newHome()
  val shown = topIn(home, "q")
  assert(shown.contains("STATUS=0"), shown)
  assert(shown.contains("no daemon at"), shown)
  assert(shown.contains("s starts one"), shown)
  assert(!fs.exists(home + "/sock"))
  val _ = fs.removeDirAll(home)

@test("top takes no arguments, and where there is no terminal it says so and exits 2")
topRefusals()
  val home = newHome()
  val r = m(home, "top", "now")
  assertEq(r.code, 2)
  assert(r.out.contains("top takes no arguments"), r.out)
  val s = m(home, "top")
  assertEq(s.code, 2)
  assert(s.out.contains("not a terminal"), s.out)
  assert(!fs.exists(home + "/sock"))
  val _ = fs.removeDirAll(home)

// The daemon's snapshot of `home`, asked over its socket.
snapshotOf(home: string) -> Overview
  val conn = UnixStream.connect(home + "/sock").ok.get
  conn.writeText("{\"op\":\"snapshot\"}\n").ok.get
  val reply = conn.readLine().ok.get.get
  val _ = conn.close()
  marshal.decodeReply(reply) match
    Ok(Reply.Viewed(o)) -> o
    other -> fail(s"not a snapshot: $other")

@test(
  "the daemon's snapshot has the budget, the running job, the queued one and why it waits, and jobs earlier daemons ended"
)
snapshotFromDaemon()
  val home = newHome()
  assertEq(m(home, "run", "--", "sh", "-c", "exit 4").code, 4)
  m(home, "stop")
  val big = submitted(home, "--units", "10", "--", "sleep", "60")
  assert(runningSoon(home, big))
  val waiting = submitted(home, "--units", "4", "--", "sleep", "1")
  val o = snapshotOf(home)
  // in quarters
  assertEq(o.usage.units, 40)
  assertEq(o.usage.unitBudget, 48)
  assertEq(o.usage.running, 1)
  assertEq(o.usage.queued, 1)
  assertEq(o.usage.takeSlot.map(t -> t.units), Some(0))
  assert(0 <= o.uptimeMs < 60000, o.uptimeMs.toString())
  assertEq(o.running.map(j -> j.id), [big])
  assertEq(o.queued.map(q -> (q.job.id, q.position, q.why)), [(waiting, 1, Why.NoUnits)])
  // the job the first daemon ran is recent to the second
  assertEq(o.recent.map(j -> (j.id, j.outcome)), [(long(1), Some(Outcome.Exited(4)))])
  m(home, "kill", big.toString())
  assertEq(m(home, "wait", waiting.toString()).code, 0)
  val after = snapshotOf(home)
  assertEq(after.recent.map(j -> j.id), [waiting, big, long(1)])
  assert(after.queued.isEmpty && after.running.isEmpty)
  cleanUp(home)
