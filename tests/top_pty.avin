module tests

// `marshal top` in a real pseudo-terminal, against a daemon of its own: the executable named by
// $MARSHAL_BIN is run under `script`, which supplies the pty, keys are written to it after a pause,
// and what it drew is read back with the terminal's escape sequences taken out.
import avin.fs
import avin.process
import avin.process.{Command, MacOS}
import avin.net.UnixStream
import avin.threads
import avin.time.millis
import dev.avinlang.marshal
import dev.avinlang.marshal.{Outcome, Overview, Reply, Why}

// Runs `marshal top` against `home` in a 100 by 30 pty, typing `keys` (a shell `printf` format) once
// it has drawn: what it wrote, with every escape sequence a space and runs of blanks one space.
topIn(home: string, keys: string) -> string
    val script = "(sleep 3; printf '" + keys + "'; sleep 2) | script -q /dev/null sh -c 'stty cols 100 rows 30; \"$M\" top; echo STATUS=$?'"
    val out = Command("sh", "-c", script).withEnv("M", bin()).withEnv("MARSHAL_HOME", home).withEnv("MARSHAL_TAKE_SLOT_DIR", slots(home)).output().getOrElse("")
    plainText(out)

// `text` with each escape sequence (ESC, `[`, parameters, a final letter) a space, and every run of
// blanks one space.
plainText(text: string) -> string
    val out = StringWriter()
    var escaping = false
    for c in text.chars()
        if escaping
            if 'a' <= c <= 'z' || 'A' <= c <= 'Z'
                escaping = false
                out.write(" ")
        else if c == '\u{1b}'
            escaping = true
        else
            out.write(c.toString())
    out.text().split(" ").filter((w: string) -> w.trim().nonEmpty()).mkString(" ")

// Waits up to five seconds for job `id` of `home` to be running.
runningSoon(home: string, id: long) -> bool
    for _ in 0 ..< 50
        if eventsOf(home, id).contains("started") then return true
        threads.sleep(millis(100))
    false

@test("top in a pty shows the running job's row and quits on q with status 0, leaving the job running")
topShowsRunningJob()
    if process.os() != MacOS then return
    val home = newHome()
    assertEq(m(home, "run", "--", "true").code, 0)
    val id = submitted(home, "--units", "3", "--", "sleep", "60")
    assert(runningSoon(home, id))
    val shown = topIn(home, "q")
    assert(shown.contains("STATUS=0"), shown)
    assert(shown.contains("marshal up"), shown)
    assert(shown.contains(s"$id running build 3"), shown)
    assert(shown.contains("sleep 60"), shown)
    assert(shown.contains("1 exit 0 build 1"), shown)
    assert(shown.contains("3 + take-slot 0 / 12"), shown)
    assertEq(eventsOf(home, id), ["submitted", "started"])
    cleanUp(home)

@test("top kills the selected job after k and y")
topKills()
    if process.os() != MacOS then return
    val home = newHome()
    val id = submitted(home, "--", "sleep", "60")
    assert(runningSoon(home, id))
    val shown = topIn(home, "kyq")
    assert(shown.contains("Kill job 1 (sleep 60)? y/n"), shown)
    assert(shown.contains("job 1 is being stopped"), shown)
    val r = m(home, "wait", id.toString())
    assertEq(r.code, 143)
    assert(r.out.contains("killed"), r.out)
    cleanUp(home)

@test("top with no daemon says so, starts none, and quits on q with status 0")
topWithoutDaemon()
    if process.os() != MacOS then return
    val home = newHome()
    val shown = topIn(home, "q")
    assert(shown.contains("STATUS=0"), shown)
    assert(shown.contains("no daemon at"), shown)
    assert(shown.contains("s starts one"), shown)
    assert(!fs.exists(home + "/sock"))
    fs.removeDirAll(home)

@test("top takes no arguments, and where there is no terminal it says so and exits 2")
topRefusals()
    val home = newHome()
    val r = m(home, "top", "now")
    assertEq(r.code, 2)
    assert(r.out.contains("top takes no arguments"), r.out)
    val s = m(home, "top")
    assertEq(s.code, 2)
    assert(s.out.contains("is not a terminal"), s.out)
    assert(!fs.exists(home + "/sock"))
    fs.removeDirAll(home)

// The daemon's snapshot of `home`, asked over its socket.
snapshotOf(home: string) -> Overview
    val conn = UnixStream.connect(home + "/sock").ok().get()
    conn.writeText("{\"op\":\"snapshot\"}\n").ok().get()
    val reply = conn.readLine().ok().get().get()
    conn.close()
    marshal.decodeReply(reply) match
        Ok(Reply.Viewed(o)) -> o
        other -> fail(s"not a snapshot: $other")

@test("the daemon's snapshot has the budget, the running job, the queued one and why it waits, and jobs earlier daemons ended")
snapshotFromDaemon()
    val home = newHome()
    assertEq(m(home, "run", "--", "sh", "-c", "exit 4").code, 4)
    m(home, "stop")
    val big = submitted(home, "--units", "10", "--", "sleep", "60")
    assert(runningSoon(home, big))
    val waiting = submitted(home, "--units", "4", "--", "sleep", "1")
    val o = snapshotOf(home)
    assertEq(o.usage.units, 10)
    assertEq(o.usage.unitBudget, 12)
    assertEq(o.usage.running, 1)
    assertEq(o.usage.queued, 1)
    assertEq(o.usage.takeSlot.map(t -> t.units), Some(0))
    assert(0 <= o.uptimeMs < 60000, o.uptimeMs.toString())
    assertEq(o.running.map(j -> j.id), [big])
    assertEq(o.queued.map(q -> (q.job.id, q.position, q.why)), [(waiting, 1, Why.NoUnits)])
    // the job the first daemon ran is recent to the second
    assertEq(o.recent.map(j -> (j.id, j.outcome)), [(long(1), Some(Outcome.Exited(4)))])
    m(home, "kill", big.toString())
    assertEq(m(home, "wait", waiting.toString()).code, 0)
    val after = snapshotOf(home)
    assertEq(after.recent.map(j -> j.id), [waiting, big, long(1)])
    assert(after.queued.isEmpty() && after.running.isEmpty())
    cleanUp(home)
