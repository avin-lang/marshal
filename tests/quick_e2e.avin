module tests

// End to end, the quick lane: a quick job starts while development jobs hold every unit; its
// deadline is capped, and a longer one refused; a third quick job waits for the lane and starts when
// one ends; memory still gates it, and its reservation counts while it runs; a landing job is not
// delayed by it; the hint; `rerun`; `ls`, `status --json`; and `marshal restart`. The helpers are
// e2e.avin's and landing_e2e.avin's.
import avin.fs
import dev.avinlang.json
import dev.avinlang.marshal
import dev.avinlang.marshal.Why

// The submitted event's spec of job `id`.
specOf(home: string, id: long) -> json.Json =
    events(home).find(e -> e("id").asLong == Some(id) && e("event").asString == Some("submitted")).get("spec")

@test("a quick job starts at once while development jobs hold every unit, and is niced and marked in ls")
quickWhileUnitsFull()
    val home = newHome("{\"units\": 1}")
    val busy = submitted(home, "--units", "1", "--", "sleep", "5")
    assert(within(2000, () -> started(home, busy)))
    val queued = submitted(home, "--units", "1", "--", "sleep", "0.1")
    val q = submitted(home, "--quick", "--kind", "small", "--", "sh", "-c", "ps -o nice= -p $$")
    assertEq(m(home, "wait", q.toString()).code, 0)
    assert(!ended(home, busy), eventsOf(home, busy).mkString(" "))
    assertEq(whyOf(home, queued), Some(Why.NoUnits))
    // niced as a development job is, unlike a landing job (the test may itself run niced, so compare)
    val land = submitted(home, "--landing", "--", "sh", "-c", "ps -o nice= -p $$")
    assertEq(m(home, "wait", land.toString()).code, 0)
    val niceOf = (id: long) -> fs.readText(s"$home/jobs/$id.log").ok.get.trim.toInt()
    assert(niceOf(q) > niceOf(land) || niceOf(q) == 20, s"${niceOf(q)} ${niceOf(land)}")
    assert(m(home, "ls").out.contains("small^"), m(home, "ls").out)
    assertEq(m(home, "kill", busy.toString()).code, 0)
    assertEq(m(home, "wait", queued.toString()).code, 0)
    cleanUp(home)

@test("a quick job's deadline is the 2-minute cap or a shorter one; past it the job is killed as a timeout")
quickCap()
    val home = newHome()
    val q = submitted(home, "--quick", "--", "sleep", "30")
    val status = statusOf(home)
    val job = status("running").asVector.get.find(j -> j("id").asLong == Some(q)).get
    assertEq(job("deadline_ms").asLong, Some(marshal.QuickCapMs))
    assertEq(job("quick").asBool, Some(true))
    assertEq(status("quick").asInt, Some(1))
    assertEq(status("quick_slots").asInt, Some(2))
    assert(m(home, "status").out.contains("quick lane 1/2"))
    assertEq(m(home, "kill", q.toString()).code, 0)
    val r = m(home, "run", "--quick", "--deadline", "1s", "--", "sleep", "300")
    assertEq(r.code, 124)
    assert(r.out.contains("timed out"), r.out)
    assertEq(eventsOf(home, q + 1), ["submitted", "started", "timeout"])
    cleanUp(home)

@test("a quick job with a deadline over the cap, or with --landing, is refused")
quickRefused()
    val home = newHome()
    val r = m(home, "submit", "--quick", "--deadline", "3m", "--", "true")
    assertEq(r.code, 2)
    assert(r.out.contains("a quick job's deadline is at most 2m00s, not 3m00s: drop --quick to give it longer"), r.out)
    val both = m(home, "submit", "--quick", "--landing", "--", "true")
    assertEq(both.code, 2)
    assert(both.out.contains("a job is quick or landing, not both"), both.out)
    // the cap itself is accepted
    assertEq(m(home, "run", "--quick", "--deadline", "2m", "--", "true").code, 0)
    cleanUp(home)

@test("a third quick job waits for the quick lane, shows why in ls, and starts when one ends")
thirdWaits()
    val home = newHome("{\"units\": 1}")
    val a = submitted(home, "--quick", "--", "sleep", "1.5")
    val b = submitted(home, "--quick", "--", "sleep", "3")
    val c = submitted(home, "--quick", "--", "sleep", "0.1")
    assertEq(whyOf(home, c), Some(Why.QuickFull))
    assert(m(home, "ls").out.contains("queued (quick lane full)"), m(home, "ls").out)
    val q = statusOf(home)("queued").asVector.get(0)
    assertEq(q("why").asString, Some("quick-lane"))
    assertEq(m(home, "wait", c.toString()).code, 0)
    assert(at(home, a, "finished") < at(home, c, "started"), s"${eventsOf(home, a)} ${eventsOf(home, c)}")
    assert(!ended(home, b) || at(home, c, "started") < at(home, b, "finished"))
    assertEq(m(home, "wait", b.toString()).code, 0)
    cleanUp(home)

@test("a quick job waits while its memory does not fit in the budget's free memory, and starts once it does")
quickBlockedByMemory()
    val home = newHome("{\"memory\": \"1G\"}")
    val a = submitted(home, "--mem", "600M", "--", "sleep", "2")
    assert(within(2000, () -> started(home, a)))
    val q = submitted(home, "--quick", "--mem", "600M", "--", "sleep", "0.1")
    assertEq(whyOf(home, q), Some(Why.NoMemory))
    assert(m(home, "ls").out.contains("queued (no memory)"))
    assertEq(m(home, "wait", q.toString()).code, 0)
    assert(at(home, a, "finished") < at(home, q, "started"), s"${eventsOf(home, a)} ${eventsOf(home, q)}")
    cleanUp(home)

@test("a running quick job's reservation counts: a development job that does not fit beside it waits for it")
devBlockedByQuick()
    val home = newHome("{\"memory\": \"1G\"}")
    val q = submitted(home, "--quick", "--mem", "600M", "--", "sleep", "2")
    assert(within(2000, () -> started(home, q)))
    val d = submitted(home, "--mem", "600M", "--", "sleep", "0.1")
    assertEq(whyOf(home, d), Some(Why.NoMemory))
    assertEq(m(home, "wait", d.toString()).code, 0)
    assert(at(home, q, "finished") < at(home, d, "started"), s"${eventsOf(home, q)} ${eventsOf(home, d)}")
    cleanUp(home)

@test("a landing job is not delayed by a quick one: while it drains the machine, the quick job waits behind it")
landingNotDelayed()
    val home = newHome("{\"memory\": \"1G\"}")
    val a = submitted(home, "--mem", "600M", "--", "sleep", "2")
    assert(within(2000, () -> started(home, a)))
    val land = submitted(home, "--landing", "--mem", "600M", "--", "sleep", "0.3")
    val q = submitted(home, "--quick", "--", "sleep", "0.1")
    assertEq(whyOf(home, land), Some(Why.Draining))
    assertEq(whyOf(home, q), Some(Why.Behind(land)))
    assertEq(m(home, "wait", q.toString()).code, 0)
    assert(at(home, land, "started") < at(home, q, "started"), s"${eventsOf(home, land)} ${eventsOf(home, q)}")
    cleanUp(home)

@test("the hint suggests --quick for a kind whose p90 is under the cap, and not for a quick job or a kind not learned")
hintE2e()
    val home = newHome()
    for i in 0 ..< 3 do assertEq(m(home, "run", "--kind", "tiny", "--", "true").code, 0)
    val r = split(home, "submit", "--kind", "tiny", "--", "true")
    assertEq(r.code, 0)
    assert(r.err.contains("marshal: hint: `tiny` jobs took") && r.err.contains("--quick starts one at once"), r.err)
    assertEq(r.err.lines.filter(l -> l.nonEmpty).length, 1)
    // the id alone stays on standard output
    assert(r.out.trim.toLongOption().isDefined, r.out)
    // the job is not moved into the lane
    assertEq(specOf(home, r.out.trim.toLong()).get("quick"), None)
    assertEq(split(home, "submit", "--quick", "--kind", "tiny", "--", "true").err, "")
    assertEq(split(home, "submit", "--kind", "unlearned", "--", "true").err, "")
    assertEq(m(home, "wait", "6").code, 0)
    cleanUp(home)

@test("rerun keeps --quick")
rerunKeepsQuick()
    val home = newHome()
    assertEq(m(home, "run", "--quick", "--", "true").code, 0)
    val again = m(home, "rerun", "1")
    assertEq(again.code, 0)
    val id = again.out.trim.toLong()
    assertEq(m(home, "wait", id.toString()).code, 0)
    assertEq(specOf(home, id)("quick").asBool, Some(true))
    cleanUp(home)

@test("run-type --quick submits a quick job, and not an external one")
runTypeQuick()
    val (home, project) = projectWithType("say", "{\"steps\": [{\"name\": \"say\", \"run\": [\"true\"]}]}")
    val r = m(home, "run-type", "--submit", "--quick", "--dir", project, "say")
    assert(r.code == 0, r.out)
    val id = idIn(r.out)
    assertEq(m(home, "wait", id.toString()).code, 0)
    assertEq(specOf(home, id)("quick").asBool, Some(true))
    assert(!specOf(home, id).has("external"), specOf(home, id).render)
    cleanUp(home)

@test("the quick lane survives marshal restart: a running quick job stays quick, and a waiting one still waits for the lane")
quickAcrossRestart()
    val home = newHome()
    val a = submitted(home, "--quick", "--", "sleep", "4")
    val b = submitted(home, "--quick", "--", "sleep", "4")
    val c = submitted(home, "--quick", "--", "sleep", "0.1")
    assertEq(whyOf(home, c), Some(Why.QuickFull))
    restarted(home)
    assertEq(whyOf(home, c), Some(Why.QuickFull))
    assertEq(statusOf(home)("quick").asInt, Some(2))
    assertEq(m(home, "wait", c.toString()).code, 0)
    assert(at(home, c, "started") > at(home, a, "finished") || at(home, c, "started") > at(home, b, "finished"))
    cleanUp(home)
