module tests

// Job labels against a real daemon: submitted with --label they show in ls, status --json, history
// and the events, rerun keeps them, a restart keeps them, and a bad label is refused.
import avin.fs
import json
import json.Json
import dev.avinlang.marshal

@test("a label shows in ls, status --json, history (text and --json) and the submitted and ending events")
labelShowsEverywhere()
    val home = newHome()
    val id = submitted(home, "--label", "train 209", "--", "sh", "-c", "exit 0")
    assertEq(m(home, "wait", id.toString()).code, 0)
    val plainId = submitted(home, "--", "sh", "-c", "exit 0")
    assertEq(m(home, "wait", plainId.toString()).code, 0)
    val ls = m(home, "ls")
    assert(ls.out.contains("LABEL") && ls.out.contains("train 209"), ls.out)
    val rows = ls.out.lines().toVector
    assert(rows(0).indexOf("LABEL") < rows(0).indexOf("COMMAND"), rows(0))
    val history = m(home, "history")
    assert(history.out.contains("LABEL") && history.out.contains("train 209"), history.out)
    val historyJson = m(home, "history", "--json").out
    assert(historyJson.contains("\"label\":\"train 209\""), historyJson)
    val submittedEvent = events(home).find(e -> e("id").asLong() == Some(id) && e("event").asString() == Some("submitted")).get()
    assertEq(submittedEvent("label").asString(), Some("train 209"))
    assertEq(submittedEvent("spec")("label").asString(), Some("train 209"))
    val finishedEvent = events(home).find(e -> e("id").asLong() == Some(id) && e("event").asString() == Some("finished")).get()
    assertEq(finishedEvent("label").asString(), Some("train 209"))
    // the job without a label has no label in any event
    for e in events(home).filter(e -> e("id").asLong() == Some(plainId))
        assert(!e.render().contains("\"label\""), e.render())
    cleanUp(home)

@test("ls and history have a LABEL column, with empty cells, while no listed job has a label")
labelNoColumn()
    val home = newHome()
    val id = submitted(home, "--", "sh", "-c", "exit 0")
    assertEq(m(home, "wait", id.toString()).code, 0)
    val history = m(home, "history").out.lines().toVector
    assert(history(0).endsWith("LABEL"), history(0))
    assertEq(history.length, 2)
    submitted(home, "--", "sleep", "30")
    val ls = m(home, "ls").out.lines().toVector
    assert(ls(0).contains("LABEL") && ls(0).indexOf("LABEL") < ls(0).indexOf("COMMAND"), ls(0))
    assertEq(ls(1).indexOf("sleep 30"), ls(0).indexOf("COMMAND"))
    assert(!m(home, "status", "--json").out.contains("\"label\""), m(home, "status", "--json").out)
    cleanUp(home)

@test("a running job's label is in status --json and ls while it runs")
labelWhileRunning()
    val home = newHome()
    val id = submitted(home, "--label", "soak", "--", "sleep", "30")
    assert(m(home, "status", "--json").out.contains("\"label\":\"soak\""), m(home, "status", "--json").out)
    assert(m(home, "ls").out.contains("soak"), m(home, "ls").out)
    cleanUp(home)

@test("history --label and events label= pick jobs by a part of the label")
labelFilters()
    val home = newHome()
    val a = submitted(home, "--label", "train 209", "--", "sh", "-c", "exit 0")
    val b = submitted(home, "--label", "release 0.2.4", "--", "sh", "-c", "exit 1")
    val c = submitted(home, "--", "sh", "-c", "exit 0")
    for id in [a, b, c] do m(home, "wait", id.toString())
    val train = m(home, "history", "--label", "train")
    assertEq(train.code, 0)
    assert(train.out.contains("train 209") && !train.out.contains("release"), train.out)
    val none = m(home, "history", "--label", "nothing")
    assert(none.out.contains("no ended jobs match"), none.out)
    val both = m(home, "history", "--label", "r", "--json").out
    assert(both.contains("\"label\":\"train 209\"") && both.contains("\"label\":\"release 0.2.4\""), both)
    val past = m(home, "events", "--since", "1", "ended:label=release")
    assertEq(past.code, 0)
    assert(past.out.contains("release 0.2.4") && !past.out.contains("train 209"), past.out)
    assert(m(home, "history", "--label", "").code != 0)
    cleanUp(home)

@test("rerun keeps the label, in the new job's events and listing")
labelRerun()
    val home = newHome()
    val id = submitted(home, "--label", "train 209", "--", "sh", "-c", "exit 0")
    assertEq(m(home, "wait", id.toString()).code, 0)
    val r = m(home, "rerun", id.toString())
    assertEq(r.code, 0)
    val again = r.out.trim().toLong()
    assertEq(m(home, "wait", again.toString()).code, 0)
    val e = events(home).find(e -> e("id").asLong() == Some(again) && e("event").asString() == Some("submitted")).get()
    assertEq(e("label").asString(), Some("train 209"))
    assert(m(home, "history", "--label", "train").out.lines().toVector.length == 3, m(home, "history", "--label", "train").out)
    cleanUp(home)

@test("a label survives a restart, on a running job and a queued one")
labelRestart()
    val home = newHome("{\"units\": 1}")
    val a = submitted(home, "--label", "running one", "--", "sleep", "30")
    val b = submitted(home, "--label", "queued one", "--", "sh", "-c", "exit 0")
    restarted(home)
    val status = m(home, "status", "--json").out
    assert(status.contains("\"label\":\"running one\"") && status.contains("\"label\":\"queued one\""), status)
    val ls = m(home, "ls").out
    assert(ls.contains("running one") && ls.contains("queued one"), ls)
    assertEq(m(home, "kill", a.toString()).code, 0)
    assertEq(m(home, "wait", b.toString()).code, 0)
    val ended = events(home).find(e -> e("id").asLong() == Some(b) && e("event").asString() == Some("finished")).get()
    assertEq(ended("label").asString(), Some("queued one"))
    cleanUp(home)

@test("a bad label is refused with a clear message, and nothing is submitted")
labelRefused()
    val home = newHome()
    val newline = m(home, "submit", "--label", "a\nb", "--", "true")
    assertEq(newline.code, 2)
    assert(newline.out.contains("`--label`: a label is one line of printable text"), newline.out)
    val empty = m(home, "submit", "--label", "", "--", "true")
    assertEq(empty.code, 2)
    assert(empty.out.contains("a label is text, not empty"), empty.out)
    val tooLong = m(home, "run", "--label", (0 ..< 81).map(i -> "x").mkString(""), "--", "true")
    assertEq(tooLong.code, 2)
    assert(tooLong.out.contains("a label is at most 80 characters, not 81"), tooLong.out)
    val spaced = m(home, "submit", "--label", " x", "--", "true")
    assertEq(spaced.code, 2)
    assert(spaced.out.contains("begin or end with a space"), spaced.out)
    val missing = m(home, "submit", "--label")
    assertEq(missing.code, 2)
    assert(missing.out.contains("`--label` needs a value"), missing.out)
    assertEq(events(home).length, 0)
    // the longest label is accepted
    val eighty = (0 ..< 80).map(i -> "x").mkString("")
    val ok = m(home, "submit", "--label", eighty, "--", "true")
    assertEq(ok.code, 0)
    cleanUp(home)

@test("a request with a newline in its label is refused by the daemon's decoder, whatever client sent it")
labelBadRequestOnWire()
    val bad = "{\"op\":\"submit\",\"kind\":\"build\",\"units\":1,\"mem\":0,\"dir\":\"/w\",\"cmd\":[\"make\"],\"label\":\"a\\nb\"}"
    assert(marshal.decodeRequest(bad).isErr(), bad)
