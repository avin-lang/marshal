module tests

// Durations learned per command and what they say of when jobs end and start (eta.avin): the median
// of a command's last five successful runs, in its directory before anywhere, before its kind's; a
// running job's time left, late past its expectation and a guess from its kind in its project; a
// queued job's start, reckoned from the running jobs' expected ends in queue order, and none where
// something no duration measures stands in the way; and the evaluation that chose the rules, over
// fixed histories.
import dev.avinlang.marshal
import dev.avinlang.marshal.{Budget, EtaBasis, EtaLeft, EtaQueued, EtaRunning, JobInfo, LearnedDuration, Why}

private val Min: long = 60000

@test("a command's duration is the median of its last five successful runs, in its directory before anywhere")
learnedDurations()
  assertEq(marshal.learnedDuration([], []), None)
  assertEq(marshal.learnedDuration([], [3 * Min]), Some(LearnedDuration(3 * Min, "cmd")))
  assertEq(marshal.learnedDuration([5 * Min], [3 * Min, 4 * Min]), Some(LearnedDuration(5 * Min, "cmd+dir")))
  // the oldest of seven are left out: the median of 3, 4, 5, 6, 100 is 5
  assertEq(
    marshal.learnedDuration([], [90 * Min, 91 * Min, 3 * Min, 4 * Min, 5 * Min, 6 * Min, 100 * Min]).map(d -> d.ms),
    Some(5 * Min)
  )
  // an even count takes the mean of the middle two
  assertEq(marshal.learnedDuration([Min, 2 * Min, 3 * Min, 4 * Min], []).map(d -> d.ms), Some(150000))

@test("a job's expectation is its command's duration, else its kind's, never above its deadline nor below 1ms")
expectations()
  val learning = marshal.defaultLearning
  val cmd = Some(LearnedDuration(7 * Min, "cmd"))
  assertEq(
    marshal.expectationFor(learning, "build", false, [], cmd, 20 * Min),
    marshal.Expectation(7 * Min, true, "cmd")
  )
  // held to the deadline
  assertEq(marshal.expectationFor(learning, "build", false, [], cmd, 5 * Min).ms, 5 * Min)
  // a run of no time still expects a millisecond
  assertEq(marshal.expectationFor(learning, "build", false, [], Some(LearnedDuration(0, "cmd+dir")), Min).ms, 1)
  // nothing learned of the command: the kind's guess, half its default deadline
  assertEq(
    marshal.expectationFor(learning, "build", false, [], None, 20 * Min),
    marshal.Expectation(10 * Min, false, "none")
  )
  // the kind's median once it has three runs
  assertEq(
    marshal.expectationFor(learning, "build", false, [Min, 2 * Min, 3 * Min], None, 20 * Min),
    marshal.Expectation(2 * Min, true, "kind")
  )

private runningEta(
    elapsed: long,
    expected: long,
    from: string,
    paused: bool = false,
    deadline: long = 30 * Min,
    eta: long = -1,
    late: bool = false,
    guess: bool = false
) -> JobInfo =
  JobInfo(
    1,
    "build",
    4,
    0,
    false,
    "/w",
    ["make"],
    "running",
    None,
    false,
    0,
    elapsed,
    deadline,
    "/l",
    None,
    paused = paused,
    expectedMs = expected,
    durationFrom = from,
    etaMs = eta,
    etaLate = late,
    etaGuess = guess
  )

private queuedJob(startsIn: long, eta: long = -1) -> JobInfo =
  JobInfo(
    2,
    "build",
    4,
    0,
    false,
    "/w",
    ["make"],
    "queued",
    None,
    false,
    0,
    0,
    30 * Min,
    "/l",
    None,
    startsInMs = startsIn,
    etaMs = eta
  )

@test(
  "a running job's ETA is its expected duration less its run time, from its own command, a guess from its kind in its project"
)
etaLeft()
  assertEq(marshal.etaLeft(runningEta(2 * Min, 8 * Min, "cmd")), EtaLeft(6 * Min))
  assertEq(marshal.etaLeft(runningEta(2 * Min, 8 * Min, "cmd+dir")), EtaLeft(6 * Min))
  assertEq(marshal.etaLeft(runningEta(2 * Min, 8 * Min, "norm+project")), EtaLeft(6 * Min))
  // its kind's runs in its project: a guess
  assertEq(marshal.etaLeft(runningEta(2 * Min, 8 * Min, "kind+project")), EtaLeft(6 * Min, false, true))
  // a kind's duration, a guessed one, and one a daemon did not say give none
  assertEq(marshal.etaLeft(runningEta(2 * Min, 8 * Min, "kind")), marshal.NoEta)
  assertEq(marshal.etaLeft(runningEta(2 * Min, 8 * Min, "none")), marshal.NoEta)
  assertEq(marshal.etaLeft(runningEta(2 * Min, 8 * Min, "")), marshal.NoEta)
  assertEq(marshal.etaLeft(queuedJob(Min)), marshal.NoEta)

@test("past its expected duration a job is late, and goes on half what it has run, never past its deadline")
etaLeftLate()
  // 9 minutes run of 8 expected, a 30-minute deadline: late, 4.5 minutes more
  assertEq(marshal.etaLeft(runningEta(9 * Min, 8 * Min, "cmd")), EtaLeft(9 * Min / 2, true))
  // exactly at its expectation it is late
  assertEq(marshal.etaLeft(runningEta(8 * Min, 8 * Min, "cmd")).late, true)
  assertEq(marshal.etaLeft(runningEta(8 * Min - 1, 8 * Min, "cmd")), EtaLeft(1))
  // 25 minutes run: half of it would pass the deadline, which leaves 5
  assertEq(marshal.etaLeft(runningEta(25 * Min, 8 * Min, "cmd")), EtaLeft(5 * Min, true))
  // at or past its deadline: nothing left, still late
  assertEq(marshal.etaLeft(runningEta(30 * Min, 8 * Min, "cmd")), EtaLeft(0, true))
  assertEq(marshal.etaLeft(runningEta(31 * Min, 8 * Min, "cmd")), EtaLeft(0, true))
  // a guess that is late is both
  assertEq(marshal.etaLeft(runningEta(10 * Min, 8 * Min, "kind+project")), EtaLeft(5 * Min, true, true))
  // without a deadline nothing holds it
  assertEq(marshal.etaLeft(runningEta(40 * Min, 8 * Min, "cmd", deadline = 0)), EtaLeft(20 * Min, true))

@test("the daemon's reckoning of a running job's time left is the one shown, late and guess included")
etaLeftFromDaemon()
  assertEq(marshal.etaLeft(runningEta(2 * Min, 8 * Min, "cmd", eta = 11 * Min, late = true)), EtaLeft(11 * Min, true))
  assertEq(marshal.etaLeft(runningEta(2 * Min, 8 * Min, "kind", eta = 0, guess = true)), EtaLeft(0, false, true))
  // a queued job has none whatever it carries
  assertEq(marshal.etaLeft(queuedJob(Min, eta = Min)), marshal.NoEta)
  // and the column shows it so
  assertEq(marshal.etaColumn(runningEta(2 * Min, 8 * Min, "cmd", eta = 11 * Min, late = true)), "+~11m")
  assertEq(marshal.etaColumn(runningEta(2 * Min, 8 * Min, "kind", eta = 0, guess = true)), "<1m?")

@test("time left past the basis is the median of the key's runs that went on longer, else half the run time")
timeLeft()
  val b = EtaBasis(10 * Min, false)
  // on time: the runs do not matter
  assertEq(marshal.timeLeft(b, [40 * Min], 4 * Min, 60 * Min), EtaLeft(6 * Min))
  // 12 minutes run: of 9, 11, 14, 20 and 30, the runs longer are 14, 20, 30; their median 20 is 8 more
  assertEq(marshal.timeLeft(b, [9 * Min, 11 * Min, 14 * Min, 20 * Min, 30 * Min], 12 * Min, 60 * Min), EtaLeft(8 * Min, true))
  // no run went on so long: half what it has run
  assertEq(marshal.timeLeft(b, [9 * Min, 11 * Min], 12 * Min, 60 * Min), EtaLeft(6 * Min, true))
  assertEq(marshal.timeLeft(b, [], 12 * Min, 60 * Min), EtaLeft(6 * Min, true))
  // the deadline holds either
  assertEq(marshal.timeLeft(b, [50 * Min], 12 * Min, 20 * Min), EtaLeft(8 * Min, true))
  assertEq(marshal.timeLeft(b, [], 4 * Min, 5 * Min), EtaLeft(Min))
  // no deadline (0): nothing holds it
  assertEq(marshal.timeLeft(b, [50 * Min], 12 * Min, 0), EtaLeft(38 * Min, true))
  // a guess stays one
  assertEq(marshal.timeLeft(EtaBasis(10 * Min, true), [], 2 * Min, 0), EtaLeft(8 * Min, false, true))

@test("an ETA counts down from the command's own expectation; a kind's in its project is a guess raised by its deadline share")
etaBases()
  assertEq(marshal.etaBasis(8 * Min, "cmd+dir", 30 * Min), Some(EtaBasis(8 * Min, false)))
  assertEq(marshal.etaBasis(8 * Min, "cmd", 30 * Min), Some(EtaBasis(8 * Min, false)))
  assertEq(marshal.etaBasis(8 * Min, "norm+project", 30 * Min), Some(EtaBasis(8 * Min, false)))
  // its own command's expectation is not raised by shares
  assertEq(marshal.etaBasis(Min, "cmd", 30 * Min, [500, 500, 500]), Some(EtaBasis(Min, false)))
  // a kind's in its project with too few shares: its median, a guess
  assertEq(marshal.etaBasis(Min, "kind+project", 30 * Min, [500, 500]), Some(EtaBasis(Min, true)))
  // three shares of a half: half the 30-minute deadline, above the kind's minute
  assertEq(marshal.etaBasis(Min, "kind+project", 30 * Min, [400, 500, 600]), Some(EtaBasis(15 * Min, true)))
  // the kind's median where it is the larger
  assertEq(marshal.etaBasis(20 * Min, "kind+project", 30 * Min, [100, 100, 100]), Some(EtaBasis(20 * Min, true)))
  // never past the deadline, even from shares above a whole (a deadline since lowered)
  assertEq(marshal.etaBasis(Min, "kind+project", 10 * Min, [2000, 2000, 2000]), Some(EtaBasis(10 * Min, true)))
  // no deadline: the kind's median alone
  assertEq(marshal.etaBasis(Min, "kind+project", 0, [500, 500, 500]), Some(EtaBasis(Min, true)))
  // only the latest twenty shares count: twenty of a tenth after many halves
  val shares = Vector.fill(30, long(500)) ++ Vector.fill(20, long(100))
  assertEq(marshal.etaBasis(Min, "kind+project", 30 * Min, shares), Some(EtaBasis(3 * Min, true)))
  // shares of nothing are not runs
  assertEq(marshal.etaBasis(Min, "kind+project", 30 * Min, [0, 0, 0]), Some(EtaBasis(Min, true)))
  // minRuns is the config's
  assertEq(marshal.etaBasis(Min, "kind+project", 30 * Min, [500], 1), Some(EtaBasis(15 * Min, true)))
  // nothing from a kind alone, a guess, a job a daemon said nothing of, or no expectation
  assertEq(marshal.etaBasis(8 * Min, "kind", 30 * Min, [500, 500, 500]), None)
  assertEq(marshal.etaBasis(8 * Min, "none", 30 * Min), None)
  assertEq(marshal.etaBasis(8 * Min, "", 30 * Min), None)
  assertEq(marshal.etaBasis(0, "cmd", 30 * Min), None)

@test("a run's deadline share is the thousandths of its deadline it took; none without a deadline")
deadlineShares()
  assertEq(marshal.deadlineShare(15 * Min, 30 * Min), 500)
  assertEq(marshal.deadlineShare(0, 30 * Min), 0)
  assertEq(marshal.deadlineShare(30 * Min, 30 * Min), 1000)
  assertEq(marshal.deadlineShare(45 * Min, 30 * Min), 1500)
  assertEq(marshal.deadlineShare(1, 3), 333)
  assertEq(marshal.deadlineShare(Min, 0), -1)
  assertEq(marshal.deadlineShare(-1, Min), -1)
  // a week's deadline, to the thousandth
  assertEq(marshal.deadlineShare(7 * 24 * 60 * Min - 1, 7 * 24 * 60 * Min), 999)

@test("an ETA reads roughly: <1m, minutes rounded up, then hours and minutes; a start from an hour on in hours")
etaTexts()
  assertEq(marshal.etaText(0), "<1m")
  assertEq(marshal.etaText(59999), "<1m")
  assertEq(marshal.etaText(Min), "~1m")
  assertEq(marshal.etaText(Min + 1), "~2m")
  assertEq(marshal.etaText(59 * Min), "~59m")
  assertEq(marshal.etaText(60 * Min), "~1h00")
  assertEq(marshal.etaText(65 * Min + 1), "~1h06")
  assertEq(marshal.etaText(600 * Min), "~10h00")
  assertEq(marshal.startText(-1), "-")
  assertEq(marshal.startText(0), "in <1m")
  assertEq(marshal.startText(3 * Min), "in ~3m")
  assertEq(marshal.startText(89 * Min), "in ~1h")
  assertEq(marshal.startText(91 * Min), "in ~2h")

@test("the ETA column counts down from the listing, stands still while paused, and is - where nothing is known")
etaColumn()
  assertEq(marshal.etaColumn(runningEta(2 * Min, 8 * Min, "cmd")), "~6m")
  assertEq(marshal.etaColumn(runningEta(2 * Min, 8 * Min, "cmd"), 3 * Min), "~3m")
  assertEq(marshal.etaColumn(runningEta(2 * Min, 8 * Min, "cmd"), 10 * Min), "<1m")
  assertEq(marshal.etaColumn(runningEta(2 * Min, 8 * Min, "cmd", paused = true), 3 * Min), "~6m")
  assertEq(marshal.etaColumn(runningEta(2 * Min, 8 * Min, "kind")), "-")
  // a guess is marked ?, a late job +, a late guess both
  assertEq(marshal.etaColumn(runningEta(2 * Min, 8 * Min, "kind+project")), "~6m?")
  assertEq(marshal.etaColumn(runningEta(10 * Min, 8 * Min, "cmd")), "+~5m")
  assertEq(marshal.etaColumn(runningEta(10 * Min, 8 * Min, "kind+project")), "+~5m?")
  // a late job counts down too, to <1m, and stands still while paused
  assertEq(marshal.etaColumn(runningEta(10 * Min, 8 * Min, "cmd"), 2 * Min), "+~3m")
  assertEq(marshal.etaColumn(runningEta(10 * Min, 8 * Min, "cmd"), 9 * Min), "+<1m")
  assertEq(marshal.etaColumn(runningEta(10 * Min, 8 * Min, "cmd", paused = true), 9 * Min), "+~5m")
  // at its deadline: nothing left
  assertEq(marshal.etaColumn(runningEta(30 * Min, 8 * Min, "cmd")), "+<1m")
  // an hour and more late
  assertEq(marshal.etaColumn(runningEta(130 * Min, 60 * Min, "cmd", deadline = 0)), "+~1h05")
  assertEq(marshal.etaColumn(queuedJob(5 * Min)), "in ~5m")
  assertEq(marshal.etaColumn(queuedJob(5 * Min), 2 * Min), "in ~3m")
  assertEq(marshal.etaColumn(queuedJob(-1)), "-")

private val etaBudget: Budget = Budget(48, 16 * G)

private runEta(units: int, left: long, memory: long = 0, landing: bool = false, quick: bool = false) -> EtaRunning =
  EtaRunning(units, memory, landing, quick, left)

private waitingEta(
    id: long,
    units: int,
    position: int,
    why: Why,
    expected: long,
    memory: long = 0,
    landing: bool = false,
    quick: bool = false
) -> EtaQueued = EtaQueued(id, units, memory, landing, quick, position, why, expected)

@test("a queued job starts when enough running jobs have ended for its units; the next one after it, beside it")
startsInOrder()
  // 40 of 48 quarters run: 24 end in 5 minutes and 16 in 8
  val runs = [runEta(24, 5 * Min), runEta(16, 8 * Min)]
  val queued = [
    waitingEta(10, 16, 1, Why.NoUnits, 10 * Min),
    waitingEta(11, 16, 2, Why.Behind(10), 3 * Min),
    waitingEta(12, 40, 3, Why.Behind(10), Min)
  ]
  val got = marshal.startEstimates(etaBudget, 40, 0, runs, queued)
  // 10 fits once the first ends; 11 then fits beside 10 at once; 12 needs 40 free: after 10 ends at 15
  assertEq(got.get(10), Some(5 * Min))
  assertEq(got.get(11), Some(5 * Min))
  assertEq(got.get(12), Some(15 * Min))

@test("a job that fits now starts in no time, and one held by hand is passed over and gets no start")
startsNowAndHeld()
  val got = marshal.startEstimates(
    etaBudget,
    0,
    0,
    [],
    [waitingEta(1, 8, 1, Why.Held, Min), waitingEta(2, 8, 2, Why.Starting, Min)]
  )
  assertEq(got.get(1), None)
  assertEq(got.get(2), Some(0))

@test("an end that is not known stops the reckoning: that job and every one behind it have no start")
unknownEnds()
  // the running job's duration is not its command's own
  val blocked = marshal.startEstimates(
    etaBudget,
    48,
    0,
    [runEta(48, -1)],
    [waitingEta(1, 4, 1, Why.NoUnits, Min), waitingEta(2, 4, 2, Why.Behind(1), Min)]
  )
  assertEq(blocked, Vector[(long, long)]().toMap)
  // a queued job of unknown duration starts, but what needs its units after it does not
  val after = marshal.startEstimates(
    etaBudget,
    40,
    0,
    [runEta(40, 2 * Min)],
    [waitingEta(1, 48, 1, Why.NoUnits, -1), waitingEta(2, 4, 2, Why.Behind(1), Min)]
  )
  assertEq(after.get(1), Some(2 * Min))
  assertEq(after.get(2), None)

@test("a job waiting for what no duration measures has no start, nor has any job behind it")
unreckonable()
  for why in [Why.ForTakeSlot, Why.QueueHeld, Why.Emptying, Why.ForExclusive(3), Why.DiskLow(G), Why.Load(9.0, 4.0, 0)]
    val got = marshal.startEstimates(
      etaBudget,
      0,
      0,
      [],
      [waitingEta(1, 4, 1, why, Min), waitingEta(2, 4, 2, Why.Starting, Min)]
    )
    assertEq((why, got.get(1), got.get(2)), (why, None, None))

@test("memory counts as units do: a job waits for the running jobs whose memory it needs to end")
startsForMemory()
  val got = marshal.startEstimates(
    etaBudget,
    8,
    12 * G,
    [runEta(4, 3 * Min, memory = 8 * G), runEta(4, 9 * Min, memory = 4 * G)],
    [waitingEta(1, 4, 1, Why.NoMemory, Min, memory = 10 * G)]
  )
  assertEq(got.get(1), Some(3 * Min))

@test("take-slot's units never free in the reckoning; quick jobs neither weigh nor get a start")
outsideAndQuick()
  // 40 quarters are take-slot's (in `used`, never ending), so 16 do not fit until never
  val got = marshal.startEstimates(
    etaBudget,
    40,
    0,
    [runEta(4, Min, quick = true)],
    [waitingEta(1, 16, 1, Why.NoUnits, Min), waitingEta(2, 4, 1, Why.QuickFull, Min, quick = true)]
  )
  assertEq(got.get(1), None)
  assertEq(got.get(2), None)

@test("the landing lane runs one job at a time: each queued landing job starts as the one before it ends")
landingStarts()
  val got = marshal.startEstimates(
    etaBudget,
    0,
    0,
    [runEta(8, 4 * Min, landing = true)],
    [
      waitingEta(1, 8, 1, Why.LaneBusy, 10 * Min, landing = true),
      waitingEta(2, 8, 2, Why.LaneBusy, -1, landing = true),
      waitingEta(3, 8, 3, Why.LaneBusy, Min, landing = true)
    ]
  )
  assertEq(got.get(1), Some(4 * Min))
  assertEq(got.get(2), Some(14 * Min))
  // 2's duration is not known, so 3 has no start
  assertEq(got.get(3), None)
  // a landing job draining for memory waits on what no duration says
  val draining = marshal.startEstimates(etaBudget, 0, 0, [], [waitingEta(1, 8, 1, Why.Draining, Min, landing = true)])
  assertEq(draining.get(1), None)

@test("a queued job behind a late job starts when the late job is reckoned to end, not at once; never past its deadline")
startsBehindLate()
  // the running job, 30 minutes into a run expected to take 20 under a 50-minute deadline, holds
  // every unit: late, it is reckoned to go on 15 minutes more
  val late = marshal.etaLeft(runningEta(30 * Min, 20 * Min, "cmd", deadline = 50 * Min))
  assertEq(late, EtaLeft(15 * Min, true))
  val queued = [waitingEta(1, 8, 1, Why.NoUnits, Min), waitingEta(2, 48, 2, Why.Behind(1), Min)]
  val got = marshal.startEstimates(etaBudget, 48, 0, [runEta(48, late.ms)], queued)
  assertEq(got.get(1), Some(15 * Min))
  assertEq(got.get(2), Some(16 * Min))
  // 45 minutes in, its deadline leaves 5
  val near = marshal.etaLeft(runningEta(45 * Min, 20 * Min, "cmd", deadline = 50 * Min))
  assertEq(marshal.startEstimates(etaBudget, 48, 0, [runEta(48, near.ms)], queued).get(1), Some(5 * Min))
  // a late running job in the landing lane holds its lane as long
  val lane = marshal.startEstimates(
    etaBudget,
    0,
    0,
    [runEta(8, late.ms, landing = true)],
    [waitingEta(3, 8, 1, Why.LaneBusy, Min, landing = true)]
  )
  assertEq(lane.get(3), Some(15 * Min))
  // a guessed one's start is reckoned from it as well
  val guessed = marshal.etaLeft(runningEta(2 * Min, 8 * Min, "kind+project"))
  assertEq(marshal.startEstimates(etaBudget, 48, 0, [runEta(48, guessed.ms)], queued).get(1), Some(6 * Min))

// The error of a time-left rule over a history: each run after the third, with the runs before it
// as history, its expectation their median of five, at 0, 25, 50, 75 and 90 percent of its run;
// the total |reckoned - true| time left, and the part of it after the run passed its expectation.
private evaluate(history: Vector[long], deadline: long, rule: (long, Vector[long], long) -> long) -> (long, long)
  var total: long = 0
  var late: long = 0
  for i in 3 ..< history.length
    val before = history.take(i)
    val expected = marshal.median(before.takeRight(5))
    val actual = history(i)
    for pct in [0, 25, 50, 75, 90]
      val elapsed = actual * long(pct) / 100
      val err = (rule(expected, before, elapsed) - (actual - elapsed)).abs
      total += err
      if elapsed >= expected then late += err
  (total, late)

@test("evaluation: over a gate that is sometimes slow, the late rule's time left beats counting down to nothing")
evaluationLate()
  // a gate of about 52 minutes that sometimes takes 75 to 90, under a 2-hour deadline
  val history = [50, 52, 51, 75, 53, 80, 52, 54, 90, 51, 78, 55].map(m -> long(m) * Min)
  val deadline = 120 * Min
  val (oldTotal, oldLate) = evaluate(history, deadline, (expected, runs, elapsed) -> if expected > elapsed then expected - elapsed else 0)
  val (newTotal, newLate) = evaluate(
    history,
    deadline,
    (expected, runs, elapsed) -> marshal.timeLeft(EtaBasis(expected, false), runs, elapsed, deadline).ms
  )
  // the whole error falls (486 to 465 minutes) and the late part most (113 to 92)
  assertEq(oldTotal / Min, 486)
  assertEq(newTotal / Min, 465)
  assertEq(oldLate / Min, 113)
  assertEq(newLate / Min, 92)
  assert(newTotal < oldTotal && newLate < oldLate, "the late rule is the better")

@test("evaluation: a new command's guess raised by its project's deadline share is less often under half its time")
evaluationNewCommand()
  // earlier runs of the kind in the project took 40%, 45% and 42% of their deadlines
  val shares: Vector[long] = [400, 450, 420]
  // (the kind's median in the project, the deadline, what the new command really took): the first
  // is the loop of kill tests, 41 seconds expected and 40 minutes taken under a 30-minute deadline
  // amended to 50
  val cases: Vector[(long, long, long)] = [
    (41000, 30 * Min, 40 * Min),
    (2 * Min, 20 * Min, 9 * Min),
    (Min, 60 * Min, 25 * Min),
    (5 * Min, 10 * Min, 4 * Min),
    (30000, 45 * Min, 15 * Min)
  ]
  var oldUnder = 0
  var newUnder = 0
  var oldErr: long = 0
  var newErr: long = 0
  for (kind, deadline, actual) in cases
    val guess = marshal.etaBasis(kind, "kind+project", deadline, shares).get
    assert(guess.guess, "a guess")
    if actual > 2 * kind then oldUnder += 1
    if actual > 2 * guess.ms then newUnder += 1
    oldErr += (kind - actual).abs
    newErr += (guess.ms - actual).abs
  assertEq(marshal.etaBasis(41000, "kind+project", 30 * Min, shares).map(b -> b.ms), Some(756000))
  assertEq((oldUnder, newUnder), (4, 1))
  assertEq((oldErr / Min, newErr / Min), (85, 33))
