module tests

// `kill --owner/--label/--all`, end to end through the command line: each selector alone and
// combined, the lane flags, landing jobs left alone unless asked for, `--all` refused without a
// terminal unless `--yes`, no match and a bad command line, the events each job gets, the jobs that
// wait for a stopped one, a paused job, the jobs of other owners, and the daemon's dry run.
import avin.fs
import avin.threads
import avin.time.millis
import dev.avinlang.json.Json

// Submits a job that sleeps, for `owner`, with `more` options, and answers its id.
kmSleeping(home: string, owner: string, more: string*) -> long
  submitted(home, (["--owner", owner] ++ more.toVector ++ ["--", "sleep", "30"])*)

// Submits a sleeping job and waits for it to start.
kmRunning(home: string, owner: string, more: string*) -> long
  val id = kmSleeping(home, owner, more*)
  assert(within(5000, () -> started(home, id)), s"job $id did not start")
  id

// The line of `out` that begins with `id` and a word, or fails.
stoppedLineOf(out: string, id: long) -> string = out.lines.find(l -> l.startsWith(id.toString() + " ")).getOrElse(fail(s"no line for job $id in: $out"))

// Fails unless no line of `out` names job `id`.
notStopped(out: string, id: long) = assert(!out.lines.exists(l -> l.startsWith(id.toString() + " ")), out)

// Whether job `id` has ended, by the log.
kmOver(home: string, id: long) -> bool = ended(home, id) || eventsOf(home, id).contains("cancelled")

// Whether job `id` is still there: neither ended nor cancelled.
kmAlive(home: string, id: long) -> bool = !kmOver(home, id)

// Fails unless the command ended with `code` and printed `why`.
exitedWith(r: Ran, code: int, why: string)
  assertEq(r.code, code)
  assert(r.out.contains(why), r.out)

@test("kill --owner stops the running and cancels the queued jobs of that owner, one line each and a count, and no other owner's job")
killOwner()
  val home = newHome("{\"units\": 1}")
  val a1 = kmRunning(home, "alpha", "--label", "one")
  val b1 = kmSleeping(home, "beta")
  val a2 = kmSleeping(home, "alpha", "--label", "two")
  val a3 = kmSleeping(home, "alpha")
  assertEq(queuedIds(home), [b1, a2, a3])
  val r = m(home, "kill", "--owner", "alpha")
  assertEq(r.code, 0)
  assertEq(stoppedLineOf(r.out, a1), s"$a1 killed  one")
  assertEq(stoppedLineOf(r.out, a2), s"$a2 cancelled  two")
  assertEq(stoppedLineOf(r.out, a3), s"$a3 cancelled")
  notStopped(r.out, b1)
  assert(r.out.contains("marshal: 3 jobs stopped"), r.out)
  assertEq(m(home, "wait", a1.toString()).code, 143)
  assertEq(m(home, "wait", a2.toString()).code, 143)
  assertEq(m(home, "wait", a3.toString()).code, 143)
  // the one job of another owner was never touched: it took the unit the killed job left
  assert(within(5000, () -> started(home, b1)))
  assert(kmAlive(home, b1))
  assertEq(eventsOf(home, b1), ["submitted", "started"])
  assertEq(m(home, "kill", b1.toString()).code, 0)
  cleanUp(home)

@test("one job selected is counted as one job, and the owner must match exactly")
killOwnerExact()
  val home = newHome("{\"units\": 4}")
  val a = kmRunning(home, "alpha")
  val longer = kmRunning(home, "alpha-two")
  val upper = kmRunning(home, "Alpha")
  val r = m(home, "kill", "--owner", "alpha")
  assertEq(r.code, 0)
  assertEq(stoppedLineOf(r.out, a), s"$a killed")
  notStopped(r.out, longer)
  notStopped(r.out, upper)
  assert(r.out.contains("marshal: 1 job stopped"), r.out)
  assert(kmAlive(home, longer) && kmAlive(home, upper))
  assertEq(m(home, "kill", "--owner", "alpha-two").code, 0)
  assertEq(m(home, "kill", "--owner", "Alpha").code, 0)
  cleanUp(home)

@test("kill --label stops the jobs whose label contains the text, upper and lower case counting as written")
killLabel()
  val home = newHome("{\"units\": 4}")
  val one = kmRunning(home, "alpha", "--label", "train 1")
  val upper = kmRunning(home, "alpha", "--label", "Train 2")
  val inside = kmRunning(home, "beta", "--label", "bench the train")
  val other = kmRunning(home, "alpha", "--label", "build")
  val bare = kmRunning(home, "alpha")
  val r = m(home, "kill", "--label", "train")
  assertEq(r.code, 0)
  assertEq(stoppedLineOf(r.out, one), s"$one killed  train 1")
  assertEq(stoppedLineOf(r.out, inside), s"$inside killed  bench the train")
  for id in [upper, other, bare] do notStopped(r.out, id)
  assert(r.out.contains("marshal: 2 jobs stopped"), r.out)
  for id in [upper, other, bare] do assert(kmAlive(home, id), id.toString())
  assertEq(m(home, "kill", "--label", "Train").code, 0)
  assert(within(5000, () -> ended(home, upper)))
  assertEq(m(home, "kill", "--owner", "alpha").code, 0)
  cleanUp(home)

@test("--owner and --label together stop only the jobs that match both")
killOwnerAndLabel()
  val home = newHome("{\"units\": 4}")
  val both = kmRunning(home, "alpha", "--label", "train 1")
  val ownerOnly = kmRunning(home, "alpha", "--label", "build")
  val labelOnly = kmRunning(home, "beta", "--label", "train 2")
  val r = m(home, "kill", "--owner", "alpha", "--label", "train")
  assertEq(r.code, 0)
  assertEq(stoppedLineOf(r.out, both), s"$both killed  train 1")
  notStopped(r.out, ownerOnly)
  notStopped(r.out, labelOnly)
  assert(r.out.contains("marshal: 1 job stopped"), r.out)
  assert(kmAlive(home, ownerOnly) && kmAlive(home, labelOnly))
  // in either order, and with --yes, which a scoped kill never needs
  val again = m(home, "kill", "--label", "train", "--yes", "--owner", "beta")
  assertEq(again.code, 0)
  assertEq(stoppedLineOf(again.out, labelOnly), s"$labelOnly killed  train 2")
  assert(kmAlive(home, ownerOnly))
  assertEq(m(home, "kill", "--owner", "alpha").code, 0)
  cleanUp(home)

@test("--queued leaves a running job alone and --running a queued, held and waiting one, for the owner they share")
killLanes()
  val home = newHome("{\"units\": 1}")
  val run = kmRunning(home, "alpha")
  val queued = kmSleeping(home, "alpha")
  val held = kmSleeping(home, "alpha")
  assertEq(m(home, "hold", held.toString()).code, 0)
  val waiting = submitted(home, "--owner", "alpha", "--after", run.toString(), "--", "true")
  val other = kmSleeping(home, "beta")
  val running1 = m(home, "kill", "--owner", "alpha", "--running")
  assertEq(running1.code, 0)
  assertEq(stoppedLineOf(running1.out, run), s"$run killed")
  assert(running1.out.contains("marshal: 1 job stopped"), running1.out)
  // the waiting job's dependency failed: it was cancelled by that, and nothing else of alpha's ran
  assertEq(m(home, "wait", run.toString()).code, 143)
  assertEq(m(home, "wait", waiting.toString()).code, 126)
  assert(kmAlive(home, held))
  // the next job in line takes the unit; the held one still waits
  assert(within(5000, () -> started(home, queued) || started(home, other)))
  val r = m(home, "kill", "--owner", "alpha", "--queued")
  assertEq(r.code, 0)
  assertEq(stoppedLineOf(r.out, held), s"$held cancelled")
  assert(!r.out.contains(s"$waiting "), r.out)
  assertEq(eventsOf(home, held), ["submitted", "held", "killed"])
  assertEq(m(home, "kill", "--owner", "alpha").code, 0)
  assertEq(m(home, "kill", "--owner", "beta").code, 0)
  cleanUp(home)

@test("--queued and --running both given select both; a lane that has no job of that owner matches nothing, exit 1")
killLanesBothAndNone()
  val home = newHome("{\"units\": 1}")
  val run = kmRunning(home, "alpha")
  val queued = kmSleeping(home, "alpha")
  val noneQueued = m(home, "kill", "--owner", "beta", "--queued")
  exitedWith(noneQueued, 1, "marshal: no jobs match")
  val onlyRunning = m(home, "kill", "--owner", "alpha", "--queued", "--running")
  assertEq(onlyRunning.code, 0)
  assert(onlyRunning.out.contains("marshal: 2 jobs stopped"), onlyRunning.out)
  assertEq(stoppedLineOf(onlyRunning.out, run), s"$run killed")
  assertEq(stoppedLineOf(onlyRunning.out, queued), s"$queued cancelled")
  cleanUp(home)

@test("a landing job is skipped unless --include-landing, and the count skipped is said")
killLanding()
  val home = newHome("{\"units\": 4}")
  val plain = kmRunning(home, "alpha")
  val landing = kmRunning(home, "alpha", "--landing")
  val r = m(home, "kill", "--owner", "alpha")
  assertEq(r.code, 0)
  assertEq(stoppedLineOf(r.out, plain), s"$plain killed")
  notStopped(r.out, landing)
  assert(r.out.contains("marshal: 1 job stopped (1 landing skipped"), r.out)
  assert(kmAlive(home, landing))
  // nothing left but a landing job: no job matches, and it says why
  val none = m(home, "kill", "--owner", "alpha")
  exitedWith(none, 1, "marshal: no jobs match (1 landing skipped")
  assert(kmAlive(home, landing))
  val label = m(home, "kill", "--label", "nothing like it")
  exitedWith(label, 1, "marshal: no jobs match")
  assert(!label.out.contains("landing skipped"), label.out)
  val with = m(home, "kill", "--owner", "alpha", "--include-landing")
  assertEq(with.code, 0)
  assertEq(stoppedLineOf(with.out, landing), s"$landing killed")
  assert(!with.out.contains("skipped"), with.out)
  assertEq(m(home, "wait", landing.toString()).code, 143)
  cleanUp(home)

@test("an exclusive job is not skipped: a selector stops it like any other")
killExclusive()
  val home = newHome("{\"units\": 4}")
  val bench = kmRunning(home, "alpha", "--exclusive", "--label", "bench")
  val r = m(home, "kill", "--owner", "alpha")
  assertEq(r.code, 0)
  assertEq(stoppedLineOf(r.out, bench), s"$bench killed  bench")
  assertEq(m(home, "wait", bench.toString()).code, 143)
  cleanUp(home)

@test("--all without a terminal is refused unless --yes is given, and stops nothing")
killAllNeedsTerminal()
  val home = newHome("{\"units\": 1}")
  val run = kmRunning(home, "alpha")
  val queued = kmSleeping(home, "beta")
  val r = m(home, "kill", "--all")
  exitedWith(r, 2, "kill --all needs a terminal to ask on: give --yes")
  assert(kmAlive(home, run) && kmAlive(home, queued))
  assertEq(eventsOf(home, run), ["submitted", "started"])
  assertEq(eventsOf(home, queued), ["submitted"])
  // the other options change nothing about it
  exitedWith(m(home, "kill", "--all", "--queued"), 2, "needs a terminal")
  exitedWith(m(home, "kill", "--all", "--include-landing"), 2, "needs a terminal")
  assert(kmAlive(home, run) && kmAlive(home, queued))
  cleanUp(home)

@test("--all --yes stops every job of every owner, but a landing job unless --include-landing")
killAllYes()
  val home = newHome("{\"units\": 2}")
  val a = kmRunning(home, "alpha")
  val b = kmRunning(home, "beta")
  val q = kmSleeping(home, "gamma")
  val landing = kmRunning(home, "alpha", "--landing")
  val r = m(home, "kill", "--all", "--yes")
  assertEq(r.code, 0)
  assertEq(stoppedLineOf(r.out, a), s"$a killed")
  assertEq(stoppedLineOf(r.out, b), s"$b killed")
  assertEq(stoppedLineOf(r.out, q), s"$q cancelled")
  notStopped(r.out, landing)
  assert(r.out.contains("marshal: 3 jobs stopped (1 landing skipped"), r.out)
  assert(kmAlive(home, landing))
  val rest = m(home, "kill", "--all", "--yes", "--include-landing")
  assertEq(rest.code, 0)
  assertEq(stoppedLineOf(rest.out, landing), s"$landing killed")
  assert(rest.out.contains("marshal: 1 job stopped"), rest.out)
  exitedWith(m(home, "kill", "--all", "--yes"), 1, "marshal: no jobs match")
  cleanUp(home)

@test("a selector that matches no job prints `marshal: no jobs match` and exits 1, and jobs that have ended are not matched")
killNoMatch()
  val home = newHome("{\"units\": 4}")
  exitedWith(m(home, "kill", "--owner", "nobody"), 1, "marshal: no jobs match")
  exitedWith(m(home, "kill", "--label", "nothing"), 1, "marshal: no jobs match")
  exitedWith(m(home, "kill", "--all", "--yes"), 1, "marshal: no jobs match")
  val done = submitted(home, "--owner", "alpha", "--label", "short", "--", "true")
  assertEq(m(home, "wait", done.toString()).code, 0)
  exitedWith(m(home, "kill", "--owner", "alpha"), 1, "marshal: no jobs match")
  exitedWith(m(home, "kill", "--label", "short"), 1, "marshal: no jobs match")
  exitedWith(m(home, "kill", "--all", "--yes"), 1, "marshal: no jobs match")
  assertEq(eventsOf(home, done), ["submitted", "started", "finished"])
  cleanUp(home)

@test("an id beside a selector, a selector with nothing to select, and an option kill does not take are refused with exit 2")
killRefusals()
  val home = newHome("{\"units\": 4}")
  val run = kmRunning(home, "alpha")
  exitedWith(m(home, "kill", run.toString(), "--owner", "alpha"), 2, "beside a selector")
  exitedWith(m(home, "kill", "--owner", "alpha", run.toString()), 2, "beside a selector")
  exitedWith(m(home, "kill", "--all", run.toString()), 2, "beside a selector")
  exitedWith(m(home, "kill", "--queued"), 2, "give --owner, --label or --all")
  exitedWith(m(home, "kill", "--include-landing"), 2, "give --owner, --label or --all")
  exitedWith(m(home, "kill", "--yes"), 2, "give --owner, --label or --all")
  exitedWith(m(home, "kill", "--all", "--owner", "alpha", "--yes"), 2, "--all stops every job")
  exitedWith(m(home, "kill", "--all", "--label", "x", "--yes"), 2, "--all stops every job")
  exitedWith(m(home, "kill", "--owner"), 2, "`--owner` needs a value")
  exitedWith(m(home, "kill", "--label"), 2, "`--label` needs a value")
  exitedWith(m(home, "kill", "--owner", ""), 2, "needs an owner")
  exitedWith(m(home, "kill", "--label", ""), 2, "needs the text a label contains")
  exitedWith(m(home, "kill", "--owner", "alpha", "--force"), 2, "no option `--force`")
  // a single kill is as it was
  exitedWith(m(home, "kill", "x"), 2, "`x` is not a job id")
  exitedWith(m(home, "kill"), 2, "give one job id")
  exitedWith(m(home, "kill", run.toString(), "99"), 2, "give one job id")
  assert(kmAlive(home, run))
  assertEq(eventsOf(home, run), ["submitted", "started"])
  exitedWith(m(home, "kill", run.toString()), 0, s"job $run is being stopped")
  assertEq(m(home, "wait", run.toString()).code, 143)
  cleanUp(home)

@test("each job stopped gets its usual event: a running job killed, a queued one killed without starting")
killEvents()
  val home = newHome("{\"units\": 1}")
  val run = kmRunning(home, "alpha")
  val queued = kmSleeping(home, "alpha")
  val r = m(home, "kill", "--owner", "alpha")
  assertEq(r.code, 0)
  assertEq(m(home, "wait", run.toString()).code, 143)
  assertEq(m(home, "wait", queued.toString()).code, 143)
  assertEq(eventsOf(home, run), ["submitted", "started", "killed"])
  assertEq(eventsOf(home, queued), ["submitted", "killed"])
  val ev = events(home).find(e -> e("id").asLong == Some(run) && e("event").asString == Some("killed")).get
  assertEq(ev("exit").asInt, Some(143))
  assert(m(home, "history").out.contains("killed"))
  cleanUp(home)

@test("a job waiting for a stopped one is cancelled as a single kill cancels it, and one selected itself is killed, not cancelled for the other")
killDependants()
  val home = newHome("{\"units\": 4}")
  val a = kmRunning(home, "alpha")
  val b = submitted(home, "--owner", "beta", "--after", a.toString(), "--", "true")
  val c = submitted(home, "--owner", "beta", "--after-ok", b.toString(), "--", "true")
  val any = submitted(home, "--owner", "beta", "--after-any", a.toString(), "--", "true")
  val r = m(home, "kill", "--owner", "alpha")
  assertEq(r.code, 0)
  assert(r.out.contains("marshal: 1 job stopped"), r.out)
  assertEq(m(home, "wait", a.toString()).code, 143)
  assertEq(m(home, "wait", b.toString()).code, 126)
  assertEq(m(home, "wait", c.toString()).code, 126)
  assertEq(eventsOf(home, b), ["submitted", "cancelled"])
  assertEq(eventsOf(home, c), ["submitted", "cancelled"])
  // --after-any waits for the end, however it ends: it runs
  assertEq(m(home, "wait", any.toString()).code, 0)
  // when the dependants are selected too they are killed, not cancelled for the failure
  val a2 = kmRunning(home, "gamma")
  val b2 = submitted(home, "--owner", "gamma", "--after", a2.toString(), "--", "true")
  val c2 = submitted(home, "--owner", "gamma", "--after", b2.toString(), "--", "true")
  val both = m(home, "kill", "--owner", "gamma")
  assertEq(both.code, 0)
  assert(both.out.contains("marshal: 3 jobs stopped"), both.out)
  assertEq(stoppedLineOf(both.out, a2), s"$a2 killed")
  assertEq(stoppedLineOf(both.out, b2), s"$b2 cancelled")
  assertEq(stoppedLineOf(both.out, c2), s"$c2 cancelled")
  for id in [b2, c2] do
    assertEq(eventsOf(home, id), ["submitted", "killed"])
    assertEq(m(home, "wait", id.toString()).code, 143)
  assertEq(m(home, "wait", a2.toString()).code, 143)
  cleanUp(home)

@test("a paused job counts as running: --running stops it, --queued does not")
killPaused()
  val home = newHome("{\"units\": 1}")
  val run = kmRunning(home, "alpha")
  assertEq(m(home, "pause", run.toString()).code, 0)
  exitedWith(m(home, "kill", "--owner", "alpha", "--queued"), 1, "marshal: no jobs match")
  assert(kmAlive(home, run))
  val r = m(home, "kill", "--owner", "alpha", "--running")
  assertEq(r.code, 0)
  assertEq(stoppedLineOf(r.out, run), s"$run killed")
  assertEq(m(home, "wait", run.toString()).code, 143)
  assert(eventsOf(home, run).contains("killed"))
  cleanUp(home)

@test("a job that a selector stopped is not named again once it has ended, and gets no second event")
killTwice()
  val home = newHome("{\"units\": 1}")
  val run = kmRunning(home, "alpha")
  assertEq(m(home, "kill", "--owner", "alpha").code, 0)
  assertEq(m(home, "wait", run.toString()).code, 143)
  assertEq(eventsOf(home, run), ["submitted", "started", "killed"])
  // ended: no longer named
  exitedWith(m(home, "kill", "--owner", "alpha"), 1, "marshal: no jobs match")
  assertEq(eventsOf(home, run), ["submitted", "started", "killed"])
  cleanUp(home)

@test("the daemon's dry run says which jobs a selector would stop, as it would classify them, and stops none")
killDryRun()
  val home = newHome("{\"units\": 1}")
  val run = kmRunning(home, "alpha", "--label", "bench", "--exclusive")
  val queued = kmSleeping(home, "beta")
  val landing = kmSleeping(home, "gamma", "--landing")
  val request = Json.obj(("op", Json.str("kill_many")), ("all", Json.Bool(true)), ("dry_run", Json.Bool(true))).render
  val reply = rawRequest(home, request).get
  assert(reply.contains("\"how\":\"would kill\""), reply)
  assert(reply.contains("\"how\":\"would cancel\""), reply)
  assert(reply.contains("\"exclusive\":true"), reply)
  assert(reply.contains("\"skipped_landing\":1"), reply)
  assert(reply.contains(s"\"id\":$run"), reply)
  assert(reply.contains(s"\"id\":$queued"), reply)
  assert(!reply.contains(s"\"id\":$landing"), reply)
  assert(kmAlive(home, run) && kmAlive(home, queued) && kmAlive(home, landing))
  assertEq(eventsOf(home, run), ["submitted", "started"])
  assertEq(eventsOf(home, queued), ["submitted"])
  // a request that selects nothing is refused by the daemon too
  val bad = rawRequest(home, Json.obj(("op", Json.str("kill_many"))).render).get
  assert(bad.contains("\"ok\":false") && bad.contains("give --owner, --label or --all"), bad)
  assertEq(m(home, "kill", "--all", "--yes", "--include-landing").code, 0)
  cleanUp(home)

@test("marshal kill --help describes the selectors, and the usage lists them")
killHelp()
  val home = newHome()
  val help = m(home, "kill", "--help")
  assertEq(help.code, 0)
  for word in ["--owner", "--label", "--queued", "--running", "--all", "--yes", "--include-landing", "no jobs match"]
    assert(help.out.contains(word), word)
  assert(m(home, "--help").out.contains("kill <id> | <selector>"))
  cleanUp(home)
