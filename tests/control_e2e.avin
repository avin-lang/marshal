module tests

// Holding and ordering the queue, end to end through the command line: `pause` and `resume` hold
// and release the whole queue, `hold` and `release` one job, `priority` places a job, and all of it
// survives `marshal restart`.
import avin.threads
import avin.time.millis
import dev.avinlang.json
import dev.avinlang.json.Json

// Fails unless `r` exited 2 saying `why`.
refusedWith(r: Ran, why: string)
  assertEq(r.code, 2)
  assert(r.out.contains(why), r.out)

// The order the jobs `ids` started in, by the event log.
startOrder(home: string, ids: Vector[long]) -> Vector[long] = ids.sortBy(id -> at(home, id, "started"))

statusJsonOf(home: string) -> Json
  val r = m(home, "status", "--json")
  assertEq(r.code, 0)
  json.parse(r.out.trim).ok.get

// The queued jobs' ids in queue order, as `status --json` lists them.
queuedIds(home: string) -> Vector[long] = statusJsonOf(home)("queued").asVector.get.map(q -> q("id").asLong.get)

// Whether each queued job is urgent, in queue order.
queuedUrgent(home: string) -> Vector[bool] = statusJsonOf(home)("queued").asVector.get.map(q -> q("urgent").asBool.get)

@test("submit --urgent queues a job ahead of every job not urgent, and two urgent jobs keep their arrival order")
submitUrgent()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--", "sleep", "30")
  val b = submitted(home, "--", "true")
  val c = submitted(home, "--urgent", "--", "true")
  val d = submitted(home, "--", "true")
  assertEq(m(home, "priority", d.toString(), "9").code, 0)
  val e = submitted(home, "--urgent", "--", "true")
  assertEq(queuedIds(home), [c, e, d, b])
  assertEq(queuedUrgent(home), [true, true, false, false])
  m(home, "kill", blocker.toString())
  val r = m(home, "run", "--urgent", "--", "true")
  assertEq(r.code, 0)
  for id in [b, c, d, e] do assertEq(m(home, "wait", id.toString()).code, 0)
  assertEq(startOrder(home, [b, c, d, e]), [c, e, d, b])
  cleanUp(home)

@test("an urgent job submitted while an earlier urgent job is held goes behind it, and starts first while it is held")
urgentBehindHeldUrgent()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--", "sleep", "30")
  val first = submitted(home, "--urgent", "--", "true")
  assertEq(m(home, "hold", first.toString()).code, 0)
  val normal = submitted(home, "--", "true")
  val second = submitted(home, "--urgent", "--", "true")
  assertEq(queuedIds(home), [first, second, normal])
  m(home, "kill", blocker.toString())
  assertEq(m(home, "wait", normal.toString()).code, 0)
  assertEq(startOrder(home, [second, normal]), [second, normal])
  assertEq(eventsOf(home, first), ["submitted", "held"])
  assertEq(m(home, "release", first.toString()).code, 0)
  assertEq(m(home, "wait", first.toString()).code, 0)
  cleanUp(home)

@test("priority --urgent moves a job to the back of the urgent band, and a number takes it out of the band")
priorityUrgentBand()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--", "sleep", "30")
  val a = submitted(home, "--urgent", "--", "true")
  val b = submitted(home, "--urgent", "--", "true")
  val c = submitted(home, "--", "true")
  assertEq(m(home, "priority", a.toString(), "--urgent").code, 0)
  assertEq(queuedIds(home), [b, a, c])
  assertEq(m(home, "priority", c.toString(), "--urgent").code, 0)
  assertEq(queuedIds(home), [b, a, c])
  assertEq(m(home, "priority", b.toString(), "0").code, 0)
  assertEq(queuedIds(home), [a, c, b])
  assertEq(queuedUrgent(home), [true, true, false])
  m(home, "kill", blocker.toString())
  for id in [a, b, c] do assertEq(m(home, "wait", id.toString()).code, 0)
  assertEq(startOrder(home, [a, b, c]), [a, c, b])
  cleanUp(home)

@test("the urgent band survives a restart in its order, and an urgent job submitted after it goes behind the band")
urgentAcrossRestart()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--", "sleep", "30")
  val normal = submitted(home, "--", "true")
  val u1 = submitted(home, "--urgent", "--", "true")
  val u2 = submitted(home, "--urgent", "--", "true")
  assertEq(m(home, "priority", u1.toString(), "--urgent").code, 0)
  assertEq(queuedIds(home), [u2, u1, normal])
  restarted(home)
  assertEq(queuedIds(home), [u2, u1, normal])
  assertEq(queuedUrgent(home), [true, true, false])
  val u3 = submitted(home, "--urgent", "--", "true")
  assertEq(queuedIds(home), [u2, u1, u3, normal])
  m(home, "kill", blocker.toString())
  for id in [normal, u1, u2, u3] do assertEq(m(home, "wait", id.toString()).code, 0)
  assertEq(startOrder(home, [normal, u1, u2, u3]), [u2, u1, u3, normal])
  cleanUp(home)

@test("pause holds the queue while running jobs go on, and resume starts what waits")
pauseAndResume()
  val home = newHome()
  val running = submitted(home, "--", "sleep", "0.6")
  val p = m(home, "pause")
  assertEq(p.code, 0)
  assert(p.out.contains("the queue is held"), p.out)
  val queued = submitted(home, "--", "true")
  assertEq(m(home, "wait", running.toString()).code, 0)
  threads.sleep(millis(300))
  assertEq(eventsOf(home, queued), ["submitted"])
  assert(m(home, "status").out.contains("the queue is held"))
  assertEq(statusJsonOf(home)("queue_held").asBool, Some(true))
  assertEq(m(home, "resume").code, 0)
  assertEq(m(home, "wait", queued.toString()).code, 0)
  assertEq(statusJsonOf(home)("queue_held").asBool, Some(false))
  assert(!m(home, "status").out.contains("held"))
  cleanUp(home)

@test("pause twice, resume of a queue not held, and either naming no job are refused")
pauseResumeErrors()
  val home = newHome()
  refusedWith(m(home, "resume"), "the queue is not held")
  assertEq(m(home, "pause").code, 0)
  refusedWith(m(home, "pause"), "the queue is already held")
  // with an id they are about one job, not the queue
  refusedWith(m(home, "pause", "3"), "no job 3")
  refusedWith(m(home, "resume", "3"), "no job 3")
  refusedWith(m(home, "pause", "1", "2"), "give one job id")
  assertEq(m(home, "resume").code, 0)
  refusedWith(m(home, "resume"), "the queue is not held")
  cleanUp(home)

@test("a held queue holds the landing lane too, and its landing job starts on resume")
pauseHoldsLanding()
  val home = newHome()
  assertEq(m(home, "pause").code, 0)
  val landing = submitted(home, "--landing", "--", "true")
  val development = submitted(home, "--", "true")
  threads.sleep(millis(500))
  assertEq(eventsOf(home, landing), ["submitted"])
  assertEq(eventsOf(home, development), ["submitted"])
  val snapshot = statusJsonOf(home)
  assertEq(snapshot("queued").asVector.map(q -> q.length), Some(2))
  assertEq(snapshot("landing"), Json.Null)
  assertEq(m(home, "resume").code, 0)
  assertEq(m(home, "wait", landing.toString()).code, 0)
  assertEq(m(home, "wait", development.toString()).code, 0)
  assert(at(home, landing, "started") <= at(home, development, "started"))
  cleanUp(home)

@test("a held job keeps its place while later jobs start, shows as held, and starts once released")
holdAndRelease()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--", "sleep", "30")
  val b = submitted(home, "--", "true")
  val c = submitted(home, "--", "true")
  val h = m(home, "hold", b.toString())
  assertEq(h.code, 0)
  assert(h.out.contains(s"job $b is held"), h.out)
  assert(m(home, "ls").out.lines.exists(l -> l.startsWith(b.toString()) && l.contains("held")))
  m(home, "kill", blocker.toString())
  assertEq(m(home, "wait", c.toString()).code, 0)
  threads.sleep(millis(300))
  assertEq(eventsOf(home, b), ["submitted", "held"])
  assertEq(m(home, "release", b.toString()).code, 0)
  assertEq(m(home, "wait", b.toString()).code, 0)
  assertEq(eventsOf(home, b), ["submitted", "held", "released", "started", "finished"])
  cleanUp(home)

@test(
  "hold and release refuse an unknown job, a running or ended one, a second hold, a release of one not held, and a bad id"
)
holdErrors()
  val home = newHome("{\"units\": 1}")
  val running = submitted(home, "--", "sleep", "30")
  val queued = submitted(home, "--", "true")
  refusedWith(m(home, "hold", "99"), "no job 99")
  refusedWith(m(home, "release", "99"), "no job 99")
  refusedWith(m(home, "hold", "0"), "no job 0")
  refusedWith(m(home, "hold", running.toString()), s"job $running is running: only a queued job is held")
  refusedWith(m(home, "release", running.toString()), s"job $running is running: only a queued job is released")
  refusedWith(m(home, "release", queued.toString()), s"job $queued is not held")
  assertEq(m(home, "hold", queued.toString()).code, 0)
  refusedWith(m(home, "hold", queued.toString()), s"job $queued is already held")
  refusedWith(m(home, "hold", "x"), "`x` is not a job id")
  refusedWith(m(home, "hold"), "give one job id")
  refusedWith(m(home, "release", "1", "2"), "give one job id")
  // a held job is cancelled by kill like any queued one, and then has ended
  assertEq(m(home, "kill", queued.toString()).code, 0)
  assertEq(m(home, "wait", queued.toString()).code, 143)
  refusedWith(m(home, "release", queued.toString()), s"job $queued has already ended")
  refusedWith(m(home, "hold", queued.toString()), s"job $queued has already ended")
  cleanUp(home)

@test("priority orders a lane's queue: higher first, equal ones by arrival, --urgent ahead of them all")
priorityOrder()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--", "sleep", "30")
  val b = submitted(home, "--", "true")
  val c = submitted(home, "--", "true")
  val d = submitted(home, "--", "true")
  val e = submitted(home, "--", "true")
  val f = submitted(home, "--", "true")
  assertEq(m(home, "priority", d.toString(), "5").code, 0)
  assertEq(m(home, "priority", e.toString(), "5").code, 0)
  assertEq(m(home, "priority", f.toString(), "-1").code, 0)
  val u = m(home, "priority", c.toString(), "--urgent")
  assertEq(u.code, 0)
  assert(u.out.contains(s"job $c is placed"), u.out)
  // the queue lists in its new order
  val listed = m(home, "ls").out.lines.drop(1).map(
    l -> l.trim.split(" ")(0).toLong()
  ).filter(id -> id != blocker).toVector
  assertEq(listed.take(5), [c, d, e, b, f])
  // a job submitted now, at the default 0, goes behind b and ahead of f
  val g = submitted(home, "--", "true")
  m(home, "kill", blocker.toString())
  for id in [b, c, d, e, f, g] do assertEq(m(home, "wait", id.toString()).code, 0)
  assertEq(startOrder(home, [b, c, d, e, f, g]), [c, d, e, b, g, f])
  cleanUp(home)

@test("priority refuses an unknown, running or ended job and arguments that are not an id and a priority")
priorityErrors()
  val home = newHome("{\"units\": 1}")
  val running = submitted(home, "--", "sleep", "30")
  val queued = submitted(home, "--", "true")
  refusedWith(m(home, "priority", "99", "1"), "no job 99")
  refusedWith(
    m(home, "priority", running.toString(), "1"),
    s"job $running is running: only a queued job is given a priority"
  )
  refusedWith(m(home, "priority", running.toString(), "--urgent"), s"job $running is running")
  val takes = "priority takes a job id and a whole number, --urgent, --low, --up or --down"
  refusedWith(m(home, "priority", queued.toString()), takes)
  refusedWith(m(home, "priority"), takes)
  refusedWith(m(home, "priority", queued.toString(), "1", "2"), takes)
  refusedWith(m(home, "priority", queued.toString(), "--up", "--down"), takes)
  refusedWith(
    m(home, "priority", queued.toString(), "up"),
    "`up` is not a priority: a whole number, --urgent, --low, --up or --down"
  )
  refusedWith(m(home, "priority", queued.toString(), "low"), "`low` is not a priority")
  refusedWith(m(home, "priority", "x", "1"), "`x` is not a job id")
  refusedWith(m(home, "priority", queued.toString(), "urgent"), "`urgent` is not a priority")
  refusedWith(m(home, "priority", queued.toString(), "1.5"), "`1.5` is not a priority")
  refusedWith(m(home, "priority", queued.toString(), "2147483648"), "`2147483648` is not a priority")
  // the highest priority there is still goes behind an urgent job
  assertEq(m(home, "priority", queued.toString(), "2147483647").code, 0)
  val other = submitted(home, "--urgent", "--", "true")
  assertEq(queuedIds(home), [other, queued])
  m(home, "kill", running.toString())
  assertEq(m(home, "wait", other.toString()).code, 0)
  refusedWith(m(home, "priority", other.toString(), "3"), s"job $other has already ended")
  cleanUp(home)

// Each queued job's priority, in queue order.
queuedPriorities(home: string) -> Vector[int] = statusJsonOf(home)("queued").asVector.get.map(
  q -> q("priority").asInt.get
)

// Fails unless `priority <id> <how>` moved the job.
movedBy(home: string, id: long, how: string)
  val r = m(home, "priority", id.toString(), how)
  assertEq(r.code, 0)
  assert(r.out.contains(s"job $id is moved ${if how == "--up" then "up" else "down"}"), r.out)

@test("priority --up and --down move a queued job one place among jobs of one priority, and the jobs start in that order")
moveOnePlace()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--", "sleep", "30")
  val b = submitted(home, "--", "true")
  val c = submitted(home, "--", "true")
  val d = submitted(home, "--", "true")
  movedBy(home, d, "--up")
  assertEq(queuedIds(home), [b, d, c])
  movedBy(home, d, "--up")
  assertEq(queuedIds(home), [d, b, c])
  movedBy(home, b, "--down")
  assertEq(queuedIds(home), [d, c, b])
  assertEq(queuedPriorities(home), [0, 0, 0])
  assertEq(eventsOf(home, d).filter(e -> e == "prioritized").length, 2)
  // a job submitted now goes behind them all
  val e = submitted(home, "--", "true")
  assertEq(queuedIds(home), [d, c, b, e])
  m(home, "kill", blocker.toString())
  for id in [b, c, d, e] do assertEq(m(home, "wait", id.toString()).code, 0)
  assertEq(startOrder(home, [b, c, d, e]), [d, c, b, e])
  cleanUp(home)

@test("the first job of a band is not moved up nor the last down, and nothing changes")
moveAtTheEdgeE2e()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--", "sleep", "30")
  val b = submitted(home, "--", "true")
  val c = submitted(home, "--", "true")
  refusedWith(m(home, "priority", b.toString(), "--up"), s"job $b is first in its band")
  refusedWith(m(home, "priority", c.toString(), "--down"), s"job $c is last in its band")
  assertEq(queuedIds(home), [b, c])
  assertEq(eventsOf(home, b).filter(e -> e == "prioritized"), Vector[string]())
  // a band of one
  val u = submitted(home, "--urgent", "--", "true")
  refusedWith(m(home, "priority", u.toString(), "--up"), s"job $u is first in its band")
  refusedWith(m(home, "priority", u.toString(), "--down"), s"job $u is last in its band")
  // the first job not urgent does not go up into the urgent band
  refusedWith(m(home, "priority", b.toString(), "--up"), s"job $b is first in its band")
  assertEq(queuedIds(home), [u, b, c])
  assertEq(queuedUrgent(home), [true, false, false])
  m(home, "kill", blocker.toString())
  cleanUp(home)

@test("a move past a job of another priority takes that priority, and no other job's priority changes")
moveAcrossPrioritiesE2e()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--", "sleep", "30")
  val b = submitted(home, "--", "true")
  val c = submitted(home, "--", "true")
  val d = submitted(home, "--", "true")
  assertEq(m(home, "priority", b.toString(), "5").code, 0)
  assertEq(m(home, "priority", c.toString(), "5").code, 0)
  assertEq(queuedIds(home), [b, c, d])
  movedBy(home, d, "--up")
  assertEq(queuedIds(home), [b, d, c])
  assertEq(queuedPriorities(home), [5, 5, 5])
  movedBy(home, d, "--down")
  movedBy(home, c, "--down")
  assertEq(queuedIds(home), [b, d, c])
  movedBy(home, b, "--down")
  assertEq(queuedIds(home), [d, b, c])
  m(home, "kill", blocker.toString())
  cleanUp(home)

@test("a move in the urgent band keeps every job urgent, and a move in the low band keeps every job low")
moveInBandsE2e()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--", "sleep", "30")
  val n = submitted(home, "--", "true")
  val u1 = submitted(home, "--urgent", "--", "true")
  val u2 = submitted(home, "--urgent", "--", "true")
  val l1 = submitted(home, "--low", "--", "true")
  val l2 = submitted(home, "--low", "--", "true")
  assertEq(queuedIds(home), [u1, u2, n, l1, l2])
  movedBy(home, u2, "--up")
  movedBy(home, l1, "--down")
  assertEq(queuedIds(home), [u2, u1, n, l2, l1])
  assertEq(queuedUrgent(home), [true, true, false, false, false])
  assertEq(statusJsonOf(home)("queued").asVector.get.map(q -> q.has("low")), [false, false, false, true, true])
  refusedWith(m(home, "priority", u1.toString(), "--down"), s"job $u1 is last in its band")
  refusedWith(m(home, "priority", n.toString(), "--down"), s"job $n is last in its band")
  refusedWith(m(home, "priority", l2.toString(), "--up"), s"job $l2 is first in its band")
  // an urgent job submitted now still joins the back of the band
  val u3 = submitted(home, "--urgent", "--", "true")
  assertEq(queuedIds(home), [u2, u1, u3, n, l2, l1])
  m(home, "kill", blocker.toString())
  cleanUp(home)

@test("a held job is moved as any other and stays held, and a job is moved past a held one")
moveHeldE2e()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--", "sleep", "30")
  val b = submitted(home, "--", "true")
  val c = submitted(home, "--", "true")
  val d = submitted(home, "--", "true")
  assertEq(m(home, "hold", c.toString()).code, 0)
  movedBy(home, c, "--up")
  assertEq(queuedIds(home), [c, b, d])
  assertEq(statusJsonOf(home)("queued").asVector.get.map(q -> q("held").asBool.get), [true, false, false])
  movedBy(home, d, "--up")
  movedBy(home, d, "--up")
  assertEq(queuedIds(home), [d, c, b])
  assertEq(m(home, "priority", c.toString(), "--urgent").code, 0)
  assertEq(m(home, "priority", c.toString(), "--low").code, 0)
  assert(m(home, "status", c.toString()).out.contains("(held)"), m(home, "status", c.toString()).out)
  m(home, "kill", blocker.toString())
  cleanUp(home)

@test("a landing job moves among the landing jobs, an exclusive one among the development jobs, as priority places them")
moveLanesE2e()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--landing", "--", "sleep", "30")
  val la = submitted(home, "--landing", "--", "true")
  val b = submitted(home, "--", "true")
  val lb = submitted(home, "--landing", "--", "true")
  val x = submitted(home, "--exclusive", "--", "true")
  movedBy(home, lb, "--up")
  val landings = queuedIds(home).filter(id -> id == la || id == lb)
  assertEq(landings, [lb, la])
  refusedWith(m(home, "priority", lb.toString(), "--up"), s"job $lb is first in its band")
  movedBy(home, x, "--up")
  assertEq(queuedIds(home).filter(id -> id == b || id == x), [x, b])
  refusedWith(m(home, "priority", b.toString(), "--down"), s"job $b is last in its band")
  m(home, "kill", blocker.toString())
  cleanUp(home)

@test("a move is refused for a job that runs, has ended, waits for another or is unknown")
moveRefusals()
  val home = newHome("{\"units\": 1}")
  val running = submitted(home, "--", "sleep", "30")
  val queued = submitted(home, "--", "true")
  val waits = submitted(home, "--after", queued.toString(), "--", "true")
  for how in ["--up", "--down"]
    refusedWith(m(home, "priority", running.toString(), how), s"job $running is running: only a queued job is moved")
    refusedWith(m(home, "priority", waits.toString(), how), s"job $waits is not queued yet: only a queued job is moved")
    refusedWith(m(home, "priority", "99", how), "no job 99")
  refusedWith(
    m(home, "priority", waits.toString(), "3"),
    s"job $waits is not queued yet: only a queued job is given a priority"
  )
  m(home, "kill", running.toString())
  assertEq(m(home, "wait", queued.toString()).code, 0)
  refusedWith(m(home, "priority", queued.toString(), "--up"), s"job $queued has already ended")
  cleanUp(home)

@test("the order moves gave survives a restart, in every band, and later moves and arrivals go on from it")
movesAcrossRestart()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--", "sleep", "30")
  val b = submitted(home, "--", "true")
  val c = submitted(home, "--", "true")
  val d = submitted(home, "--", "true")
  val u1 = submitted(home, "--urgent", "--", "true")
  val u2 = submitted(home, "--urgent", "--", "true")
  val l1 = submitted(home, "--low", "--", "true")
  val l2 = submitted(home, "--low", "--", "true")
  assertEq(m(home, "priority", b.toString(), "5").code, 0)
  movedBy(home, d, "--up")
  movedBy(home, d, "--up")
  movedBy(home, u2, "--up")
  movedBy(home, l2, "--up")
  val order = [u2, u1, d, b, c, l2, l1]
  assertEq(queuedIds(home), order)
  assertEq(queuedPriorities(home), [0, 0, 5, 5, 0, 0, 0])
  restarted(home)
  assertEq(queuedIds(home), order)
  assertEq(queuedPriorities(home), [0, 0, 5, 5, 0, 0, 0])
  restarted(home)
  assertEq(queuedIds(home), order)
  movedBy(home, c, "--up")
  val e = submitted(home, "--", "true")
  assertEq(queuedIds(home), [u2, u1, d, c, b, e, l2, l1])
  m(home, "kill", blocker.toString())
  for id in [b, c, d, e, u1, u2] do assertEq(m(home, "wait", id.toString()).code, 0)
  assertEq(startOrder(home, [b, c, d, e, u1, u2]), [u2, u1, d, c, b, e])
  cleanUp(home)

@test("a held queue, a held job and priorities survive a restart, and release and resume after it")
controlAcrossRestart()
  val home = newHome("{\"units\": 1}")
  val blocker = submitted(home, "--", "sleep", "30")
  val b = submitted(home, "--", "true")
  val c = submitted(home, "--", "true")
  val d = submitted(home, "--", "true")
  assertEq(m(home, "hold", b.toString()).code, 0)
  assertEq(m(home, "priority", d.toString(), "3").code, 0)
  assertEq(m(home, "pause").code, 0)
  m(home, "kill", blocker.toString())
  assertEq(m(home, "wait", blocker.toString()).code, 143)
  val pid = daemonPid(home)
  restarted(home)
  assertEq(daemonPid(home), pid)
  threads.sleep(millis(300))
  assertEq(statusJsonOf(home)("queue_held").asBool, Some(true))
  val queued = statusJsonOf(home)("queued").asVector.get
  assertEq(queued.map(q -> q("id").asLong.get), [d, b, c])
  assertEq(queued.map(q -> q("held").asBool.get), [false, true, false])
  assertEq(queued.map(q -> q("priority").asInt.get), [3, 0, 0])
  for id in [b, c, d] do assertEq(eventsOf(home, id).filter(e -> e == "started"), Vector[string]())
  refusedWith(m(home, "pause"), "the queue is already held")
  assertEq(m(home, "resume").code, 0)
  assertEq(m(home, "wait", c.toString()).code, 0)
  assertEq(startOrder(home, [c, d]), [d, c])
  assertEq(eventsOf(home, b), ["submitted", "held"])
  assertEq(m(home, "release", b.toString()).code, 0)
  assertEq(m(home, "wait", b.toString()).code, 0)
  cleanUp(home)

@test("stop --wait is refused while the queue or a queued job is held, and --force still stops")
stopWhileHeld()
  val home = newHome("{\"units\": 1}")
  assertEq(m(home, "pause").code, 0)
  val queued = submitted(home, "--", "true")
  refusedWith(m(home, "stop", "--wait"), "the queue is held")
  assertEq(m(home, "resume").code, 0)
  assertEq(m(home, "wait", queued.toString()).code, 0)
  val blocker = submitted(home, "--", "sleep", "30")
  val held = submitted(home, "--", "true")
  assertEq(m(home, "hold", held.toString()).code, 0)
  refusedWith(m(home, "stop", "--wait"), "a queued job is held")
  // nothing to wait for once the queue is empty, held or not
  assertEq(m(home, "pause").code, 0)
  val r = m(home, "stop", "--force")
  assertEq(r.code, 0)
  assertEq(m(home, "wait", held.toString()).code, 143)
  assertEq(m(home, "wait", blocker.toString()).code, 143)
  cleanUp(home)

@test("a held queue with nothing queued stops with --wait at once")
stopWaitHeldButEmpty()
  val home = newHome()
  assertEq(m(home, "pause").code, 0)
  assertEq(m(home, "stop", "--wait").code, 0)
  cleanUp(home)
