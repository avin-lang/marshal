module tests

// Holding and ordering the queue, end to end through the command line: `pause` and `resume` hold
// and release the whole queue, `hold` and `release` one job, `priority` places a job, and all of it
// survives `marshal restart`.
import avin.threads
import avin.time.millis
import json
import json.Json

// Fails unless `r` exited 2 saying `why`.
refusedWith(r: Ran, why: string)
    assertEq(r.code, 2)
    assert(r.out.contains(why), r.out)

// The order the jobs `ids` started in, by the event log.
startOrder(home: string, ids: Vector[long]) -> Vector[long] = ids.sortBy(id -> at(home, id, "started"))

statusJsonOf(home: string) -> Json
    val r = m(home, "status", "--json")
    assertEq(r.code, 0)
    json.parse(r.out.trim()).ok().get()

@test("pause holds the queue while running jobs go on, and resume starts what waits")
pauseAndResume()
    val home = newHome()
    val running = submitted(home, "--", "sleep", "0.6")
    val p = m(home, "pause")
    assertEq(p.code, 0)
    assert(p.out.contains("the queue is held"), p.out)
    val queued = submitted(home, "--", "true")
    assertEq(m(home, "wait", running.toString()).code, 0)
    threads.sleep(millis(300))
    assertEq(eventsOf(home, queued), ["submitted"])
    assert(m(home, "status").out.contains("the queue is held"))
    assertEq(statusJsonOf(home)("queue_held").asBool(), Some(true))
    assertEq(m(home, "resume").code, 0)
    assertEq(m(home, "wait", queued.toString()).code, 0)
    assertEq(statusJsonOf(home)("queue_held").asBool(), Some(false))
    assert(!m(home, "status").out.contains("held"))
    cleanUp(home)

@test("pause twice, resume of a queue not held, and either with arguments are refused")
pauseResumeErrors()
    val home = newHome()
    refusedWith(m(home, "resume"), "the queue is not held")
    assertEq(m(home, "pause").code, 0)
    refusedWith(m(home, "pause"), "the queue is already held")
    refusedWith(m(home, "pause", "3"), "pause takes no arguments")
    refusedWith(m(home, "resume", "3"), "resume takes no arguments")
    assertEq(m(home, "resume").code, 0)
    refusedWith(m(home, "resume"), "the queue is not held")
    cleanUp(home)

@test("a held queue holds the landing lane too, and its landing job starts on resume")
pauseHoldsLanding()
    val home = newHome()
    assertEq(m(home, "pause").code, 0)
    val landing = submitted(home, "--landing", "--", "true")
    val development = submitted(home, "--", "true")
    threads.sleep(millis(500))
    assertEq(eventsOf(home, landing), ["submitted"])
    assertEq(eventsOf(home, development), ["submitted"])
    val snapshot = statusJsonOf(home)
    assertEq(snapshot("queued").asVector().map(q -> q.length()), Some(2))
    assertEq(snapshot("landing"), Json.Null)
    assertEq(m(home, "resume").code, 0)
    assertEq(m(home, "wait", landing.toString()).code, 0)
    assertEq(m(home, "wait", development.toString()).code, 0)
    assert(at(home, landing, "started") <= at(home, development, "started"))
    cleanUp(home)

@test("a held job keeps its place while later jobs start, shows as held, and starts once released")
holdAndRelease()
    val home = newHome("{\"units\": 1}")
    val blocker = submitted(home, "--", "sleep", "30")
    val b = submitted(home, "--", "true")
    val c = submitted(home, "--", "true")
    val h = m(home, "hold", b.toString())
    assertEq(h.code, 0)
    assert(h.out.contains(s"job $b is held"), h.out)
    assert(m(home, "ls").out.lines().exists(l -> l.startsWith(b.toString()) && l.contains("held")))
    m(home, "kill", blocker.toString())
    assertEq(m(home, "wait", c.toString()).code, 0)
    threads.sleep(millis(300))
    assertEq(eventsOf(home, b), ["submitted", "held"])
    assertEq(m(home, "release", b.toString()).code, 0)
    assertEq(m(home, "wait", b.toString()).code, 0)
    assertEq(eventsOf(home, b), ["submitted", "held", "released", "started", "finished"])
    cleanUp(home)

@test("hold and release refuse an unknown job, a running or ended one, a second hold, a release of one not held, and a bad id")
holdErrors()
    val home = newHome("{\"units\": 1}")
    val running = submitted(home, "--", "sleep", "30")
    val queued = submitted(home, "--", "true")
    refusedWith(m(home, "hold", "99"), "no job 99")
    refusedWith(m(home, "release", "99"), "no job 99")
    refusedWith(m(home, "hold", "0"), "no job 0")
    refusedWith(m(home, "hold", running.toString()), s"job $running is running: only a queued job is held")
    refusedWith(m(home, "release", running.toString()), s"job $running is running: only a queued job is released")
    refusedWith(m(home, "release", queued.toString()), s"job $queued is not held")
    assertEq(m(home, "hold", queued.toString()).code, 0)
    refusedWith(m(home, "hold", queued.toString()), s"job $queued is already held")
    refusedWith(m(home, "hold", "x"), "`x` is not a job id")
    refusedWith(m(home, "hold"), "give one job id")
    refusedWith(m(home, "release", "1", "2"), "give one job id")
    // a held job is cancelled by kill like any queued one, and then has ended
    assertEq(m(home, "kill", queued.toString()).code, 0)
    assertEq(m(home, "wait", queued.toString()).code, 143)
    refusedWith(m(home, "release", queued.toString()), s"job $queued has already ended")
    refusedWith(m(home, "hold", queued.toString()), s"job $queued has already ended")
    cleanUp(home)

@test("priority orders a lane's queue: higher first, equal ones by arrival, --urgent at the front")
priorityOrder()
    val home = newHome("{\"units\": 1}")
    val blocker = submitted(home, "--", "sleep", "30")
    val b = submitted(home, "--", "true")
    val c = submitted(home, "--", "true")
    val d = submitted(home, "--", "true")
    val e = submitted(home, "--", "true")
    val f = submitted(home, "--", "true")
    assertEq(m(home, "priority", d.toString(), "5").code, 0)
    assertEq(m(home, "priority", e.toString(), "5").code, 0)
    assertEq(m(home, "priority", f.toString(), "-1").code, 0)
    val u = m(home, "priority", c.toString(), "--urgent")
    assertEq(u.code, 0)
    assert(u.out.contains(s"job $c is placed"), u.out)
    // the queue lists in its new order
    val listed = m(home, "ls").out.lines().drop(1).map(l -> l.trim().split(" ")(0).toLong()).filter(id -> id != blocker).toVector()
    assertEq(listed.take(5), [c, d, e, b, f])
    // a job submitted now, at the default 0, goes behind b and ahead of f
    val g = submitted(home, "--", "true")
    m(home, "kill", blocker.toString())
    for id in [b, c, d, e, f, g] do assertEq(m(home, "wait", id.toString()).code, 0)
    assertEq(startOrder(home, [b, c, d, e, f, g]), [c, d, e, b, g, f])
    cleanUp(home)

@test("priority refuses an unknown, running or ended job and arguments that are not an id and a priority")
priorityErrors()
    val home = newHome("{\"units\": 1}")
    val running = submitted(home, "--", "sleep", "30")
    val queued = submitted(home, "--", "true")
    refusedWith(m(home, "priority", "99", "1"), "no job 99")
    refusedWith(m(home, "priority", running.toString(), "1"), s"job $running is running: only a queued job is given a priority")
    refusedWith(m(home, "priority", running.toString(), "--urgent"), s"job $running is running")
    refusedWith(m(home, "priority", queued.toString()), "priority takes a job id and a whole number, or --urgent")
    refusedWith(m(home, "priority"), "priority takes a job id and a whole number, or --urgent")
    refusedWith(m(home, "priority", queued.toString(), "1", "2"), "priority takes a job id and a whole number, or --urgent")
    refusedWith(m(home, "priority", "x", "1"), "`x` is not a job id")
    refusedWith(m(home, "priority", queued.toString(), "urgent"), "`urgent` is not a priority")
    refusedWith(m(home, "priority", queued.toString(), "1.5"), "`1.5` is not a priority")
    refusedWith(m(home, "priority", queued.toString(), "2147483648"), "`2147483648` is not a priority")
    // the highest priority there is leaves no room for an urgent one in front of it
    assertEq(m(home, "priority", queued.toString(), "2147483647").code, 0)
    val other = submitted(home, "--", "true")
    refusedWith(m(home, "priority", other.toString(), "--urgent"), "already has the highest priority there is")
    m(home, "kill", running.toString())
    assertEq(m(home, "wait", other.toString()).code, 0)
    refusedWith(m(home, "priority", other.toString(), "3"), s"job $other has already ended")
    cleanUp(home)

@test("a held queue, a held job and priorities survive a restart, and release and resume after it")
controlAcrossRestart()
    val home = newHome("{\"units\": 1}")
    val blocker = submitted(home, "--", "sleep", "30")
    val b = submitted(home, "--", "true")
    val c = submitted(home, "--", "true")
    val d = submitted(home, "--", "true")
    assertEq(m(home, "hold", b.toString()).code, 0)
    assertEq(m(home, "priority", d.toString(), "3").code, 0)
    assertEq(m(home, "pause").code, 0)
    m(home, "kill", blocker.toString())
    assertEq(m(home, "wait", blocker.toString()).code, 143)
    val pid = daemonPid(home)
    assertEq(m(home, "restart").code, 0)
    assertEq(daemonPid(home), pid)
    threads.sleep(millis(300))
    assertEq(statusJsonOf(home)("queue_held").asBool(), Some(true))
    val queued = statusJsonOf(home)("queued").asVector().get()
    assertEq(queued.map(q -> q("id").asLong().get()), [d, b, c])
    assertEq(queued.map(q -> q("held").asBool().get()), [false, true, false])
    assertEq(queued.map(q -> q("priority").asInt().get()), [3, 0, 0])
    for id in [b, c, d] do assertEq(eventsOf(home, id).filter(e -> e == "started"), Vector[string]())
    refusedWith(m(home, "pause"), "the queue is already held")
    assertEq(m(home, "resume").code, 0)
    assertEq(m(home, "wait", c.toString()).code, 0)
    assertEq(startOrder(home, [c, d]), [d, c])
    assertEq(eventsOf(home, b), ["submitted", "held"])
    assertEq(m(home, "release", b.toString()).code, 0)
    assertEq(m(home, "wait", b.toString()).code, 0)
    cleanUp(home)

@test("stop --wait is refused while the queue or a queued job is held, and --force still stops")
stopWhileHeld()
    val home = newHome("{\"units\": 1}")
    assertEq(m(home, "pause").code, 0)
    val queued = submitted(home, "--", "true")
    refusedWith(m(home, "stop", "--wait"), "the queue is held")
    assertEq(m(home, "resume").code, 0)
    assertEq(m(home, "wait", queued.toString()).code, 0)
    val blocker = submitted(home, "--", "sleep", "30")
    val held = submitted(home, "--", "true")
    assertEq(m(home, "hold", held.toString()).code, 0)
    refusedWith(m(home, "stop", "--wait"), "a queued job is held")
    // nothing to wait for once the queue is empty, held or not
    assertEq(m(home, "pause").code, 0)
    val r = m(home, "stop", "--force")
    assertEq(r.code, 0)
    assertEq(m(home, "wait", held.toString()).code, 143)
    assertEq(m(home, "wait", blocker.toString()).code, 143)
    cleanUp(home)

@test("a held queue with nothing queued stops with --wait at once")
stopWaitHeldButEmpty()
    val home = newHome()
    assertEq(m(home, "pause").code, 0)
    assertEq(m(home, "stop", "--wait").code, 0)
    cleanUp(home)
