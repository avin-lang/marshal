module tests

// Reservations learned from the peaks of a command's runs, and admission counting each running job as its
// reservation or its measured memory, whichever is more.
import dev.avinlang.json
import dev.avinlang.marshal

import dev.avinlang.marshal.{
  Budget, JobInfo, JobSpec, MemoryHistory, MemoryLearning, Overview, Reply, Request, Reservation, Started, Usage,
  Waiting
}

val M: long = 1024 * 1024
val learning0: MemoryLearning = marshal.defaultMemoryLearning

@test("no history learns nothing and reserves 0; one measured run is enough")
littleHistory()
  assertEq(marshal.learnedPeak(learning0, []), None)
  assertEq(marshal.reservationFor(learning0, 0, false, [], 56 * G), Reservation(0, false))
  // peaks of 0 (jobs never measured) are not history
  assertEq(marshal.learnedPeak(learning0, [0, 0]), None)
  assertEq(marshal.learnedPeak(learning0, [20 * G]), Some(22 * G))
  assertEq(marshal.learnedPeak(learning0, [0, 20 * G, 0]), Some(22 * G))
  assertEq(marshal.reservationFor(learning0, 0, false, [20 * G], 56 * G), Reservation(22 * G, true))
  // the least history follows minRuns, exactly at the boundary
  assertEq(marshal.learnedPeak(MemoryLearning(5, 2, 10), [20 * G]), None)
  assertEq(marshal.learnedPeak(MemoryLearning(5, 2, 10), [10 * G, 20 * G]), Some(22 * G))

@test("enough history reserves the most of the recent peaks plus a tenth, rounded up to a mebibyte")
enoughHistory()
  assertEq(marshal.learnedPeak(learning0, [10 * G, 20 * G]), Some(22 * G))
  assertEq(marshal.learnedPeak(learning0, [20 * G, 10 * G, 15 * G]), Some(22 * G))
  assertEq(marshal.reservationFor(learning0, 0, false, [10 * G, 20 * G], 56 * G), Reservation(22 * G, true))
  // rounded up to a whole mebibyte
  assertEq(marshal.learnedPeak(learning0, [1000, 1000]), Some(M))
  val odd = 3 * G + 12345
  val learned = marshal.learnedPeak(learning0, [odd, 1]).get
  assertEq(learned % M, 0)
  assert(learned >= odd + odd / 10, s"$learned")
  assert(learned < odd + odd / 10 + M, s"$learned")

@test("only the last five peaks count: an old big peak is forgotten, one in the window is not")
resvWindow()
  val old: Vector[long] = [50 * G] ++ (0 ..< 5).map(_ -> 10 * G).toVector
  assertEq(marshal.learnedPeak(learning0, old), Some(11 * G))
  val edge: Vector[long] = [50 * G] ++ (0 ..< 4).map(_ -> 10 * G).toVector
  assertEq(marshal.learnedPeak(learning0, edge), Some(55 * G))
  val recent: Vector[long] = (0 ..< 9).map(_ -> 10 * G).toVector ++ [50 * G]
  assertEq(marshal.learnedPeak(learning0, recent), Some(55 * G))
  assertEq(marshal.learnedPeak(MemoryLearning(3, 1, 0), [9 * G, G, 2 * G, 3 * G]), Some(3 * G))

@test("a learned peak near the largest size does not overflow")
noOverflow()
  assertEq(marshal.learnedPeak(learning0, [long.MaxValue, long.MaxValue]), Some(long.MaxValue))
  assertEq(marshal.reservationFor(learning0, 0, false, [long.MaxValue, 1], 56 * G), Reservation(56 * G, true))

@test("a given memory is the reservation, --mem 0 opting out of learning")
given()
  val peaks: Vector[long] = [20 * G, 20 * G]
  assertEq(marshal.reservationFor(learning0, 0, true, peaks, 56 * G), Reservation(0, false))
  assertEq(marshal.reservationFor(learning0, 4 * G, true, peaks, 56 * G), Reservation(4 * G, false))
  // a memory above 0 from a client that does not say it was given still counts as given
  assertEq(marshal.reservationFor(learning0, 4 * G, false, peaks, 56 * G), Reservation(4 * G, false))

@test("a learned reservation above the whole budget is held to the budget, so the job can run alone")
overBudget()
  val r = marshal.reservationFor(learning0, 0, false, [80 * G, 70 * G], 56 * G)
  assertEq(r, Reservation(56 * G, true))
  assertEq(marshal.neverFits(Budget(12, 56 * G), 1, r.bytes, false), None)
  val b = Budget(12, 56 * G)
  // it waits while anything holds memory, and starts once nothing does
  assertEq(marshal.schedule(b, [Started(1, 1, M, false, 0, hour)], [Waiting(2, 1, r.bytes, false, hour, 20)], 0), [])
  assertEq(marshal.schedule(b, [], [Waiting(2, 1, r.bytes, false, hour, 20)], 0), [long(2)])
  // and nothing that reserves memory starts beside it
  assertEq(marshal.schedule(b, [Started(2, 1, r.bytes, false, 0, hour)], [Waiting(3, 1, M, false, hour, 30)], 0), [])

@test("a running job holds its reservation, or its measured memory where that is more")
holding()
  assertEq(marshal.holding(0, 0), 0)
  assertEq(marshal.holding(30 * G, 0), 30 * G)
  assertEq(marshal.holding(30 * G, 2 * G), 30 * G)
  assertEq(marshal.holding(0, 27 * G), 27 * G)
  assertEq(marshal.holding(10 * G, 27 * G), 27 * G)

@test("admission counts measured memory: a job reserving nothing but holding 27G keeps a 30G job out of 56G")
resvAdmission()
  val b = Budget(12, 56 * G)
  val big = Waiting(2, 1, 30 * G, false, hour, 20)
  val heavy = Started(1, 1, marshal.holding(0, 27 * G), false, 0, hour)
  assertEq(marshal.schedule(b, [heavy], [big], 0), [])
  val light = Started(1, 1, marshal.holding(0, 26 * G), false, 0, hour)
  assertEq(marshal.schedule(b, [light], [big], 0), [long(2)])
  // two learned 30G builds are not admitted together; two small jobs are
  assertEq(
    marshal.schedule(b, [], [Waiting(1, 1, 30 * G, false, hour, 10), Waiting(2, 1, 30 * G, false, hour, 20)], 0),
    [long(1)]
  )
  assertEq(
    marshal.schedule(b, [], [Waiting(1, 1, G, false, hour, 10), Waiting(2, 1, G, false, hour, 20)], 0),
    [long(1), long(2)]
  )

@test("a command with history in its directory learns from that; without, from the command anywhere")
dirHistory()
  val small: Vector[long] = [G, 2 * G]
  val big: Vector[long] = [26 * G, 20 * G, G, 2 * G]
  assertEq(marshal.memoryHistory(learning0, small, big), MemoryHistory(small, "cmd+dir"))
  assertEq(marshal.memoryHistory(learning0, [G], big), MemoryHistory([G], "cmd+dir"))
  assertEq(marshal.memoryHistory(learning0, [], big), MemoryHistory(big, "cmd"))
  // peaks of 0 are not history
  assertEq(marshal.memoryHistory(learning0, [0, 0], big), MemoryHistory(big, "cmd"))
  // a command never run reserves nothing: there is no wider fallback
  val fresh = marshal.memoryHistory(learning0, [], [])
  assertEq(fresh.from, "cmd")
  assertEq(marshal.reservationFor(learning0, 0, false, fresh.peaks, 60 * G), Reservation(0, false))
  assertEq(marshal.reservationSource(0, false, Reservation(0, false), fresh.from), "none")
  // the directory's estimate is the same rule: the most of its last five, a tenth more
  assertEq(marshal.learnedPeak(learning0, small), Some(2 * G + 205 * M))
  // the minimum follows the learning's minRuns
  assertEq(marshal.memoryHistory(MemoryLearning(5, 2, 10), [G], big).from, "cmd")
  assertEq(marshal.memoryHistory(MemoryLearning(5, 2, 10), small, big).from, "cmd+dir")
  assertEq(marshal.memoryHistory(MemoryLearning(5, 3, 10), small, big).from, "cmd")

@test("keys are kind, lane and command, then directory; a kind alone is never a key")
dirKey()
  assertEq(marshal.memoryKey("test", false, "sysl test ."), "test\nsysl test .")
  assertEq(marshal.memoryKey("test", true, "sysl test ."), "test+landing\nsysl test .")
  assertEq(marshal.memoryDirKey("test", false, "sysl test .", "/a"), "test\nsysl test .\n/a")
  assert(marshal.memoryDirKey("test", false, "s", "/a") != marshal.memoryDirKey("test", false, "s", "/b"), "dirs")
  assert(
    marshal.memoryKey("test", false, "sysl test .") != marshal.memoryKey("test", false, "sysl test compiler"),
    "targets"
  )
  assertEq(
    marshal.memoryKeys("test", false, ["sysl", "test", "."], "/a"),
    ["test\nsysl test .", "test\nsysl test .\n/a"]
  )
  assertEq(marshal.memoryKeys("test", false, ["sysl", "test", "."], ""), ["test\nsysl test ."])
  // a command with no signature teaches nothing, the kind included
  assertEq(marshal.memoryKeys("test", false, [], "/a"), [])
  assertEq(marshal.memoryKeys("test", false, ["env", "A=1"], "/a"), [])

@test("where a reservation came from: given (--mem, 0 among them) wins, else the key learned from, else none")
resvSource()
  val learned = Reservation(22 * G, true)
  assertEq(marshal.reservationSource(4 * G, true, Reservation(4 * G, false), "cmd+dir"), "given")
  assertEq(marshal.reservationSource(0, true, Reservation(0, false), "cmd+dir"), "given")
  assertEq(marshal.reservationSource(4 * G, false, Reservation(4 * G, false), "cmd"), "given")
  assertEq(marshal.reservationSource(0, false, learned, "cmd+dir"), "cmd+dir")
  assertEq(marshal.reservationSource(0, false, learned, "cmd"), "cmd")
  assertEq(marshal.reservationSource(0, false, Reservation(0, false), "cmd"), "none")

// An ending event of job `id` of kind `test` running `cmd` (a JSON array, or none), in `dir` (none
// for an event that names no directory).
peakEvent(
    id: long,
    peak: long,
    dir: Option[string],
    cmd: Option[string] = Some("[\"sysl\",\"test\",\".\"]")
) -> string =
  val d = dir.map(x -> s",\"dir\":\"$x\"").getOrElse("")
  val c = cmd.map(x -> s",\"cmd\":$x").getOrElse("")
  s"{\"ts\":1,\"event\":\"finished\",\"id\":$id,\"kind\":\"test\",\"landing\":false$d$c,\"exit\":0,\"run_ms\":10,\"peak_rss\":$peak}"

@test(
  "the log's peaks are recovered under the recorded command and under it in each directory; no kind-wide key"
)
recoverDirPeaks()
  val sig = marshal.memoryKey("test", false, "sysl test .")
  val r = marshal.recover(
    [
      peakEvent(1, 26 * G, Some("/c")),
      peakEvent(2, G, Some("/g")),
      peakEvent(3, 25 * G, Some("/c")),
      peakEvent(4, 2 * G, Some("/g")),
      peakEvent(5, 3 * G, None),
      peakEvent(6, 0, Some("/g")),
      peakEvent(7, 30 * G, Some("/c"), Some("[\"/w/sysl-x/stage1\",\"test\",\"compiler\",\"--jobs\",\"4\"]"))
    ]
  )
  assertEq(r.peaks.get(sig), Some([26 * G, G, 25 * G, 2 * G, 3 * G]))
  assertEq(r.peaks.get(marshal.memoryDirKey("test", false, "sysl test .", "/c")), Some([26 * G, 25 * G]))
  assertEq(r.peaks.get(marshal.memoryDirKey("test", false, "sysl test .", "/g")), Some([G, 2 * G]))
  assertEq(r.peaks.get(marshal.memoryKey("test", false, "stage1 test compiler")), Some([30 * G]))
  assertEq(r.peaks.get("test"), None)
  // events without a command (none was ever recorded without one, but a hand-edited log may) teach
  // nothing; those without a directory teach their command
  val old = marshal.recover([peakEvent(1, 26 * G, None, None), peakEvent(2, 20 * G, None)])
  assertEq(old.peaks.keys.toVector, [sig])
  assertEq(old.peaks(sig), [20 * G])
  // a command that is not an array of strings teaches nothing either
  assertEq(marshal.recover([peakEvent(1, G, None, Some("\"sysl test\""))]).peaks.isEmpty, true)

job(memory: long, reserved: long, learned: bool) -> JobInfo =
  JobInfo(
    1,
    "build",
    1,
    memory,
    false,
    "/",
    ["true"],
    "queued",
    None,
    false,
    0,
    0,
    0,
    "/l",
    None,
    reserved = reserved,
    reservedLearned = learned
  )

@test("RESV shows a learned reservation with ~, a given one exactly, and none as -")
resvText()
  assertEq(marshal.reservedText(job(0, 22 * G, true)), "~22G")
  assertEq(marshal.reservedText(job(0, 3 * G + 512 * M, true)), "~3.5G")
  assertEq(marshal.reservedText(job(29 * G, 29 * G, false)), "29G")
  assertEq(marshal.reservedText(job(0, 0, false)), "-")
  // a job from a daemon that sent no reservation shows the memory it declared
  assertEq(marshal.reservedText(job(512 * M, 0, false)), "512M")

@test("a job's resv_from reads back; one that is \"\" is left out, and a listing without it reads as \"\"")
resvFromProtocol()
  for from in ["given", "cmd+dir", "cmd", "none", "kind+dir", "kind"]
    val j = JobInfo(
      1,
      "build",
      1,
      0,
      false,
      "/",
      ["true"],
      "queued",
      None,
      false,
      0,
      0,
      0,
      "/l",
      None,
      reserved = 22 * G,
      reservedLearned = true,
      reservedFrom = from
    )
    assertEq(marshal.encodeJob(j)("resv_from").asString, Some(from))
    assertEq(marshal.decodeReply(marshal.encodeReply(Reply.Jobs([j])).render), Ok(Reply.Jobs([j])))
  val unsaid = marshal.encodeJob(job(0, 22 * G, true))
  assert(!unsaid.render.contains("resv_from"), unsaid.render)
  assertEq(marshal.decodeJob(unsaid).map(j -> j.reservedFrom), Ok(""))
  assert(
    marshal.decodeJob(
      json.parse(unsaid.render.replace("\"resv\":", "\"resv_from\":7,\"resv\":")).ok.get
    ).err.exists(e -> e.contains("`resv_from` is not a string"))
  )

@test("a job's reservation and learned mark, the held memory and the memory-given flag read back")
protocol()
  for (r, learned) in [(long(0), false), (22 * G, true), (long.MaxValue, true)]
    val reply = Reply.Jobs([job(0, r, learned)])
    assertEq(marshal.decodeReply(marshal.encodeReply(reply).render), Ok(reply))
  val j = marshal.encodeJob(job(0, 22 * G, true))
  assertEq((j("resv").asLong, j("resv_learned").asBool), (Some(22 * G), Some(true)))
  // a job from a daemon that sent no reservation reserves the memory it declared
  val old = marshal.encodeJob(job(3 * G, 0, false)).render.replace(",\"resv\":0,\"resv_learned\":false", "")
  assert(!old.contains("resv"), old)
  assertEq(marshal.decodeReply(s"{\"ok\":true,\"job\":$old}"), Ok(Reply.Ended(job(3 * G, 3 * G, false))))
  val u = Usage(1, 12, 30 * G, 56 * G, 1, 0, None, None, 27 * G, 64 * G, false, 57 * G)
  assertEq(marshal.decodeReply(marshal.encodeReply(Reply.Using(u)).render), Ok(Reply.Using(u)))
  // a snapshot counts its running and queued jobs from its lists
  val view = Reply.Viewed(
    Overview(Usage(0, 12, 30 * G, 56 * G, 0, 0, None, None, 27 * G, 64 * G, false, 57 * G), 0, [], [], [])
  )
  assertEq(marshal.decodeReply(marshal.encodeReply(view).render), Ok(view))
  assertEq(marshal.statusJson(u, [])("mem_held").asLong, Some(57 * G))
  for given in [false, true]
    val r = Request.Submit(JobSpec("build", 1, 0, false, "/", None, ["make"], [], memoryGiven = given))
    assertEq(marshal.decodeRequest(marshal.encodeRequest(r).render), Ok(r))
  // a submit from a client that does not say reads as not given
  assertEq(
    marshal.decodeRequest(
      "{\"op\":\"submit\",\"kind\":\"build\",\"units\":1,\"mem\":0,\"dir\":\"/\",\"cmd\":[\"make\"]}"
    ),
    Ok(Request.Submit(JobSpec("build", 4, 0, false, "/", None, ["make"], [])))
  )
  assert(
    marshal.decodeRequest(
      "{\"op\":\"submit\",\"kind\":\"build\",\"units\":1,\"mem\":0,\"dir\":\"/\",\"cmd\":[\"make\"],\"mem_given\":3}"
    ).err.get.contains("`mem_given` is not a bool")
  )
