module tests

// End to end, why a queued job waits as `ls` and `status --json` say it. The helpers are e2e.avin's
// and control_e2e.avin's.
import json.Json

// The `ls` row of job `id`.
lsRowOf(home: string, id: long) -> string
    val r = m(home, "ls")
    assertEq(r.code, 0)
    r.out.lines().toVector.find(l -> l.startsWith(id.toString() + " ")).getOrElse(s"no row for $id in ${r.out}")

// The queued job `id` as `status --json` gives it.
lsQueuedJson(home: string, id: long) -> Json = statusJsonOf(home)("queued").asVector().get().find(q -> q("id").asLong() == Some(id)).get()

@test("a job short of units says so in ls and in status --json, and a running job says nothing")
noUnitsE2e()
    val home = newHome("{\"units\": 1}")
    val busy = submitted(home, "--units", "1", "--", "sleep", "30")
    assert(within(2000, () -> started(home, busy)))
    val queued = submitted(home, "--units", "1", "--", "sleep", "30")
    assert(lsRowOf(home, queued).contains("queued (no units)"), lsRowOf(home, queued))
    assertEq(lsQueuedJson(home, queued)("why").asString(), Some("units"))
    assert(!lsQueuedJson(home, queued).has("behind"))
    assert(!lsRowOf(home, busy).contains("("), lsRowOf(home, busy))
    assert(!statusJsonOf(home)("running").asVector().get()(0).has("why"))
    m(home, "stop", "--force")
    cleanUp(home)

@test("a job short of memory says memory")
noMemoryE2e()
    val home = newHome("{\"memory\": \"1G\"}")
    val busy = submitted(home, "--mem", "600M", "--", "sleep", "30")
    assert(within(2000, () -> started(home, busy)))
    val queued = submitted(home, "--mem", "600M", "--", "sleep", "30")
    assert(lsRowOf(home, queued).contains("queued (no memory)"), lsRowOf(home, queued))
    assertEq(lsQueuedJson(home, queued)("why").asString(), Some("memory"))
    m(home, "stop", "--force")
    cleanUp(home)

@test("a draining landing job and the job behind it say draining and behind")
drainingE2e()
    val home = newHome("{\"memory\": \"1G\"}")
    val a = submitted(home, "--mem", "600M", "--", "sleep", "30")
    assert(within(2000, () -> started(home, a)))
    val land = submitted(home, "--landing", "--mem", "600M", "--", "sleep", "1")
    val b = submitted(home, "--mem", "100M", "--", "sleep", "1")
    assert(lsRowOf(home, land).contains("queued (draining)"), lsRowOf(home, land))
    assert(lsRowOf(home, b).contains(s"queued (behind $land)"), lsRowOf(home, b))
    assertEq(lsQueuedJson(home, land)("why").asString(), Some("draining"))
    assertEq(lsQueuedJson(home, b)("why").asString(), Some("behind"))
    assertEq(lsQueuedJson(home, b)("behind").asLong(), Some(land))
    m(home, "stop", "--force")
    cleanUp(home)

@test("a landing job while the lane is held says lane")
laneE2e()
    val home = newHome("{\"memory\": \"1G\"}")
    val first = submitted(home, "--landing", "--mem", "300M", "--", "sleep", "30")
    assert(within(2000, () -> started(home, first)))
    val second = submitted(home, "--landing", "--mem", "300M", "--", "sleep", "30")
    assert(lsRowOf(home, second).contains("queued (lane busy)"), lsRowOf(home, second))
    assertEq(lsQueuedJson(home, second)("why").asString(), Some("lane"))
    m(home, "stop", "--force")
    cleanUp(home)

@test("a held job says held with no reason in ls, and why held in status --json")
heldE2e()
    val home = newHome("{\"units\": 1}")
    val busy = submitted(home, "--units", "1", "--", "sleep", "30")
    assert(within(2000, () -> started(home, busy)))
    val queued = submitted(home, "--units", "1", "--", "sleep", "30")
    assertEq(m(home, "hold", queued.toString()).code, 0)
    assert(!lsRowOf(home, queued).contains("("), lsRowOf(home, queued))
    assert(lsRowOf(home, queued).contains("held"), lsRowOf(home, queued))
    assertEq(lsQueuedJson(home, queued)("why").asString(), Some("held"))
    m(home, "stop", "--force")
    cleanUp(home)

@test("a held queue says queue held in ls and queue-held in status --json, and an empty queue has no why anywhere")
queueHeldE2e()
    val home = newHome("{\"units\": 4}")
    assertEq(statusJsonOf(home)("queued").asVector().get().length, 0)
    assertEq(m(home, "pause").code, 0)
    val queued = submitted(home, "--", "sleep", "30")
    assert(lsRowOf(home, queued).contains("queued (queue held)"), lsRowOf(home, queued))
    assertEq(lsQueuedJson(home, queued)("why").asString(), Some("queue-held"))
    m(home, "stop", "--force")
    cleanUp(home)

@test("the reason survives marshal restart")
restartE2e()
    val home = newHome("{\"units\": 1}")
    val busy = submitted(home, "--units", "1", "--", "sleep", "30")
    assert(within(2000, () -> started(home, busy)))
    val queued = submitted(home, "--units", "1", "--", "sleep", "30")
    restarted(home)
    assert(within(5000, () -> lsRowOf(home, queued).contains("queued (no units)")), lsRowOf(home, queued))
    assertEq(lsQueuedJson(home, queued)("why").asString(), Some("units"))
    m(home, "stop", "--force")
    cleanUp(home)
