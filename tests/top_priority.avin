module tests

// `marshal top`'s keys that place a queued job (u, w, n, +, -), without a terminal: what each asks
// of the daemon, what it says of a job that is not queued, the bottom line naming them after its
// other keys, and the selection following a job that moved.
import dev.avinlang.marshal
import dev.avinlang.marshal.{Request, JobInfo, Outcome, Overview, QueuedJob, Why}
import dev.avinlang.marshal.top.{Action, App, Ask, Stay}
import dev.avinlang.tui.{Down, Grid, Up}

// The keys the bottom line always names, as it reads.
val FooterLine: string = "hHelp EnterLog kKill pHold fFilter oOwner qQuit"

// The keys that place a queued job, as the bottom line reads after `FooterLine` and a space.
val PlaceLine: string = "uUrgent wLow nNormal +-Move"

// The bottom line's keys while a queued job is selected: 75 cells and the space that ends them.
val PlacingLine: string = FooterLine + " " + PlaceLine

// A job as a snapshot gives it, with what places it in the queue.
private placedInfo(
    id: long,
    state: string = "queued",
    urgent: bool = false,
    low: bool = false,
    priority: int = 0,
    held: bool = false
) -> JobInfo =
  JobInfo(
    id,
    "build",
    4,
    0,
    false,
    "/w",
    ["sleep", "30"],
    state,
    None,
    false,
    0,
    minuteMs,
    20 * minuteMs,
    s"/h/jobs/$id.log",
    None,
    held = held,
    priority = priority,
    urgent = urgent,
    low = low
  )

private inQueue(jobs: Vector[JobInfo]) -> Vector[QueuedJob] = jobs.zipWithIndex.map(
  p -> QueuedJob(p.0, p.1 + 1, if p.0.held then Why.Held else Why.NoUnits)
)

// A running job (1), then queued ones: 3, 4 at priority 4, 5 urgent, 6 low and 7 held; a job
// waiting for another (8) and an ended one (9).
private placeable() -> Overview = Overview(
  full().usage,
  0,
  [snapJob(1)],
  inQueue(
    [
      placedInfo(3),
      placedInfo(4, priority = 4),
      placedInfo(5, urgent = true),
      placedInfo(6, low = true),
      placedInfo(7, held = true)
    ]
  ),
  [snapJob(9, "done", Some(Outcome.Exited(0)))],
  [placedInfo(8, "waiting")]
)

// The action `c` gives with the job at line `at` selected, and the view after it.
private pressAt(at: int, c: char) -> (Action, App)
  val app = viewing(placeable())
  for _ in 0 ..< at
    app.handle(press(Down))
  (app.handle(key(c)), app)

@test("u makes the selected queued job urgent, with no question")
placeUrgent()
  val (a, app) = pressAt(1, 'u')
  assertEq(a, Ask(Request.Prioritize(3, marshal.Urgent), "3 urgent"))
  assertEq(app.confirming, None)
  assertEq(app.message, "")

@test("w makes the selected queued job low, with no question")
placeLow()
  val (a, app) = pressAt(1, 'w')
  assertEq(a, Ask(Request.Prioritize(3, marshal.LowBand), "3 low"))
  assertEq(app.confirming, None)

@test("n makes the selected queued job normal by giving it the priority it has, whatever band it is in")
placeNormal()
  assertEq(pressAt(1, 'n').0, Ask(Request.Prioritize(3, marshal.Level(0)), "3 normal"))
  assertEq(pressAt(2, 'n').0, Ask(Request.Prioritize(4, marshal.Level(4)), "4 normal"))
  assertEq(pressAt(3, 'n').0, Ask(Request.Prioritize(5, marshal.Level(0)), "5 normal"))
  assertEq(pressAt(4, 'n').0, Ask(Request.Prioritize(6, marshal.Level(0)), "6 normal"))

@test("+ moves the selected queued job up one place")
placeUp()
  assertEq(pressAt(2, '+').0, Ask(Request.Prioritize(4, marshal.OneUp), "4 moved up"))

@test("- moves the selected queued job down one place")
placeDown()
  assertEq(pressAt(2, '-').0, Ask(Request.Prioritize(4, marshal.OneDown), "4 moved down"))

@test("urgent then normal, and low then urgent, each ask the daemon for just that")
placeInTurn()
  val app = viewing(placeable())
  app.handle(press(Down))
  assertEq(app.handle(key('u')), Ask(Request.Prioritize(3, marshal.Urgent), "3 urgent"))
  assertEq(app.handle(key('n')), Ask(Request.Prioritize(3, marshal.Level(0)), "3 normal"))
  assertEq(app.handle(key('w')), Ask(Request.Prioritize(3, marshal.LowBand), "3 low"))
  assertEq(app.handle(key('u')), Ask(Request.Prioritize(3, marshal.Urgent), "3 urgent"))

@test("a held queued job is placed as any other: the keys ask the same of it")
placeHeld()
  assertEq(pressAt(5, 'u').0, Ask(Request.Prioritize(7, marshal.Urgent), "7 urgent"))
  assertEq(pressAt(5, 'w').0, Ask(Request.Prioritize(7, marshal.LowBand), "7 low"))
  assertEq(pressAt(5, 'n').0, Ask(Request.Prioritize(7, marshal.Level(0)), "7 normal"))
  assertEq(pressAt(5, '+').0, Ask(Request.Prioritize(7, marshal.OneUp), "7 moved up"))
  assertEq(pressAt(5, '-').0, Ask(Request.Prioritize(7, marshal.OneDown), "7 moved down"))

@test("each key on a running job asks nothing and says only a queued job is placed")
placeRunning()
  for c in ['u', 'w', 'n']
    val (a, app) = pressAt(0, c)
    assertEq(a, Stay)
    assertEq(app.message, "job 1 is running: only a queued job is given a priority")
  for c in ['+', '-']
    val (a, app) = pressAt(0, c)
    assertEq(a, Stay)
    assertEq(app.message, "job 1 is running: only a queued job is moved")

@test("each key on a job that has ended asks nothing and says so")
placeEnded()
  for c in ['u', 'w', 'n', '+', '-']
    val (a, app) = pressAt(7, c)
    assertEq(a, Stay)
    assertEq(app.message, "job 9 has already ended")

@test("each key on a job that waits for another asks nothing and says it is not queued yet")
placeWaiting()
  for c in ['u', 'w', 'n']
    val (a, app) = pressAt(6, c)
    assertEq(a, Stay)
    assertEq(app.message, "job 8 is not queued yet: only a queued job is given a priority")
  for c in ['+', '-']
    val (a, app) = pressAt(6, c)
    assertEq(a, Stay)
    assertEq(app.message, "job 8 is not queued yet: only a queued job is moved")

@test("each key with no job selected, or no snapshot, asks nothing")
placeNothing()
  for c in ['u', 'w', 'n', '+', '-']
    val empty = viewing(Overview(full().usage, 0, [], [], []))
    assertEq(empty.handle(key(c)), Stay)
    assertEq(empty.message, "no job selected")
    val none = App("/h/sock")
    assertEq(none.handle(key(c)), Stay)

@test("the keys do nothing under the kill dialog or the help")
placeUnderOverlays()
  val app = viewing(placeable())
  app.handle(press(Down))
  app.handle(key('k'))
  for c in ['u', 'w', '+', '-']
    assertEq(app.handle(key(c)), Stay)
  assert(app.confirming.isDefined)
  val helped = viewing(placeable())
  helped.handle(press(Down))
  helped.handle(key('h'))
  assertEq(helped.handle(key('u')), Stay)
  assertEq(helped.message, "")

// A view of `placeable` with the job at line `at` selected.
private selecting(at: int) -> App
  val app = viewing(placeable())
  for _ in 0 ..< at
    app.handle(press(Down))
  app

// A running job (1) and 39 queued ones (2 to 40): more than a screen of 20 rows lists.
private longQueue() -> Overview =
  Overview(full().usage, 0, [snapJob(1)], inQueue((2 .. 40).map(i -> placedInfo(long(i))).toVector), [])

// The rows of `g` above its bottom line.
private aboveBottom(g: Grid) -> Vector[string] = (0 ..< g.height - 1).map(y -> g.rowText(y)).toVector

// `app` drawn 80 by 20 an hour after its last key, when the highlight has hidden.
private drawnIdle(app: App) -> Grid
  val g = Grid(80, 20)
  app.draw(g, 0, 60 * minuteMs)
  g

@test("while a queued job is selected the bottom line names the placing keys after q Quit, one space between")
placeKeysOnBottomLine()
  val g = drawn(selecting(1), 80, 20)
  assertEq(g.rowText(19).trim, PlacingLine)
  // every queued job has them: urgent, low and held ones too
  for at in 1 .. 5
    assertEq(drawn(selecting(at), 80, 20).rowText(19).trim, PlacingLine)
  // they are named once, on the bottom line: every row above reads as with the running job selected
  assertEq(rowOf(g, "uUrgent"), 19)
  assertEq(aboveBottom(g), aboveBottom(drawn(selecting(0), 80, 20)))
  // with more jobs than rows, the row above the bottom line is a job's
  val on = viewing(longQueue())
  on.handle(press(Down))
  val long_ = drawn(on, 80, 20)
  assert(long_.rowText(19).startsWith(PlacingLine), long_.rowText(19))
  val listed = long_.rowText(18)
  assert(listed.trim.nonEmpty && !listed.contains("Urgent"), listed)
  assertEq(listed, drawn(viewing(longQueue()), 80, 20).rowText(18))
  assert(listed.trim.startsWith((18 - rowOf(long_, "STATE")).toString() + " "), listed)

@test("a running, waiting or ended job, a hidden highlight, no jobs and no snapshot leave the bottom line without the placing keys")
placeKeysHide()
  for at in [0, 6, 7]
    val g = drawn(selecting(at), 80, 20)
    assertEq(rowOf(g, "Urgent"), -1)
    assertEq(g.rowText(19).trim, FooterLine)
  val empty = drawn(viewing(Overview(full().usage, 0, [], [], [])), 80, 20)
  assertEq(rowOf(empty, "Urgent"), -1)
  assertEq(empty.rowText(19).trim, FooterLine)
  val none = drawn(App("/h/sock"), 80, 20)
  assertEq(rowOf(none, "Urgent"), -1)
  assertEq(none.rowText(19).trim, FooterLine)
  // a queued job whose highlight has hidden: the keys go with the highlight and come back with it
  val idle = selecting(1)
  assertEq(drawn(idle, 80, 20).rowText(19).trim, PlacingLine)
  val hidden = drawnIdle(idle)
  assertEq(rowOf(hidden, "Urgent"), -1)
  assertEq(hidden.rowText(19).trim, FooterLine)
  assertEq(aboveBottom(hidden), aboveBottom(drawn(selecting(1), 80, 20)))
  idle.handle(press(Down), 60 * minuteMs)
  val back = Grid(80, 20)
  idle.draw(back, 0, 60 * minuteMs)
  assertEq(idle.selected().map(j -> j.id), Some(long(3)))
  assertEq(back.rowText(19).trim, PlacingLine)

@test("the list has the same rows whether or not the placing keys show")
placeKeysTakeNoRow()
  val off = viewing(longQueue())
  val on = viewing(longQueue())
  on.handle(press(Down))
  val without = drawn(off, 80, 20)
  val with_ = drawn(on, 80, 20)
  val heading = rowOf(without, "STATE")
  assertEq(off.page, 19 - heading - 1)
  assertEq(on.page, off.page)
  assertEq(rowOf(with_, "STATE"), heading)
  assertEq(aboveBottom(with_), aboveBottom(without))
  // hidden, the highlight leaves the list its rows too
  val idle = viewing(longQueue())
  idle.handle(press(Down))
  assertEq(aboveBottom(drawnIdle(idle)), aboveBottom(without))
  assertEq(idle.page, off.page)
  // a short list: as many rows of jobs under a queued, a running, a waiting and an ended selection
  for at in [1, 5, 6, 7]
    assertEq(aboveBottom(drawn(selecting(at), 80, 20)), aboveBottom(drawn(selecting(0), 80, 20)))

@test("moving the selection from a queued job to a running one and back takes the placing keys away and brings them back, and no row shifts")
placeKeysComeAndGo()
  val app = viewing(longQueue())
  val start = drawn(app, 80, 20)
  assert(!start.rowText(19).contains("Urgent"), start.rowText(19))
  assert(start.rowText(19).startsWith(FooterLine), start.rowText(19))
  app.handle(press(Down))
  val queued = drawn(app, 80, 20)
  assert(queued.rowText(19).startsWith(PlacingLine), queued.rowText(19))
  assertEq(aboveBottom(queued), aboveBottom(start))
  app.handle(press(Up))
  val running = drawn(app, 80, 20)
  assertEq(running.rowText(19), start.rowText(19))
  assertEq(aboveBottom(running), aboveBottom(start))
  app.handle(press(Down))
  val again = drawn(app, 80, 20)
  assertEq(again.rowText(19), queued.rowText(19))
  assertEq(aboveBottom(again), aboveBottom(start))
  // onto the next queued job: the keys stay
  app.handle(press(Down))
  assert(drawn(app, 80, 20).rowText(19).startsWith(PlacingLine))

@test("a screen narrower than the keys cuts the bottom line at its width, the placing keys first, and wraps nothing")
placeKeysNarrow()
  for w in [1, 5, 7, 8, 12, 20, 24, 26, 40, 47, 48, 49, 50, 56, 60, 75, 76, 77, 80, 100]
    val g = drawn(selecting(1), w, 20)
    assertEq(g.rowText(19).trim, PlacingLine.take(w).trim)
    // nothing of the keys stands on the row above
    assertEq(aboveBottom(g), aboveBottom(drawn(selecting(0), w, 20)))
    // up to the width of the other keys and their space, the line is the one a running job has
    if w <= FooterLine.charCount + 1 then assertEq(g.rowText(19), drawn(selecting(0), w, 20).rowText(19))
  // what shows at the widths the goldens are drawn at
  assertEq(drawn(selecting(1), 24, 20).rowText(19).trim, "hHelp EnterLog kKill pHo")
  assertEq(drawn(selecting(1), 40, 20).rowText(19).trim, "hHelp EnterLog kKill pHold fFilter oOwne")
  assertEq(drawn(selecting(1), 60, 20).rowText(19).trim, "hHelp EnterLog kKill pHold fFilter oOwner qQuit uUrgent wLow")
  assertEq(drawn(selecting(1), 80, 20).rowText(19).trim, PlacingLine)

@test("a screen of any height names the placing keys on its last row only, and the rows above are those a running job has")
placeKeysShort()
  for h in 2 .. 20
    val g = drawn(selecting(1), 80, h)
    assertEq(g.rowText(h - 1).trim, PlacingLine)
    assertEq(rowOf(g, "uUrgent"), h - 1)
    // the heading stands where it does with the running job selected, and as many rows follow it
    val queued = selecting(1)
    val running = selecting(0)
    assertEq(rowOf(drawn(queued, 80, h), "STATE"), rowOf(drawn(running, 80, h), "STATE"))
    assertEq(queued.page, running.page)
  // one row: the bottom line is the screen
  assertEq(drawn(selecting(1), 80, 1).rowText(0), drawn(selecting(1), 80, 20).rowText(19))

@test("the daemon's answer stands at the right end of the room the placing keys leave: whole on a wide screen, cut on a narrow one")
placeMessage()
  val app = selecting(1)
  app.message = "3 moved up"
  // 120 columns: the keys, and the answer whole at the right end
  val wide = drawn(app, 120, 20).rowText(19)
  assert(wide.startsWith(PlacingLine + "  ") && wide.endsWith(" 3 moved up"), wide)
  assertEq(wide.charCount, 120)
  // 80 columns: the keys take 76 cells and a space, so three cells of the answer show
  val g = drawn(app, 80, 20)
  assert(g.rowText(19).startsWith(PlacingLine + " "), g.rowText(19))
  assert(!g.rowText(19).contains("3 moved up"), g.rowText(19))
  assert(g.rowText(19).trim.charCount > PlacingLine.charCount, g.rowText(19))
  assertEq(aboveBottom(g), aboveBottom(drawn(selecting(0), 80, 20)))
  // the same answer under a running job, where the keys are not named, is whole at 80 columns
  val running = selecting(0)
  running.message = "3 moved up"
  val whole = drawn(running, 80, 20).rowText(19).trim
  assert(whole.startsWith(FooterLine + " ") && whole.endsWith(" 3 moved up"), whole)
  app.message = "job 3 is first in its band"
  val refused = drawn(app, 120, 20).rowText(19).trim
  assert(refused.startsWith(PlacingLine + " ") && refused.endsWith(" job 3 is first in its band"), refused)

@test("with the placing keys showing, the answer is cut before the scroll position goes, and the position goes whole before any key")
placeKeysMessageAndPosition()
  val app = viewing(longQueue())
  app.handle(press(Down))
  drawn(app, 140, 20)
  val position = app.position
  assert(position.nonEmpty && position.contains("of 40"), position)
  val answer = "job 2 is first in its band"
  app.message = answer
  // room for all three: the keys, the answer, the position at the right end
  val wide = drawn(app, 140, 20).rowText(19)
  assert(wide.startsWith(PlacingLine + " ") && wide.contains(" " + answer + " "), wide)
  assert(wide.endsWith(position), wide)
  // less room: the position is whole and the answer is cut to the ten cells left between
  val keys = PlacingLine.charCount + 1
  val width = keys + 1 + 10 + 1 + position.charCount
  val cut = drawn(app, width, 20).rowText(19)
  assert(cut.startsWith(PlacingLine + " ") && cut.contains(" job 2 is"), cut)
  assert(!cut.contains(answer), cut)
  assert(cut.endsWith(" " + position), cut)
  // the position needs two cells after the keys: with one fewer it goes, and the answer has the room
  val least = keys + 2 + position.charCount
  assert(drawn(app, least, 20).rowText(19).endsWith(position))
  val gone = drawn(app, least - 1, 20).rowText(19)
  assert(!gone.contains("of 40"), gone)
  assert(gone.startsWith(PlacingLine + " ") && gone.contains(" job 2 is"), gone)
  // 80 columns: the keys whole, no position, three cells of the answer
  val eighty = drawn(app, 80, 20).rowText(19)
  assert(eighty.startsWith(PlacingLine + " "), eighty)
  assert(!eighty.contains("of 40"), eighty)
  // under the running job the same screen has the position and fifteen cells of the answer
  app.handle(press(Up))
  app.message = answer
  val running = drawn(app, 80, 20).rowText(19)
  assert(running.startsWith(FooterLine + "  job 2 is first"), running)
  assert(running.endsWith(app.position) && app.position.contains("of 40"), running)

@test("the log pane is as tall and stands on the same rows under a queued job as under a running one")
placeKeysWithLog()
  val queued = selecting(1)
  queued.handle(key('l'))
  val g = drawn(queued, 100, 30)
  assert(g.rowText(29).startsWith(PlacingLine), g.rowText(29))
  assertEq(rowOf(g, "uUrgent"), 29)
  val running = selecting(0)
  running.handle(key('l'))
  val r = drawn(running, 100, 30)
  assert(r.rowText(29).startsWith(FooterLine), r.rowText(29))
  assertEq(rowOf(r, "Urgent"), -1)
  val top_ = rowOf(g, "job 3 log")
  assert(top_ > 0, top_.toString())
  assertEq(top_, rowOf(r, "job 1 log"))
  // the pane's box ends on the row above the bottom line in both
  assert(g.rowText(28).trim.startsWith("╰") && r.rowText(28).trim.startsWith("╰"), g.rowText(28))
  assertEq(queued.logRows, running.logRows)

// `placeable` with its queue in the order `ids`, job 3 marked as `urgent` and `low` say.
private reordered(ids: Vector[long], urgent: bool = false, low: bool = false) -> Overview
  val o = placeable()
  val jobs = ids.map(id -> if id == 3 then placedInfo(id, urgent = urgent, low = low) else o.queued.find(q -> q.job.id == id).get.job)
  Overview(o.usage, 0, o.running, inQueue(jobs), o.recent, o.waiting)

@test("the selection stays on a job that moved, wherever the next snapshot lists it")
placeSelectionFollows()
  val app = selecting(2)
  assertEq(app.selected().map(j -> j.id), Some(long(4)))
  app.handle(key('+'))
  drawn(app, 80, 20)
  app.update(reordered([4, 3, 5, 6, 7]))
  assertEq(app.selected().map(j -> j.id), Some(long(4)))
  assertEq(app.table.selected, 1)
  app.handle(key('-'))
  app.handle(key('-'))
  drawn(app, 80, 20)
  app.update(reordered([3, 5, 6, 4, 7]))
  assertEq(app.selected().map(j -> j.id), Some(long(4)))
  assertEq(app.table.selected, 4)

@test("a job moved from the first line is followed too, though a view left on the first line otherwise stays there")
placeSelectionFollowsFromTop()
  val queue = Overview(full().usage, 0, [], inQueue([placedInfo(3), placedInfo(4), placedInfo(5)]), [])
  val app = viewing(queue)
  assertEq(app.selected().map(j -> j.id), Some(long(3)))
  app.handle(key('-'))
  drawn(app, 80, 20)
  app.update(Overview(full().usage, 0, [], inQueue([placedInfo(4), placedInfo(3), placedInfo(5)]), []))
  assertEq(app.selected().map(j -> j.id), Some(long(3)))
  assertEq(app.table.selected, 1)
  // without a placing key the first line stays selected as jobs change under it
  val left = viewing(queue)
  drawn(left, 80, 20)
  left.update(Overview(full().usage, 0, [], inQueue([placedInfo(4), placedInfo(3), placedInfo(5)]), []))
  assertEq(left.selected().map(j -> j.id), Some(long(4)))

@test("a job made urgent or low shows its mark in KIND at the next snapshot, and no mark when normal again")
placeMarks()
  val app = selecting(1)
  val before = drawn(app, 120, 20)
  val first = before.rowText(app.table.selected + rowOf(before, "COMMAND") + 1)
  assert(!first.contains("build!") && !first.contains("build~"), first)
  app.handle(key('u'))
  drawn(app, 120, 20)
  app.update(reordered([5, 3, 4, 6, 7], urgent = true))
  val urgent = drawn(app, 120, 20)
  assertEq(app.selected().map(j -> j.id), Some(long(3)))
  assert(urgent.rowText(app.table.selected + rowOf(urgent, "COMMAND") + 1).contains("build!"), urgent.rowText(4))
  app.handle(key('w'))
  app.update(reordered([5, 4, 6, 3, 7], low = true))
  val low = drawn(app, 120, 20)
  assertEq(app.selected().map(j -> j.id), Some(long(3)))
  assert(low.rowText(app.table.selected + rowOf(low, "COMMAND") + 1).contains("build~"), low.rowText(4))
  app.handle(key('n'))
  app.update(reordered([5, 3, 4, 6, 7]))
  val normal = drawn(app, 120, 20)
  val row = normal.rowText(app.table.selected + rowOf(normal, "COMMAND") + 1)
  assert(!row.contains("build!") && !row.contains("build~"), row)

@test("the help lists the keys that place a queued job")
placeHelp()
  val app = viewing(placeable())
  app.handle(key('h'))
  val g = drawn(app, 120, 34)
  assert(rowOf(g, "u  w  n  +  -   a queued job: urgent, low, normal; + - one place up or down") >= 0)
  // the help is no longer than it was: a screen of 30 rows still shows its last line
  val small = drawn(app, 120, 30)
  assert(rowOf(small, "OWNER who it is for; disk low: under disk_min, nothing starts.") >= 0)

// The full daemon's view with its first queued job (10) selected.
private onQueued() -> App
  val app = viewing(full())
  app.handle(press(Down))
  app.handle(press(Down))
  app

@test("golden: the placing keys on the bottom line at 80 columns and narrower, on a short screen, with a message, and under the help")
goldenPlaceKeys()
  for (w, h) in [(80, 18), (60, 16), (40, 12), (24, 12)]
    golden(s"place-keys-$w", drawn(onQueued(), w, h))
  golden("place-keys-short", drawn(onQueued(), 80, 7))
  val app = onQueued()
  app.message = "10 moved up"
  golden("place-keys-message", drawn(app, 80, 18))
  app.handle(key('h'))
  golden("place-keys-help", drawn(app, 80, 34))
