module tests

// `marshal wait <id> [--timeout <t>]` against a real daemon: the timeout before or after the id, a
// job that outlasts it (124), a job that ends first (its own status), and the refusals. The helpers
// are those of e2e.avin and control_e2e.avin.
import avin.time
import avin.time.millis
import avin.threads

@test("wait <id> --timeout that expires says so on one line and exits 124, the job still running")
waitJobTimeoutExpires()
    val home = daemonHome()
    val id = submitted(home, "--", "sleep", "30")
    val began = time.monotonic()
    val r = m(home, "wait", id.toString(), "--timeout", "1s")
    assertEq(r.code, 124)
    assert(r.out.contains(s"timed out after 1.0s waiting for job $id"), r.out)
    val took = (time.monotonic() - began).toMillis
    assert(took >= 900 && took < 8000, s"took $took ms")
    assertEq(r.out.trim.lines.toVector.length, 1)
    assertEq(m(home, "status").code, 0)
    assert(m(home, "ls").out.contains("running"), "the job goes on running")
    assertEq(m(home, "kill", id.toString()).code, 0)
    cleanUp(home)

@test("wait --timeout <t> <id>: the option before the id is the same wait")
waitJobTimeoutFirst()
    val home = daemonHome()
    val id = submitted(home, "--", "sleep", "30")
    val r = m(home, "wait", "--timeout", "1s", id.toString())
    assertEq(r.code, 124)
    assert(r.out.contains(s"waiting for job $id"), r.out)
    assertEq(m(home, "kill", id.toString()).code, 0)
    cleanUp(home)

@test("wait <id> --timeout where the job ends first exits with the job's status, either option position")
waitJobEndsFirst()
    val home = daemonHome()
    val ok = submitted(home, "--", "sh", "-c", "sleep 0.5; exit 0")
    val r = m(home, "wait", ok.toString(), "--timeout", "30s")
    assertEq(r.code, 0)
    assert(!r.out.contains("timed out"), r.out)
    val bad = submitted(home, "--", "sh", "-c", "sleep 0.5; exit 3")
    val b = m(home, "wait", "--timeout", "30s", bad.toString())
    assertEq(b.code, 3)
    assert(!b.out.contains("timed out"), b.out)
    cleanUp(home)

@test("wait <id> --timeout on a job that has already ended answers at once with its status")
waitJobAlreadyEnded()
    val home = daemonHome()
    val id = submitted(home, "--", "sh", "-c", "exit 4")
    assertEq(m(home, "wait", id.toString()).code, 4)
    val r = m(home, "wait", id.toString(), "--timeout", "1s")
    assertEq(r.code, 4)
    assert(!r.out.contains("timed out"), r.out)
    cleanUp(home)

@test("wait <id> --timeout for a job nobody numbered is answered, not timed out")
waitJobUnknown()
    val home = daemonHome()
    val r = m(home, "wait", "99", "--timeout", "5s")
    assertEq(r.code, 2)
    assert(r.out.contains("no job 99") && !r.out.contains("timed out"), r.out)
    cleanUp(home)

@test("wait <id> refuses a bad timeout, a repeated one, a missing value, --since, other options and two ids")
waitJobRefusals()
    val home = daemonHome()
    val id = submitted(home, "--", "true")
    val n = id.toString()
    refusedWith(m(home, "wait", n, "--timeout", "soon"), "`--timeout soon`: a timeout is minutes")
    refusedWith(m(home, "wait", "--timeout", "-5s", n), "a timeout is minutes")
    refusedWith(m(home, "wait", n, "--timeout", "1s", "--timeout", "2s"), "--timeout is given twice")
    refusedWith(m(home, "wait", n, "--timeout"), "--timeout needs a value")
    refusedWith(m(home, "wait", n, "--since", "1"), "--since goes with wait --until")
    refusedWith(m(home, "wait", "--since", "1m", n), "--since goes with wait --until")
    refusedWith(m(home, "wait", n, "--bogus"), "takes --timeout, not `--bogus`")
    refusedWith(m(home, "wait", n, n), "give one job id")
    refusedWith(m(home, "wait", n, "--timeout", "1s", n), "give one job id")
    refusedWith(m(home, "wait", "--timeout", "1s"), "give one job id")
    refusedWith(m(home, "wait", "abc", "--timeout", "1s"), "`abc` is not a job id")
    refusedWith(m(home, "wait"), "give one job id")
    cleanUp(home)

@test("wait --help describes --timeout with an id and --since with --until only")
waitJobHelp()
    val home = newHome()
    val r = m(home, "wait", "--help")
    assertEq(r.code, 0)
    assert(r.out.contains("--timeout also with an id") && r.out.contains("--since only here"), r.out)
    cleanUp(home)
