module tests

// The line protocol: every request and reply reads back as itself, and malformed text is refused
// with a reason.
import dev.avinlang.marshal
import dev.avinlang.marshal.{JobInfo, JobSpec, Outcome, Overview, QueuedJob, Reply, Request, Usage, Why}
import json

val spec: JobSpec = JobSpec("test", 4, 29 * 1024 * 1024 * 1024, false, "/work/dir", Some(90000), ["sysl", "test", "compiler", "--timeout", "1800"], [("PATH", "/bin"), ("LANG", "")])

roundTrip(r: Request) = assertEq(marshal.decodeRequest(marshal.encodeRequest(r).render()), Ok(r))

replyRoundTrip(r: Reply) = assertEq(marshal.decodeReply(marshal.encodeReply(r).render()), Ok(r))

job(state: string, outcome: Option[Outcome], sample: Option[string] = None) -> JobInfo =
    JobInfo(7, "build", 1, 0, true, "/d", ["sh", "-c", "exit 3"], state, outcome, false, 12, 3400, 1200000, "/h/jobs/7.log", sample)

@test("every request reads back as itself")
requests()
    roundTrip(Request.Submit(spec))
    roundTrip(Request.Submit(JobSpec("build", 1, 0, true, "/", None, ["make"], [])))
    roundTrip(Request.Wait(1))
    roundTrip(Request.Wait(long.MaxValue))
    roundTrip(Request.Kill(42))
    roundTrip(Request.List)
    roundTrip(Request.Status)
    roundTrip(Request.Stop(false, false))
    roundTrip(Request.Stop(true, false))
    roundTrip(Request.Stop(false, true))
    roundTrip(Request.Hello)
    roundTrip(Request.Restart)

@test("a command's words keep quotes, new lines, empty words and characters beyond ASCII")
awkwardWords()
    roundTrip(Request.Submit(JobSpec("é", 1, 0, false, "/tmp/ü dir", None, ["sh", "-c", "echo \"a\\b\"\n\t", "", "日本 😀"], [("X", "a=b")])))

@test("every reply reads back as itself")
replies()
    replyRoundTrip(Reply.Submitted(3, "/h/jobs/3.log"))
    replyRoundTrip(Reply.Done)
    replyRoundTrip(Reply.Hi("0.1.0", 501))
    replyRoundTrip(Reply.Hi("", long.MaxValue))
    replyRoundTrip(Reply.Failed("no job 9"))
    replyRoundTrip(Reply.Failed(""))
    replyRoundTrip(Reply.Using(Usage(8, 12, 30, 64, 3, 2, Some(5), None)))
    replyRoundTrip(Reply.Using(Usage(0, 12, 0, 0, 0, 0, None, None)))
    replyRoundTrip(Reply.Using(Usage(0, 12, 0, 0, 0, 0, None, Some(marshal.TakeSlotUse("/ü dir/.git", 7, 2, true)))))
    replyRoundTrip(Reply.Using(Usage(0, 12, 0, 0, 0, 0, None, Some(marshal.TakeSlotUse("", 0, 0, false)))))
    replyRoundTrip(Reply.Jobs([]))
    replyRoundTrip(Reply.Jobs([job("queued", None), job("running", None)]))
    for o in [Outcome.Exited(0), Outcome.Exited(255), Outcome.Signalled(9), Outcome.TimedOut, Outcome.Cancelled, Outcome.Lost]
        replyRoundTrip(Reply.Ended(job("done", Some(o))))
    replyRoundTrip(Reply.Ended(job("done", Some(Outcome.TimedOut), Some("/h/jobs/7.sample.txt"))))

@test("a request is one line: rendered JSON holds no line break")
oneLine()
    val text = marshal.encodeRequest(Request.Submit(JobSpec("k", 1, 0, false, "/", None, ["a\nb"], [("V", "x\ny")]))).render()
    assert(!text.contains("\n"))

@test("text that is not a request is refused with a reason")
badRequests()
    val cases = [
        ("", "not JSON"),
        ("[1]", "a request is a JSON object"),
        ("{}", "`op` is missing"),
        ("{\"op\": 1}", "`op` is not a string"),
        ("{\"op\": \"dance\"}", "no such request: `dance`"),
        ("{\"op\": \"wait\"}", "`id` is missing"),
        ("{\"op\": \"wait\", \"id\": \"7\"}", "`id` is not a whole number"),
        ("{\"op\": \"kill\", \"id\": 1.5}", "`id` is not a whole number"),
        ("{\"op\": \"submit\", \"kind\": \"x\", \"units\": 1, \"mem\": 0, \"dir\": \"/\", \"cmd\": []}", "`cmd` is empty"),
        ("{\"op\": \"submit\", \"kind\": \"x\", \"units\": 1, \"mem\": 0, \"dir\": \"/\", \"cmd\": [1]}", "`cmd` is not an array of strings"),
        ("{\"op\": \"submit\", \"kind\": \"x\", \"units\": 1, \"mem\": 0, \"cmd\": [\"a\"]}", "`dir` is missing"),
        ("{\"op\": \"submit\", \"kind\": \"x\", \"units\": 3000000000, \"mem\": 0, \"dir\": \"/\", \"cmd\": [\"a\"]}", "`units` is not an int"),
        ("{\"op\": \"submit\", \"kind\": \"x\", \"units\": 1, \"mem\": 0, \"dir\": \"/\", \"cmd\": [\"a\"], \"env\": {\"A\": 1}}", "`env` is not an object of strings"),
        ("{\"op\": \"stop\", \"force\": \"yes\"}", "`force` is not a bool")]
    for (text, why) in cases
        marshal.decodeRequest(text) match
            Err(e) -> assert(e.contains(why), s"$text: $e")
            Ok(r) -> fail(s"$text read as $r")

@test("absent optional fields take their defaults, and null is absent")
requestDefaults()
    assertEq(marshal.decodeRequest("{\"op\": \"submit\", \"kind\": \"x\", \"units\": 1, \"mem\": 0, \"dir\": \"/\", \"cmd\": [\"a\"]}"), Ok(Request.Submit(JobSpec("x", 1, 0, false, "/", None, ["a"], []))))
    assertEq(marshal.decodeRequest("{\"op\": \"submit\", \"kind\": \"x\", \"units\": 1, \"mem\": 0, \"dir\": \"/\", \"cmd\": [\"a\"], \"landing\": null, \"deadline_ms\": null}"), Ok(Request.Submit(JobSpec("x", 1, 0, false, "/", None, ["a"], []))))
    assertEq(marshal.decodeRequest("{\"op\": \"stop\"}"), Ok(Request.Stop(false, false)))
    assertEq(marshal.decodeRequest(" {\"op\": \"ls\", \"extra\": true} "), Ok(Request.List))

@test("a reply that is not one is refused")
badReplies()
    assert(marshal.decodeReply("").isErr())
    assert(marshal.decodeReply("{}").isErr())
    assert(marshal.decodeReply("{\"ok\": false}").isErr())
    assert(marshal.decodeReply("{\"ok\": true, \"job\": {\"id\": 1}}").isErr())
    assert(marshal.decodeReply("{\"ok\": true, \"job\": {\"id\": 1, \"kind\": \"k\", \"units\": 1, \"mem\": 0, \"landing\": false, \"dir\": \"/\", \"cmd\": [], \"state\": \"done\", \"outcome\": {\"how\": \"melted\"}, \"killed\": false, \"queued_ms\": 0, \"elapsed_ms\": 0, \"deadline_ms\": 0, \"log\": \"l\"}}").isErr())

@test("each outcome's exit status: the code, 128 + the signal, 124, 143 and 125")
exitCodes()
    assertEq(marshal.exitCode(Outcome.Exited(0)), 0)
    assertEq(marshal.exitCode(Outcome.Exited(3)), 3)
    assertEq(marshal.exitCode(Outcome.Exited(255)), 255)
    assertEq(marshal.exitCode(Outcome.Signalled(9)), 137)
    assertEq(marshal.exitCode(Outcome.Signalled(15)), 143)
    assertEq(marshal.exitCode(Outcome.TimedOut), 124)
    assertEq(marshal.exitCode(Outcome.Cancelled), 143)
    assertEq(marshal.exitCode(Outcome.Lost), 125)

// A snapshot with `running` and `queued` jobs and `recent` ones, its counts their lengths.
overview(running: Vector[JobInfo], queued: Vector[QueuedJob], recent: Vector[JobInfo], landing: Option[long] = None,
         takeSlot: Option[marshal.TakeSlotUse] = None) -> Overview =
    Overview(Usage(5, 12, 1024, 4096, running.length(), queued.length(), landing, takeSlot), 3723000, running, queued, recent)

val everyWhy: Vector[Why] = [Why.NoUnits, Why.NoMemory, Why.LaneBusy, Why.ForTakeSlot, Why.Behind(3), Why.Behind(long.MaxValue), Why.Starting]

// A running job measured at `rss` with a peak of `peak`, started at `at`.
measuredJob(rss: long, peak: long, at: long = 1762521060000) -> JobInfo =
    JobInfo(7, "build", 1, 0, false, "/d", ["make"], "running", None, false, 12, 3400, 1200000, "/h/jobs/7.log", None, rss, peak, at)

@test("a job's memory as measured and its start read back, from none to the largest")
measuredReplies()
    for (rss, peak) in [(long(0), long(0)), (long(1), long(1)), (long(500), long(812) * 1024 * 1024), (long.MaxValue, long.MaxValue)]
        replyRoundTrip(Reply.Ended(measuredJob(rss, peak)))
        replyRoundTrip(Reply.Jobs([measuredJob(rss, peak), job("queued", None)]))
    val j = marshal.encodeJob(measuredJob(4096, 8192))
    assertEq(j("rss").asLong(), Some(long(4096)))
    assertEq(j("peak_rss").asLong(), Some(long(8192)))
    assertEq(j("started_at").asLong(), Some(long(1762521060000)))
    // a queued job has not started and holds nothing
    val q = marshal.encodeJob(job("queued", None))
    assertEq((q("rss").asLong(), q("peak_rss").asLong(), q("started_at").asLong()), (Some(long(0)), Some(long(0)), Some(long(0))))

@test("the budget's measured memory and the machine's read back in status and snapshot replies")
measuredUsage()
    val u = Usage(8, 12, 30, 64, 3, 2, Some(5), None, long(9) * 1024 * 1024 * 1024, long(64) * 1024 * 1024 * 1024)
    replyRoundTrip(Reply.Using(u))
    replyRoundTrip(Reply.Viewed(Overview(Usage(1, 12, 0, long.MaxValue, 1, 0, None, None, 123456789, 0), 0, [measuredJob(123456789, 223456789)], [], [])))
    val status = marshal.statusJson(u, [measuredJob(100, 200), job("queued", None)])
    assertEq(status("rss").asLong(), Some(9 * long(1024) * 1024 * 1024))
    assertEq(status("machine_mem").asLong(), Some(64 * long(1024) * 1024 * 1024))
    val running = status("running").asVector().get()(0)
    assertEq(running("rss").asLong(), Some(long(100)))
    assertEq(running("peak_rss").asLong(), Some(long(200)))
    assertEq(status("queued").asVector().get()(0)("peak_rss").asLong(), Some(long(0)))
    // a reply from a daemon that measured nothing reads as none measured and the machine unknown
    assertEq(marshal.decodeReply("{\"ok\":true,\"units\":0,\"unit_budget\":12,\"mem\":0,\"mem_budget\":0,\"running\":0,\"queued\":0,\"landing\":null,\"take_slot\":null}"),
             Ok(Reply.Using(Usage(0, 12, 0, 0, 0, 0, None, None))))

@test("the snapshot request reads back as itself and is written as op snapshot")
snapshotRequest()
    roundTrip(Request.Snapshot)
    assertEq(marshal.encodeRequest(Request.Snapshot).render(), "{\"op\":\"snapshot\"}")
    assertEq(marshal.decodeRequest("{\"op\": \"snapshot\", \"extra\": 1}"), Ok(Request.Snapshot))

@test("every snapshot reads back as itself: empty, every reason to wait, take-slot or none, a landing job")
snapshotReplies()
    replyRoundTrip(Reply.Viewed(overview([], [], [])))
    val queued = everyWhy.zipWithIndex().map(w -> QueuedJob(job("queued", None), w.1 + 1, w.0))
    replyRoundTrip(Reply.Viewed(overview([job("running", None)], queued, [job("done", Some(Outcome.Lost)), job("done", Some(Outcome.Exited(1)))], Some(7))))
    replyRoundTrip(Reply.Viewed(overview([], [], [], None, Some(marshal.TakeSlotUse("/s/.git", 4, 1, true)))))
    replyRoundTrip(Reply.Viewed(Overview(Usage(0, 12, 0, long.MaxValue, 0, 0, None, None), 0, [], [], [])))

@test("a snapshot's queued job is the job's own fields plus position, waits and, behind a job, behind")
snapshotWire()
    val text = marshal.encodeReply(Reply.Viewed(overview([], [QueuedJob(job("queued", None), 2, Why.Behind(5)), QueuedJob(job("queued", None), 3, Why.ForTakeSlot)], []))).render()
    assert(!text.contains("\n"))
    val j = json.parse(text).ok().get()
    val s = j("snapshot")
    assertEq(s("uptime_ms").asLong(), Some(long(3723000)))
    assertEq(s("unit_budget").asInt(), Some(12))
    val q = s("queued").asVector().get()
    assertEq(q(0)("id").asLong(), Some(long(7)))
    assertEq(q(0)("position").asInt(), Some(2))
    assertEq(q(0)("waits").asString(), Some("behind"))
    assertEq(q(0)("behind").asLong(), Some(long(5)))
    assertEq(q(1)("waits").asString(), Some("take-slot"))
    assert(!q(1).has("behind"))
    assertEq(s("recent").asVector().map(v -> v.length()), Some(0))
    // a client that knows only jobs reads a queued entry as a job
    assertEq(marshal.decodeJob(q(0)), Ok(job("queued", None)))

@test("a snapshot that is not one is refused, and a status reply is still a status reply")
badSnapshots()
    val good = marshal.encodeReply(Reply.Viewed(overview([], [QueuedJob(job("queued", None), 1, Why.NoUnits)], []))).render()
    assert(marshal.decodeReply(good.replace("\"units\"}", "\"melted\"}")).isErr(), "an unknown reason")
    assert(marshal.decodeReply(good.replace("\"waits\":\"units\"", "\"waits\":\"behind\"")).isErr(), "behind with no job")
    assert(marshal.decodeReply(good.replace("\"position\":1", "\"position\":\"1\"")).isErr(), "a position that is not a number")
    assert(marshal.decodeReply("{\"ok\": true, \"snapshot\": {}}").isErr())
    assert(marshal.decodeReply("{\"ok\": true, \"snapshot\": 3}").isErr())
    // an older daemon refuses the request with a sentence the view shows
    assertEq(marshal.decodeReply("{\"ok\":false,\"error\":\"no such request: `snapshot`\"}"), Ok(Reply.Failed("no such request: `snapshot`")))
    replyRoundTrip(Reply.Using(Usage(8, 12, 30, 64, 3, 2, Some(5), None)))

@test("version and restart are requests of their op alone, and the version reply names the version and the pid")
versionAndRestart()
    assertEq(marshal.encodeRequest(Request.Hello).render(), "{\"op\":\"version\"}")
    assertEq(marshal.encodeRequest(Request.Restart).render(), "{\"op\":\"restart\"}")
    assertEq(marshal.decodeRequest("{\"op\": \"restart\", \"extra\": 1}"), Ok(Request.Restart))
    assertEq(marshal.decodeReply("{\"ok\": true, \"version\": \"0.2.0\", \"pid\": 77}"), Ok(Reply.Hi("0.2.0", 77)))
    assert(marshal.decodeReply("{\"ok\": true, \"version\": \"0.2.0\"}").isErr())
    assert(marshal.decodeReply("{\"ok\": true, \"version\": 2, \"pid\": 77}").isErr())
