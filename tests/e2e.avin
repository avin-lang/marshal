    assert(within(5000, () -> fs.readText(slots(home) + "/land.lock/pid").ok().exists(t -> t.trim() == run.pid.toString())))
    val id = submitted(home, "--landing", "--", "true")
    threads.sleep(millis(4000))
    assert(!started(home, id), "two landings at once")
    process.signal(run.pid, 15)
    assert(within(10000, () -> ended(home, id)))
    assert(!fs.exists(slots(home) + "/land.lock"))
