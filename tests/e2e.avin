@test("`help <command>` describes one command; an unknown one is refused")
helpWord()
    val home = newHome()
    val r = split(home, "help", "tail")
    assertEq(r.code, 0)
    assert(r.out.startsWith("usage: marshal tail <id> [-f] [-n <lines>]"), r.out)
    val bad = split(home, "help", "dance")
    assertEq(bad.code, 2)
    assertEq(bad.out, "")
    assert(bad.err.contains("no command `dance`"), bad.err)
    assertEq(split(home, "help", "run", "wait").code, 2)
    fs.removeDirAll(home)

@test("an unknown command is refused even with --help, and help for it is not invented")
helpOfUnknown()
