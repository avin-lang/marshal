@test("marshal's landing job keeps a take-slot landing waiting until it ends")
marshalLandingFirst()
    val home = newHome()
    val id = submitted(home, "--landing", "--", "sleep", "60")
    assert(within(2000, () -> started(home, id)))
    val run = takeSlot(home, [("LANDING", "1")], "touch", "marker")
    threads.sleep(millis(3000))
    assert(!fs.exists(home + "/marker"), "two landings at once")
    m(home, "kill", id.toString())
    assert(within(25000, () -> run.code.load() == 0), "take-slot's landing never followed")
    assert(fs.exists(home + "/marker"))
    cleanUp(home)

@test("a daemon that starts after one died removes what that one left in take-slot's directory, and only that")
restartCleansRegistrations()
    val home = newHome("{\"units\": 4}")
    val other = sleeper()
    fs.createDirAll(slots(home) + "/slot-units").ok().get()
    fs.writeText(slots(home) + s"/slot-units/${other.pid}", "0\n").ok().get()
    val id = submitted(home, "--units", "3", "--", "sleep", "60")
    assert(within(2000, () -> started(home, id)))
    val queued = submitted(home, "--units", "4", "--", "true")
    val pid = pidOf(home, id)
    val daemon = daemonPid(home)
    assert(within(2000, () -> tickets(home).exists(t -> t.endsWith(s"-$daemon"))))
    process.signal(daemon, 9).ok().get()
    process.signal(-pgidOf(home, id), 9)
    while process.signal(daemon, 0).isOk() || process.signal(pid, 0).isOk() do threads.sleep(millis(20))
    assert(held(home).contains(pid.toString()))
    assertEq(m(home, "status").code, 0)
    assertEq(held(home), [other.pid.toString()])
    assert(!tickets(home).exists(t -> t.endsWith(s"-$daemon")), tickets(home).mkString(" "))
    assert(eventsOf(home, queued).contains("lost"))
    stopSleeper(other)
    cleanUp(home)

@test("status --json is one object of the budget in use and the running and queued jobs")
statusJson()
    val home = newHome("{\"units\": 4, \"memory\": \"8G\"}")
    val running = submitted(home, "--units", "3", "--mem", "2G", "--", "sleep", "60")
    val queued = submitted(home, "--units", "2", "--", "sleep", "60")
    assert(within(2000, () -> started(home, running)))
    val r = m(home, "status", "--json")
    assertEq(r.code, 0)
    assertEq(r.out.lines().toVector().length(), 1)
    val j = json.parse(r.out).ok().get()
    assertEq(j("units").asInt(), Some(3))
    assertEq(j("unit_budget").asInt(), Some(4))
    assertEq(j("mem").asLong(), Some(long(2) * 1024 * 1024 * 1024))
    assertEq(j("running").asVector().get().map(x -> x("id").asLong().get()), [running])
    assertEq(j("queued").asVector().get().map(x -> x("id").asLong().get()), [queued])
    assertEq(j("take_slot")("dir").asString(), Some(slots(home)))
    assertEq(m(home, "status", "--yaml").code, 2)
    cleanUp(home)

// `status --json` of `home`, parsed.
statusOf(home: string) -> Json = json.parse(m(home, "status", "--json").out).ok().get()

@test("the daemon measures a running job's whole tree: rss and peak in status --json and the snapshot, the peak in its ending event")
measuredMemory()
    val home = newHome("{\"units\": 4}")
    val before = time.now().epochMillis()
    // a shell, a shell under it, and a sleep under each
    val id = submitted(home, "--units", "4", "--", "sh", "-c", "sh -c 'sleep 30 & wait' & sleep 31 & wait")
    val waiting = submitted(home, "--", "sleep", "1")
    val job = () -> statusOf(home)("running").asVector().get().find(x -> x("id").asLong() == Some(id))
    assert(within(5000, () -> job().exists(x -> x("rss").asLong().exists(n -> n > 0))), "no measurement of the running job")
    val after = time.now().epochMillis()
    val status = statusOf(home)
    val j = status("running").asVector().get()(0)
    val rss = j("rss").asLong().get()
    // the tree is four processes, each a megabyte or more
    assert(rss > long(4) * 1024 * 1024, s"$rss")
    assert(j("peak_rss").asLong().get() >= rss)
    assert(before <= j("started_at").asLong().get() <= after, j.render())
    assert(status("rss").asLong().get() > 0)
    assertEq(status("machine_mem").asLong(), process.totalMemory().ok())
    // the queued job has not started and holds nothing
    val q = status("queued").asVector().get()(0)
    assertEq((q("id").asLong(), q("rss").asLong(), q("peak_rss").asLong(), q("started_at").asLong()), (Some(waiting), Some(long(0)), Some(long(0)), Some(long(0))))
    // snapshot after snapshot, the peak never goes down and is never below what is held now
    var peak: long = 0
    for _ in 0 ..< 4
        val o = snapshotOf(home)
        val r = o.running.find(x -> x.id == id).get()
        assert(r.peakRss >= peak && r.peakRss >= r.rss && r.rss > 0, s"${r.rss} ${r.peakRss} after $peak")
        assertEq(o.usage.rss, r.rss)
        assertEq(Some(o.usage.machineMemory), process.totalMemory().ok())
        peak = r.peakRss
        threads.sleep(millis(600))
    assertEq(m(home, "kill", id.toString()).code, 0)
    m(home, "wait", id.toString())
    val ending = events(home).find(e -> e("id").asLong() == Some(id) && e("event").asString() == Some("killed")).get()
    assert(ending("peak_rss").asLong().get() >= peak, ending.render())
    assertEq(ending("rss").asLong(), Some(long(0)))
    // an ended job is shown with its peak and nothing held
    val ended = snapshotOf(home).recent.find(x -> x.id == id).get()
    assertEq((ended.rss, ended.peakRss), (long(0), ending("peak_rss").asLong().get()))
    assertEq(m(home, "wait", waiting.toString()).code, 0)
    val finished = events(home).find(e -> e("id").asLong() == Some(waiting) && e("event").asString() == Some("finished")).get()
    assert(finished.has("peak_rss"), finished.render())
    cleanUp(home)

@test("a job's peak memory and start time survive a restart, and the restarted daemon goes on measuring it")
measuredMemorySurvivesRestart()
    val home = newHome("{\"units\": 4}")
    // one sleep under the shell for five seconds, then four: the tree grows after the restart
    val id = submitted(home, "--", "sh", "-c", "sleep 40 & sleep 5; sleep 41 & sleep 42 & sleep 43 & wait")
    val job = () -> statusOf(home)("running").asVector().get().find(x -> x("id").asLong() == Some(id))
    assert(within(5000, () -> job().exists(x -> x("rss").asLong().exists(n -> n > 0))), "no measurement of the running job")
    val first = job().get()
    val startedAt = first("started_at").asLong().get()
    val peakBefore = first("peak_rss").asLong().get()
    assert(peakBefore > 0, first.render())
    assertEq(m(home, "restart").code, 0)
    // at once after the restart the job has what it had: its start and a peak no lower
    val resumed = job().get()
    assertEq(resumed("started_at").asLong(), Some(startedAt))
    assert(resumed("peak_rss").asLong().get() >= peakBefore, resumed.render())
    // and the new image measures it: the peak rises as the tree grows
    assert(within(12000, () -> job().exists(x -> x("peak_rss").asLong().exists(n -> n > peakBefore))), s"the peak stayed at $peakBefore: ${job().map(x -> x.render())}")
    assert(job().get()("rss").asLong().get() > 0)
    assertEq(m(home, "kill", id.toString()).code, 0)
    m(home, "wait", id.toString())
    val ending = events(home).find(e -> e("id").asLong() == Some(id) && e("event").asString() == Some("killed")).get()
    assert(ending("peak_rss").asLong().get() > peakBefore, ending.render())
    assertEq(snapshotOf(home).recent.find(x -> x.id == id).get().startedAt, startedAt)
    cleanUp(home)

@test("a job's start time is the same to the millisecond across any number of restarts, queued, running and ended, and in its events")
startTimeSurvivesRestarts()
    val home = newHome("{\"units\": 1}")
    val id = submitted(home, "--", "sleep", "30")
    val waiting = submitted(home, "--", "sleep", "30")
    val job = (n: long) -> statusOf(home)("running").asVector().get().find(x -> x("id").asLong() == Some(n))
    assert(within(5000, () -> job(id).exists(x -> x("started_at").asLong().exists(n -> n > 0))), "the job did not start")
    val startedAt = job(id).get()("started_at").asLong().get()
    for i in [long(0), 1, 2, 3, 4]
        threads.sleep(millis(i * 37))
        assertEq(m(home, "restart").code, 0)
        assertEq(job(id).get()("started_at").asLong(), Some(startedAt))
    assertEq(m(home, "kill", id.toString()).code, 0)
    m(home, "wait", id.toString())
    assertEq(snapshotOf(home).recent.find(x -> x.id == id).get().startedAt, startedAt)
    assertEq(m(home, "restart").code, 0)
    assertEq(snapshotOf(home).recent.find(x -> x.id == id).get().startedAt, startedAt)
    val ending = events(home).find(e -> e("id").asLong() == Some(id) && e("event").asString() == Some("killed")).get()
    assertEq(ending("started_at").asLong(), Some(startedAt))
    // the job that was queued across the restarts starts after them, at a later time
    assert(within(5000, () -> job(waiting).exists(x -> x("started_at").asLong().exists(n -> n >= startedAt))), "the queued job did not start")
    assertEq(m(home, "kill", waiting.toString()).code, 0)
    cleanUp(home)

@test("a take-slot directory that is not one keeps the daemon from starting")
missingTakeSlotDir()
    val home = newHome()
    fs.removeDir(slots(home)).ok().get()
    val r = m(home, "status")
    assertEq(r.code, 2)
    assert(r.out.contains("is not a directory"), r.out)
    fs.removeDirAll(home)

// `m` with the caller's time zone set to `zone`.
inZone(home: string, zone: string, args: string*) -> Ran = mWith(home, [("TZ", zone)], args*)

@test("history prints ENDED and reads --since in the caller's time zone, with or without daylight saving, and --json keeps the instant")
historyLocalTime()
    val home = newHome()
    val finished = (id: long, ts: long) -> marshal.eventLine(ts, "finished", marshal.JobInfo(id, "build", 4, 0, false, "/d", ["x"], "done", Some(marshal.Outcome.Exited(0)), false, 0, 1000, 60000, s"$home/jobs/$id.log", None), [("run_ms", Json.num(1000)), ("exit", Json.num(0))])
    fs.writeText(home + "/events.jsonl", finished(1, 1783182600000) + "\n" + finished(2, 1794061800000) + "\n").ok().get()
    val h = inZone(home, "America/New_York", "history")
    assert(h.out.contains("2026-11-07 09:30:00") && h.out.contains("2026-07-04 12:30:00"), h.out)
    assert(inZone(home, "Asia/Kolkata", "history").out.contains("2026-11-07 20:00:00"), inZone(home, "Asia/Kolkata", "history").out)
    assertEq(mWith(home, [("TZ", "UTC")], "history").out.contains("2026-07-04 16:30:00"), true)
    val ids = (r: Ran) -> r.out.lines().toVector().filter(l -> l.startsWith("1 ") || l.startsWith("2 ")).length()
    assertEq(ids(inZone(home, "America/New_York", "history", "--since", "2026-11-07T09:30")), 1)
    assertEq(ids(inZone(home, "America/New_York", "history", "--since", "2026-11-07T09:31")), 0)
    assertEq(ids(inZone(home, "America/New_York", "history", "--since", "2026-07-04T12:30")), 2)
    assertEq(ids(inZone(home, "America/New_York", "history", "--since", "2026-07-04T12:31")), 1)
    assertEq(ids(inZone(home, "Asia/Kolkata", "history", "--since", "2026-11-07T20:00")), 1)
    assertEq(ids(inZone(home, "Asia/Kolkata", "history", "--since", "2026-11-07T14:30")), 1)
    assertEq(ids(inZone(home, "America/New_York", "history", "--since", "2026-11-07T14:30")), 0)
    assertEq(ids(inZone(home, "America/New_York", "history", "--since", "2026-11-07T14:30Z")), 1)
    assertEq(ids(inZone(home, "Asia/Kolkata", "history", "--since", "2026-11-07T14:31Z")), 0)
    assertEq(ids(inZone(home, "America/New_York", "history", "--since", "2026-11-07T16:30+02:00")), 1)
    assertEq(ids(inZone(home, "America/New_York", "history", "--since", "2026-11-07T16:31+02:00")), 0)
    assertEq(inZone(home, "America/New_York", "history", "--json").out, inZone(home, "Asia/Kolkata", "history", "--json").out)
    assert(inZone(home, "America/New_York", "history", "--json").out.contains("\"ended_at\":1794061800000"), inZone(home, "America/New_York", "history", "--json").out)

@test("history refuses a bad --since date, offset included, and says so on standard error")
historyBadSince()
    val home = newHome()
    fs.writeText(home + "/events.jsonl", "").ok().get()
    for bad in ["2026-11-07T14:30+2", "2026-11-07T14:30+25:00", "2026-11-07Z", "2026-13-07", "soon"] do
        val r = mWith(home, [("TZ", "America/New_York")], "history", "--since", bad)
        assertEq(r.code, 2)
        assert(r.out.contains("is not a time"), r.out)
        assertEq(mWith(home, [("TZ", "UTC")], "stats", "--since", bad).code, 2)

@test("history and stats read the log with no daemon running, start none, and skip and count a corrupt line")
historyNoDaemon()
    val home = newHome()
    val finished = (id: long, kind: string, run: long, exit: int) -> marshal.eventLine(1794061800000 + id * 1000, "finished", marshal.JobInfo(id, kind, 4, 0, false, "/d", ["x"], "done", Some(marshal.Outcome.Exited(exit)), false, 0, run, 60000, s"$home/jobs/$id.log", None), [("run_ms", Json.num(run)), ("exit", Json.num(exit))])
    fs.writeText(home + "/events.jsonl", finished(1, "build", 2000, 0) + "\nthis is not json\n" + finished(2, "test", 5000, 1) + "\n" + finished(3, "test", 7000, 0) + "\n").ok().get()
    val h = mWith(home, [("TZ", "UTC")], "history")
    assertEq(h.code, 0)
    assert(h.out.contains("ID  KIND"), h.out)
    assert(h.out.contains("ENDED") && !h.out.contains("(UTC)"), h.out)
    assert(h.out.contains("skipped 1 lines"), h.out)
    val rows = h.out.lines().toVector().filter(l -> l.nonEmpty() && !l.startsWith("marshal:") && !l.startsWith("ID"))
    assertEq(rows.length(), 3)
    assert(rows(0).startsWith("3 "), rows(0))
    assert(rows(0).contains("2026-11-07 14:30:03"), rows(0))
    assert(rows(1).contains("failed") && rows(1).contains("5.0s"), rows(1))
    assertEq(m(home, "history", "--failed").out.lines().toVector().filter(l -> l.startsWith("2 ")).length(), 1)
    assert(!m(home, "history", "--failed").out.contains("build"))
    assertEq(m(home, "history", "--kind", "build", "--limit", "5").out.lines().toVector().filter(l -> l.startsWith("1 ")).length(), 1)
    assert(m(home, "history", "--since", "2030-01-01").out.contains("no ended jobs match"))
    assert(mWith(home, [("TZ", "UTC")], "history", "--since", "2026-11-07T14:30").out.contains("2026-11-07 14:30:03"))
    val s = m(home, "stats", "--json")
    assertEq(s.code, 0)
    val parsed = json.parse(s.out.lines().toVector()(0)).ok().get()
    assertEq(parsed("unreadable").asLong(), Some(long(1)))
    val kinds = parsed("kinds").asVector().get()
    assertEq(kinds.map(k -> k("kind").asString().get()), ["build", "test"])
    assertEq(kinds(1)("count").asLong(), Some(long(2)))
    assertEq(kinds(1)("success_pct").asLong(), Some(long(50)))
    assertEq(kinds(1)("p50_ms").asLong(), Some(long(5000)))
    assertEq(kinds(1)("peak_max"), Json.Null)
    assert(m(home, "stats", "--kind", "test").out.contains("50%"))
    assert(!fs.exists(home + "/sock"), "history started a daemon")
    fs.removeDirAll(home)

@test("history and stats on a home with no log say nothing matched; bad options exit 2")
historyEmptyAndRefusals()
    val home = newHome()
    val r = m(home, "history")
    assertEq(r.code, 0)
    assert(r.out.contains("no ended jobs match"), r.out)
    assert(m(home, "stats", "--json").out.contains("{\"kinds\":[],\"unreadable\":0}"))
    for args in [["history", "--bogus"], ["history", "--since", "soon"], ["history", "--limit", "0"], ["history", "--kind"], ["stats", "--failed"], ["stats", "--limit", "3"], ["history", "7"]] do
        val bad = m(home, args*)
        assert(bad.code == 2, args.mkString(" ") + ": " + bad.out)
        assert(bad.out.contains("marshal: "), bad.out)
    assert(m(home, "history", "--help").out.contains("--since"))
    assert(m(home, "stats", "--help").out.contains("--kind"))
    assert(!fs.exists(home + "/sock"), "history started a daemon")
    fs.removeDirAll(home)

@test("history and stats list jobs the daemon ran, and still list them after a restart")
historyAfterJobsAndRestart()
    val home = newHome()
    assertEq(m(home, "run", "--kind", "build", "--", "true").code, 0)
    assertEq(m(home, "run", "--kind", "test", "--", "sh", "-c", "exit 3").code, 3)
    val before = m(home, "history")
    assertEq(before.code, 0)
    val rows = before.out.lines().toVector().filter(l -> l.startsWith("1 ") || l.startsWith("2 "))
    assertEq(rows.length(), 2)
    assert(rows(0).startsWith("2 ") && rows(0).contains("failed") && rows(0).contains("3"), rows(0))
    assert(rows(1).startsWith("1 ") && rows(1).contains("ok"), rows(1))
    assertEq(m(home, "history", "--failed").out.lines().toVector().filter(l -> l.startsWith("1 ")).length(), 0)
    assertEq(m(home, "restart").code, 0)
    assertEq(m(home, "history").out, before.out)
    assertEq(m(home, "run", "--kind", "build", "--", "true").code, 0)
    val s = json.parse(m(home, "stats", "--json").out.lines().toVector()(0)).ok().get()
    val kinds = s("kinds").asVector().get()
    assertEq(kinds.map(k -> k("kind").asString().get()), ["build", "test"])
    assertEq(kinds(0)("count").asLong(), Some(long(2)))
    assertEq(kinds(0)("success_pct").asLong(), Some(long(100)))
    assertEq(kinds(1)("success_pct").asLong(), Some(long(0)))
    cleanUp(home)

// A process that does nothing but stand in for the test process that owns a home.
startOwner() -> process.Child = Command("sleep", "120").start().ok().get()

// Ends `owner` by SIGKILL, as a killed test run would be, and reaps it.
killOwner(owner: process.Child)
    process.signal(owner.pid(), 9)
    owner.waitFor()
    ()

@test("the teardown ends the daemon of a home whose owner is gone, and removes the home")
reapsDeadOwner()
    val owner = startOwner()
    val home = newHome()
    register(home, owner.pid())
    assertEq(m(home, "status").code, 0)
    val daemon = daemonPid(home)
    killOwner(owner)
    assert(reapOrphans() >= 1, "nothing was reaped")
    assert(process.signal(daemon, 0).isErr(), "the daemon is still running")
    assert(!fs.exists(home), "the home is still there")
    assert(!fs.exists(entryOf(home)), "the registry entry is still there")

@test("the teardown leaves a home whose owner is still running, and a home it cannot read")
reapLeavesLiveOwner()
    val home = newHome()
    assertEq(m(home, "status").code, 0)
    val daemon = daemonPid(home)
    reapOrphans()
    assert(process.signal(daemon, 0).isOk(), "a live test's daemon was ended")
    assert(fs.exists(home + "/sock"))
    fs.writeText(registry() + "/garbage-entry", "").ok().get()
    reapOrphans()
    assert(process.signal(daemon, 0).isOk(), "an empty entry ended a daemon")
    fs.remove(registry() + "/garbage-entry")
    cleanUp(home)

@test("a daemon whose owner is killed stops by itself, with its job and its followers")
daemonStopsWithOwner()
    val owner = startOwner()
    val home = newHome()
    val watch = [("MARSHAL_TEST_WATCH_PID", owner.pid().toString())]
    assertEq(mWith(home, watch, "status").code, 0)
    val daemon = daemonPid(home)
    val id = submitted(home, "--", "sleep", "60")
    val following = startM(home, [], "events", "--follow")
    assert(within(5000, () -> started(home, id)), "the job did not start")
    killOwner(owner)
    assert(within(5000, () -> process.signal(daemon, 0).isErr()), "the daemon is still running")
    assert(within(5000, () -> process.signal(following.pid, 0).isErr()), "events --follow is still running")
    assertEq(eventsOf(home, id), ["submitted", "started", "killed"])
    fs.removeDirAll(home)
    fs.remove(entryOf(home))
