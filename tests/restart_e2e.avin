module tests

// End to end, `marshal restart` while something else still answers at the daemon's socket: what a
// child the old image was starting does, forked but not yet running its program, since it holds a
// copy of the old image's listener until then. The helpers are e2e.avin's and quiet_e2e.avin's.
import avin.fs
import avin.net.{UnixListener, UnixStream}
import avin.process.{Command, ExitStatus}
import avin.threads
import avin.threads.spawn
import avin.time
import avin.time.millis
import avin.json.Json

// The restart request a client sends, naming `program`.
restartRequest(program: string) -> string = Json.obj(("op", Json.str("restart")), ("program", Json.str(program))).render + "\n"

@test("a restarted image takes over its socket's path even while another listener still answers there")
restartTakesOverSocket()
    val home = newHome()
    val id = submitted(home, "--", "sleep", "30")
    val before = daemonPid(home)
    val conn = UnixStream.connect(home + "/sock").ok.get
    // the path answers for a listener that is not the new image's, as the old one's copy does
    fs.remove(home + "/sock")
    val stray = UnixListener.bind(home + "/sock").ok.get
    conn.writeText(restartRequest(bin())).ok.get
    // the old image goes without a reply
    assertEq(conn.readLine().ok.flatten, None)
    conn.close()
    assert(daemonSaid(home, s"daemon $before restarted", 10000), daemonLog(home))
    assert(!daemonLog(home).contains("another daemon is listening"), daemonLog(home))
    assert(m(home, "version").out.contains(s"daemon $before: marshal"), daemonLog(home))
    assertEq(daemonPid(home), before)
    assert(m(home, "ls").out.contains("running"))
    stray.close()
    assertEq(m(home, "kill", id.toString()).code, 0)
    cleanUp(home)

@test("restart asks again when its first connection to the restarted daemon closes unanswered")
restartAsksAgain()
    val home = newHome()
    // the daemon restarts as a script that runs marshal once the test says so
    val go = home + "/go"
    val wrapper = home + "/marshal-later"
    fs.writeText(wrapper, s"#!/bin/sh\nwhile [ ! -f '$go' ]; do sleep 0.05; done\nexec '${bin()}' \"$$@\"\n").ok.get
    assertEq(Command("chmod", "+x", wrapper).run().ok, Some(ExitStatus.Exited(0)))
    assertEq(mWith(home, [("MARSHAL_RESTART_PROGRAM", wrapper)], "submit", "--", "sleep", "30").code, 0)
    val before = daemonPid(home)
    val client = spawn(() -> m(home, "restart"))
    assert(daemonSaid(home, "restarting as", 10000), daemonLog(home))
    // the old image is gone and the new one waits: the client's next connection reaches a
    // listener that closes it unanswered
    fs.remove(home + "/sock")
    val stray = UnixListener.bind(home + "/sock").ok.get
    val answered = stray.accept().ok.get
    answered.close()
    stray.close()
    fs.remove(home + "/sock")
    fs.writeText(go, "").ok.get
    val r = client.join()
    assertEq(r.code, 0)
    assert(r.out.contains(s"daemon $before restarted"), r.out)
    assertEq(daemonPid(home), before)
    assertEq(m(home, "kill", "1").code, 0)
    cleanUp(home)
