module tests

// Deadlines learned from recorded durations: a command's, else its kind's.
import dev.avinlang.marshal
import dev.avinlang.marshal.Learning

val minute: long = 60000
val learning: Learning = marshal.defaultLearning

// The deadline of a job whose command has `dirRuns` in its directory and `cmdRuns` anywhere; a
// kind's runs (`history`) are no key of the chain, and teach a command's deadline nothing.
private dl(
    learning: Learning,
    kind: string,
    landing: bool,
    history: Vector[long],
    dirRuns: Vector[long],
    cmdRuns: Vector[long],
    overrunMs: long
) -> marshal.LearnedDeadline = marshal.jobDeadline(learning, kind, landing, [(dirRuns, "cmd+dir"), (cmdRuns, "cmd")], overrunMs)

@test("an unseen kind has its default: build 20 min, test 45, landing 120, anything else 30")
defaults()
  assertEq(marshal.deadlineMs(learning, "build", false, []), 20 * minute)
  assertEq(marshal.deadlineMs(learning, "test", false, []), 45 * minute)
  assertEq(marshal.deadlineMs(learning, "test", true, []), 120 * minute)
  assertEq(marshal.deadlineMs(learning, "build", true, []), 120 * minute)
  assertEq(marshal.deadlineMs(learning, "docs", false, []), 30 * minute)
  assertEq(marshal.deadlineMs(learning, "", false, []), 30 * minute)

@test("too few runs keep the default")
tooFew()
  assertEq(marshal.deadlineMs(learning, "test", false, [10 * minute, 10 * minute]), 45 * minute)
  assertEq(marshal.expectedMs(learning, "test", false, [10 * minute, 10 * minute]), 45 * minute / 2)

@test("enough runs give twice their median, or half again their longest where that is later")
learned()
  assertEq(marshal.deadlineMs(learning, "test", false, [10 * minute, 12 * minute, 14 * minute]), 24 * minute)
  assertEq(marshal.deadlineMs(learning, "test", false, [10 * minute, 12 * minute, 50 * minute]), 75 * minute)
  assertEq(marshal.expectedMs(learning, "test", false, [10 * minute, 12 * minute, 50 * minute]), 12 * minute)

@test("the nex train: runs of 6 to 13 minutes do not stop a run of 13m17s")
nexTrain()
  // job 3470's key held these runs (milliseconds), its median 6m36s, so twice it was 13m11s
  val runs: Vector[long] = [
    494150, 1296502, 439729, 336661, 348378, 391987, 345402, 395938, 400588, 522998, 1573, 368784, 358564, 429649,
    359093, 395829, 424887, 777562, 597322
  ]
  val ran: long = 797106
  // by the median alone, as before
  assertEq(marshal.median(runs.takeRight(20)) * 2, 791876)
  val d = dl(learning, "train", true, runs, runs, runs, 0)
  assertEq(d, marshal.LearnedDeadline(1296502 * 3 / 2, "cmd+dir"))
  assert(d.ms > ran)
  // without the 21-minute run, the longest left (12m58s) still leaves room: 19m26s
  val later = runs.filter(r -> r != 1296502)
  assertEq(dl(learning, "train", true, [], later, [], 0).ms, 777562 * 3 / 2)
  assert(dl(learning, "train", true, [], later, [], 0).ms > ran * 14 / 10)

@test("a job's deadline is learned from its command in its directory, then anywhere, never its kind alone")
perCommand()
  val kind = Vector.fill(20, 2 * minute)
  val mine = [20 * minute, 20 * minute, 20 * minute]
  val elsewhere = [8 * minute, 8 * minute, 8 * minute]
  assertEq(
    dl(learning, "test", false, kind, mine, elsewhere, 0),
    marshal.LearnedDeadline(40 * minute, "cmd+dir")
  )
  // too few runs in its directory: its command's runs anywhere
  assertEq(
    dl(learning, "test", false, kind, mine.take(2), elsewhere, 0),
    marshal.LearnedDeadline(16 * minute, "cmd")
  )
  // too few of its command: its kind's many runs are not a key, so the kind's default
  assertEq(
    dl(learning, "test", false, kind, mine.take(2), elsewhere.take(2), 0),
    marshal.LearnedDeadline(45 * minute, "none")
  )
  // too few of anything: the kind's default
  assertEq(dl(learning, "test", false, [], [], [], 0), marshal.LearnedDeadline(45 * minute, "none"))
  assertEq(dl(learning, "train", true, [], [], [], 0), marshal.LearnedDeadline(120 * minute, "none"))
  // a kind's unrelated short runs never cut a long command's deadline
  assert(dl(learning, "test", false, kind, mine, [], 0).ms > 20 * minute)

@test("a growing suite stays inside its deadline")
growing()
  // each run a little longer than the one before it, the next as much again
  var runs = Vector[long]()
  var next: long = 6 * minute
  for _ in 0 ..< 30
    if runs.length >= 3 then assert(dl(learning, "test", false, [], runs, [], 0).ms > next, s"$next")
    runs = runs ++ [next]
    next = next + next / 10
  // runs that do not grow keep twice their median
  val steady = Vector.fill(10, 10 * minute)
  assertEq(dl(learning, "test", false, [], steady, [], 0).ms, 20 * minute)

@test("a single outlier raises the deadline to half again it, until it leaves the window")
outlier()
  val runs = Vector.fill(10, 10 * minute) ++ [60 * minute]
  assertEq(dl(learning, "test", false, [], runs, [], 0).ms, 90 * minute)
  // twenty ordinary runs later it is forgotten
  val gone = runs ++ Vector.fill(20, 10 * minute)
  assertEq(dl(learning, "test", false, [], gone, [], 0).ms, 20 * minute)

@test("a run its deadline stopped sets the next deadline at half again how long it ran")
overrun()
  val runs = [6 * minute, 6 * minute, 6 * minute]
  assertEq(dl(learning, "test", false, [], runs, [], 0).ms, 12 * minute)
  assertEq(
    dl(learning, "test", false, [], runs, [], 12 * minute),
    marshal.LearnedDeadline(18 * minute, "overrun")
  )
  // a deadline the runs give that is later already is kept
  assertEq(
    dl(learning, "test", false, [], runs, [], 4 * minute),
    marshal.LearnedDeadline(12 * minute, "cmd+dir")
  )
  // with nothing learned, the default stands unless the stopped run asks for more
  assertEq(dl(learning, "test", false, [], [], [], 45 * minute).ms, 135 * minute / 2)
  assertEq(dl(learning, "test", false, [], [], [], minute).ms, 45 * minute)
  assertEq(dl(learning, "x", false, [], [], [], long.MaxValue).ms, long.MaxValue)

@test("the margin over the longest run is configurable, and a huge longest saturates")
margin()
  val tight = Learning(20, 3, 2, 0, 100)
  assertEq(dl(tight, "test", false, [], [10, 10, 30], [], 0).ms, 30)
  assertEq(dl(learning, "test", false, [], [1, 1, long.MaxValue], [], 0).ms, long.MaxValue)

@test("a learned deadline is never below the floor")
floor()
  assertEq(marshal.deadlineMs(learning, "build", false, [1000, 1000, 1000]), 5 * minute)
  assertEq(marshal.expectedMs(learning, "build", false, [1000, 1000, 1000]), 1000)

@test("only the last window of runs is read")
window()
  val old = Vector.fill(100, 100 * minute)
  val fresh = Vector.fill(20, 10 * minute)
  assertEq(marshal.deadlineMs(learning, "test", false, old ++ fresh), 20 * minute)
  val small = Learning(3, 1, 3, 0)
  assertEq(marshal.deadlineMs(small, "x", false, [100, 1, 2, 3]), 6)

@test("the median is the middle, or the mean of the two middles, of any order")
medians()
  assertEq(marshal.median([]), 0)
  assertEq(marshal.median([7]), 7)
  assertEq(marshal.median([3, 1, 2]), 2)
  assertEq(marshal.median([4, 1, 3, 2]), 2)
  assertEq(marshal.median([1, 4]), 2)
  assertEq(marshal.median([1, 2]), 1)
  assertEq(marshal.median([long.MaxValue, long.MaxValue]), long.MaxValue)
  assertEq(marshal.median([long.MaxValue - 1, long.MaxValue]), long.MaxValue - 1)

@test("a huge median saturates the deadline rather than overflowing")
saturates()
  assertEq(marshal.deadlineMs(learning, "x", false, [long.MaxValue, long.MaxValue, long.MaxValue]), long.MaxValue)

@test("a landing run's history is kept apart from a development run's")
keys()
  assertEq(marshal.historyKey("test", false), "test")
  assertEq(marshal.historyKey("test", true), "test+landing")

@test("the deadline chain: cmd+dir, cmd, norm+project, kind+project, then the default; each key needs three runs")
deadlineChain()
  val three = (m: long) -> Vector.fill(3, m * minute)
  val chain = (dir: Vector[long], cmd: Vector[long], norm: Vector[long], kp: Vector[long]) -> [
    (dir, "cmd+dir"),
    (cmd, "cmd"),
    (norm, "norm+project"),
    (kp, "kind+project")
  ]
  assertEq(
    marshal.jobDeadline(learning, "build", false, chain(three(10), three(11), three(12), three(13)), 0),
    marshal.LearnedDeadline(20 * minute, "cmd+dir")
  )
  assertEq(
    marshal.jobDeadline(learning, "build", false, chain([], three(11), three(12), three(13)), 0),
    marshal.LearnedDeadline(22 * minute, "cmd")
  )
  // a new train script: its own name has no runs, its numbered siblings in its project have
  assertEq(
    marshal.jobDeadline(learning, "build", true, chain([], [], three(30), three(1)), 0),
    marshal.LearnedDeadline(60 * minute, "norm+project")
  )
  assertEq(
    marshal.jobDeadline(learning, "build", false, chain([], [], [minute], three(13)), 0),
    marshal.LearnedDeadline(26 * minute, "kind+project")
  )
  // two runs of each are too few anywhere: the kind's default
  val two = Vector.fill(2, 10 * minute)
  assertEq(
    marshal.jobDeadline(learning, "build", false, chain(two, two, two, two), 0),
    marshal.LearnedDeadline(20 * minute, "none")
  )
  // a key's runs spread widely are still learned from: the longest is what the deadline covers
  assertEq(
    marshal.jobDeadline(learning, "build", false, chain([], [], [], [minute, minute, 54 * minute]), 0),
    marshal.LearnedDeadline(81 * minute, "kind+project")
  )
  // a run its deadline stopped still asks for more
  assertEq(
    marshal.jobDeadline(learning, "build", false, chain([], [], three(10), []), 40 * minute),
    marshal.LearnedDeadline(60 * minute, "overrun")
  )
  assertEq(marshal.jobDeadline(learning, "build", false, [], 0), marshal.LearnedDeadline(20 * minute, "none"))

// The deadline a job of `chain` is enforced at, by `learning`.
private enforced(
    learning: Learning,
    kind: string,
    landing: bool,
    chain: Vector[(Vector[long], string)],
    overrunMs: long
) -> marshal.LearnedDeadline = marshal.enforcedDeadline(learning, kind, landing, chain, overrunMs)

private four(dir: Vector[long], cmd: Vector[long], norm: Vector[long], kp: Vector[long]) -> Vector[(Vector[long], string)] = [
  (dir, "cmd+dir"),
  (cmd, "cmd"),
  (norm, "norm+project"),
  (kp, "kind+project")
]

private threeOf(m: long) -> Vector[long] = Vector.fill(3, m * minute)

@test("a learned deadline is enforced at half again itself, at every key of the chain")
marginEveryKey()
  assertEq(learning.enforcePct, 150)
  // twice the median of 10-minute runs is 20 minutes, enforced at 30
  assertEq(
    enforced(learning, "build", false, four(threeOf(10), threeOf(11), threeOf(12), threeOf(13)), 0),
    marshal.LearnedDeadline(30 * minute, "cmd+dir")
  )
  assertEq(
    enforced(learning, "build", false, four([], threeOf(11), threeOf(12), threeOf(13)), 0),
    marshal.LearnedDeadline(33 * minute, "cmd")
  )
  assertEq(
    enforced(learning, "build", true, four([], [], threeOf(30), threeOf(1)), 0),
    marshal.LearnedDeadline(90 * minute, "norm+project")
  )
  assertEq(
    enforced(learning, "build", false, four([], [], [minute], threeOf(13)), 0),
    marshal.LearnedDeadline(39 * minute, "kind+project")
  )
  // what is learned is unchanged: only what is enforced is widened
  assertEq(
    marshal.jobDeadline(learning, "build", false, four([], [], [minute], threeOf(13)), 0),
    marshal.LearnedDeadline(26 * minute, "kind+project")
  )

@test("a deadline learned from a run its deadline stopped is widened too")
marginOverrun()
  // half again a 40-minute overrun is 60 minutes, enforced at 90
  assertEq(
    enforced(learning, "build", false, four([], [], threeOf(10), []), 40 * minute),
    marshal.LearnedDeadline(90 * minute, "overrun")
  )
  assertEq(enforced(learning, "x", false, four([], [], [], []), long.MaxValue).ms, long.MaxValue)

@test("a kind's default is enforced as it is, with or without a margin")
marginNotOnDefault()
  assertEq(enforced(learning, "build", false, [], 0), marshal.LearnedDeadline(20 * minute, "none"))
  assertEq(enforced(learning, "test", false, four([], [], [], []), 0), marshal.LearnedDeadline(45 * minute, "none"))
  assertEq(enforced(learning, "test", true, four([], [], [], []), 0), marshal.LearnedDeadline(120 * minute, "none"))
  assertEq(enforced(learning, "docs", false, four(threeOf(1).take(2), [], [], []), 0), marshal.LearnedDeadline(30 * minute, "none"))
  val wide = Learning(20, 3, 2, 5 * minute, 150, 300)
  assertEq(enforced(wide, "build", false, [], 0), marshal.LearnedDeadline(20 * minute, "none"))

@test("the margin is the configured factor: 1.0 enforces the learned deadline itself, 2.0 twice it")
marginConfigured()
  val exact = Learning(20, 3, 2, 5 * minute, 150, 100)
  assertEq(
    enforced(exact, "build", false, four(threeOf(10), [], [], []), 0),
    marshal.jobDeadline(exact, "build", false, four(threeOf(10), [], [], []), 0)
  )
  assertEq(enforced(exact, "build", false, four(threeOf(10), [], [], []), 0).ms, 20 * minute)
  val double = Learning(20, 3, 2, 5 * minute, 150, 200)
  assertEq(enforced(double, "build", false, four(threeOf(10), [], [], []), 0).ms, 40 * minute)
  // a floor-held deadline is widened from the floor
  assertEq(enforced(learning, "build", false, four([1000, 1000, 1000], [], [], []), 0).ms, 15 * minute / 2)
  // a huge one saturates
  assertEq(enforced(learning, "x", false, four([1, 1, long.MaxValue], [], [], []), 0).ms, long.MaxValue)
  assertEq(marshal.enforcedMs(learning, long.MaxValue / 2), long.MaxValue)

@test("the expected duration is not widened by the margin")
marginNotOnEta()
  val runs = [10 * minute, 12 * minute, 14 * minute]
  assertEq(marshal.expectedMs(learning, "test", false, runs), 12 * minute)
  val e = marshal.expectationFor(learning, "test", false, runs, None, enforced(learning, "test", false, four(runs, [], [], []), 0).ms)
  assertEq(e.ms, 12 * minute)
