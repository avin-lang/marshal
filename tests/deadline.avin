module tests

// Deadlines learned per kind from recorded durations.
import dev.avinlang.marshal
import dev.avinlang.marshal.Learning

val minute: long = 60000
val learning: Learning = marshal.defaultLearning

@test("an unseen kind has its default: build 20 min, test 45, landing 120, anything else 30")
defaults()
    assertEq(marshal.deadlineMs(learning, "build", false, []), 20 * minute)
    assertEq(marshal.deadlineMs(learning, "test", false, []), 45 * minute)
    assertEq(marshal.deadlineMs(learning, "test", true, []), 120 * minute)
    assertEq(marshal.deadlineMs(learning, "build", true, []), 120 * minute)
    assertEq(marshal.deadlineMs(learning, "docs", false, []), 30 * minute)
    assertEq(marshal.deadlineMs(learning, "", false, []), 30 * minute)

@test("too few runs keep the default")
tooFew()
    assertEq(marshal.deadlineMs(learning, "test", false, [10 * minute, 10 * minute]), 45 * minute)
    assertEq(marshal.expectedMs(learning, "test", false, [10 * minute, 10 * minute]), 45 * minute / 2)

@test("enough runs give twice their median")
learned()
    assertEq(marshal.deadlineMs(learning, "test", false, [10 * minute, 12 * minute, 50 * minute]), 24 * minute)
    assertEq(marshal.expectedMs(learning, "test", false, [10 * minute, 12 * minute, 50 * minute]), 12 * minute)

@test("a learned deadline is never below the floor")
floor()
    assertEq(marshal.deadlineMs(learning, "build", false, [1000, 1000, 1000]), 5 * minute)
    assertEq(marshal.expectedMs(learning, "build", false, [1000, 1000, 1000]), 1000)

@test("only the last window of runs is read")
window()
    val old = Vector.fill(100, 100 * minute)
    val fresh = Vector.fill(20, 10 * minute)
    assertEq(marshal.deadlineMs(learning, "test", false, old ++ fresh), 20 * minute)
    val small = Learning(3, 1, 3, 0)
    assertEq(marshal.deadlineMs(small, "x", false, [100, 1, 2, 3]), 6)

@test("the median is the middle, or the mean of the two middles, of any order")
medians()
    assertEq(marshal.median([]), 0)
    assertEq(marshal.median([7]), 7)
    assertEq(marshal.median([3, 1, 2]), 2)
    assertEq(marshal.median([4, 1, 3, 2]), 2)
    assertEq(marshal.median([1, 4]), 2)
    assertEq(marshal.median([1, 2]), 1)
    assertEq(marshal.median([long.MaxValue, long.MaxValue]), long.MaxValue)
    assertEq(marshal.median([long.MaxValue - 1, long.MaxValue]), long.MaxValue - 1)

@test("a huge median saturates the deadline rather than overflowing")
saturates()
    assertEq(marshal.deadlineMs(learning, "x", false, [long.MaxValue, long.MaxValue, long.MaxValue]), long.MaxValue)

@test("a landing run's history is kept apart from a development run's")
keys()
    assertEq(marshal.historyKey("test", false), "test")
    assertEq(marshal.historyKey("test", true), "test+landing")
