module tests

// Reserving marshal for one owner, end to end through the command line: `reserve` keeps every other
// owner's jobs waiting in their places while the owner's and quick jobs start; `unreserve`, or the
// reservation's end, lets them go in queue order; it survives `marshal restart` with its end; and
// `status`, `ls` and `events` say it.
import avin.threads
import avin.time
import avin.time.millis
import dev.avinlang.json
import dev.avinlang.json.Json

// The reason the queued job `id` waits, as `status --json` words it (`queuedJson` is hold_many_e2e's).
whyWordOf(home: string, id: long) -> string = queuedJson(home, id)("why").asString.get

// The events of marshal's own of `name`, in the order logged.
machineEvents(home: string, name: string) -> Vector[Json] =
  events(home).filter(e -> e("event").asString == Some(name))

@test("owner reserve: other owners' jobs wait as reserved, the owner's and quick jobs start, and unreserve lets the rest go in order")
ownerReserveGates()
  val home = newHome("{\"units\": 1}")
  val r = m(home, "reserve", "--owner", "rel0120", "--for", "1h")
  assertEq(r.code, 0)
  assert(r.out.contains("marshal: reserved for rel0120 (1h left): only its jobs and quick jobs start"), r.out)
  val a = submitted(home, "--owner", "avin", "--units", "1", "--", "sleep", "0.3")
  val b = submitted(home, "--owner", "avin", "--units", "1", "--", "sleep", "0.3")
  val urgent = submitted(home, "--owner", "avin", "--urgent", "--", "true")
  val landing = submitted(home, "--owner", "avin", "--landing", "--", "true")
  threads.sleep(millis(500))
  for id in [a, b, urgent, landing]
    assertEq(eventsOf(home, id), ["submitted"])
    assertEq(whyWordOf(home, id), "reserved")
    assertEq(queuedJson(home, id)("reserved_for").asString, Some("rel0120"))
  // the owner's own job, and another owner's quick job, start
  assertEq(m(home, "run", "--owner", "rel0120", "--", "true").code, 0)
  assertEq(m(home, "run", "--owner", "avin", "--quick", "--", "true").code, 0)
  // the owner's, behind the reserved-out jobs in the queue, are not kept behind them
  assertEq(m(home, "run", "--owner", "rel0120", "--units", "1", "--", "true").code, 0)
  for id in [a, b, urgent, landing] do assertEq(eventsOf(home, id), ["submitted"])
  // every view says it
  val status = m(home, "status")
  assert(status.out.contains("; reserved for rel0120 (1h left): only its jobs and quick jobs start"), status.out)
  val st = statusJsonOf(home)
  assertEq(st("reserve")("owner").asString, Some("rel0120"))
  assert(st("reserve")("left_ms").asLong.get > 3_500_000)
  val ls = m(home, "ls")
  assert(ls.out.lines.toVector(0).startsWith("marshal: reserved for rel0120 (1h left)"), ls.out)
  assert(ls.out.lines.exists(l -> l.startsWith(a.toString()) && l.contains("queued (reserved for rel0120)")), ls.out)
  val one = m(home, "status", a.toString())
  assert(one.out.contains(s"job $a is queued (reserved for rel0120)"), one.out)
  assertEq(json.parse(m(home, "status", a.toString(), "--json").out.trim).ok.get("why").asString, Some("reserved"))
  // unreserve: each goes, in queue order (urgent first, then a and b)
  val u = m(home, "unreserve")
  assertEq(u.code, 0)
  assert(u.out.contains("marshal: not reserved: every owner's jobs start"), u.out)
  for id in [a, b, urgent, landing] do assertEq(m(home, "wait", id.toString()).code, 0)
  assertEq(startOrder(home, [urgent, a, b]), [urgent, a, b])
  assertEq(statusJsonOf(home)("reserve"), Json.Null)
  assert(!m(home, "ls").out.contains("reserved for"))
  val reserved = machineEvents(home, "reserved")
  assertEq(reserved.length, 1)
  assertEq(reserved(0)("owner").asString, Some("rel0120"))
  assertEq(reserved(0)("for_ms").asLong, Some(long(3_600_000)))
  assertEq(machineEvents(home, "unreserved").map(e -> e("owner").asString.get), ["rel0120"])
  // a second unreserve, with nothing standing, is no failure and logs nothing
  assertEq(m(home, "unreserve").code, 0)
  assertEq(machineEvents(home, "unreserved").length, 1)
  cleanUp(home)

@test("owner reserve: the reservation ends by itself at its end, and the jobs it kept waiting start in queue order")
ownerReserveExpires()
  val home = newHome("{\"units\": 1}")
  assertEq(m(home, "reserve", "--owner", "rel", "--for", "3s").code, 0)
  val a = submitted(home, "--owner", "x", "--units", "1", "--", "true")
  val b = submitted(home, "--owner", "y", "--units", "1", "--", "true")
  threads.sleep(millis(1000))
  assertEq(eventsOf(home, a), ["submitted"])
  assertEq(whyWordOf(home, b), "reserved")
  val soon = time.monotonic() + millis(8000)
  assertEq(m(home, "wait", b.toString()).code, 0)
  assertEq(m(home, "wait", a.toString()).code, 0)
  // ended within a tick of its end
  assert(time.monotonic() < soon)
  assertEq(startOrder(home, [a, b]), [a, b])
  assertEq(machineEvents(home, "reserve-expired").map(e -> e("owner").asString.get), ["rel"])
  assertEq(statusJsonOf(home)("reserve"), Json.Null)
  assert(!m(home, "status").out.contains("reserved"))
  cleanUp(home)

@test("owner reserve: a restart keeps the reservation and its end, and it still expires on time after it")
ownerReserveRestart()
  val home = newHome("{\"units\": 1}")
  assertEq(m(home, "reserve", "--owner", "rel", "--for", "6s").code, 0)
  val until = statusJsonOf(home)("reserve")("until").asLong.get
  val a = submitted(home, "--owner", "x", "--", "true")
  restarted(home)
  val after = statusJsonOf(home)("reserve")
  assertEq(after("owner").asString, Some("rel"))
  assertEq(after("until").asLong, Some(until))
  assertEq(whyWordOf(home, a), "reserved")
  assertEq(m(home, "run", "--owner", "rel", "--", "true").code, 0)
  assertEq(m(home, "wait", a.toString()).code, 0)
  // it started only once the reservation had ended, not counted again from the restart
  val started = tsOf(home, a, "started")
  assert(started >= until, s"started at $started, before the end $until")
  assert(started < until + 5000, s"started at $started, long after the end $until")
  assertEq(machineEvents(home, "reserve-expired").length, 1)
  cleanUp(home)

@test("owner reserve: --for missing or invalid, --owner missing, and stray arguments are refused, leaving nothing reserved")
ownerReserveRefused()
  val home = newHome()
  refusedWith(m(home, "reserve", "--owner", "rel"), "--for <t>")
  refusedWith(m(home, "reserve", "--for", "1h"), "--owner")
  refusedWith(m(home, "reserve", "--owner", "rel", "--for", "soon"), "not `soon`")
  refusedWith(m(home, "reserve", "--owner", "rel", "--for", "0"), "not `0`")
  refusedWith(m(home, "reserve", "--owner", "rel", "--for", "25h"), "at most 24h00m")
  refusedWith(m(home, "reserve", "--owner", "a b", "--for", "1h"), "one word")
  refusedWith(m(home, "reserve", "--owner", "rel", "--for", "1h", "now"), "not `now`")
  refusedWith(m(home, "unreserve", "rel"), "unreserve takes no arguments")
  assertEq(statusJsonOf(home)("reserve"), Json.Null)
  assertEq(machineEvents(home, "reserved").length, 0)
  val help = m(home, "reserve", "--help")
  assertEq(help.code, 0)
  assert(help.out.contains("usage: marshal reserve --owner <name> --for <t>"), help.out)
  assert(m(home, "--help").out.contains("marshal unreserve"))
  cleanUp(home)

@test("owner reserve: a second reserve replaces the first, its owner and its end, and the log names the one replaced")
ownerReserveReplaces()
  val home = newHome()
  assertEq(m(home, "reserve", "--owner", "first", "--for", "1h").code, 0)
  val f = submitted(home, "--owner", "first", "--", "sleep", "30")
  val r = m(home, "reserve", "--owner", "second", "--for", "30m")
  assertEq(r.code, 0)
  assert(r.out.contains("reserved for second (30m left)"), r.out)
  assertEq(statusJsonOf(home)("reserve")("owner").asString, Some("second"))
  // the first owner's job that was already running goes on; a new one of theirs waits
  val g = submitted(home, "--owner", "first", "--", "true")
  threads.sleep(millis(400))
  assertEq(eventsOf(home, f), ["submitted", "started"])
  assertEq(whyWordOf(home, g), "reserved")
  val logged = machineEvents(home, "reserved")
  assertEq(logged.length, 2)
  assertEq(logged(1)("replaced").asString, Some("first"))
  assert(logged(0).get("replaced").isEmpty)
  m(home, "kill", f.toString())
  assertEq(m(home, "unreserve").code, 0)
  assertEq(m(home, "wait", g.toString()).code, 0)
  cleanUp(home)

@test("owner reserve: a job of the default owner is the owner's, and a running job of another owner goes on")
ownerReserveDefaultOwner()
  val home = newHome()
  val running = submitted(home, "--owner", "other", "--", "sleep", "1")
  threads.sleep(millis(200))
  // the default owner of a job submitted here, as the daemon works it out
  val probe = submitted(home, "--", "sleep", "0.2")
  val owner = statusJsonOf(home)("running").asVector.get.find(j -> j("id").asLong == Some(probe)).get("owner").asString.get
  assert(owner.nonEmpty)
  assertEq(m(home, "reserve", "--owner", owner, "--for", "10m").code, 0)
  assertEq(m(home, "run", "--", "true").code, 0)
  assertEq(m(home, "wait", running.toString()).code, 0)
  assertEq(eventsOf(home, running), ["submitted", "started", "finished"])
  val other = submitted(home, "--owner", "other", "--", "true")
  threads.sleep(millis(300))
  assertEq(whyWordOf(home, other), "reserved")
  m(home, "unreserve")
  assertEq(m(home, "wait", other.toString()).code, 0)
  cleanUp(home)

@test("owner reserve: a held job stays held through unreserve, and a held queue holds the owner's jobs too")
ownerReserveHolds()
  val home = newHome()
  assertEq(m(home, "reserve", "--owner", "rel", "--for", "1h").code, 0)
  val held = submitted(home, "--owner", "x", "--", "true")
  assertEq(m(home, "hold", held.toString()).code, 0)
  assertEq(whyWordOf(home, held), "held")
  assertEq(m(home, "pause").code, 0)
  val mine = submitted(home, "--owner", "rel", "--", "true")
  threads.sleep(millis(300))
  assertEq(whyWordOf(home, mine), "queue-held")
  assertEq(m(home, "resume").code, 0)
  assertEq(m(home, "wait", mine.toString()).code, 0)
  assertEq(m(home, "unreserve").code, 0)
  threads.sleep(millis(300))
  assertEq(eventsOf(home, held), ["submitted", "held"])
  assertEq(whyWordOf(home, held), "held")
  assertEq(m(home, "release", held.toString()).code, 0)
  assertEq(m(home, "wait", held.toString()).code, 0)
  cleanUp(home)

@test("owner reserve: a job waiting --after another joins the queue reserved out, and a reserved-out job does not make stop --wait refuse")
ownerReserveAfterAndStop()
  val home = newHome()
  assertEq(m(home, "reserve", "--owner", "rel", "--for", "4s").code, 0)
  val first = submitted(home, "--owner", "rel", "--", "true")
  val next = submitted(home, "--owner", "x", "--after", first.toString(), "--", "true")
  assertEq(m(home, "wait", first.toString()).code, 0)
  threads.sleep(millis(300))
  assertEq(eventsOf(home, next), ["submitted", "ready"])
  assertEq(whyWordOf(home, next), "reserved")
  // stop --wait waits for it: the reservation ends by itself
  assertEq(m(home, "stop", "--wait").code, 0)
  assertEq(eventsOf(home, next), ["submitted", "ready", "started", "finished"])
  cleanUp(home)

@test("owner reserve: marshal events lists reserved, unreserved and reserve-expired, and filters by their names")
ownerReserveEventsCommand()
  val home = newHome()
  assertEq(m(home, "reserve", "--owner", "rel", "--for", "1h").code, 0)
  assertEq(m(home, "unreserve").code, 0)
  assertEq(m(home, "reserve", "--owner", "rel2", "--for", "2s").code, 0)
  assert(within(8000, () -> machineEvents(home, "reserve-expired").nonEmpty))
  val all = m(home, "events")
  assertEq(all.code, 0)
  assert(all.out.contains("\"event\":\"reserved\""), all.out)
  assert(all.out.contains("\"event\":\"unreserved\""), all.out)
  assert(all.out.contains("\"event\":\"reserve-expired\""), all.out)
  val only = m(home, "events", "reserved")
  assertEq(only.out.trim.lines.toVector.length, 2)
  assert(!only.out.contains("unreserved"), only.out)
  // a daemon starting over this log finds no lost job and no unreadable line in them
  assertEq(m(home, "stop").code, 0)
  assertEq(m(home, "status").code, 0)
  assert(!daemonLog(home).contains("are not events"), daemonLog(home))
  assertEq(submitted(home, "--", "true"), 1)
  cleanUp(home)
