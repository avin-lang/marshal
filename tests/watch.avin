module tests

// Waiting on events: the condition grammar, the filters, the `--since` forms, and a watch's requests
// and replies on the wire.
import dev.avinlang.marshal
import dev.avinlang.marshal.{Condition, Filter, Mode, Request, Reply, Since}
import avin.json
import avin.json.Json

val Ending: Vector[string] = ["finished", "timeout", "quiet", "killed", "cancelled", "lost"]

parsed(text: string) -> Condition = marshal.parseCondition(text).ok.get

filterOf(text: string) -> Filter = parsed(text) match
    Condition.Matching(f) -> f
    other -> fail(s"$text is not an event filter: $other")

refused(text: string) -> string = marshal.parseCondition(text).err.get

// An event as the log writes it, with the fields the filters read.
event(name: string, kind: string = "build", landing: bool = false, exit: Option[int] = None) -> Json
    val base = [("ts", Json.num(1000)), ("event", Json.str(name)), ("id", Json.num(3)), ("kind", Json.str(kind)), ("landing", Json.Bool(landing))]
    Json.Obj(base ++ exit.map(c -> [("exit", Json.num(c))]).getOrElse([]))

@test("idle and job= parse to their own conditions")
stateConditions()
    assertEq(parsed("idle"), Condition.IsIdle)
    assertEq(parsed("  idle "), Condition.IsIdle)
    assertEq(parsed("job=4"), Condition.JobsEnded([4]))
    assertEq(parsed("job=4,5,6"), Condition.JobsEnded([4, 5, 6]))
    assertEq(parsed("job=7,7"), Condition.JobsEnded([7]))

@test("every event name parses to the filter that says it")
eventNames()
    assertEq(filterOf("ended"), Filter(Ending, None, None, false, false))
    assertEq(filterOf("failed"), Filter(Ending, None, None, false, true))
    assertEq(filterOf("landing-done"), Filter(Ending, None, None, true, false))
    assertEq(filterOf("started"), Filter(["started"], None, None, false, false))
    assertEq(filterOf("submitted"), Filter(["submitted"], None, None, false, false))
    assertEq(filterOf("any"), Filter([], None, None, false, false))
    for name in ["ready", "retry", "held", "released", "paused", "resumed", "prioritized"]
        assertEq(filterOf(name), Filter([name], None, None, false, false))
        assertEq(filterOf(name + ":kind=gate"), Filter([name], Some("gate"), None, false, false))
        assert(refused(name + ":outcome=ok").contains("has no outcome"), refused(name + ":outcome=ok"))
        assert(marshal.parseFilter(name).isOk, name)
        assert(marshal.admits(filterOf(name), event(name)), name)
        assert(!marshal.admits(filterOf(name), event("started")), name)
    assert(refused("dance").contains("ready, retry, held, released, paused, resumed, prioritized"), refused("dance"))
    assert(refused("RETRY").contains("is not a condition"), refused("RETRY"))

@test("cancelled is an ending and an outcome, and the ending of an attempt that is retried does not end its job")
cancelledAndRetried()
    assertEq(marshal.outcomeOf(event("cancelled")), Some("cancelled"))
    assert(marshal.admits(filterOf("ended:outcome=cancelled"), event("cancelled")))
    assert(marshal.admits(filterOf("failed"), event("cancelled")))
    assert(!marshal.admits(filterOf("ended:outcome=killed"), event("cancelled")))
    assert(!marshal.admits(filterOf("ended"), event("ready")))
    assert(!marshal.admits(filterOf("ended"), event("retry")))
    val attempt = Json.Obj([("event", Json.str("finished")), ("exit", Json.num(1)), ("retrying", Json.Bool(true))])
    val last = Json.Obj([("event", Json.str("finished")), ("exit", Json.num(1))])
    assert(!marshal.endsJob(attempt))
    assert(marshal.endsJob(last))
    assert(marshal.endsJob(event("cancelled")))
    assert(!marshal.endsJob(event("retry")))
    assert(!marshal.endsJob(event("ready")))
    // every attempt's ending is still an ending to `ended` and `failed`
    assert(marshal.admits(filterOf("failed"), attempt))

@test("filters follow a colon, joined by commas, in either order")
filtersAfterAColon()
    assertEq(filterOf("ended:kind=avin-gate").kind, Some("avin-gate"))
    assertEq(filterOf("ended:outcome=failed").outcome, Some("failed"))
    val both = filterOf("ended:kind=gate,outcome=timeout")
    assertEq((both.kind, both.outcome), (Some("gate"), Some("timeout")))
    val swapped = filterOf("ended:outcome=timeout,kind=gate")
    assertEq((swapped.kind, swapped.outcome), (Some("gate"), Some("timeout")))
    assertEq(filterOf("started:kind=test").kind, Some("test"))
    assertEq(filterOf("failed:kind=x,outcome=lost").outcome, Some("lost"))
    assertEq(filterOf("landing-done:outcome=ok").landing, true)

@test("a bad condition says why")
badConditions()
    assert(refused("").contains("empty"), refused(""))
    assert(refused("dance").contains("`dance` is not a condition"), refused("dance"))
    assert(refused("idle:kind=x").contains("`idle` takes no filters"), refused("idle:kind=x"))
    assert(refused("job").contains("takes ids"), refused("job"))
    assert(refused("job=").contains("takes ids"), refused("job="))
    assert(refused("job=x").contains("`x` is not a job id"), refused("job=x"))
    assert(refused("job=0").contains("`0` is not a job id"), refused("job=0"))
    assert(refused("job=1,,2").contains("is not a job id"), refused("job=1,,2"))
    assert(refused("job=-3").contains("is not a job id"), refused("job=-3"))
    assert(refused("ended:").contains("is not a filter"), refused("ended:"))
    assert(refused("ended:kind").contains("`kind` is not a filter"), refused("ended:kind"))
    assert(refused("ended:kind=").contains("is not a filter"), refused("ended:kind="))
    assert(refused("ended:=x").contains("is not a filter"), refused("ended:=x"))
    assert(refused("ended:colour=red").contains("`colour` is not a filter"), refused("ended:colour=red"))
    assert(refused("ended:kind=a,kind=b").contains("given twice"), refused("ended:kind=a,kind=b"))
    assert(refused("ended:outcome=ok,outcome=failed").contains("given twice"), refused("ended:outcome=ok,outcome=failed"))
    assert(refused("ended:outcome=great").contains("`great` is not an outcome"), refused("ended:outcome=great"))
    assert(refused("failed:outcome=ok").contains("never ends ok"), refused("failed:outcome=ok"))
    assert(refused("started:outcome=ok").contains("has no outcome"), refused("started:outcome=ok"))
    assert(refused("submitted:outcome=failed").contains("has no outcome"), refused("submitted:outcome=failed"))
    assert(refused("ENDED").contains("is not a condition"), refused("ENDED"))

@test("an events filter is an event condition, never idle or job=")
eventFilters()
    assert(marshal.parseFilter("ended:kind=x").isOk)
    assert(marshal.parseFilter("any").isOk)
    assert(marshal.parseFilter("idle").isErr)
    assert(marshal.parseFilter("job=3").isErr)
    assert(marshal.parseFilter("nonsense").isErr)

@test("the outcome of an event is ok, failed, timeout, killed or lost, and only an ending has one")
outcomes()
    assertEq(marshal.outcomeOf(event("finished", exit = Some(0))), Some("ok"))
    assertEq(marshal.outcomeOf(event("finished", exit = Some(1))), Some("failed"))
    assertEq(marshal.outcomeOf(event("finished", exit = Some(143))), Some("failed"))
    assertEq(marshal.outcomeOf(event("finished", exit = Some(127))), Some("failed"))
    assertEq(marshal.outcomeOf(event("timeout", exit = Some(124))), Some("timeout"))
    assertEq(marshal.outcomeOf(event("killed", exit = Some(143))), Some("killed"))
    assertEq(marshal.outcomeOf(event("lost", exit = Some(125))), Some("lost"))
    assertEq(marshal.outcomeOf(event("started")), None)
    assertEq(marshal.outcomeOf(event("submitted")), None)
    assertEq(marshal.outcomeOf(event("finished")), None)

@test("a filter admits the events it names and no others")
admission()
    val ok = event("finished", exit = Some(0))
    val bad = event("finished", exit = Some(2))
    val timeout = event("timeout", kind = "test", exit = Some(124))
    val started = event("started")
    val landed = event("finished", landing = true, exit = Some(0))
    assert(marshal.admits(filterOf("ended"), ok))
    assert(marshal.admits(filterOf("ended"), bad))
    assert(marshal.admits(filterOf("ended"), timeout))
    assert(!marshal.admits(filterOf("ended"), started))
    assert(!marshal.admits(filterOf("failed"), ok))
    assert(marshal.admits(filterOf("failed"), bad))
    assert(marshal.admits(filterOf("failed"), timeout))
    assert(!marshal.admits(filterOf("failed"), started))
    assert(marshal.admits(filterOf("started"), started))
    assert(!marshal.admits(filterOf("started"), ok))
    assert(!marshal.admits(filterOf("submitted"), started))
    assert(marshal.admits(filterOf("submitted"), event("submitted")))
    assert(marshal.admits(filterOf("any"), started))
    assert(marshal.admits(filterOf("any"), ok))
    assert(marshal.admits(filterOf("landing-done"), landed))
    assert(!marshal.admits(filterOf("landing-done"), ok))
    assert(!marshal.admits(filterOf("landing-done"), event("started", landing = true)))
    assert(marshal.admits(filterOf("ended:kind=test"), timeout))
    assert(!marshal.admits(filterOf("ended:kind=test"), ok))
    assert(!marshal.admits(filterOf("started:kind=test"), started))
    assert(marshal.admits(filterOf("ended:outcome=ok"), ok))
    assert(!marshal.admits(filterOf("ended:outcome=ok"), bad))
    assert(marshal.admits(filterOf("ended:outcome=failed"), bad))
    assert(!marshal.admits(filterOf("ended:outcome=failed"), timeout))
    assert(marshal.admits(filterOf("ended:outcome=timeout,kind=test"), timeout))
    assert(!marshal.admits(filterOf("ended:outcome=timeout,kind=build"), timeout))
    assert(marshal.admits(filterOf("failed:outcome=timeout"), timeout))
    assert(!marshal.admits(filterOf("failed:outcome=timeout"), bad))
    assert(marshal.admits(filterOf("landing-done:outcome=ok"), landed))
    assert(!marshal.admits(filterOf("ended:kind=build"), event("finished", kind = "other", exit = Some(0))))

@test("a filter on an event with no kind or exit lets nothing through that needs them")
admissionOfBareEvents()
    val bare = Json.obj(("event", Json.str("finished")))
    assert(marshal.admits(filterOf("ended"), bare))
    assert(!marshal.admits(filterOf("ended:kind=build"), bare))
    assert(!marshal.admits(filterOf("ended:outcome=ok"), bare))
    assert(!marshal.admits(filterOf("failed"), Json.obj(("event", Json.str("started")))))
    assert(!marshal.admits(filterOf("ended"), Json.obj(("ts", Json.num(1)))))

@test("--since takes a job id, a time ago, or a time")
sinceForms()
    val now: long = 10000000000
    assertEq(marshal.parseSince("12", now), Ok(Since(None, Some(12))))
    assertEq(marshal.parseSince("0", now), Ok(Since(None, Some(0))))
    assertEq(marshal.parseSince("90s", now), Ok(Since(Some(now - 90000), None)))
    assertEq(marshal.parseSince("10m", now), Ok(Since(Some(now - 600000), None)))
    assertEq(marshal.parseSince("2h", now), Ok(Since(Some(now - 7200000), None)))
    assertEq(marshal.parseSince("1d", now), Ok(Since(Some(now - 86400000), None)))
    assertEq(marshal.parseSince("@1762521060000", now), Ok(Since(Some(1762521060000), None)))
    assertEq(marshal.parseSince("1000d", 5), Ok(Since(Some(0), None)))

@test("--since refuses what is not a time")
sinceRefusals()
    for text in ["", "s", "m", "-5", "1.5h", "10x", "@", "@x", "@-1", "abc", "1 0", "99999999999999999999"] do
        assert(marshal.parseSince(text, 1000).isErr, text)
    assert(marshal.parseSince("9999999999999999d", 1000).isErr)

@test("a watch request reads back as itself, in each mode, with and without a since")
watchRequests()
    for source in ["idle", "job=3", "job=3,4", "ended", "ended:kind=x,outcome=failed", "failed", "landing-done", "started", "any"] do
        val once = Request.Watch(source, parsed(source), Mode.Once, None, None)
        assertEq(marshal.decodeRequest(marshal.encodeRequest(once).render), Ok(once))
    for source in ["ended", "failed:kind=gate", "any", "started", "submitted"] do
        for mode in [Mode.Past, Mode.Follow, Mode.Once] do
            val r = Request.Watch(source, parsed(source), mode, Some(1762521060000), Some(12))
            assertEq(marshal.decodeRequest(marshal.encodeRequest(r).render), Ok(r))
            val none = Request.Watch(source, parsed(source), mode, None, None)
            assertEq(marshal.decodeRequest(marshal.encodeRequest(none).render), Ok(none))

@test("a watch request with a bad condition, mode or field is refused with a reason")
watchRefusals()
    val decode = (text: string) -> marshal.decodeRequest(text).err.get
    assert(decode("{\"op\":\"watch\",\"cond\":\"dance\",\"mode\":\"once\"}").contains("bad condition"))
    assert(decode("{\"op\":\"watch\",\"mode\":\"once\"}").contains("`cond` is missing"))
    assert(decode("{\"op\":\"watch\",\"cond\":\"idle\"}").contains("`mode` is missing"))
    assert(decode("{\"op\":\"watch\",\"cond\":\"idle\",\"mode\":\"sometimes\"}").contains("`mode` is not once, past or follow"))
    assert(decode("{\"op\":\"watch\",\"cond\":7,\"mode\":\"once\"}").contains("`cond` is not a string"))
    assert(decode("{\"op\":\"watch\",\"cond\":\"ended\",\"mode\":\"once\",\"since\":\"x\"}").contains("`since` is not"))
    assert(decode("{\"op\":\"watch\",\"cond\":\"idle\",\"mode\":\"follow\"}").contains("event filter"))
    assert(decode("{\"op\":\"watch\",\"cond\":\"job=2\",\"mode\":\"past\"}").contains("event filter"))
    assert(marshal.decodeRequest("{\"op\":\"watch\",\"cond\":\"idle\",\"mode\":\"once\"}").isOk)

@test("a watch's replies read back as themselves")
watchReplies()
    val ev = event("finished", exit = Some(0))
    assertEq(marshal.decodeReply(marshal.encodeReply(Reply.Streamed(ev)).render), Ok(Reply.Streamed(ev)))
    assertEq(marshal.decodeReply(marshal.encodeReply(Reply.Replayed([ev, event("started")])).render), Ok(Reply.Replayed([ev, event("started")])))
    assertEq(marshal.decodeReply(marshal.encodeReply(Reply.Replayed([])).render), Ok(Reply.Replayed([])))
    assertEq(marshal.decodeReply(marshal.encodeReply(Reply.Failed("events were dropped: x")).render), Ok(Reply.Failed("events were dropped: x")))

@test("only a watch is answered with a stream")
watchingIsWatch()
    assert(marshal.watching(Request.Watch("idle", Condition.IsIdle, Mode.Once, None, None)))
    for r in [Request.Wait(1), Request.List, Request.Status, Request.Hello, Request.Restart(None), Request.Kill(1)] do
        assert(!marshal.watching(r))
