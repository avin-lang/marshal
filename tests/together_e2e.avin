module tests

// End to end, the features that meet in one job: a job waiting for others (`--after`) or to retry
// (`--retries`) beside a hold by hand, a pause, the urgent band, `wait --until` and `events`, and
// all of it across `marshal restart`. The helpers are e2e.avin's, control_e2e.avin's,
// depends_e2e.avin's and watch_e2e.avin's.
import avin.fs
import avin.process
import avin.threads
import avin.time
import avin.time.millis
import json
import json.Json

// The `ls` row of job `id`.
lsRow(home: string, id: long) -> string =
    m(home, "ls").out.lines().find(l -> l.startsWith(id.toString() + " ")).getOrElse("")

// The position in the log of job `id`'s `n`th `started` event, counting from 1; -1 when there is none.
nthStart(home: string, id: long, n: int) -> int
    var seen = 0
    val evs = events(home)
    for i in evs.indices
        if evs(i)("id").asLong() == Some(id) && evs(i)("event").asString() == Some("started")
            seen += 1
            if seen == n then return i
    -1

// Waits up to five seconds for job `id` to record the event `name`.
awaitEvent(home: string, id: long, name: string)
    val until = time.monotonic() + millis(5000)
    while at(home, id, name) < 0 && time.monotonic() < until do threads.sleep(millis(20))
    assert(at(home, id, name) >= 0, s"job $id never recorded `$name`: ${eventsOf(home, id)}")

// Waits up to ten seconds for a background command to exit.
awaitExit(b: Background)
    val until = time.monotonic() + millis(10000)
    while alive(b.pid) && time.monotonic() < until do threads.sleep(millis(50))
    assert(!alive(b.pid), s"the command is still waiting: ${outputOf(b)}")

@test("a waiting job held by hand joins the queue when its dependency ends, but stays held until released")
togetherHeldWaiting()
    val home = newHome()
    val a = submitted(home, "--", "sleep", "1")
    val b = submitted(home, "--after", a.toString(), "--", "true")
    assertEq(m(home, "hold", b.toString()).code, 0)
    assert(lsRow(home, b).contains(s"held after $a"), lsRow(home, b))
    refusedWith(m(home, "hold", b.toString()), s"job $b is already held")
    assertEq(m(home, "wait", a.toString()).code, 0)
    awaitEvent(home, b, "ready")
    threads.sleep(millis(500))
    assertEq(eventsOf(home, b), ["submitted", "held", "ready"])
    assert(lsRow(home, b).contains("held"), lsRow(home, b))
    assert(!lsRow(home, b).contains("after"), lsRow(home, b))
    assertEq(m(home, "release", b.toString()).code, 0)
    assertEq(m(home, "wait", b.toString()).code, 0)
    assertEq(eventsOf(home, b), ["submitted", "held", "ready", "released", "started", "finished"])
    cleanUp(home)

@test("a waiting job released by hand before its dependency ends still waits for it")
togetherReleasedWhileWaiting()
    val home = newHome()
    val a = submitted(home, "--", "sleep", "1")
    val b = submitted(home, "--after", a.toString(), "--", "true")
    assertEq(m(home, "hold", b.toString()).code, 0)
    assertEq(m(home, "release", b.toString()).code, 0)
    refusedWith(m(home, "release", b.toString()), s"job $b is not held")
    assert(lsRow(home, b).contains(s"after $a"), lsRow(home, b))
    assertEq(m(home, "wait", b.toString()).code, 0)
    assert(startedAfter(home, b, a))
    assertEq(eventsOf(home, b), ["submitted", "held", "released", "ready", "started", "finished"])
    cleanUp(home)

@test("a held waiting job whose dependency fails is cancelled, held or not")
togetherHeldWaitingCancelled()
    val home = newHome()
    val a = submitted(home, "--", "sh", "-c", "sleep 0.5; exit 1")
    val b = submitted(home, "--after", a.toString(), "--", "true")
    assertEq(m(home, "hold", b.toString()).code, 0)
    assertEq(m(home, "wait", b.toString()).code, 126)
    assertEq(eventsOf(home, b), ["submitted", "held", "cancelled"])
    cleanUp(home)

@test("a job waiting to retry can be held, and then waits for its release before its next attempt")
togetherHeldRetrying()
    val home = newHome()
    val id = submitted(home, (["--retries", "1", "--retry-delay", "1s", "--"] ++ failsUntil(home, 2))*)
    awaitEvent(home, id, "retry")
    assertEq(m(home, "hold", id.toString()).code, 0)
    threads.sleep(millis(1800))
    assertEq(nthStart(home, id, 2), -1)
    assert(lsRow(home, id).contains("held"), lsRow(home, id))
    assertEq(m(home, "release", id.toString()).code, 0)
    assertEq(m(home, "wait", id.toString()).code, 0)
    assertEq(eventsOf(home, id), ["submitted", "started", "finished", "retry", "held", "released", "started", "finished"])
    cleanUp(home)

@test("stop --wait is refused while a waiting job is held, and stop --force cancels it")
togetherStopHeldWaiting()
    val home = newHome()
    val a = submitted(home, "--", "sleep", "30")
    val b = submitted(home, "--after", a.toString(), "--", "true")
    assertEq(m(home, "hold", b.toString()).code, 0)
    refusedWith(m(home, "stop", "--wait"), "a waiting job is held, so `--wait` would wait for ever")
    assertEq(m(home, "stop", "--force").code, 0)
    assertEq(m(home, "wait", b.toString()).code, 143)
    cleanUp(home)

@test("an urgent job that waits for another joins the urgent band when it is ready, ahead of jobs queued before it")
togetherAfterUrgent()
    val home = newHome("{\"units\": 1}")
    val a = submitted(home, "--", "sleep", "1")
    val n = submitted(home, "--", "true")
    val u = submitted(home, "--after", a.toString(), "--urgent", "--", "true")
    assert(lsRow(home, u).contains(s"after $a"), lsRow(home, u))
    assertEq(m(home, "wait", n.toString()).code, 0)
    assertEq(m(home, "wait", u.toString()).code, 0)
    assertEq(startOrder(home, [n, u]), [u, n])
    assertEq(eventsOf(home, u), ["submitted", "ready", "started", "finished"])
    cleanUp(home)

@test("an urgent job that waits keeps its band across a restart")
togetherAfterUrgentAcrossRestart()
    val home = newHome("{\"units\": 1}")
    val a = submitted(home, "--", "sleep", "1.5")
    val n = submitted(home, "--", "true")
    val u = submitted(home, "--after", a.toString(), "--urgent", "--", "true")
    restarted(home)
    assertEq(m(home, "wait", n.toString()).code, 0)
    assertEq(m(home, "wait", u.toString()).code, 0)
    assertEq(startOrder(home, [n, u]), [u, n])
    cleanUp(home)

@test("a paused dependency delays the jobs waiting for it until it is resumed and ends")
togetherPausedDependency()
    val home = newHome()
    val a = submitted(home, "--", "sh", "-c", "sleep 1 & wait")
    val b = submitted(home, "--after", a.toString(), "--", "true")
    startedGroup(home, a)
    assertEq(m(home, "pause", a.toString()).code, 0)
    threads.sleep(millis(1800))
    assertEq(eventsOf(home, b), ["submitted"])
    assert(lsRow(home, b).contains(s"after $a"), lsRow(home, b))
    assertEq(m(home, "resume", a.toString()).code, 0)
    assertEq(m(home, "wait", b.toString()).code, 0)
    assert(startedAfter(home, b, a))
    cleanUp(home)

@test("a paused dependency still delays its dependents across a restart")
togetherPausedDependencyAcrossRestart()
    val home = newHome()
    val a = submitted(home, "--", "sh", "-c", "sleep 1 & wait")
    val b = submitted(home, "--after", a.toString(), "--", "true")
    startedGroup(home, a)
    assertEq(m(home, "pause", a.toString()).code, 0)
    restarted(home)
    threads.sleep(millis(1500))
    assertEq(eventsOf(home, b), ["submitted"])
    assertEq(m(home, "resume", a.toString()).code, 0)
    assertEq(m(home, "wait", b.toString()).code, 0)
    assert(startedAfter(home, b, a))
    cleanUp(home)

@test("a pause ends with a failed attempt, and the retry runs unpaused with its own run time")
togetherPausedAttemptRetried()
    val home = newHome()
    val cmd = s"if [ -f $home/once ]; then exit 0; fi; touch $home/once; sleep 30"
    val id = submitted(home, "--retries", "1", "--", "sh", "-c", cmd)
    val pgid = startedGroup(home, id)
    // paused only once the first attempt has marked itself, so the second one finds the mark
    waitForGroup(pgid, 2)
    val until = time.monotonic() + millis(5000)
    while !fs.exists(home + "/once") && time.monotonic() < until do threads.sleep(millis(20))
    assertEq(m(home, "pause", id.toString()).code, 0)
    // the paused attempt is ended from outside, as a crash would end it: a signal not sent by kill
    process.signal(-pgid, 9)
    assertEq(m(home, "wait", id.toString()).code, 0)
    assertEq(eventsOf(home, id), ["submitted", "started", "paused", "finished", "retry", "started", "finished"])
    val last = events(home).filter(e -> e("id").asLong() == Some(id)).last
    assertEq(last("paused").asBool(), Some(false))
    assertEq(last("attempt").asLong(), Some(long(2)))
    cleanUp(home)

@test("a retry of an urgent job joins the urgent band again, ahead of jobs queued while it ran")
togetherRetryUrgent()
    val home = newHome("{\"units\": 1}")
    val fails = failsUntil(home, 2)
    val u = submitted(home, "--urgent", "--retries", "1", "--", "sh", "-c", "sleep 0.8; " + fails(2))
    awaitEvent(home, u, "started")
    val n = submitted(home, "--", "true")
    assertEq(m(home, "wait", u.toString()).code, 0)
    assertEq(m(home, "wait", n.toString()).code, 0)
    assert(nthStart(home, u, 2) >= 0 && nthStart(home, u, 2) < at(home, n, "started"), s"${eventsOf(home, u)}")
    cleanUp(home)

@test("a retry of a job taken out of the urgent band by priority does not rejoin it")
togetherRetryLeftBand()
    val home = newHome("{\"units\": 1}")
    val blocker = submitted(home, "--", "sleep", "30")
    val fails = failsUntil(home, 2)
    val u = submitted(home, "--urgent", "--retries", "1", "--", "sh", "-c", "sleep 0.8; " + fails(2))
    assertEq(m(home, "priority", u.toString(), "0").code, 0)
    assertEq(m(home, "kill", blocker.toString()).code, 0)
    awaitEvent(home, u, "started")
    val n = submitted(home, "--", "true")
    assertEq(m(home, "wait", u.toString()).code, 0)
    assertEq(m(home, "wait", n.toString()).code, 0)
    assert(at(home, n, "started") < nthStart(home, u, 2), s"${eventsOf(home, u)}")
    cleanUp(home)

@test("a retry of an urgent job keeps its band across a restart during its retry delay")
togetherRetryUrgentAcrossRestart()
    val home = newHome("{\"units\": 1}")
    val fails = failsUntil(home, 2)
    val u = submitted(home, "--urgent", "--retries", "1", "--retry-delay", "2s", "--", "sh", "-c", "sleep 0.5; " + fails(2))
    awaitEvent(home, u, "started")
    // the unit is busy when the delay ends, so the retry has to queue, and goes ahead of n
    val busy = submitted(home, "--", "sleep", "3.5")
    val n = submitted(home, "--", "true")
    awaitEvent(home, u, "retry")
    restarted(home)
    assert(daemonLog(home).contains("and 1 waiting jobs"), daemonLog(home))
    assertEq(m(home, "wait", n.toString()).code, 0)
    assertEq(m(home, "wait", u.toString()).code, 0)
    assert(nthStart(home, u, 2) >= 0 && nthStart(home, u, 2) < at(home, n, "started"), s"${eventsOf(home, u)} ${eventsOf(home, n)}")
    assert(at(home, busy, "started") < nthStart(home, u, 2))
    cleanUp(home)

@test("wait --until ready and wait --until retry answer on those events, live and from the log")
togetherWaitReadyRetry()
    val home = daemonHome()
    val ready = startM(home, [], "wait", "--until", "ready", "--timeout", "20s")
    val retry = startM(home, [], "wait", "--until", "retry", "--timeout", "20s")
    settleWatch()
    val a = submitted(home, "--", "sleep", "0.3")
    val b = submitted(home, "--after", a.toString(), "--", "true")
    val c = submitted(home, (["--retries", "1", "--"] ++ failsUntil(home, 2))*)
    awaitExit(ready)
    awaitExit(retry)
    val r = json.parse(linesOf(ready)(0)).ok().get()
    assertEq(eventName(r), "ready")
    assertEq(r("id").asLong(), Some(b))
    val t = json.parse(linesOf(retry)(0)).ok().get()
    assertEq(eventName(t), "retry")
    assertEq(t("id").asLong(), Some(c))
    assertEq(t("attempt").asLong(), Some(long(2)))
    assertEq(m(home, "wait", c.toString()).code, 0)
    // the same events, already in the log
    val since = m(home, "wait", "--until", "ready", "--since", "1")
    assertEq(since.code, 0)
    assertEq(printedEvent(since)("id").asLong(), Some(b))
    val again = m(home, "wait", "--until", "retry:kind=" + t("kind").asString().get(), "--since", "1")
    assertEq(again.code, 0)
    assertEq(printedEvent(again)("id").asLong(), Some(c))
    cleanUp(home)

@test("events filters on every event name either feature logs, and ended:outcome=cancelled finds a cascade")
togetherEventsFilters()
    val home = newHome()
    val a = submitted(home, "--", "sh", "-c", "sleep 0.5; exit 1")
    val b = submitted(home, "--after", a.toString(), "--", "true")
    val c = submitted(home, "--", "sleep", "30")
    val d = submitted(home, "--after-any", a.toString(), "--", "true")
    assertEq(m(home, "hold", d.toString()).code, 0)
    assertEq(m(home, "release", d.toString()).code, 0)
    awaitEvent(home, c, "started")
    assertEq(m(home, "pause", c.toString()).code, 0)
    assertEq(m(home, "resume", c.toString()).code, 0)
    assertEq(m(home, "wait", d.toString()).code, 0)
    assertEq(m(home, "wait", b.toString()).code, 126)
    for (filter, id) in [("ready", d), ("held", d), ("released", d), ("paused", c), ("resumed", c), ("ended:outcome=cancelled", b)]
        val r = m(home, "events", filter)
        assertEq(r.code, 0)
        val evs = printedEvents(r)
        assertEq(evs.map(e -> e("id").asLong().get()), [id])
    assertEq(printedEvents(m(home, "events", "failed")).map(e -> e("id").asLong().get()), [a, b])
    cleanUp(home)

@test("wait --until job= on a job that is retried answers only when its last attempt ends, live and from the log")
togetherWaitJobRetried()
    val home = daemonHome()
    val id = submitted(home, (["--retries", "2", "--"] ++ ["sh", "-c", "sleep 0.5; " + failsUntil(home, 3)(2)])*)
    val w = startM(home, [], "wait", "--until", s"job=$id", "--timeout", "20s")
    awaitExit(w)
    val ev = json.parse(linesOf(w)(0)).ok().get()
    assertEq(ev("attempt").asLong(), Some(long(3)))
    assertEq(ev("exit").asLong(), Some(long(0)))
    // the log has three endings of the job; the one asked for is the last
    val back = m(home, "wait", "--until", s"job=$id")
    assertEq(printedEvent(back)("attempt").asLong(), Some(long(3)))
    val listed = m(home, "history", "--json")
    assert(listed.out.contains(s"\"id\":$id"), listed.out)
    cleanUp(home)

@test("wait --until job= on a job waiting to retry across a restart answers when it finally ends")
togetherWaitJobRetriedAcrossRestart()
    val home = daemonHome()
    // the first attempt fails; the second ends only once the test lets it
    val cmd = s"n=$$(cat $home/runs 2>/dev/null || echo 0); n=$$((n + 1)); echo $$n > $home/runs; [ $$n -ge 2 ] || exit 5; while [ ! -f $home/end ]; do sleep 0.05; done"
    val id = submitted(home, "--retries", "1", "--retry-delay", "3s", "--", "sh", "-c", cmd)
    awaitEvent(home, id, "retry")
    assertEq(m(home, "wait", "--until", s"job=$id", "--timeout", "1s").code, 124)
    restarted(home)
    fs.writeText(home + "/end", "").ok().get()
    val r = m(home, "wait", "--until", s"job=$id", "--timeout", "20s")
    assertEq(r.code, 0)
    assertEq(printedEvent(r)("attempt").asLong(), Some(long(2)))
    cleanUp(home)

@test("wait --until idle waits for a job waiting for another and for one waiting to retry")
togetherIdleWaits()
    val home = daemonHome()
    val id = submitted(home, (["--retries", "1", "--retry-delay", "3s", "--"] ++ failsUntil(home, 2))*)
    awaitEvent(home, id, "retry")
    assertEq(m(home, "wait", "--until", "idle", "--timeout", "1s").code, 124)
    val r = m(home, "wait", "--until", "idle", "--timeout", "20s")
    assertEq(r.code, 0)
    assertEq(eventsOf(home, id).last, "finished")
    val a = submitted(home, "--", "sleep", "30")
    val b = submitted(home, "--after", a.toString(), "--", "true")
    assertEq(m(home, "kill", a.toString()).code, 0)
    assertEq(m(home, "wait", "--until", "idle", "--timeout", "20s").code, 0)
    assertEq(eventsOf(home, b), ["submitted", "cancelled"])
    cleanUp(home)

@test("a held waiting job stays held across a restart, and a ready one there waits for its release")
togetherHeldWaitingAcrossRestart()
    val home = newHome()
    val a = submitted(home, "--", "sleep", "1")
    val b = submitted(home, "--after", a.toString(), "--", "true")
    assertEq(m(home, "hold", b.toString()).code, 0)
    restarted(home)
    assert(lsRow(home, b).contains(s"held after $a"), lsRow(home, b))
    assertEq(m(home, "wait", a.toString()).code, 0)
    awaitEvent(home, b, "ready")
    restarted(home)
    threads.sleep(millis(300))
    assertEq(eventsOf(home, b), ["submitted", "held", "ready"])
    assertEq(m(home, "release", b.toString()).code, 0)
    assertEq(m(home, "wait", b.toString()).code, 0)
    cleanUp(home)
