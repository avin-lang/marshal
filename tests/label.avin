module tests

// Job labels: what a label may be, how it travels (the wire, the saved state, the event log), and
// where it shows (ls, history, events filters, top).
import avin.time
import json
import json.Json
import dev.avinlang.marshal
import dev.avinlang.marshal.cli
import dev.avinlang.marshal.top
import dev.avinlang.marshal.{HistoryFilter, JobInfo, JobSpec, Ledger, Outcome, Overview, SavedJob, SavedState, Usage}
import dev.avinlang.tui.{Enter, Span, Table}

val labelSpec: JobSpec = JobSpec("test", 4, 0, false, "/w", None, ["sysl", "test", "."], [("PATH", "/bin")], false, [], false, 0, 0, false, "train 209")

// A job as a listing or the log gives it, with `label`.
labelled(id: long, label: string, state: string = "running", outcome: Option[Outcome] = None) -> JobInfo =
    JobInfo(id, "build", 1, 0, false, "/w", ["sleep", "30"], state, outcome, false, 0, 60000, 1200000, s"/h/jobs/$id.log", None, 0, 0, 0, false, 0, false, false, [], 1, 0, false, label)

refusedLabel(text: string, why: string) = marshal.checkLabel(text) match
    Err(e) -> assert(e.contains(why), s"`$text`: $e")
    Ok(t) -> fail(s"`$text` was accepted as `$t`")

@test("a label is one line of 1 to 80 characters with no control characters and no space at either end")
labelValid()
    for text in ["x", "train 209", "release 0.2.4, take 2", "a  b", "日本語のラベル", "é😀", "tab-free\u{a0}nbsp"]
        assertEq(marshal.checkLabel(text), Ok(text))
    val eighty = (0 ..< 80).map(i -> "x").mkString("")
    assertEq(marshal.checkLabel(eighty), Ok(eighty))
    val wide = (0 ..< 80).map(i -> "é").mkString("")
    assertEq(marshal.checkLabel(wide), Ok(wide))

@test("a label that is empty, too long, has a control character or a space at an end is refused, with the reason")
labelInvalid()
    refusedLabel("", "not empty")
    refusedLabel((0 ..< 81).map(i -> "x").mkString(""), "at most 80 characters, not 81")
    refusedLabel((0 ..< 81).map(i -> "é").mkString(""), "at most 80 characters, not 81")
    refusedLabel("a\nb", "one line")
    refusedLabel("a\r", "one line")
    refusedLabel("a\tb", "one line")
    refusedLabel("a\u{0}b", "one line")
    refusedLabel("a\u{1b}[31mb", "one line")
    refusedLabel("a\u{7f}", "one line")
    refusedLabel("a\u{85}b", "one line")
    refusedLabel(" a", "begin or end with a space")
    refusedLabel("a ", "begin or end with a space")
    refusedLabel("   ", "begin or end with a space")

@test("a label travels in a submit request, and a job without one writes no label member")
labelWire()
    assertEq(marshal.decodeRequest(marshal.encodeRequest(marshal.Request.Submit(labelSpec)).render()), Ok(marshal.Request.Submit(labelSpec)))
    assert(marshal.encodeSpec(labelSpec).render().contains("\"label\":\"train 209\""), marshal.encodeSpec(labelSpec).render())
    val plain = JobSpec("build", 1, 0, false, "/w", None, ["make"], [])
    assert(!marshal.encodeSpec(plain).render().contains("label"), marshal.encodeSpec(plain).render())
    assertEq(marshal.decodeSpec(marshal.encodeSpec(plain)).map(s -> s.label), Ok(""))

@test("a request from a client that knows no labels, or sends a null one, has none")
labelOldClient()
    val old = "{\"op\":\"submit\",\"kind\":\"build\",\"units\":1,\"mem\":0,\"dir\":\"/w\",\"cmd\":[\"make\"]}"
    assertEq(marshal.decodeRequest(old).map(r -> r match
        marshal.Request.Submit(s) -> s.label
        _ -> "wrong"), Ok(""))
    val nulled = "{\"op\":\"submit\",\"kind\":\"build\",\"units\":1,\"mem\":0,\"dir\":\"/w\",\"cmd\":[\"make\"],\"label\":null}"
    assertEq(marshal.decodeRequest(nulled).map(r -> r match
        marshal.Request.Submit(s) -> s.label
        _ -> "wrong"), Ok(""))

@test("a request with a bad label is refused, naming the field")
labelBadRequest()
    val head = "{\"op\":\"submit\",\"kind\":\"build\",\"units\":1,\"mem\":0,\"dir\":\"/w\",\"cmd\":[\"make\"],\"label\":"
    for (text, why) in [("\"\"", "not empty"), ("\"a\\nb\"", "one line"), ("\"" + (0 ..< 81).map(i -> "x").mkString("") + "\"", "at most 80"), ("7", "`label` is not a string"), ("[\"a\"]", "`label` is not a string")]
        marshal.decodeRequest(head + text + "}") match
            Err(e) -> assert(e.contains(why) && e.contains("label"), s"$text: $e")
            Ok(r) -> fail(s"$text read as $r")

@test("a job's label reads back from a reply, and a reply without one has none")
labelInJobReply()
    val j = labelled(7, "train 209")
    assertEq(marshal.decodeJob(marshal.encodeJob(j)), Ok(j))
    assert(marshal.encodeJob(j).render().contains("\"label\":\"train 209\""), marshal.encodeJob(j).render())
    val plain = labelled(7, "")
    assert(!marshal.encodeJob(plain).render().contains("label"), marshal.encodeJob(plain).render())
    assertEq(marshal.decodeJob(marshal.encodeJob(plain)).map(i -> i.label), Ok(""))
    // a label already in the log is read as it is, whatever the limits are now
    val long81 = (0 ..< 90).map(i -> "x").mkString("")
    assertEq(marshal.decodeJob(marshal.encodeJob(labelled(7, long81))).map(i -> i.label), Ok(long81))

@test("a labelled job reads back from the saved state, in the queue, running and ended, and an old state has no label")
labelSavedState()
    val saved = (id: long, state: string) -> SavedJob(id, labelSpec, state, 1, 2, 3, 4, 5, 6, s"/h/jobs/$id.log", 0, 0, None, false, false, None, 0, 0)
    val s = SavedState("0.2.4", 1, 2, 3, 10, [saved(9, "queued")], [saved(8, "running")], [saved(7, "done")], None)
    assertEq(marshal.decodeState(marshal.encodeState(s).render()), Ok(s))
    assert(marshal.encodeState(s).render().contains("\"label\":\"train 209\""), marshal.encodeState(s).render())
    val oldSpec = JobSpec("test", 4, 0, false, "/w", None, ["sysl"], [])
    val old = SavedState("0.2.4", 1, 2, 3, 10, [SavedJob(9, oldSpec, "queued", 1, 2, 3, 4, 5, 6, "/h/jobs/9.log", 0, 0, None, false, false, None, 0, 0)], [], [], None)
    assertEq(marshal.decodeState(marshal.encodeState(old).render()), Ok(old))
    assert(!marshal.encodeState(old).render().contains("label"), marshal.encodeState(old).render())
    assertEq(marshal.decodeState(marshal.encodeState(old).render()).map(r -> r.queue(0).spec.label), Ok(""))

@test("every event of a labelled job carries its label, and rerun finds it in the submitted event")
labelInEvents()
    val j = labelled(7, "train 209")
    val submitted = marshal.eventLine(1000, "submitted", j, [("spec", marshal.encodeSpec(labelSpec))])
    assert(submitted.contains("\"label\":\"train 209\""), submitted)
    val ended = marshal.eventLine(2000, "finished", labelled(7, "train 209", "done", Some(Outcome.Exited(0))), [("run_ms", Json.num(5)), ("exit", Json.num(0))])
    assert(ended.contains("\"label\":\"train 209\""), ended)
    assertEq(marshal.specOf([submitted, ended], 7).map(s -> s.label), Some("train 209"))
    // a job that was lost keeps its label
    assertEq(marshal.asLost(j).label, "train 209")

endedLine(ts: long, id: long, label: string, how: Outcome = Outcome.Exited(0)) -> string =
    marshal.eventLine(ts, "finished", labelled(id, label, "done", Some(how)), [("run_ms", Json.num(1000)), ("exit", Json.num(marshal.exitCode(how)))])

@test("history reads each job's label from its ending event, and filters by a part of it, case as written")
labelHistoryFilter()
    val l = ledgerOf([endedLine(1000, 1, "train 209"), endedLine(2000, 2, ""), endedLine(3000, 3, "train 210, take 2"), endedLine(4000, 4, "Release 0.2.4", Outcome.Exited(1))])
    assertEq(l.ends.toVector().map(e -> e.label), ["train 209", "", "train 210, take 2", "Release 0.2.4"])
    val pick = (text: string) -> marshal.selectEnded(l, HistoryFilter(None, None, false, Some(text)), 20).map(e -> e.id)
    assertEq(pick("train"), [long(3), long(1)])
    assertEq(pick("209"), [long(1)])
    assertEq(pick("train 210, take"), [long(3)])
    assertEq(pick("Release"), [long(4)])
    assertEq(pick("release"), [])
    assertEq(pick("nothing"), [])
    assertEq(marshal.selectEnded(l, HistoryFilter(None, None, true, Some("")), 20).map(e -> e.id), [long(4)])
    assertEq(marshal.selectEnded(l, HistoryFilter(None, None, true, Some("train")), 20).map(e -> e.id), [])
    assertEq(marshal.selectEnded(l, HistoryFilter(None, None, false), 20).map(e -> e.id), [long(4), long(3), long(2), long(1)])

@test("history prints a LABEL column last, always, and --json gives the label only for a labelled job")
labelHistoryPrinting()
    val zone = time.utc
    val plain = ledgerOf([endedLine(1000, 1, ""), endedLine(2000, 2, "")])
    val withOut = marshal.historyListing(marshal.selectEnded(plain, HistoryFilter(None, None, false), 20), zone)
    val bare = withOut.lines().toVector()
    assert(bare(0).endsWith("LABEL") && bare(0).contains("ENDED"), bare(0))
    assertEq(bare.length(), 3)
    assert(!bare(1).contains("train"), bare(1))
    val l =ledgerOf([endedLine(1000, 1, "train 209"), endedLine(2000, 2, "")])
    val shown = marshal.historyListing(marshal.selectEnded(l, HistoryFilter(None, None, false), 20), zone).lines().toVector()
    assert(shown(0).startsWith("ID  KIND") && shown(0).endsWith("LABEL") && shown(0).contains("ENDED"), shown(0))
    assertEq(shown(0).indexOf("LABEL"), shown(2).indexOf("train 209"))
    assert(shown(2).endsWith("train 209"), shown(2))
    assert(!shown(1).contains("train"), shown(1))
    val onlyPlain = marshal.historyListing(marshal.selectEnded(l, HistoryFilter(None, None, false, Some("none")), 20), zone)
    assertEq(onlyPlain, "marshal: no ended jobs match")
    val json = marshal.historyJson(marshal.selectEnded(l, HistoryFilter(None, None, false), 20), 0).render()
    assert(json.contains("\"label\":\"train 209\""), json)
    assertEq(json.split("\"label\"").length(), 2)

@test("history and stats take --label, and refuse it with no text")
labelHistoryOptions()
    val parse = (command: string, args: Vector[string]) -> cli.parseQuery(command, args, 1_000_000, time.utc)
    assertEq(parse("history", ["--label", "train 209"]).map(q -> q.filter.label), Ok(Some("train 209")))
    assertEq(parse("stats", ["--label", "train", "--kind", "test"]).map(q -> (q.filter.label, q.filter.kind)), Ok((Some("train"), Some("test"))))
    assertEq(parse("history", []).map(q -> q.filter.label), Ok(None))
    assertEq(parse("history", ["--label", ""]), Err("marshal: --label needs some text"))
    assertEq(parse("history", ["--label"]), Err("marshal: --label needs a value"))

@test("the events filter label= matches a part of a job's label, takes the rest of the text with its commas, and combines with the others")
labelEventFilter()
    val filterOf = (text: string) -> marshal.parseFilter(text).ok().get()
    assertEq(filterOf("any:label=train 209").label, Some("train 209"))
    assertEq(filterOf("ended:label=train 210, take 2").label, Some("train 210, take 2"))
    val both = filterOf("ended:kind=build,label=a,b=c")
    assertEq((both.kind, both.label), (Some("build"), Some("a,b=c")))
    val all = filterOf("ended:outcome=failed,kind=test,label=x")
    assertEq((all.outcome, all.kind, all.label), (Some("failed"), Some("test"), Some("x")))
    assertEq(filterOf("ended").label, None)
    val labelled = (label: string) -> Json.Obj([("event", Json.str("finished")), ("id", Json.num(1)), ("kind", Json.str("build")), ("exit", Json.num(0)), ("label", Json.str(label))])
    val unlabelled = Json.Obj([("event", Json.str("finished")), ("id", Json.num(1)), ("kind", Json.str("build")), ("exit", Json.num(0))])
    val f = filterOf("ended:label=train")
    assert(marshal.admits(f, labelled("train 209")))
    assert(marshal.admits(f, labelled("the train")))
    assert(!marshal.admits(f, labelled("Train 209")))
    assert(!marshal.admits(f, labelled("")))
    assert(!marshal.admits(f, unlabelled))
    assert(!marshal.admits(filterOf("ended:kind=test,label=train"), labelled("train 209")))
    assert(marshal.admits(filterOf("ended:kind=build,label=train"), labelled("train 209")))
    assert(marshal.admits(filterOf("ended"), unlabelled))

@test("a label= filter with no text, or a filter of the wrong shape beside it, is refused")
labelEventFilterRefused()
    for text in ["ended:label=", "ended:kind=build,label=", "ended:label"]
        assert(marshal.parseCondition(text).isErr(), text)
    assert(marshal.parseCondition("ended:label").err().get().contains("is not a filter"), marshal.parseCondition("ended:label").err().get())
    assert(marshal.parseCondition("ended:kind=build,").isErr())
    assert(marshal.parseCondition("idle:label=x").isErr())
    assert(marshal.parseCondition("job=3,label=x").isErr())
    // kind twice is still refused beside a label
    assert(marshal.parseCondition("ended:kind=a,kind=b,label=x").isErr())

@test("run and submit read --label, run-type does too, and each refuses a bad label with a reason")
labelOptions()
    val env: Vector[(string, string)] = []
    val parse = (args: Vector[string]) -> cli.parseSubmission(args, "/w", env)
    assertEq(parse(["--label", "train 209", "--", "make"]).map(s -> s.label), Ok("train 209"))
    assertEq(parse(["--kind", "docs", "--label", "x", "make"]).map(s -> (s.kind, s.label, s.cmd)), Ok(("docs", "x", ["make"])))
    assertEq(parse(["make"]).map(s -> s.label), Ok(""))
    assertEq(parse(["--label", "a\nb", "--", "make"]), Err("`--label`: a label is one line of printable text: no newline, tab or other control character"))
    assertEq(parse(["--label", "", "--", "make"]), Err("`--label`: a label is text, not empty"))
    assertEq(parse(["--label", (0 ..< 81).map(i -> "x").mkString(""), "--", "make"]), Err("`--label`: a label is at most 80 characters, not 81"))
    assertEq(parse(["--label"]), Err("`--label` needs a value"))
    assertEq(cli.typeLine(["--label", "train 209", "train", "main"]).map(l -> (l.label, l.rest)), Ok(("train 209", ["train", "main"])))
    assertEq(cli.typeLine(["train", "main", "--label", "x", "--submit"]).map(l -> (l.label, l.submitOnly, l.rest)), Ok(("x", true, ["train", "main"])))
    assertEq(cli.typeLine(["train"]).map(l -> l.label), Ok(""))
    assertEq(cli.typeLine(["--label", " x", "train"]), Err("`--label`: a label does not begin or end with a space"))
    assertEq(cli.typeLine(["train", "--label"]), Err("`--label` needs a value"))

@test("ls always has a LABEL column before COMMAND, empty for a job without a label")
labelListing()
    val none = marshal.listing([labelled(1, ""), labelled(2, "")]).lines().toVector()
    assertEq(none(0), "ID  STATE    KIND   UNITS  RESV  STARTED  ELAPSED  LABEL  COMMAND")
    assertEq(none(1).indexOf("sleep 30"), none(0).indexOf("COMMAND"))
    val rows = marshal.listing([labelled(1, "train 209"), labelled(2, ""), labelled(30, "a longer label")]).lines().toVector()
    assert(rows(0).contains("ELAPSED  LABEL"), rows(0))
    assert(rows(0).endsWith("LABEL           COMMAND"), rows(0))
    assertEq(rows(1).indexOf("train 209"), rows(0).indexOf("LABEL"))
    assertEq(rows(3).indexOf("a longer label"), rows(0).indexOf("LABEL"))
    for r in rows.drop(1)
        assertEq(r.indexOf("sleep 30"), rows(0).indexOf("COMMAND"))

@test("the label column of top: shown whether or not a listed job has a label, elided and dropped by the width")
labelColumnWidth()
    val base = top.columnsFor(120, 7)
    val withLabel = top.withLabelColumn(base)
    assertEq(withLabel.map(c -> c.title).takeRight(2), ["LABEL", "COMMAND"])
    assertEq(withLabel.length(), base.length() + 1)
    val cells = [Span("1"), Span("cmd")]
    // the label is whole in its cell: the table sizes the column to the longest and cuts it with an ellipsis
    assertEq(top.withLabelCell(cells, "a long label"), [Span("1"), Span("a long label"), Span("cmd")])
    // no label: a one-space cell, which keeps the table from leaving the column out
    assertEq(top.withLabelCell(cells, ""), [Span("1"), Span(" "), Span("cmd")])
    // 120 cells: the fixed columns take 75 and 11 separators, and COMMAND keeps 20, leaving 14
    assertEq(labelCells("abc", 120), 5)
    assertEq(labelCells("123456789", 120), 9)
    assertEq(labelCells("12345678901234567890", 120), 14)
    assertEq(labelCells("12345678901234567890", 200), 20)
    assertEq(labelCells("1234567890123456789012345678901234567890", 200), top.LabelCap)
    // a narrow screen leaves the column out; a screen where no job has a label keeps it, at its heading's width
    assertEq(labelCells("train 209", 90), 0)
    assertEq(labelCells("", 200), 5)
    assertEq(labelCells("", 120), 5)
    assertEq(labelCells("", 90), 0)

@test("the label column is sized and cut by display width: a double-width character counts 2 cells")
labelWideCharacters()
    // five double-width characters take 10 cells, though they are 5 characters
    assertEq(labelCells("日本語のラ", 200), 10)
    assertEq(labelCells("日本語のラベル", 200), 14)
    // 13 characters are 26 cells, cut at the cap of 24; the same label is narrowed by a narrow screen
    assertEq(labelCells("日本語のラベルはとても長い", 200), top.LabelCap)
    assertEq(labelCells("日本語のラベルはとても長い", 120), 14)
    assertEq(labelCells("abc日", 200), 5)

// The cells the LABEL column takes in a table `width` cells wide drawing a row with `label`; 0 where
// the column is left out.
labelCells(label: string, width: int) -> int
    val base = top.columnsFor(width, 7)
    val withLabel = top.withLabelColumn(base)
    Table(withLabel).widths(width, [top.withLabelCell(base.map(c -> Span("x")), label)])(withLabel.length() - 2)

// An overview of the jobs given, all running.
overviewOf(jobs: Vector[JobInfo]) -> Overview =
    Overview(Usage(1, 12, 0, 4294967296, jobs.length(), 0, None, None), 1000, jobs, [], [])

@test("top draws LABEL before COMMAND on a wide screen, elided to its column, and with empty cells when no job has a label")
labelTopTable()
    val wide = drawn(viewing(overviewOf([labelled(1, "train 209"), labelled(2, "")])), 140, 20)
    val head = rowOf(wide, "ID STATE")
    assert(wide.rowText(head).contains("LABEL"), wide.rowText(head))
    assert(wide.rowText(head).indexOf("LABEL") < wide.rowText(head).indexOf("COMMAND"), wide.rowText(head))
    assert(wide.rowText(head + 1).contains("train 209"), wide.rowText(head + 1))
    assertEq(wide.rowText(head + 1).indexOf("train 209"), wide.rowText(head).indexOf("LABEL"))
    assert(wide.rowText(head + 1).trim().endsWith("sleep 30"), wide.rowText(head + 1))
    assert(wide.rowText(head + 2).trim().endsWith("sleep 30"), wide.rowText(head + 2))
    assertEq(wide.rowText(head + 2).indexOf("sleep 30"), wide.rowText(head + 1).indexOf("sleep 30"))
    // a long label is cut with an ellipsis, and COMMAND keeps its place
    val long = (0 ..< 60).map(i -> "L").mkString("")
    val cut = drawn(viewing(overviewOf([labelled(1, long)])), 140, 20)
    assert(cut.rowText(head + 1).contains("…"), cut.rowText(head + 1))
    assert(!cut.rowText(head + 1).contains(long), cut.rowText(head + 1))
    assert(cut.rowText(head + 1).trim().endsWith("sleep 30"), cut.rowText(head + 1))
    // a narrow screen leaves the column out
    val narrow = drawn(viewing(overviewOf([labelled(1, "train 209")])), 100, 20)
    assert(!narrow.rowText(rowOf(narrow, "ID STATE")).contains("LABEL"), narrow.rowText(rowOf(narrow, "ID STATE")))
    // no label anywhere: the column is there with empty cells, COMMAND in the same place as with labels
    val plain = drawn(viewing(overviewOf([labelled(1, ""), labelled(2, "")])), 140, 20)
    val plainHead = rowOf(plain, "ID STATE")
    assert(plain.rowText(plainHead).contains("LABEL"), plain.rowText(plainHead))
    assertEq(plain.rowText(plainHead).trim().split(" ").filter(w -> w.nonEmpty()).takeRight(2), ["LABEL", "COMMAND"])
    assertEq(plain.rowText(plainHead + 1).indexOf("sleep 30"), plain.rowText(plainHead).indexOf("COMMAND"))
    // a screen too narrow for it still leaves it out, labels or none
    val plainNarrow = drawn(viewing(overviewOf([labelled(1, "")])), 100, 20)
    assert(!plainNarrow.rowText(rowOf(plainNarrow, "ID STATE")).contains("LABEL"), plainNarrow.rowText(rowOf(plainNarrow, "ID STATE")))

@test("top's log pane header shows the whole label after the kind, wrapped under where it began, and is as it was for a job without one")
labelTopLogHeader()
    val app = viewing(overviewOf([labelled(1, "train 209"), labelled(2, "")]))
    app.handle(press(Enter))
    app.logLines = ["a line"]
    val g = drawn(app, 100, 30)
    val title = rowOf(g, "job 1 log, following")
    assert(g.rowText(title + 1).contains("kind"), g.rowText(title + 1))
    assert(g.rowText(title + 1).contains("build   label  train 209"), g.rowText(title + 1))
    assert(g.rowText(title + 2).contains("command") && g.rowText(title + 2).contains("sleep 30"), g.rowText(title + 2))
    assert(g.rowText(title + 3).contains("──────"), g.rowText(title + 3))
    assert(!g.rowText(title + 2).contains("label"), g.rowText(title + 2))
    // a job without a label: the kind line is the one there always was, and the command follows it
    val plain = viewing(overviewOf([labelled(2, "")]))
    plain.handle(press(Enter))
    plain.logLines = ["a line"]
    val p = drawn(plain, 100, 30)
    val pt = rowOf(p, "job 2 log, following")
    assert(p.rowText(pt + 1).contains("kind") && p.rowText(pt + 1).contains("build"), p.rowText(pt + 1))
    assertEq(p.rowText(pt + 1).replace("│", "").trim(), "kind    build")
    assert(p.rowText(pt + 2).contains("command"), p.rowText(pt + 2))
    assert(p.rowText(pt + 3).contains("──────"), p.rowText(pt + 3))
    // a label too long for the rest of the kind line wraps under where it began, every character kept
    val long = (0 ..< 120).map(i -> if i % 10 == 9 then "z" else "a").mkString("")
    val wrapped = viewing(overviewOf([labelled(3, long)]))
    wrapped.handle(press(Enter))
    wrapped.logLines = ["a line"]
    val w = drawn(wrapped, 60, 30)
    val wt = rowOf(w, "job 3 log, following")
    val start = w.rowText(wt + 1).indexOf("label") + 7
    var seen = ""
    for k in 1 ..< 5
        seen = seen + w.rowText(wt + k).slice(start, w.rowText(wt + k).byteLength()).replace("│", "").trim()
    assert(!seen.contains("…"), seen)
    assertEq(seen, long)
    assert(w.rowText(wt + 1).contains("kind") && w.rowText(wt + 1).contains("build   label  "), w.rowText(wt + 1))
    assert(!w.rowText(wt + 2).contains("label") && !w.rowText(wt + 2).contains("kind"), w.rowText(wt + 2))
    assert(w.rowText(wt + 5).contains("command"), w.rowText(wt + 5))
    assertEq(rowOf(w, "command"), wt + 5)
