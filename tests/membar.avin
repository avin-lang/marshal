module tests

// The memory meter of `marshal top`, drawn in bars as htop draws its meters: the reserved memory in
// cyan, what the running jobs hold beyond their reservations in blue, the rest blank, and the label
// inside the brackets against `]`.
import dev.avinlang.marshal.top
import dev.avinlang.tui.{Blue, BrightBlack, Cyan, Grid}

// The meter drawn 16 cells wide at the left of a fresh grid, against a 16G budget unless told, so a
// cell is a gigabyte.
bar(reserved: long, held: long, budget: long = 16 * G, label: string = "") -> Grid
  val g = Grid(20, 1)
  top.memBar(g, 0, 0, 16, reserved, held, budget, label)
  g

// The colour of each of the meter's cells, `c` cyan, `b` blue, `.` empty.
shades(g: Grid) -> string =
  (1 .. 16).map(
    x -> if g(
      x,
      0
    ).text == " " then "." elif g(x, 0).style.fg == Cyan then "c" elif g(x, 0).style.fg == Blue then "b" else "?"
  ).mkString("")

g0(g: Grid) -> string = g.rowText(0).trim

@test("reserved memory alone is cyan bars, held equal, less or unknown alike")
reservedOnly()
  assertEq(shades(bar(4 * G, 4 * G)), "cccc............")
  assertEq(g0(bar(4 * G, 4 * G)), "[||||            ]")
  assertEq(shades(bar(4 * G, 0)), "cccc............")
  assertEq(shades(bar(4 * G, 2 * G)), "cccc............")
  // a half cell rounds up
  assertEq(shades(bar(G * 9 / 2, 0)), "ccccc...........")
  assertEq(shades(bar(0, 0)), "................")
  assertEq(shades(bar(16 * G, 16 * G)), "cccccccccccccccc")
  assertEq(shades(bar(40 * G, 0)), "cccccccccccccccc")
  // no budget set: an empty meter
  assertEq(g0(bar(4 * G, 9 * G, 0)), "[                ]")

@test("measured memory alone, with nothing reserved, fills the meter in blue")
rssOnly()
  assertEq(shades(bar(0, 8 * G)), "bbbbbbbb........")
  assertEq(g0(bar(0, 8 * G)), "[||||||||        ]")
  // more than the budget fills the meter and no more
  assertEq(shades(bar(0, 40 * G)), "bbbbbbbbbbbbbbbb")

@test("reserved and measured beyond it: cyan for the reservations, then blue for the rest")
both()
  assertEq(shades(bar(4 * G, 10 * G)), "ccccbbbbbb......")
  assertEq(g0(bar(4 * G, 10 * G)), "[||||||||||      ]")
  assertEq(shades(bar(G * 9 / 2, 10 * G)), "cccccbbbbb......")
  // both past the budget: the reservations fill it
  assertEq(shades(bar(20 * G, 30 * G)), "cccccccccccccccc")
  // a reservation too small for half a cell still shows as one cyan cell
  assertEq(shades(bar(1, 8 * G)), "cbbbbbbb........")

@test("the label sits inside the brackets against `]`, in the colour of the cells it covers")
label()
  val g = bar(4 * G, 10 * G, label = "4G/16G")
  assertEq(g0(g), "[||||||||||4G/16G]")
  assertEq(g(10, 0).style.fg, Blue)
  assertEq(g(11, 0).style.fg, BrightBlack)
  // a full meter: the label is drawn over the bars, in the reservations' colour
  val full = bar(16 * G, 0, label = "16G/16G")
  assertEq(g0(full), "[|||||||||16G/16G]")
  assertEq(full(16, 0).style.fg, Cyan)
  // no budget set: the memory the jobs reserve, on an empty meter
  assertEq(g0(bar(4 * G, 0, 0, "4G")), "[              4G]")
